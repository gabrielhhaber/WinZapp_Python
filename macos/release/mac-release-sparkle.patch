+
+  appcast:
+    needs: appcast-plan
+    if: ${{ !cancelled() && needs.appcast-plan.outputs.tags != '' && needs.appcast-plan.outputs.tags != '[]' }}
+    runs-on: macos-15
+    permissions:
+      contents: write     # the appcast branch (the feed's state)
+      pages: write        # actions/deploy-pages
+      id-token: write     # actions/deploy-pages
+    environment:
+      name: github-pages
+      url: ${{ steps.deploy.outputs.page_url }}
+    env:
+      # Sparkle's tools for signing, pinned here (not taken from the tag):
+      # the official release archive and the SHA-256 GitHub publishes for it,
+      # the same pin as build_app.py's.
