             --repo "$GITHUB_REPOSITORY" --title "$name" --notes-file notes.md "${flags[@]}"
+
+  appcast-plan:
+    # Which published releases the appcast still lacks, read from the
+    # releases and the appcast itself, not from this run's plan: a release
+    # whose appcast job failed (or that an earlier run published) is added
+    # on the next run. A tag older than the newest item of its channel
+    # already in a feed is never re-queued: that feed keeps only its newest
+    # items (appcast.py merge), so it would be pruned again on every run.
+    needs: publish
+    if: ${{ !cancelled() && vars.SPARKLE_PUBLIC_ED_KEY != '' }}
+    runs-on: ubuntu-latest
+    outputs:
+      tags: ${{ steps.plan.outputs.tags }}
+    steps:
+      - id: plan
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          python3 - <<'PY' >> "$GITHUB_OUTPUT"
+          import base64, json, os, re, subprocess
+
+          REPO, UPSTREAM = os.environ["GITHUB_REPOSITORY"], os.environ["UPSTREAM"]
+          TAG = re.compile(r"v(\d+)\.(\d+)\.(\d+)\.(\d+)(alpha|beta)?")
+
+          def key(tag):   # provenance.tag_is_newer's order
+              m = TAG.fullmatch(tag)
+              return tuple(int(m.group(i)) for i in range(1, 5)) + ({"alpha": 1, "beta": 2}.get(m.group(5), 3),)
+
+          def channel(tag):
+              return "alpha" if tag.endswith("alpha") else ""
+
+          def gh(*args, ok=False):
+              r = subprocess.run(["gh", *args], capture_output=True, text=True)
+              if r.returncode and not (ok and "404" in r.stderr):
+                  raise SystemExit(r.stderr)
+              return r.returncode == 0, r.stdout
+
+          feeds = {}
+          for arch in ("arm64", "x86_64"):
