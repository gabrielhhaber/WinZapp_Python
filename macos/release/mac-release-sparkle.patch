+          for tag in sorted((t for t in out.split() if TAG.fullmatch(t)), key=key):
+              if not (needed(tag, "arm64") or needed(tag, "x86_64")):
+                  continue
+              _, assets = gh("release", "view", tag, "--repo", REPO, "--json", "assets",
+                             "--jq", ".assets[].name")
