@@ -191,6 +201,9 @@ jobs:
           # The checkout has no tags; build_app checks HEAD is this tag's commit.
           WINZAPP_RELEASE_TAG: ${{ matrix.tag }}
           WINZAPP_CI_GITHUB_TOKEN: ${{ github.token }}
+          # Read only by a tag whose build_app knows Sparkle; older tags ignore them.
+          WINZAPP_SPARKLE_PUBLIC_KEY: ${{ vars.SPARKLE_PUBLIC_ED_KEY }}
