+              items = json.loads(base64.b64decode(json.loads(out)["content"])) if found else []
+              feeds[arch] = {i["tag"]: channel(i["tag"]) for i in items}
+
+          def needed(tag, arch):
+              listed = feeds[arch]
+              if tag in listed:
+                  return False
+              same = [t for t, c in listed.items() if c == channel(tag)]
+              return not same or key(tag) > max(map(key, same))
+
+          _, out = gh("api", f"repos/{REPO}/releases?per_page=30",
+                      "--jq", ".[] | select(.draft | not) | .tag_name")
