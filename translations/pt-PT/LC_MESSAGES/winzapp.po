msgstr "Ctrl+Alt+Shift+O: ativar/desativar o modo offline"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_p_label"
msgid ""
"Ctrl+Alt+Shift+P: pause/resume whichever audio is currently playing, from "
