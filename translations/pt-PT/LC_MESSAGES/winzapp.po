#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_launch.py
#: client/ui/conversation_panel/ai_actions.py
msgctxt "ai_disabled"
msgid ""
"Turn on AI features, add a key for a provider and enable this kind of media "
"in Settings > Online AI: Transcriptions and Descriptions first."
msgstr ""
"Primeiro ative as funcionalidades de IA, introduza a chave de um fornecedor "
"e ative este tipo de conteúdo em Definições > IA online: Transcrições e "
"Descrições."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_authentication"
msgid ""
"The provider rejected the key or access to this model. Check the key and "
"permissions."
msgstr ""
"O fornecedor recusou a chave ou o acesso ao modelo. Verifique a chave e as "
"permissões."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_busy"
msgid ""
"An operation is already running. Wait or cancel it before starting another."
msgstr ""
"Já existe uma operação em curso. Aguarde ou cancele antes de iniciar outra."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_cancelled"
msgid "The request was cancelled."
msgstr "O pedido foi cancelado."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_credentials"
msgid ""
"The API key cannot be read or saved. Re-enter it; for a damaged credential "
"store, explicitly reset all AI keys first."
msgstr ""
"Não foi possível ler ou guardar a chave de API. Introduza-a novamente; se o "
"armazenamento estiver danificado, reponha explicitamente todas as chaves de "
"IA primeiro."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_limit"
msgid ""
"This session reached its request or conversation limit. Close it before "
"starting a new session."
msgstr ""
"Esta sessão atingiu o seu limite de pedidos ou perguntas. Feche a janela "
"antes de iniciar outra sessão."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media"
msgid ""
"The original media could not be downloaded or read. It may no longer be "
"available on WhatsApp."
msgstr ""
"Não foi possível transferir ou ler o conteúdo original. Pode já não estar "
"disponível no WhatsApp."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media_format"
msgid "This file is not in a supported, readable format."
msgstr "Este ficheiro não está num formato legível e suportado."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media_size"
msgid "This file exceeds the size limit for sending to an AI provider."
msgstr ""
"Este ficheiro excede o limite de tamanho para envio a um fornecedor de IA."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_network"
msgid ""
"Could not connect to the provider. Check your connection; no automatic retry"
" was made."
msgstr ""
"Não foi possível ligar ao fornecedor. Verifique a ligação; não houve "
"repetição automática."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_output_limit"
msgid ""
"The response exceeds the supported text limit for a transcript or PDF. No "
"partial result was shown and no other provider was tried automatically. Try "
"a shorter file."
msgstr ""
"A resposta excede o limite de texto suportado para uma transcrição ou PDF. "
"Não foi mostrado um resultado incompleto nem foi tentado outro fornecedor "
"automaticamente. Experimente um ficheiro mais curto."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_providers"
msgid ""
"No AI provider is available for this kind of media. In Settings > Online AI:"
" Transcriptions and Descriptions, add a key to a provider that handles it "
"and turn it on."
msgstr ""
"Nenhum fornecedor de IA está disponível para este tipo de conteúdo. Em "
"Definições > IA online: Transcrições e Descrições, introduza a chave de um "
"fornecedor que o aceite e ative-o."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_question"
msgid "Enter a question of no more than 2,000 characters."
msgstr "Introduza uma pergunta com até 2.000 caracteres."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_quota"
msgid ""
"The provider's quota or rate limit was reached. Check usage and billing "
"before trying again."
msgstr ""
"A quota ou limite de pedidos do fornecedor foi atingido. Verifique a "
"utilização e faturação antes de tentar novamente."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_refusal"
msgid "The provider declined to process this media or answer the question."
msgstr "O fornecedor recusou processar este conteúdo ou responder à pergunta."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_request"
msgid ""
"The provider rejected the request. Check the model identifier and settings."
msgstr ""
"O fornecedor recusou o pedido. Verifique o identificador do modelo e as "
"definições."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_response"
msgid "No usable answer was received from the provider."
msgstr "Não foi recebida uma resposta utilizável do fornecedor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_server"
msgid ""
"The provider is temporarily unavailable. The request was not retried "
"automatically."
msgstr ""
"O fornecedor está temporariamente indisponível. O pedido não foi repetido "
"automaticamente."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_timeout"
msgid ""
"The request timed out. It was not retried; a request already received may "
"still be charged."
msgstr ""
"O pedido excedeu o tempo limite. Não foi repetido; se já recebido, ainda "
"pode ser cobrado."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_fast"
msgid "Quick"
msgstr "Rápida"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_gemini_notice"
msgid ""
"Gemini: unpaid services may use inputs for product improvement and human "
"review. Do not send sensitive or personal information under those terms. "
"Paid-service terms differ; check your project's billing. WinZapp cannot "
"infer this from an API key."
msgstr ""
"Gemini: os serviços gratuitos podem utilizar as entradas para melhorias e "
"revisão humana. Não envie informações pessoais ou sensíveis sob estes "
"termos. Os termos dos serviços pagos diferem; verifique a faturação do "
"projeto. O WinZapp não identifica isto pela chave de API."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_get_key"
msgid "Get an API &key"
msgstr "Obter &uma chave de API"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_get_models"
msgid "&Get models"
msgstr "O&bter modelos"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_hide_action_button"
msgid ""
"&Hide the online AI button after the message list (the message menu still "
"offers it)"
msgstr ""
"Ocultar o botão de IA online &que fica depois da lista de mensagens (o menu "
"da mensagem continua a oferecê-lo)"

