"{chat}: Star sync: {confirmed} confirmed, {refused} refused, {unknown} "
"unverified, {skipped} not processed."
msgstr ""
"{chat}: Sincronização de estrelas: {confirmed} confirmadas, {refused} "
"recusadas, {unknown} não verificadas, {skipped} não processadas."

