#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_reset_confirm"
msgid ""
"Remove the saved keys of every AI provider? You will need to enter them "
"again. This also repairs a damaged AI credential store."
msgstr ""
"Remover as chaves guardadas de todos os fornecedores de IA? Terá de as "
