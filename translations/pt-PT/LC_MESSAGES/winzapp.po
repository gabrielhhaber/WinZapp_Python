msgstr "Ctrl+Shift+M: marcar como lido/não lido"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_n_order_label"
