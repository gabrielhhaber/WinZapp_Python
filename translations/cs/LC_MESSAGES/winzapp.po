#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_summary_locked_consent"
msgid ""
"These messages are from a locked chat. Sending them outside WhatsApp needs "
"fresh consent every time, and it is never remembered. Locking the vault "
"closes this window and discards the summary."
msgstr ""
"Tyto zprávy jsou ze zamčeného chatu. Odeslání mimo WhatsApp vyžaduje pokaždé"
" nový souhlas a nikdy se nepamatuje. Zamčení trezoru toto okno zavře a "
"shrnutí zahodí."

