msgctxt "storage_method"
msgid "Operation method"
msgstr "Způsob operace"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_method_hold"
msgid "Move to recoverable holding"
msgstr "Přesunout do obnovitelného odkladiště"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_method_remove"
msgid "Permanently remove local copies"
msgstr "Trvale odstranit místní kopie"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_modified"
msgid "Modified"
msgstr "Změněno"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
msgctxt "storage_needs_rescan"
msgid ""
"The previous snapshot is no longer current. Scan again before another "
"preview."
msgstr ""
"Předchozí snímek už není aktuální. Před dalším náhledem prohledejte znovu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_next_held"
msgid "Next held page"
msgstr "Další stránka odložených"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_next_page"
msgid "Next page"
msgstr "Další stránka"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_presentation.py
msgctxt "storage_not_scanned"
msgid ""
"Not measured yet. Scan reads file metadata. No file is selected and no "
"cleanup starts automatically."
msgstr ""
"Zatím nezměřeno. Prohledání čte metadata souborů. Žádný soubor se nevybere a"
" žádný úklid se automaticky nespustí."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_options.py
msgctxt "storage_notify_only"
msgid "Notify only"
msgstr "Jen oznámit"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_open_backups"
msgid "Open profile backup settings"
msgstr "Otevřít nastavení záloh profilu"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_open_models"
msgid "Open model management settings"
msgstr "Otevřít nastavení správy modelů"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_operation_failed"
msgid ""
"The job could not finish. Nothing further was started. Review held files if "
"an operation was interrupted, then scan again."
msgstr ""
"Úlohu nešlo dokončit. Nic dalšího se nespustilo. Pokud byla operace "
"přerušena, zkontrolujte odložené soubory a pak prohledejte znovu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
#, python-brace-format
msgctxt "storage_operation_result"
msgid ""
"Completed: {completed}; skipped: {skipped}; failed: {failed}. Removed "
"logical size: {removed}; moved to holding: {held}. This is not a measurement"
" of freed disk space."
msgstr ""
"Dokončeno: {completed}; přeskočeno: {skipped}; selhalo: {failed}. Odebraná "
"logická velikost: {removed}; přesunuto do odkladiště: {held}. Nejde o měření"
" uvolněného místa na disku."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_option_announce_progress"
msgid "Announce scan progress at limited intervals"
msgstr "Ohlašovat průběh prohledávání v omezených intervalech"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_option_external_models"
msgid "Include known external model files"
msgstr "Zahrnout známé externí soubory modelů"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_option_match_media"
msgid "Match media with selected local histories"
msgstr "Porovnávat média s vybranými místními historiemi"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_option_other_accounts"
msgid "Include currently known other account folders"
msgstr "Zahrnout aktuálně známé složky ostatních účtů"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_option_scan_open"
msgid "Scan when this manager opens"
msgstr "Prohledat při otevření tohoto správce"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_option_scan_start"
msgid "Evaluate at application startup"
msgstr "Vyhodnotit při spuštění aplikace"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_options.py
msgctxt "storage_options_note"
msgid ""
"All background work is optional. Saving preferences does not apply a file "
"preview. A target is advisory, not a hard quota. No disk-free-space "
"threshold is enforced. Optional matching reads selected local message "
"histories. External models and other accounts are information only. Newly "
"added account folders require disabling and re-enabling that scope."
msgstr ""
"Veškerá práce na pozadí je volitelná. Uložení předvoleb nepoužije náhled "
"souborů. Cíl je jen doporučení, ne pevná kvóta. Žádný práh volného místa na "
"disku se nevynucuje. Volitelné porovnání čte vybrané místní historie zpráv. "
"Externí modely a ostatní účty slouží jen pro informaci. Nově přidané složky "
"účtů vyžadují vypnutí a opětovné zapnutí daného rozsahu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_options_tab"
msgid "Preferences"
msgstr "Předvolby"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_owner_note"
msgid ""
"Models, runtimes, backups, logs, databases and login data stay protected "
"here. Use their existing settings to manage them. Unknown files are not "
"declared unnecessary. Only verified cache files and matched received-media "
"copies can enter a preview."
msgstr ""
"Modely, běhová prostředí, zálohy, protokoly, databáze a přihlašovací údaje "
"zůstávají tady chráněné. Ke správě použijte jejich vlastní nastavení. "
"Neznámé soubory se neoznačují jako zbytečné. Do náhledu se můžou dostat jen "
"ověřené soubory mezipaměti a porovnané kopie přijatých médií."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_pause_day"
msgid "Pause scheduled evaluations for one day"
msgstr "Pozastavit plánovaná vyhodnocení na jeden den"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_options.py
msgctxt "storage_pause_downloads"
msgid "Pause new automatic media downloads"
msgstr "Pozastavit nová automatická stahování médií"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_pause_hour"
msgid "Pause scheduled evaluations for one hour"
msgstr "Pozastavit plánovaná vyhodnocení na jednu hodinu"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager.py client/ui/dialogs/storage_rules.py
msgctxt "storage_preferences_invalid"
msgid ""
"Check the numeric fields and preference file. Unsupported or unreadable "
"protection settings block file actions. Explicit Reset can restore this "
"account's defaults."
msgstr ""
"Zkontrolujte číselná pole a soubor předvoleb. Nepodporovaná nebo nečitelná "
"nastavení ochrany blokují akce se soubory. Výslovný Reset může obnovit "
"výchozí hodnoty tohoto účtu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_preferences_limit"
msgid ""
"The preference size limit was reached. Previous readable settings were kept."
" Select fewer protection entries or use smaller batches, then retry."
msgstr ""
"Byl dosažen limit velikosti předvoleb. Předchozí čitelná nastavení zůstala "
"zachována. Vyberte méně položek ochrany nebo použijte menší dávky a zkuste "
"to znovu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
#: client/ui/dialogs/storage_manager_auxiliary.py
msgctxt "storage_preferences_saved"
msgid "Storage preferences saved. No file operation was started."
msgstr "Předvolby úložiště uloženy. Nebyla spuštěna žádná operace se soubory."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_preview"
msgid "Preview selection"
msgstr "Náhled výběru"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_preview_limit"
msgid ""
"Select at most 500 eligible files per preview, or fewer if their paths are "
"unusually long. No part of this selection was applied."
msgstr ""
"Vyberte nejvýš 500 způsobilých souborů na náhled, nebo méně, pokud mají "
"neobvykle dlouhé cesty. Žádná část tohoto výběru nebyla použita."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
#, python-brace-format
msgctxt "storage_preview_summary"
msgid ""
"Selected: {selected}; eligible: {count}; logical size: {size}. Method: "
"{method}. Protected and in-use files are excluded. Holding does not free "
"disk space."
msgstr ""
"Vybráno: {selected}; způsobilých: {count}; logická velikost: {size}. Metoda:"
" {method}. Chráněné a používané soubory jsou vyloučeny. Odkladiště "
"neuvolňuje místo na disku."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_previous_page"
msgid "Previous page"
msgstr "Předchozí stránka"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_matching.py
#: client/ui/dialogs/storage_presentation.py
#: client/ui/dialogs/storage_protections.py
#, python-brace-format
msgctxt "storage_private_item"
msgid "Local item {number}"
msgstr "Místní položka {number}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect"
msgid "Protect selected files"
msgstr "Chránit vybrané soubory"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_category"
msgid "Protect this category"
msgstr "Chránit tuto kategorii"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_chats"
msgid "Protect selected conversations"
msgstr "Chránit vybrané chaty"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_scope"
msgid "Protection scope"
msgstr "Rozsah ochrany"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_scope_account"
msgid "This account"
msgstr "Tento účet"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_scope_shared"
msgid "Shared components, across accounts"
msgstr "Sdílené součásti napříč účty"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_protections.py
#, python-brace-format
msgctxt "storage_protection_count"
msgid "Saved protections: {count}."
msgstr "Uložené ochrany: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protection_note"
msgid ""
"Protection wins over manual selection and rules. Shared protection applies "
"across this installation's accounts. Removing protection grants no new "
"selection. Missing or currently unnamed items keep a private numbered label."
msgstr ""
"Ochrana má přednost před ručním výběrem i pravidly. Sdílená ochrana platí "
"pro všechny účty této instalace. Odebrání ochrany nic nového nevybere. "
"Chybějící nebo aktuálně nepojmenované položky si ponechají soukromé "
"očíslované označení."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_protections.py
#, python-brace-format
msgctxt "storage_protection_row"
msgid "{scope}: {name}"
msgstr "{scope}: {name}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protection_saved"
msgid "Protection choices saved. Previous preview cleared."
msgstr "Volby ochrany uloženy. Předchozí náhled vymazán."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_protections_tab"
msgid "Protections"
msgstr "Ochrana"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_purge_held"
msgid "Permanently remove selected held files"
msgstr "Trvale odstranit vybrané odložené soubory"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_purge_held_confirm"
msgid ""
"Permanently remove {count} held files ({size})? This cannot be undone here; "
"WhatsApp may no longer have the media."
msgstr ""
"Trvale odstranit odložené soubory (počet: {count}, {size})? Tady to nejde "
"vrátit; WhatsApp už média nemusí mít."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_purge_matching_required"
msgid ""
"To permanently remove held media, enable media matching and select "
"conversations in Preferences, save, then retry. Only currently visible, "
"unlocked and completely matched media without a protection can be removed."
msgstr ""
"Pro trvalé odstranění odložených médií zapněte v Předvolbách porovnávání "
"médií a vyberte chaty, uložte a zkuste to znovu. Odstranit jde jen aktuálně "
"viditelná, odemčená a úplně porovnaná média bez ochrany."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_critical"
msgid "Required component or critical data; managed by its owner"
msgstr "Nezbytná součást nebo kritická data; spravuje je jejich vlastník"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_external"
msgid "Information only; outside this manager's file-action scope"
msgstr "Jen pro informaci; mimo rozsah akcí se soubory tohoto správce"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_important"
msgid "Sent, pending, failed or starred content; protected"
msgstr "Odeslaný, čekající, neúspěšný obsah nebo obsah s hvězdičkou; chráněno"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_in_use"
msgid "In use or current ownership is uncertain; protected"
msgstr "Používá se nebo je aktuální vlastnictví nejisté; chráněno"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_local_copy"
msgid "Received-media local copy; may be impossible to download again"
msgstr "Místní kopie přijatého média; znovu stáhnout ji možná nepůjde"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_protected"
msgid "Unknown or unsupported file; protected"
msgstr "Neznámý nebo nepodporovaný soubor; chráněno"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_reproducible"
msgid "Verified compile-cache layout; regenerable"
msgstr "Ověřená struktura mezipaměti kompilace; obnovitelné"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_unmatched"
msgid "Local history not matched completely; protected"
msgstr "Místní historie nebyla porovnána celá; chráněno"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_user_protected"
msgid "Protected by your keep-list"
msgstr "Chráněno vaším seznamem k ponechání"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_refresh_held"
msgid "Refresh held files"
msgstr "Obnovit odložené soubory"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_refresh_history"
msgid "Refresh summary history"
msgstr "Obnovit historii souhrnů"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_refresh_protections"
msgid "Refresh protections"
msgstr "Obnovit ochrany"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_remove_protection"
msgid "Remove selected protections"
msgstr "Odebrat vybrané ochrany"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_remove_protection_confirm"
msgid ""
"Remove {count} selected protections? Files are not selected or removed by "
"this action."
msgstr ""
"Odebrat vybrané ochrany (počet: {count})? Touto akcí se žádné soubory "
"nevyberou ani neodstraní."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_remove_rule"
msgid "Remove rule draft"
msgstr "Odebrat koncept pravidla"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reset_confirm"
msgid ""
"Reset this account's storage preferences, rules and keep-list? Shared "
"protections, held files and media download blocks stay. No files are "
"cleaned."
msgstr ""
"Resetovat předvolby úložiště, pravidla a seznam k ponechání tohoto účtu? "
"Sdílené ochrany, odložené soubory a blokace stahování médií zůstanou. Žádné "
"soubory se neuklidí."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reset_preferences"
msgid "Reset account storage preferences"
msgstr "Resetovat předvolby úložiště účtu"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reset_target"
msgid "Reset only the target fields"
msgstr "Resetovat jen pole cíle"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_restore_held"
msgid "Restore selected held files"
msgstr "Obnovit vybrané odložené soubory"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_restore_held_confirm"
msgid ""
"Restore {count} held files ({size}) to their original local locations? "
"Existing files will not be overwritten."
msgstr ""
"Obnovit odložené soubory (počet: {count}, {size}) do jejich původních "
"místních umístění? Existující soubory se nepřepíšou."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/media_files.py
msgctxt "storage_restore_media_confirm"
msgid ""
"Request this cleaned local copy once more from WhatsApp? It may no longer be"
" available. Other cleaned files stay blocked, and automatic downloading "
"stays blocked for this item too."
msgstr ""
"Požádat WhatsApp ještě jednou o tuto uklizenou místní kopii? Možná už není k"
" dispozici. Ostatní uklizené soubory zůstanou blokované a automatické "
"stahování zůstane blokované i pro tuto položku."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_resume_schedule"
msgid "Resume scheduled evaluations"
msgstr "Obnovit plánovaná vyhodnocení"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_retire_tokens"
msgid "Remove expired completed-operation records"
msgstr "Odebrat prošlé záznamy dokončených operací"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_retire_tokens_confirm"
msgid ""
"Remove empty operation records older than two days? Held files and active "
"recovery records are kept. Previews expire after one day."
msgstr ""
"Odebrat prázdné záznamy operací starší než dva dny? Odložené soubory a "
"aktivní záznamy obnovy zůstanou. Náhledy vyprší po jednom dni."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_auxiliary.py
#, python-brace-format
msgctxt "storage_retire_tokens_result"
msgid "Expired empty operation records removed: {count}."
msgstr "Odebrané prošlé prázdné záznamy operací: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reverse_order"
msgid "Reverse sort order"
msgstr "Obrátit pořadí řazení"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_automatic"
msgid "Automatically remove verified compile cache"
msgstr "Automaticky odstraňovat ověřenou mezipaměť kompilace"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rule_automatic_confirm"
msgid ""
"Enable automatic permanent removal of matching verified compile-cache files "
"during saved startup/interval evaluations? Personal media, models and "
"unknown files are excluded. Protection wins; no files are removed by saving "
"this draft."
msgstr ""
"Zapnout automatické trvalé odstraňování odpovídajících ověřených souborů "
"mezipaměti kompilace při uložených vyhodnoceních při spuštění/v intervalu? "
"Osobní média, modely a neznámé soubory jsou vyloučeny. Ochrana má přednost; "
"uložením tohoto konceptu se žádné soubory neodstraní."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_rule_combine"
msgid "Condition combination"
msgstr "Kombinace podmínek"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_days"
msgid "Minimum age in days; 0: no age condition"
msgstr "Minimální stáří ve dnech; 0: bez podmínky stáří"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rule_editor"
msgid "Storage rule"
msgstr "Pravidlo úložiště"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rule_enabled"
msgid "Enable this rule after saving preferences"
msgstr "Po uložení předvoleb toto pravidlo zapnout"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_limit"
msgid "Up to 100 rules can be saved."
msgstr "Uložit jde až 100 pravidel."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_minimum_mib"
msgid "Minimum size in MiB; 0: no size condition"
msgstr "Minimální velikost v MiB; 0: bez podmínky velikosti"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_mode"
msgid "Rule action"
msgstr "Akce pravidla"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_notify"
msgid "Notify about matches"
msgstr "Oznamovat shody"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_off"
msgid "Off"
msgstr "Vypnuto"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_on"
msgid "On"
msgstr "Zapnuto"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
#, python-brace-format
msgctxt "storage_rule_row"
msgid "{category}; {mode}; {state}; age {days} days; minimum {size}"
msgstr "{category}; {mode}; {state}; stáří {days} dní; minimum {size}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_suggest"
msgid "Suggest for manual review"
msgstr "Navrhnout k ruční kontrole"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rules_note"
msgid ""
"Age and size are conditions, not proof of uselessness. Protection wins. A "
"suggestion or notification rule wins over an automatic rule on the same "
"file. Automatic mode is available only for verified regenerable compile "
"cache."
msgstr ""
