#, python-brace-format
msgctxt "low_disk_session_closed"
msgid ""
"Low disk space: only {free} GB free. WhatsApp was closed safely so it does "
"not lose this session, and WinZapp is offline. Free up space until there are"
" at least {needed} GB and it connects again by itself."
msgstr ""
"Málo místa na disku: volných je jen {free} GB. WhatsApp byl bezpečně zavřen,"
" aby nepřišel o tuto relaci, a WinZapp je offline. Uvolněte místo, aby bylo "
"volných aspoň {needed} GB, a připojí se znovu sám."

#: translations/en-US/LC_MESSAGES/winzapp.po client/core/profile_disk_guard.py
msgctxt "low_disk_session_resumed"
msgid "There is free disk space again. Connecting to WhatsApp."
msgstr "Na disku je zase volné místo. Připojuji se k WhatsAppu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_mic_permission_denied"
msgid ""
"WinZapp does not have microphone permission. Turn it on in System Settings, "
"Privacy and Security, Microphone."
msgstr ""
"WinZapp nemá oprávnění k mikrofonu. Zapněte ho v Nastavení systému, Soukromí"
" a zabezpečení, Mikrofon."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_mic_permission_waiting"
msgid ""
"macOS is asking for microphone permission. Recording starts once you allow "
"it, and the prompt may be waiting behind another permission prompt."
msgstr ""
"macOS žádá o oprávnění k mikrofonu. Nahrávání začne, jakmile ho povolíte, a "
"dotaz může čekat za jiným dotazem na oprávnění."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_not_yet_available"
msgid "not yet available on Mac"
msgstr "na Macu zatím není k dispozici"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_system_audio_permission_denied"
msgid ""
"WinZapp does not have permission to record system audio, so computer audio "
"will be silent. Turn it on in System Settings, Privacy and Security, Screen "
"and System Audio Recording."
msgstr ""
"WinZapp nemá oprávnění nahrávat systémový zvuk, takže zvuk počítače bude "
"tichý. Zapněte ho v Nastavení systému, Soukromí a zabezpečení, Nahrávání "
"obrazovky a systémového zvuku."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_system_audio_permission_waiting"
msgid ""
"macOS is asking for permission to record system audio. Recording starts once"
" you answer, and the prompt may be waiting behind another permission prompt."
msgstr ""
"macOS žádá o oprávnění nahrávat systémový zvuk. Nahrávání začne, jakmile "
"odpovíte, a dotaz může čekat za jiným dotazem na oprávnění."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_available_reminder"
msgid ""
"A new version of WinZapp is available (v{new_version}). To install it, "
"choose Help > Check for updates, or switch to WinZapp."
msgstr ""
"Je k dispozici nová verze WinZappu (v{new_version}). Pro instalaci zvolte "
"Nápověda > Zkontrolovat aktualizace, nebo přepněte do WinZappu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_downloaded_reminder"
msgid ""
"WinZapp update v{new_version} has been downloaded and will be installed when"
" you quit WinZapp. To install it now, choose Help > Check for updates, or "
"switch to WinZapp."
msgstr ""
"Aktualizace WinZappu v{new_version} je stažená a nainstaluje se, až WinZapp "
"ukončíte. Pro instalaci hned zvolte Nápověda > Zkontrolovat aktualizace, "
"nebo přepněte do WinZappu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_ready_to_install"
msgid ""
"WinZapp update v{new_version} has been downloaded and is ready to install. "
"Choose Install and Relaunch in the Software Update window."
msgstr ""
"Aktualizace WinZappu v{new_version} je stažená a připravená k instalaci. V "
"okně Aktualizace softwaru zvolte Nainstalovat a znovu spustit."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_reopened_other_accounts"
msgid ""
"The update was not installed. The other WinZapp accounts that were closed "
"for it have been opened again."
msgstr ""
"Aktualizace nebyla nainstalována. Ostatní účty WinZappu, které se kvůli ní "
"zavřely, byly znovu otevřeny."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_access_denied"
msgid "GitHub refused access to the verification request."
msgstr "GitHub odmítl přístup k ověřovacímu požadavku."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_connection"
msgid "The connection to GitHub failed. Check your internet connection."
msgstr "Připojení ke GitHubu selhalo. Zkontrolujte připojení k internetu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_dns"
msgid ""
"GitHub's address could not be resolved. Check your internet connection."
msgstr "Adresu GitHubu nešlo přeložit. Zkontrolujte připojení k internetu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_file"
msgid ""
"Could not retrieve the update verification file.\n"
"{reason}"
msgstr ""
"Ověřovací soubor aktualizace nešlo získat.\n"
"{reason}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_http_error"
msgid "GitHub returned an unexpected response."
msgstr "GitHub vrátil neočekávanou odpověď."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_not_found"
msgid "The verification resource was not found on GitHub."
msgstr "Ověřovací zdroj nebyl na GitHubu nalezen."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_rate_limited"
msgid "GitHub's request limit was reached."
msgstr "Byl dosažen limit požadavků na GitHub."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_server"
msgid "GitHub reported a temporary server error. Try again later."
msgstr "GitHub hlásí dočasnou chybu serveru. Zkuste to později."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_tag"
msgid ""
"Could not verify the official release tag.\n"
"{reason}"
msgstr ""
"Oficiální značku vydání nešlo ověřit.\n"
"{reason}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_timeout"
msgid "The verification request timed out. Try again later."
msgstr "Vypršel časový limit ověřovacího požadavku. Zkuste to později."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_tls"
msgid ""
"The secure connection could not be verified. Check the date, time and "
"network certificate settings."
msgstr ""
"Zabezpečené připojení nešlo ověřit. Zkontrolujte datum, čas a nastavení "
"síťových certifikátů."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_unexpected"
msgid "The verification request failed unexpectedly. Try again later."
msgstr "Ověřovací požadavek neočekávaně selhal. Zkuste to později."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_wait"
msgid "Wait at least {seconds} seconds before checking again."
msgstr "Před další kontrolou počkejte aspoň {seconds} s."

