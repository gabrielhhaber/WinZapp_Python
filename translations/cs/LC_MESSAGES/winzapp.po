#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "ai_auto_age_minutes"
msgid "{minutes} minutes ago"
msgstr "před {minutes} min"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/settings_dialog.py
msgctxt "ai_auto_button"
msgid "Automatic transcri&ption and description..."
msgstr "Auto&matický přepis a popis..."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "ai_auto_consent"
msgid ""
"Every voice message, picture, sticker or video you receive in a conversation"
" that is not locked will be sent automatically to: {providers}. Do you "
"agree?"
msgstr ""
"Každá hlasová zpráva, obrázek, samolepka nebo video, které dostanete v "
"nezamčeném chatu, se automaticky odešle: {providers}. Souhlasíte?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_consent_title"
msgid "Send media automatically?"
msgstr "Odesílat média automaticky?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_daily_limit"
msgid "Daily &limit of automatic requests (0 for no limit):"
msgstr "Denní &limit automatických požadavků (0 bez omezení):"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_describe"
msgid ""
"Describe received pictures, stickers and videos automatically, &with the "
"online providers"
msgstr ""
"Automaticky popisovat přijaté obrázky, samolepky a videa &pomocí online "
"poskytovatelů"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_max_age"
msgid "&Process automatically the messages received up to:"
msgstr "Automaticky &zpracovávat zprávy přijaté nejvýš:"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_scope"
msgid "Conversations t&he automatic options apply to:"
msgstr "&Chaty, na které se automatické volby vztahují:"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_scope_all"
msgid "All conversations, except the ones I turn off"
msgstr "Všechny chaty kromě těch, které vypnu"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_scope_selected"
msgid "Only the conversations I turn on"
msgstr "Jen chaty, které zapnu"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_transcribe"
msgid ""
"Transcribe received &voice messages automatically, with the online providers"
msgstr ""
"Automaticky přepisovat přijaté &hlasové zprávy pomocí online poskytovatelů"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_auto_used_today"
msgid "Automatic &requests made today:"
msgstr "&Dnes provedené automatické požadavky:"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_balanced"
msgid "Balanced"
msgstr "Vyvážený"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_billing"
msgid "Usage and &billing"
msgstr "Využití a &fakturace"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
#: client/ui/dialogs/ai_text_result_dialog.py
msgctxt "ai_cancel_notice"
msgid ""
"Cancelled locally. A request already received by the provider may still be "
"charged."
msgstr ""
"Zrušeno místně. Požadavek, který už poskytovatel přijal, může být stále "
"zpoplatněn."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
#: client/ui/dialogs/ai_text_result_dialog.py
msgctxt "ai_chain_failed"
msgid "None of the providers could process this media:"
msgstr "Žádný z poskytovatelů nedokázal toto médium zpracovat:"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_connection_loading"
msgid "Checking the connection…"
msgstr "Ověřuji připojení…"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_connection_ok"
msgid ""
"The provider accepted the key check. This does not verify quality, billing "
"or available quota."
msgstr ""
"Poskytovatel kontrolu klíče přijal. Tím se neověřuje kvalita, fakturace ani "
"dostupný limit."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
#, python-brace-format
msgctxt "ai_consent"
msgid ""
"The selected media and, for photos and videos, your questions and the "
"previous answers in this window may be sent to {providers}, in that order, "
"if the earlier ones fail. This may incur API charges. Chat names and "
"captions are not sent. Provider data policies apply; the result can be "
"wrong. Do you want to continue?"
msgstr ""
"Vybrané médium a u fotek a videí i vaše otázky a předchozí odpovědi v tomto "
"okně se můžou odeslat těmto poskytovatelům: {providers}, v tomto pořadí, "
"pokud ti předchozí selžou. Může to být zpoplatněno přes API. Názvy chatů a "
"popisky se neodesílají. Platí zásady zpracování dat poskytovatelů; výsledek "
"může být chybný. Chcete pokračovat?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_consent_title"
msgid "Send media to an AI provider?"
msgstr "Odeslat médium poskytovateli AI?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_context_caption_label"
msgid "Include the &caption when describing media"
msgstr "&Zahrnout popisek při popisu médií"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_media_modes.py
#, python-brace-format
msgctxt "ai_context_consent"
msgid ""
"Your settings add the caption and the message this one replies to, when they"
" exist, to the description request. For this media, {providers} may also "
"receive that text, which other people wrote in the chat, besides the "
"picture. This replaces the earlier notice that captions are not sent. Chat "
"names and senders are still not sent. Do you want to continue?"
msgstr ""
"Vaše nastavení přidává k požadavku na popis také popisek a citovanou zprávu,"
" na kterou tato odpovídá, pokud existují. Pro toto médium může {providers} "
"kromě obrázku obdržet i tento text, který v chatu napsali ostatní lidé. Tím "
"se nahrazuje dřívější upozornění, že se popisky neodesílají. Jména chatů a "
"odesílatelů se nadále neodesílají. Chcete pokračovat?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_context_quote_label"
msgid "Include the &quoted message when describing media"
msgstr "Zahrnout &citovanou zprávu při popisu médií"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_copy_answer"
msgid "Copy latest answer"
msgstr "Kopírovat poslední odpověď"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_delete_key"
msgid "Remove &saved key"
msgstr "Odebrat &uložený klíč"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_lock_test"
msgid "Treat as a locked chat and simulate vault locking after 15 seconds"
msgstr "Považovat za zamčený chat a po 15 sekundách simulovat zamčení trezoru"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_locked"
msgid "The demo vault locked; the photo session was closed."
msgstr "Ukázkový trezor se zamkl; relace s fotkou byla zavřena."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_notice"
msgid ""
"Fictional chat; no WhatsApp connection or messages sent. The generated "
"picture contains WINZAPP DEMO 123, a blue rectangle, a red circle and a "
"yellow triangle. Settings and keys are separate from your installed WinZapp."
" Start with Settings, then focus the photo and press Ctrl+Shift+I. Real AI "
"answers require your own API key and may cost money; no simulated answers "
"are supplied."
msgstr ""
"Smyšlený chat; žádné spojení s WhatsAppem a žádné odeslané zprávy. "
"Vygenerovaný obrázek obsahuje WINZAPP DEMO 123, modrý obdélník, červený kruh"
" a žlutý trojúhelník. Nastavení a klíče jsou oddělené od nainstalovaného "
"WinZappu. Začněte Nastavením, pak přejděte na fotku a stiskněte "
"Ctrl+Shift+I. Skutečné odpovědi AI vyžadují vlastní klíč API a můžou stát "
"peníze; simulované odpovědi nejsou k dispozici."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_photo"
msgid "Demo contact: Generated test picture (no personal information)"
msgstr "Ukázkový kontakt: Vygenerovaný testovací obrázek (bez osobních údajů)"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_text"
msgid "Demo contact: This is a fictional message; nothing was sent."
msgstr "Ukázkový kontakt: Toto je smyšlená zpráva; nic nebylo odesláno."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_title"
msgid "WinZapp — manual photo demo (no WhatsApp)"
msgstr "WinZapp – ruční ukázka fotky (bez WhatsAppu)"

#: translations/en-US/LC_MESSAGES/winzapp.po client/status_panel.py
#: client/ui/ai_media_demo.py client/ui/conversations.py
#: client/ui/media_viewer.py
msgctxt "ai_describe_image_menu"
msgid "Describe"
msgstr "Popsat"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_images_label"
msgid "Describe received ima&ges"
msgstr "&Popisovat přijaté obrázky"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_sticker_menu"
msgid "Describe sticker"
msgstr "Popsat samolepku"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_stickers_label"
msgid "&Describe received stickers"
msgstr "Popisovat přijaté &samolepky"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_video_menu"
msgid "Describe"
msgstr "Popsat"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_videos_label"
msgid "Describe &received videos"
msgstr "Popisovat přijatá &videa"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_detailed"
msgid "Detailed"
msgstr "Podrobný"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_launch.py
#: client/ui/conversation_panel/ai_actions.py
msgctxt "ai_disabled"
msgid ""
"Turn on AI features, add a key for a provider and enable this kind of media "
"in Settings > Online AI: Transcriptions and Descriptions first."
msgstr ""
"Nejdřív zapněte funkce AI, přidejte klíč pro poskytovatele a povolte tento "
"druh médií v Nastavení > Online AI: přepisy a popisy."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_authentication"
msgid ""
"The provider rejected the key or access to this model. Check the key and "
"permissions."
msgstr ""
"Poskytovatel odmítl klíč nebo přístup k tomuto modelu. Zkontrolujte klíč a "
"oprávnění."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_busy"
msgid ""
"An operation is already running. Wait or cancel it before starting another."
msgstr ""
"Už probíhá jiná operace. Před spuštěním další počkejte nebo ji zrušte."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_cancelled"
msgid "The request was cancelled."
msgstr "Požadavek byl zrušen."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/call_translation.py
msgctxt "ai_error_credentials"
msgid ""
"The API key cannot be read or saved. Re-enter it; for a damaged credential "
"store, explicitly reset all AI keys first."
msgstr ""
"Klíč API nejde přečíst ani uložit. Zadejte ho znovu; pokud je úložiště "
"přihlašovacích údajů poškozené, nejdřív výslovně resetujte všechny klíče AI."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_credits"
msgid ""
"The provider's account has no credit left for this request. Add credits or "
"choose a free model, then try again."
msgstr ""
"Účet poskytovatele nemá na tento požadavek žádný kredit. Doplňte kredit nebo"
" zvolte bezplatný model a zkuste to znovu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_limit"
msgid ""
"This session reached its request or conversation limit. Close it before "
"starting a new session."
msgstr ""
"Tato relace dosáhla limitu požadavků nebo konverzace. Před zahájením nové "
"relace ji zavřete."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_local_url"
msgid ""
"The server address is not valid. Use http://localhost or http://127.0.0.1 "
"with the port, or an https:// address, without a user name, password or "
"parameters."
msgstr ""
"Adresa serveru není platná. Použijte http://localhost nebo http://127.0.0.1 "
"s portem, nebo adresu https:// bez uživatelského jména, hesla či parametrů."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media"
msgid ""
"The original media could not be downloaded or read. It may no longer be "
"available on WhatsApp."
msgstr ""
"Původní médium nešlo stáhnout ani přečíst. Možná už ve WhatsAppu není k "
"dispozici."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media_format"
msgid "This file is not in a supported, readable format."
msgstr "Tento soubor není v podporovaném čitelném formátu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media_size"
msgid "This file exceeds the size limit for sending to an AI provider."
msgstr ""
"Tento soubor překračuje limit velikosti pro odeslání poskytovateli AI."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_network"
msgid ""
"Could not connect to the provider. Check your connection; no automatic retry"
" was made."
msgstr ""
"K poskytovateli se nešlo připojit. Zkontrolujte připojení; automaticky se to"
" znovu nezkoušelo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_ocr_language"
msgid ""
"Windows has no text recognition language installed. Add one in Settings, "
"Time and language, Language and region."
msgstr ""
"Ve Windows není nainstalován žádný jazyk pro rozpoznávání textu. Přidejte ho"
" v Nastavení, Čas a jazyk, Jazyk a oblast."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_ocr_unavailable"
msgid "Text recognition is not available on this computer."
msgstr "Rozpoznávání textu není v tomto počítači dostupné."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_output_limit"
msgid ""
"The response exceeds the supported text limit for a transcript or PDF. No "
"partial result was shown and no other provider was tried automatically. Try "
"a shorter file."
msgstr ""
"Odpověď překračuje podporovaný limit textu pro přepis nebo PDF. Žádný "
"částečný výsledek se nezobrazil a automaticky se nezkoušel jiný "
"poskytovatel. Zkuste kratší soubor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_providers"
msgid ""
"No AI provider is available for this kind of media. In Settings > Online AI:"
" Transcriptions and Descriptions, add a key to a provider that handles it "
"and turn it on."
msgstr ""
"Pro tento druh médií není k dispozici žádný poskytovatel AI. V Nastavení > "
"Online AI: přepisy a popisy přidejte klíč poskytovateli, který ho "
"zpracovává, a zapněte ho."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_question"
msgid "Enter a question of no more than 2,000 characters."
msgstr "Zadejte otázku o délce nejvýš 2 000 znaků."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_quota"
msgid ""
"The provider's quota or rate limit was reached. Check usage and billing "
"before trying again."
msgstr ""
"Byl dosažen limit nebo kvóta poskytovatele. Před dalším pokusem zkontrolujte"
" využití a fakturaci."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_refusal"
msgid "The provider declined to process this media or answer the question."
msgstr "Poskytovatel odmítl toto médium zpracovat nebo odpovědět na otázku."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_request"
msgid ""
"The provider rejected the request. Check the model identifier and settings."
msgstr ""
"Poskytovatel požadavek odmítl. Zkontrolujte identifikátor modelu a "
"nastavení."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/summary_voice_online.py
msgctxt "ai_error_response"
msgid "No usable answer was received from the provider."
msgstr "Od poskytovatele nepřišla žádná použitelná odpověď."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_server"
msgid ""
"The provider is temporarily unavailable. The request was not retried "
"automatically."
msgstr ""
"Poskytovatel je dočasně nedostupný. Požadavek se automaticky neopakoval."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_timeout"
msgid ""
"The request timed out. It was not retried; a request already received may "
"still be charged."
msgstr ""
"Vypršel časový limit požadavku. Neopakoval se; požadavek, který už byl "
"přijat, může být stále zpoplatněn."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_translation_engine_missing"
msgid ""
"This copy of WinZapp lacks a component the offline translation needs. "
"Reinstall WinZapp, or choose another translation provider."
msgstr ""
"Této kopii WinZappu chybí součást, kterou offline překlad potřebuje. "
"Přeinstalujte WinZapp, nebo zvolte jiného poskytovatele překladu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_translation_language"
msgid ""
"The chosen translation provider cannot translate this language. Choose "
"another target or source language in the \"Message translation\" settings."
msgstr ""
"Zvolený poskytovatel překladu tento jazyk přeložit neumí. Zvolte jiný cílový"
" nebo zdrojový jazyk v nastavení „Překlad zpráv“."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_translation_local_failed"
msgid ""
"The offline model could not translate this text. Try again, choose a smaller"
" model, or run it on the processor."
msgstr ""
"Offline model tento text nedokázal přeložit. Zkuste to znovu, zvolte menší "
"model, nebo ho spusťte na procesoru."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_translation_local_load"
msgid ""
"The offline model could not be loaded, most likely for lack of memory. "
"Choose a smaller model, run it on the processor, or choose another "
"translation provider."
msgstr ""
"Offline model nešlo načíst, nejspíš kvůli nedostatku paměti. Zvolte menší "
"model, spusťte ho na procesoru, nebo zvolte jiného poskytovatele překladu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_translation_model_missing"
msgid ""
"The offline model is not on this computer. Download it with \"Download "
"model\" in the \"Message translation\" settings."
msgstr ""
"Offline model v tomto počítači není. Stáhněte ho tlačítkem „Stáhnout model“ "
"v nastavení „Překlad zpráv“."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_fast"
msgid "Quick"
msgstr "Rychlý"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/ai_actions.py
#: client/ui/conversation_panel/ai_full_video.py
#: client/ui/dialogs/ai_full_video.py
msgctxt "ai_full_video"
msgid "Understand full video"
msgstr "Porozumět celému videu"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_full_video_busy"
msgid ""
"Another transcription is running. Wait for it to finish, then try again."
msgstr "Právě probíhá jiný přepis. Počkejte, až skončí, a zkuste to znovu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_full_video.py
#, python-brace-format
msgctxt "ai_full_video_consent"
msgid ""
"Still pictures taken from this video and the text transcribed on this "
"computer from what is said in it may be sent to {providers}, in that order, "
"if the earlier ones fail. The video's sound is never sent, but the text may "
"contain private words of the people in the video. Your questions and the "
"previous answers in this window may be sent too. This may incur API charges."
" Provider data policies apply; the answer can be wrong. Do you want to "
"continue?"
msgstr ""
"Statické snímky pořízené z tohoto videa a text přepsaný v tomto počítači z "
"toho, co se v něm říká, mohou být odeslány poskytovateli {providers}, v "
"tomto pořadí, pokud předchozí selžou. Zvuk videa se nikdy neodesílá, ale "
"text může obsahovat soukromá slova lidí ve videu. Mohou být odeslány i vaše "
"otázky a předchozí odpovědi v tomto okně. To může účtovat poplatky za API. "
"Platí zásady zpracování dat poskytovatele; odpověď může být chybná. Chcete "
"pokračovat?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_full_video.py
#, python-brace-format
msgctxt "ai_full_video_cut_notice"
msgid ""
"The transcribed text is long: only its first {chars} characters are sent."
msgstr "Přepsaný text je dlouhý: odesílá se pouze prvních {chars} znaků."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "ai_full_video_cut_status"
msgid "Only the first {chars} characters of the transcribed speech were used."
msgstr "Použilo se pouze prvních {chars} znaků přepsané řeči."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_full_video_declined"
msgid "Nothing was sent."
msgstr "Nic nebylo odesláno."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_full_video.py
#, python-brace-format
msgctxt "ai_full_video_failed"
msgid ""
"The speech of this video could not be transcribed on this computer. {reason}\n"
"\n"
"Describe only the images instead? The answer will not cover what is said."
msgstr ""
"Řeč tohoto videa nebylo možné v tomto počítači přepsat. {reason}\n"
"\n"
