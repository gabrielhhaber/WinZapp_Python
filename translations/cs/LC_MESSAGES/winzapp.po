msgstr "Tento chat nemá žádné staré místní hvězdičky k synchronizaci."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/message_stars.py
#, python-brace-format
msgctxt "star_sync_result"
msgid ""
"{chat}: Star sync: {confirmed} confirmed, {refused} refused, {unknown} "
"unverified, {skipped} not processed."
msgstr ""
"{chat}: Synchronizace hvězdiček: potvrzeno {confirmed}, odmítnuto {refused},"
" neověřeno {unknown}, nezpracováno {skipped}."

