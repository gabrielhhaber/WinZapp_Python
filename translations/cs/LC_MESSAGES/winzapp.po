msgstr "Mediální soubory: {count}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "media_download_failed"
msgid ""
"This media file could not be downloaded. The link may have expired or the "
"WhatsApp connection may be unavailable."
msgstr ""
"Tento mediální soubor nešlo stáhnout. Odkaz možná vypršel, nebo není "
"dostupné spojení s WhatsAppem."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "media_download_gone_from_phone"
msgid "This file is no longer on WhatsApp's servers or on your phone."
msgstr "Tento soubor už není na serverech WhatsAppu ani ve vašem telefonu."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/audio_playback.py
#: client/ui/conversation_panel/media_files.py
msgctxt "media_download_offline"
msgid ""
"Media files can't be downloaded while WhatsApp is disconnected or "
"connecting. Wait for the connection to come back and try again."
msgstr ""
"Mediální soubory nejde stahovat, dokud je WhatsApp odpojený nebo se "
"připojuje. Počkejte, až se spojení obnoví, a zkuste to znovu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "media_download_phone_no_answer"
msgid ""
"Your phone did not answer the request to send this file again. It may be "
"busy: try again in a moment."
msgstr ""
"Váš telefon neodpověděl na žádost o opětovné odeslání tohoto souboru. Možná "
"je zaneprázdněný: zkuste to za chvíli."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "media_download_retried_unreadable"
msgid ""
"Your phone sent this file again, but it could not be opened. If it keeps "
"happening, send WinZapp's logs to the developers."
msgstr ""
"Váš telefon tento soubor odeslal znovu, ale nešlo ho otevřít. Pokud se to "
"bude opakovat, pošlete protokoly WinZappu vývojářům."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/sending.py
