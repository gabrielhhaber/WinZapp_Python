msgstr "Zastavit synchronizaci hvězdiček"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/message_stars.py
msgctxt "star_sync_stopping"
msgid ""
"Stopping star sync. The current request may still complete; no further "
"messages will be processed."
msgstr ""
"Zastavuji synchronizaci hvězdiček. Probíhající požadavek se ještě může "
"dokončit; další zprávy se už nezpracují."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/message_stars.py
msgctxt "star_sync_unknown"
msgid ""
"Some results could not be verified. Refresh the open chat with Shift+F5 "
"before retrying; an unverified action may already have succeeded."
msgstr ""
"Některé výsledky nešlo ověřit. Před dalším pokusem obnovte otevřený chat "
"klávesami Shift+F5; neověřená akce už mohla proběhnout."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "star_unverified"
msgid ""
"Could not verify this star change. Refresh the open chat with Shift+F5 "
"before retrying; it may already have been applied."
msgstr ""
"Tuto změnu hvězdičky nešlo ověřit. Před dalším pokusem obnovte otevřený chat"
" klávesami Shift+F5; změna už možná byla provedena."

