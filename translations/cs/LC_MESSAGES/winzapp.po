#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/neteq_component_dialog.py
msgctxt "neteq_component_remove_confirm"
msgid ""
"Remove the call playback component? Calls with the Neonize engine will use "
"the standard playback."
msgstr ""
"Odebrat součást pro přehrávání hovorů? Hovory přes engine Neonize pak "
"použijí standardní přehrávání."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "neteq_component_remove_in_use"
msgid ""
"The call playback component is in use and could not be removed. Close "
"WinZapp, open it again and remove it before making a call."
msgstr ""
"Součást pro přehrávání hovorů se používá a nepodařilo se ji odebrat. Zavřete"
" WinZapp, znovu ho otevřete a odeberte součást dřív, než začnete hovor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "neteq_component_removed"
msgid ""
"Call playback component removed. Calls with the Neonize engine use the "
"standard playback."
msgstr ""
"Součást pro přehrávání hovorů byla odebrána. Hovory přes engine Neonize "
"používají standardní přehrávání."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "neteq_component_state_absent"
msgid ""
"Not downloaded (download size: {size}). Calls with the Neonize engine use "
"the standard playback."
msgstr ""
"Nestaženo (velikost stahování: {size}). Hovory přes engine Neonize používají"
" standardní přehrávání."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "neteq_component_state_bundled"
msgid ""
"Included in this installation of WinZapp, so there is nothing to download. "
"Calls with the Neonize engine use it."
msgstr ""
"Je součástí této instalace WinZappu, takže není co stahovat. Hovory přes "
"engine Neonize ji používají."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "neteq_component_state_incomplete"
msgid ""
"Download incomplete or damaged. Calls with the Neonize engine use the "
"standard playback until it is downloaded again."
msgstr ""
"Stahování neúplné nebo poškozené. Hovory přes engine Neonize používají "
"standardní přehrávání, dokud se součást znovu nestáhne."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "neteq_component_state_installed"
msgid ""
"Downloaded. Calls with the Neonize engine use it to play the other person's "
"voice more smoothly."
msgstr ""
"Staženo. Hovory přes engine Neonize ji používají k plynulejšímu přehrávání "
"hlasu druhé strany."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "neteq_component_state_unavailable"
msgid ""
"This version of WinZapp does not offer the component for download yet. Calls"
" with the Neonize engine use the standard playback."
msgstr ""
"Tato verze WinZappu zatím součást ke stažení nenabízí. Hovory přes engine "
"Neonize používají standardní přehrávání."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
#, python-brace-format
msgctxt "network_install_location_message"
msgid ""
"WinZapp is in a network folder and can't run from it:\n"
"\n"
"{path}\n"
"\n"
"This happens, for example, in virtual machines such as Parallels on a Mac, where the Downloads folder is actually a folder on the other computer. Install WinZapp with WinZappInstaller, or move the WinZapp folder to a drive on this computer, such as C:\\WinZapp, and open it from there.\n"
"\n"
"WinZapp will close now."
msgstr ""
"WinZapp je v síťové složce a nemůže z ní běžet:\n"
"\n"
"{path}\n"
"\n"
"To se stává například ve virtuálních počítačích, jako je Parallels na Macu, kde je složka Stažené soubory ve skutečnosti složkou na druhém počítači. Nainstalujte WinZapp pomocí WinZappInstaller, nebo přesuňte složku WinZappu na disk tohoto počítače, například C:\\WinZapp, a otevřete ho odtud.\n"
"\n"
"WinZapp se teď zavře."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "network_install_location_title"
msgid "WinZapp can't run from this folder"
msgstr "WinZapp nemůže běžet z této složky"

