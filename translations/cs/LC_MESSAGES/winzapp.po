#: client/ui/conversation_panel/message_stars.py
#, python-brace-format
msgctxt "star_sync_confirm"
msgid ""
"{chat}: Star {count} old locally starred messages from this chat in "
"WhatsApp? This only adds stars; it does not remove any. Messages unavailable"
" to the linked device may not be synchronized."
msgstr ""
"{chat}: Označit ve WhatsAppu hvězdičkou staré místně označené zprávy z "
"tohoto chatu (počet: {count})? Hvězdičky se jen přidají, žádné se "
"neodeberou. Zprávy, které propojené zařízení nemá k dispozici, se nemusí "
"synchronizovat."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_menu.py
#: client/ui/conversation_panel/message_stars.py
msgctxt "star_sync_local"
msgid "Sync old local stars with WhatsApp…"
msgstr "Synchronizovat staré místní hvězdičky s WhatsAppem…"

