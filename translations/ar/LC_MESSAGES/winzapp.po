#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
#, python-brace-format
msgctxt "network_install_location_message"
msgid ""
"WinZapp is in a network folder and can't run from it:\n"
"\n"
"{path}\n"
"\n"
"This happens, for example, in virtual machines such as Parallels on a Mac, where the Downloads folder is actually a folder on the other computer. Install WinZapp with WinZappInstaller, or move the WinZapp folder to a drive on this computer, such as C:\\WinZapp, and open it from there.\n"
"\n"
"WinZapp will close now."
msgstr ""
"WinZapp في مجلد شبكة ولا يمكن تشغيله منه:\n"
"\n"
"{path}\n"
"\n"
"يحدث هذا، على سبيل المثال، في الأجهزة الافتراضية مثل Parallels على Mac، حيث أن مجلد التنزيلات هو في الواقع مجلد على الكمبيوتر الآخر. ثبت WinZapp باستخدام WinZappInstaller، أو انقل مجلد WinZapp إلى قرص على هذا الكمبيوتر، مثل C:\\WinZapp، وافتحه من هناك.\n"
"\n"
"سيغلق WinZapp الآن."

