#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_insert_refused_vault_closed"
msgid ""
"The locked-chats vault was closed, and the transcription was not inserted "
"into the message."
msgstr "أُغلقت خزنة الدردشات المقفلة، ولم يتم إدراج التفريغ النصي في الرسالة."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_options.py
msgctxt "transcription_keep_loaded_check"
msgid "&Keep the model loaded in memory (faster-whisper and whisper.cpp)"
msgstr "ال&إبقاء على النموذج محملاً في الذاكرة (faster-whisper و whisper.cpp)"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_language_detect"
msgid "Detect a&utomatically"
msgstr "الكشف تلقا&ئياً"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_language_interface"
msgid "WinZapp's own language"
msgstr "لغة WinZapp الخاصة"

#: translations/en-US/LC_MESSAGES/winzapp.po
