msgid "Alt+Shift+K: announce the focused message's date and time"
msgstr "Alt+Shift+K: إعلان تاريخ ووقت الرسالة المركزة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_l_label"
msgid "Alt+Shift+L: announce the focused message's status"
msgstr "Alt+Shift+L: إعلان حالة الرسالة المركزة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_m_label"
msgid "Alt+Shift+M: jump to the previous message that mentions you"
msgstr "Alt+Shift+M: القفز إلى الرسالة السابقة التي تشير إليك"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_n_label"
msgid ""
"Alt+Shift+N: on a voice message or video, do what Enter and Space do not: "
"transcribe it locally with Whisper into its line in the list, or play, pause"
" or open it when Enter and Space are set to transcribe (Settings > User "
"Interface)"
msgstr ""
"Alt+Shift+N: على رسالة صوتية أو فيديو، افعل ما لا يفعله Enter و Space: فرغها"
" نصيًا محليًا باستخدام Whisper إلى سطرها في القائمة، أو شغّلها أو أوقفها أو "
"افتحها عندما تكون Enter و Space مضبوطة على التفريغ النصي (الإعدادات > واجهة "
"المستخدم)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_num_label"
msgid ""
"Alt+Shift+0 to Alt+Shift+9: temporarily bookmark the focused message, or "
"jump to an existing temporary bookmark (cleared when you leave the chat)"
msgstr ""
"Alt+Shift+0 إلى Alt+Shift+9: ضع إشارة مؤقتة للرسالة المركزة، أو اقفز إلى "
"إشارة مؤقتة موجودة (تُمسح عند مغادرة الدردشة)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_o_label"
msgid "Alt+Shift+O: jump to the next message that replies to you"
msgstr "Alt+Shift+O: القفز إلى الرسالة التالية التي ترد عليك"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_p_label"
msgid "Alt+Shift+P: jump to the previous message that replies to you"
msgstr "Alt+Shift+P: القفز إلى الرسالة السابقة التي ترد عليك"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_q_label"
msgid "Alt+Shift+Q: go to quoted message"
msgstr "Alt+Shift+Q: انتقل إلى الرسالة المقتبسة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_r_label"
msgid "Alt+Shift+R: reply privately (groups)"
msgstr "Alt+Shift+R: الرد بشكل خاص (المجموعات)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_s_label"
msgid "Alt+Shift+S: open the mute chat menu / unmute"
msgstr "Alt+Shift+S: فتح قائمة كتم الدردشة / إلغاء الكتم"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_t_label"
msgid ""
"Alt+Shift+T: transcribe the voice message or audio locally with Whisper, or "
"open the transcription already saved"
msgstr ""
"Alt+Shift+T: فرّغ الرسالة الصوتية أو الصوت نصيًا محليًا باستخدام Whisper، أو"
" افتح التفريغ النصي المحفوظ بالفعل"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_v_label"
msgid "Alt+Shift+V: chat with participant (groups)"
msgstr "Alt+Shift+V: دردشة مع المشارك (المجموعات)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_t_label"
msgid "Alt+T: announce chat status (last seen, online, typing)"
msgstr "Alt+T: إعلان حالة الدردشة (آخر ظهور، متصل، يكتب)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_archive_chats_label"
msgid "Ctrl+Alt+Shift+A: archive the selected chats"
msgstr "Ctrl+Alt+Shift+A: أرشفة الدردشات المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_clear_chats_label"
msgid "Ctrl+Alt+Shift+L: clear the selected chats"
msgstr "Ctrl+Alt+Shift+L: مسح الدردشات المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_copy_label"
msgid "Ctrl+Alt+Shift+C: copy the selected messages"
msgstr "Ctrl+Alt+Shift+C: نسخ الرسائل المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_chats_label"
msgid "Ctrl+Shift+Delete: delete the selected chats"
msgstr "Ctrl+Shift+Delete: حذف الدردشات المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_label"
msgid "Ctrl+Shift+Delete: delete the selected messages"
msgstr "Ctrl+Shift+Delete: حذف الرسائل المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_delete_transcriptions_label"
msgid ""
"Ctrl+Alt+Shift+Delete: delete the saved local transcriptions of the selected"
" messages"
msgstr ""
"Ctrl+Alt+Shift+Delete: حذف التفريغات النصية المحلية المحفوظة للرسائل المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_forward_label"
msgid "Ctrl+Alt+Shift+E: forward the selected messages"
msgstr "Ctrl+Alt+Shift+E: إعادة توجيه الرسائل المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_override_note"
msgid ""
"With \"Replace shortcuts with bulk actions when selecting chats and "
"messages\" enabled (Settings > User Interface), shortcuts like forward, "
"save, clear and delete act on the whole selection whenever one exists."
msgstr ""
"عند تمكين \"استبدال الاختصارات بإجراءات جماعية عند تحديد الدردشات والرسائل\""
" (الإعدادات > واجهة المستخدم)، تعمل الاختصارات مثل إعادة التوجيه، الحفظ، "
"المسح والحذف على التحديد بأكمله كلما كان موجودًا."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_pin_label"
msgid "Ctrl+Alt+Shift+X: pin the selected messages"
msgstr "Ctrl+Alt+Shift+X: تثبيت الرسائل المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_read_chats_label"
msgid "Ctrl+Alt+Shift+R: mark the selected chats as read"
msgstr "Ctrl+Alt+Shift+R: تحديد الدردشات المحددة كمقروءة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_save_label"
msgid "Ctrl+Alt+Shift+S: save the selected messages"
msgstr "Ctrl+Alt+Shift+S: حفظ الرسائل المحددة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_star_label"
msgid "Ctrl+Alt+Shift+F: star the selected messages"
msgstr "Ctrl+Alt+Shift+F: تمييز الرسائل المحددة بنجمة"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_transcribe_inline_label"
msgid ""
"Ctrl+Alt+Shift+N: transcribe the selected messages locally with Whisper into"
" their lines"
msgstr ""
"Ctrl+Alt+Shift+N: تفريغ الرسائل المحددة نصيًا محليًا باستخدام Whisper إلى "
"أسطرها"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_transcribe_label"
msgid ""
"Ctrl+Alt+Shift+T: transcribe the selected messages locally with Whisper and "
"show them together"
msgstr ""
"Ctrl+Alt+Shift+T: تفريغ الرسائل المحددة نصيًا محليًا باستخدام Whisper وعرضها"
" معًا"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_unread_chats_label"
msgid "Ctrl+Alt+Shift+U: mark the selected chats as unread"
msgstr "Ctrl+Alt+Shift+U: تحديد الدردشات المحددة كغير مقروءة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_c_label"
msgid "Ctrl+C: call settings"
msgstr "Ctrl+C: إعدادات المكالمة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_m_label"
msgid "Ctrl+M: mute or unmute the microphone"
msgstr "Ctrl+M: كتم أو إلغاء كتم الميكروفون"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_p_label"
msgid "Ctrl+P: switch a voice call to a video call"
msgstr "Ctrl+P: التبديل من مكالمة صوتية إلى مكالمة فيديو"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_shift_q_label"
msgid "Ctrl+Shift+Q: end the call"
msgstr "Ctrl+Shift+Q: إنهاء المكالمة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_v_label"
msgid "Ctrl+V: turn video on or off in a video call"
msgstr "Ctrl+V: تشغيل أو إيقاف الفيديو في مكالمة فيديو"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_alt_l_label"
msgid "Alt+L: go to the calls list"
msgstr "Alt+L: الانتقال إلى قائمة المكالمات"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_shift_r_label"
msgid "Ctrl+Shift+R: call back a missed call"
msgstr "Ctrl+Shift+R: إعادة الاتصال بمكالمة فائتة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_tab_label"
msgid ""
"Ctrl+Tab and Ctrl+Shift+Tab: switch between the all, missed, declined and "
"answered tabs"
msgstr ""
"Ctrl+Tab و Ctrl+Shift+Tab: التبديل بين علامات التبويب الكل، الفائتة، "
"المرفوضة والمجاوبة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_enter_label"
msgid "Enter: open the call's chat"
msgstr "Enter: فتح دردشة المكالمة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_f5_label"
msgid "F5: refresh the calls list"
msgstr "F5: تحديث قائمة المكالمات"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_hint"
msgid ""
"Tab and Shift+Tab move focus. Press Enter or Escape in this field to capture"
" those keys. Tab to OK to confirm, or Cancel to discard."
msgstr ""
"Tab و Shift+Tab ينقلان التركيز. اضغط Enter أو Escape في هذا الحقل لالتقاط "
"تلك المفاتيح. Tab إلى موافق للتأكيد، أو إلغاء للتجاهل."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_modifier_required"
msgid "Use Control or Alt with a letter or digit."
msgstr "استخدم Control أو Alt مع حرف أو رقم."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_prompt"
msgid "Press the new key combination"
msgstr "اضغط على مزيج المفاتيح الجديد"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_reserved"
msgid "This key combination is reserved by the operating system."
msgstr "هذا مزيج المفاتيح محجوز من قبل نظام التشغيل."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_wait"
msgid "Press another key while holding the modifiers."
msgstr "اضغط على مفتاح آخر مع الاستمرار في الضغط على المعدلات."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_change"
msgid "&Change"
msgstr "&تغيير"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_change_title"
msgid "Change keyboard shortcut"
msgstr "تغيير اختصار لوحة المفاتيح"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
#, python-brace-format
msgctxt "shortcut_conflict"
msgid ""
"This shortcut is already used in an overlapping screen by:\n"
"{actions}\n"
"Remove or change that assignment first."
msgstr ""
"هذا الاختصار مستخدم بالفعل في شاشة متداخلة بواسطة:\n"
"{actions}\n"
"أزل أو غيّر تلك المهمة أولاً."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_num_label"
msgid "Ctrl+Alt+1 to Ctrl+Alt+9: switch to the matching paired account"
msgstr "Ctrl+Alt+1 إلى Ctrl+Alt+9: التبديل إلى الحساب المقترن المطابق"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_d_label"
msgid "Ctrl+Alt+Shift+D: disconnect"
msgstr "Ctrl+Alt+Shift+D: قطع الاتصال"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_g_label"
msgid ""
"Ctrl+Alt+Shift+G: switch the recording device until WinZapp closes, in every"
" open account (then 1 to 0)"
msgstr ""
"Ctrl+Alt+Shift+G: التبديل بين أجهزة التسجيل حتى إغلاق WinZapp، في كل حساب "
"مفتوح (ثم 1 إلى 0)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_h_label"
msgid ""
"Ctrl+Alt+Shift+H: switch the playback device until WinZapp closes, in every "
"open account (then 1 to 0)"
msgstr ""
"Ctrl+Alt+Shift+H: التبديل بين أجهزة التشغيل حتى إغلاق WinZapp، في كل حساب "
"مفتوح (ثم 1 إلى 0)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_num_label"
msgid "Ctrl+Alt+Shift+0 to Ctrl+Alt+Shift+9: remove a temporary bookmark"
msgstr "Ctrl+Alt+Shift+0 إلى Ctrl+Alt+Shift+9: إزالة إشارة مؤقتة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_o_label"
msgid "Ctrl+Alt+Shift+O: toggle offline mode"
msgstr "Ctrl+Alt+Shift+O: التبديل بين وضع عدم الاتصال"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_p_label"
msgid ""
"Ctrl+Alt+Shift+P: pause/resume whichever audio is currently playing, from "
"any panel"
msgstr "Ctrl+Alt+Shift+P: إيقاف/استئناف أي صوت يُعمل حاليًا، من أي لوحة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_q_label"
msgid "Ctrl+Alt+Shift+Q: exit WinZapp"
msgstr "Ctrl+Alt+Shift+Q: إغلاق WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_c_label"
msgid "Ctrl+C: copy message"
msgstr "Ctrl+C: نسخ الرسالة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_comma_label"
msgid "Ctrl+comma: settings"
msgstr "Ctrl+comma: الإعدادات"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_f4_label"
msgid "Ctrl+F4: close the current account, keeping the others open"
msgstr "Ctrl+F4: إغلاق الحساب الحالي، مع إبقاء الآخرين مفتوحين"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_left_label"
msgid "Ctrl+Left: previous status"
msgstr "Ctrl+Left: الحالة السابقة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_n_label"
msgid "Ctrl+N: new chat"
msgstr "Ctrl+N: دردشة جديدة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_num_label"
msgid ""
"Ctrl+0 to Ctrl+9: bookmark the focused message, or jump to an existing "
