msgstr "افتح أو شغّل الحالة المركزة"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_paste"
msgid "Paste into the message editor from the message list"
msgstr "لصق في محرر الرسالة من قائمة الرسائل"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_pick_device"
msgid "Choose numbered audio device"
msgstr "اختر جهاز صوت رقمي"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_pick_selected_device"
msgid "Choose the selected audio device"
msgstr "اختر جهاز الصوت المحدد"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_pin_preview"
msgid ""
"Pin or unpin the chat; play or stop the preview while recording is paused"
msgstr ""
"تثبيت أو إلغاء تثبيت الدردشة؛ تشغيل أو إيقاف المعاينة أثناء إيقاف التسجيل "
"مؤقتًا"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_previous_filter"
msgid "Previous call-list filter"
msgstr "مرشح قائمة المكالمات السابق"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_previous_tone"
msgid "Previous emoji skin tone"
msgstr "درجة لون الرمز التعبيري السابقة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_quick_chat_assign_label"
msgid ""
"Ctrl+Alt+Shift+F1 to Ctrl+Alt+Shift+F10: assign the focused chat to quick "
"chat 1 to 9 and 0"
msgstr ""
"Ctrl+Alt+Shift+F1 إلى Ctrl+Alt+Shift+F10: تعيين الدردشة المحددة للدردشة "
"السريعة من 1 إلى 9 و0"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_quick_chat_open_label"
msgid "Ctrl+Shift+F1 to Ctrl+Shift+F10: open quick chat 1 to 9 and 0"
msgstr "Ctrl+Shift+F1 إلى Ctrl+Shift+F10: فتح الدردشة السريعة من 1 إلى 9 و0"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_remove"
msgid "Remove &shortcut"
msgstr "إزالة اخت&صار"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_resend_message_label"
msgid ""
"Ctrl+Shift+Y: on a message whose send failed or was not confirmed, try "
"sending it again"
msgstr ""
"Ctrl+Shift+Y: على رسالة فشل إرسالها أو لم يتم تأكيدها، حاول إرسالها مرة أخرى"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_reset"
msgid "Restore &default"
msgstr "&استعادة الافتراضي"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_reset_all"
msgid "&Restore all defaults"
msgstr "استعادة &كل الافتراضيات"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_retry_status_label"
msgid "Ctrl+Shift+Y: on a status that was not posted, try posting it again"
msgstr "Ctrl+Shift+Y: على حالة لم تُنشر، حاول نشرها مرة أخرى"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_review_message_label"
msgid ""
"Read a recent message by position, counting back from the newest (1 is the "
"newest, 0 is the tenth); pressed twice quickly it copies the message, "
"position"
msgstr ""
"اقرأ رسالة حديثة حسب الموضع، عدًا من الأحدث (1 هو الأحدث، 0 هو العاشر); عند "
"الضغط مرتين بسرعة تنسخ الرسالة، الموضع"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_scope_global"
msgid "System-wide"
msgstr "نظامي"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_scope_links"
msgid "Links"
msgstr "روابط"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_scope_mentions"
msgid "Mentions"
msgstr "إشارات"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_search_enter_label"
msgid ""
"Enter: next search result (alternative, only works in the search field)"
msgstr "Enter: نتيجة البحث التالية (بديل، يعمل فقط في حقل البحث)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_search_f3_label"
msgid "F3: next search result, in the whole open conversation"
msgstr "F3: نتيجة البحث التالية، في toda المحادثة المفتوحة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_search_label"
msgid "S&earch shortcuts"
msgstr "ال&بحث عن اختصارات"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_search_none"
msgid "No shortcut found."
msgstr "لم يتم العثور على اختصار."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_search_shift_enter_label"
msgid ""
"Shift+Enter: previous search result (alternative, only works in the search "
"field)"
msgstr "Shift+Enter: نتيجة البحث السابقة (بديل، يعمل فقط في حقل البحث)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_search_shift_f3_label"
msgid "Shift+F3: previous search result, in the whole open conversation"
msgstr "Shift+F3: نتيجة البحث السابقة، في toda المحادثة المفتوحة"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_select_active"
msgid "Toggle the focused row while selection mode is active"
msgstr "تبديل الصف المركّز بينما وضع التحديد نشط"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_select_end"
msgid "Extend selection to the last row"
msgstr "توسيع التحديد إلى آخر صف"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_select_previous"
msgid "Extend selection to the previous row"
msgstr "توسيع التحديد إلى الصف السابق"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_select_start"
msgid "Extend selection to the first row"
msgstr "توسيع التحديد إلى أول صف"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_settings_hint"
msgid ""
"Select a command, press Tab to Change, then press the new keys. Confirm with"
" OK. Changes take effect when you apply or save Settings. The same key can "
"serve different screens; a new conflicting assignment is refused."
msgstr ""
"اختر أمرًا، اضغط Tab لتغيير، ثم اضغط المفاتيح الجديدة. أكد بـ موافق. "
"التغييرات تسري عند تطبيق أو حفظ الإعدادات. نفس المفتاح يمكن أن يخدم شاشات "
"مختلفة؛ مهمة متعارض تُرفض."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_settings_list"
msgid "Commands and keyboard shortcuts"
msgstr "الأوامر واختصارات لوحة المفاتيح"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_down_label"
msgid "Shift+Down: select the next chat or message and move focus to it"
msgstr "Shift+Down: تحديد الدردشة أو الرسالة التالية ونقل التركيز إليها"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_end_label"
msgid ""
"Shift+End: seek to the end of the audio/video being played, or select every "
"message/chat below and move to the last one if nothing is playing"
msgstr ""
"Shift+End: الانتقال إلى نهاية الصوت/الفيديو الجاري تشغيله، أو تحديد كل "
"رسالة/دردشة أدناه والانتقال إلى آخر واحدة إذا لم يتم تشغيل شيء"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_f5_label"
msgid "Shift+F5: resync the open chat"
msgstr "Shift+F5: إعادة مزامنة الدردشة المفتوحة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_home_label"
msgid ""
"Shift+Home: seek to the start of the audio/video being played, or select "
"every message/chat above and move to the first one if nothing is playing"
msgstr ""
"Shift+Home: الانتقال إلى بداية الصوت/الفيديو الجاري تشغيله، أو تحديد كل "
"رسالة/دردشة أعلاه والانتقال إلى أول واحدة إذا لم يتم تشغيل شيء"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_left_label"
msgid "Shift+Left: rewind audio/video 5 seconds"
msgstr "Shift+Left: إعادة الصوت/الفيديو 5 ثوانٍ"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_pagedown_label"
msgid "Shift+Page Down: forward audio/video 1 minute"
msgstr "Shift+Page Down: تقديم الصوت/الفيديو دقيقة واحدة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_pageup_label"
msgid "Shift+Page Up: rewind audio/video 1 minute"
msgstr "Shift+Page Up: إعادة الصوت/الفيديو دقيقة واحدة"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_right_label"
msgid "Shift+Right: forward audio/video 5 seconds"
msgstr "Shift+Right: تقديم الصوت/الفيديو 5 ثوانٍ"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_space_label"
msgid ""
"Space: play/pause the focused audio or video. Whenever a selection already "
"exists it selects/deselects the focused chat or message instead, if the "
"option is enabled in Settings, User Interface"
msgstr ""
"Space: تشغيل/إيقاف الصوت أو الفيديو المركّز مؤقتًا. عندما يوجد تحديد بالفعل "
"يحدد/يلغي تحديد الدردشة أو الرسالة المركزة بدلاً من ذلك، إذا كان الخيار "
"مفعلًا في الإعدادات، واجهة المستخدم"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_status_delete_label"
msgid ""
"Delete: in My status, delete the status being shown, for everyone who "
"received it"
msgstr "Delete: في حالتي، حذف الحالة المعروضة لدى كل من استلمها"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_status_delete_transcription_label"
msgid "Alt+Shift+Delete: delete the saved local transcription of the status"
msgstr "Alt+Shift+Delete: حذف التفريغ النصي المحلي المحفوظ للحالة"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_status_transcribe_inline_label"
msgid ""
"Alt+Shift+N: on an audio or video status, do what Enter and Space do not: "
"transcribe it locally with Whisper into its line in the list, or open or "
"play it when Enter and Space are set to transcribe"
msgstr ""
