#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_history_question"
msgid "Your question:"
msgstr "سؤالك:"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_missing"
msgid "No key saved"
msgstr "لم يتم حفظ مفتاح"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_readable"
msgid "&Readable API key"
msgstr "مف&تاح API قابل للقراءة"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_notice"
msgid ""
"The saved key is marked for removal from WinZapp. Save with Apply or OK, or "
"discard with Cancel. The API key in your provider account will not be "
"revoked."
msgstr ""
"المفتاح المحفوظ مخصص للإزالة من WinZapp. احفظ باستخدام تطبيق أو موافق، أو "
"ألغِ باستخدام إلغاء. مفتاح API في حساب الموفّر الخاص بك لن يتم إلغاؤه."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_pending"
msgid "Key marked for removal."
msgstr "المفتاح مخصص للإزالة."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_saved"
msgid "Key saved"
msgstr "تم حفظ المفتاح"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_kind_audio"
msgid "voice messages"
msgstr "الرسائل الصوتية"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_kind_image"
msgid "photos"
msgstr "الصور"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_kind_pdf"
msgid "PDF"
msgstr "PDF"

#: translations/en-US/LC_MESSAGES/winzapp.po
