msgctxt "transcription_language_label"
msgid "Transcription lan&guage"
msgstr "ل&غة التفريغ النصي"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cancelled"
msgid "Operation cancelled."
msgstr "تم إلغاء العملية."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cuda_installed"
msgid ""
"The CUDA libraries have been installed. Transcription can now use the "
"graphics card."
msgstr "تم تثبيت مكتبات CUDA. يمكن الآن استخدام بطاقة الرسومات للتفريغ النصي."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cuda_installed_not_usable"
msgid ""
"The CUDA libraries are installed, but the graphics card still cannot use "
"them. Transcription will keep running on the processor. Check that the "
"graphics card driver is up to date."
msgstr ""
"مكتبات CUDA مثبتة، لكن بطاقة الرسومات لا يمكنها استخدامها بعد. سيستمر "
"التفريغ النصي في العمل على المعالج. تأكد من أن برنامج تشغيل بطاقة الرسومات "
"محدث."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cuda_installed_unverified"
msgid ""
"The CUDA libraries have been installed, but it could not be confirmed that "
"the graphics card can use them."
msgstr ""
"تم تثبيت مكتبات CUDA، لكن لم يمكن تأكيد أن بطاقة الرسومات يمكنها استخدامها."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cuda_remove_needs_restart"
msgid ""
"The CUDA libraries are in use. Close and reopen WinZapp, then remove them "
"again."
msgstr ""
"مكتبات CUDA قيد الاستخدام. أغلق وأعِد فتح WinZapp، ثم أزِلها مرة أخرى."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cuda_removed"
msgid "The CUDA libraries have been removed."
msgstr "تم إزالة مكتبات CUDA."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_cuda_verified"
msgid "The CUDA libraries have been verified. Their files are intact."
msgstr "تم التحقق من مكتبات CUDA. ملفاتها سليمة."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_failed"
msgid "The operation could not be completed."
msgstr "لم يمكن إكمال العملية."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_model_downloaded"
msgid "The {model} model has been downloaded."
msgstr "تم تنزيل نموذج {model}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_model_nothing_to_remove"
msgid "There were no files of the {model} model to remove."
msgstr "لم توجد ملفات لنموذج {model} لإزالتها."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_model_removed"
msgid "The {model} model has been removed."
msgstr "تم إزالة نموذج {model}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_model_repaired"
msgid "The {model} model has been downloaded again and verified."
msgstr "تم تنزيل نموذج {model} مرة أخرى والتحقق منه."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_model_verified"
msgid "The {model} model has been verified. Its files are intact."
msgstr "تم التحقق من نموذج {model}. ملفاته سليمة."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_models_move_cancelled_partial"
msgid ""
"Moving the models was cancelled. Already in the new folder: {moved}. Still "
"in the previous folder: {remaining}."
msgstr ""
"تم إلغاء نقل النماذج. بالفعل في المجلد الجديد: {moved}. لا يزال في المجلد "
"السابق: {remaining}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_models_move_no_space"
msgid ""
"There is not enough disk space in the new folder. The models are still in "
"the previous folder."
msgstr ""
"لا توجد مساحة كافية على القرص في المجلد الجديد. النماذج لا تزال في المجلد "
"السابق."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_models_move_partial"
msgid ""
"Not all models could be moved. Already in the new folder: {moved}. Still in "
"the previous folder: {remaining}."
msgstr ""
"لم يمكن نقل كل النماذج. بالفعل في المجلد الجديد: {moved}. لا يزال في المجلد "
"السابق: {remaining}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_models_move_partial_no_space"
msgid ""
"There is not enough disk space in the new folder to move every model. "
"Already in the new folder: {moved}. Still in the previous folder: "
"{remaining}."
msgstr ""
"لا توجد مساحة كافية على القرص في المجلد الجديد لنقل كل النماذج. بالفعل في "
"المجلد الجديد: {moved}. لا يزال في المجلد السابق: {remaining}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_models_moved"
msgid "The models have been moved to the new folder: {models}."
msgstr "تم نقل النماذج إلى المجلد الجديد: {models}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_manage_models_nothing_to_move"
msgid "No models needed to be moved."
msgstr "لا توجد نماذج تحتاج إلى النقل."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_whisper_cpp_installed"
msgid "The whisper.cpp program has been installed: {build}."
msgstr "تم تثبيت برنامج whisper.cpp: {build}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_whisper_cpp_remove_in_use"
msgid ""
"Part of the whisper.cpp program ({build}) is in use by a transcription. "
"Remove it again once the transcription has finished."
msgstr ""
"جزء من برنامج whisper.cpp ({build}) قيد الاستخدام بواسطة تفريغ نصي. أزله مرة"
" أخرى عند انتهاء التفريغ النصي."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_whisper_cpp_removed"
msgid "The whisper.cpp program has been removed: {build}."
msgstr "تم إزالة برنامج whisper.cpp: {build}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_manage_whisper_cpp_verified"
msgid ""
"The whisper.cpp program has been verified: {build}. Its files are intact."
msgstr "تم التحقق من برنامج whisper.cpp: {build}. ملفاته سليمة."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_media_send_failed"
msgid ""
"There is no audio to transcribe in this message: sending it failed and the "
"recording was not saved."
msgstr ""
"لا يوجد صوت لتفريغه نصيًا في هذه الرسالة: فشل الإرسال ولم يتم حفظ التسجيل."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_media_still_preparing"
msgid ""
"This message's audio is still being prepared for sending. Try transcribing "
"it again in a moment."
msgstr ""
"صوت هذه الرسالة لا يزال يُعد للإرسال. حاول تفريغه نصيًا مرة أخرى بعد لحظة."

#: translations/en-US/LC_MESSAGES/winzapp.po
