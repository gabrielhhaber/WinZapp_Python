#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_finished"
msgid "Transcription finished."
msgstr "Transcriere finalizată."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_hidden_vault_closed"
msgid ""
"The transcription finished, but the locked-chats vault was closed. Open the "
"vault to see the transcription."
msgstr ""
"Transcrierea s-a încheiat, dar seiful conversațiilor blocate a fost închis. "
"Deschideți seiful pentru a vedea transcrierea."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_hidden_vault_closed_not_saved"
msgid ""
"The transcription finished, but the locked-chats vault was closed, and the "
"transcription was not saved."
msgstr ""
"Transcrierea s-a încheiat, dar seiful conversațiilor blocate a fost închis, "
"iar transcrierea nu a fost salvată."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_insert_refused_vault_closed"
msgid ""
"The locked-chats vault was closed, and the transcription was not inserted "
"into the message."
msgstr ""
"Seiful conversațiilor blocate a fost închis, iar transcrierea nu a fost "
"inserată în mesaj."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_language_detect"
msgid "D&etect automatically"
msgstr "&Detectați automat"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_language_interface"
msgid "WinZapp's own language"
msgstr "Limba interfeței WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po
