msgstr ""
"Această selecție nu a putut fi aplicată. Reîmprospătează listele și "
"selectează din nou; alege mai puține conversații dacă este necesar."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py
msgctxt "wa_lists_unavailable"
msgid "WhatsApp lists are unavailable in this version."
msgstr "Listele WhatsApp nu sunt disponibile în această versiune."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py
msgctxt "wa_lists_unconfirmed"
msgid ""
"The change could not be verified. Refresh the lists before trying again; it "
"may already have been applied."
msgstr ""
"Modificarea nu a putut fi confirmată. Reîmprospătează listele înainte de a "
"încerca din nou; este posibil să fi fost deja aplicată."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main.py
#: client/ui/dialogs/connect.py
msgctxt "websocket_failed_reconnect"
msgid ""
"The WebSocket connection failed. This can happen when a previous pairing attempt was not completed.\n"
"\n"
"You will be redirected to the connection dialog to try again."
msgstr ""
"Conexiunea WebSocket a eșuat. Acest lucru se poate întâmpla atunci când o încercare anterioară de asociere nu a fost finalizată.\n"
"\n"
"Veți fi redirecționat către dialogul de conectare pentru a încerca din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/connect.py
msgctxt "websocket_init_failed"
msgid "An error occurred while connecting to the WebSocket:"
msgstr "A apărut o eroare la conectarea la WebSocket:"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "whats_new_btn"
msgid "&What's new?"
msgstr "&Ce este nou?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "whats_new_close"
msgid "&Close"
msgstr "&Închidere"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/window_chrome.py
msgctxt "whats_new_none_message"
msgid "No changelog is available for this version."
msgstr ""
"Niciun jurnal de modificări nu este disponibil pentru această versiune."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/window_chrome.py
msgctxt "whats_new_none_title"
msgid "No news"
msgstr "Nicio veste"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "whats_new_title"
msgid "What's new in WinZapp"
msgstr "Ce este nou în WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
#, python-brace-format
msgctxt "wpp_force_reinstall_confirm_msg"
msgid ""
"This will temporarily interrupt WPPConnect and download and reinstall the "
"latest version (v{version}), even if it is already installed. Continue?"
msgstr ""
"Această acțiune va întrerupe temporar WPPConnect și va descărca și reinstala"
" cea mai recentă versiune (v{version}), chiar dacă este deja instalată. "
"Continuați?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_force_reinstall_confirm_title"
msgid "Force reinstall WPPConnect"
msgstr "Forțați reinstalarea WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/settings_dialog.py
msgctxt "wpp_port_label"
msgid "API port (WPPConnect):"
msgstr "Port API (WPPConnect):"

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "wpp_reinstall_notice_message"
msgid ""
"Your current WPPConnect installation may be missing the latest features, "
"such as voice and video calls. Do you want to reinstall WPPConnect now? If "
"you change your mind, you can always access this option from the Help menu "
"(alt+h)."
msgstr ""
"Instalarea actuală a WPPConnect ar putea să nu aibă toate funcțiile cele mai"
" recente, cum ar fi apelurile video și vocale. Doriți să reinstalați "
"WPPConnect acum? Dacă vă răzgândiți, puteți accesa oricând această opțiune "
"din meniul ajutor (alt+a)."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "wpp_reinstall_notice_title"
msgid "WPPConnect update recommended"
msgstr "Actualizare WPPConnect recomandată"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
#, python-brace-format
msgctxt "wpp_update_available_msg"
msgid ""
"A recommended update for WPPConnect Server is available (current: {current},"
" new: {new}). It is not mandatory. Update now? WinZapp will stop the API, "
"install the new version, and restart it automatically."
msgstr ""
"Este disponibilă o actualizare recomandată pentru WPPConnect Server (actual:"
" {current}, nou: {new}). Nu este obligatorie. Actualizați acum? WinZapp va "
"opri API-ul, va instala noua versiune și o va reporni automat."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_update_available_title"
msgid "WPPConnect update available"
msgstr "WPPConnect este disponibilă o actualizare"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py
#, python-brace-format
msgctxt "wpp_update_background_ready_msg"
msgid ""
"WPPConnect update {version} has been downloaded. WinZapp will go offline for"
" a moment to install it and restart WPPConnect."
msgstr ""
"Actualizarea WPPConnect {version} a fost descărcată. WinZapp va fi offline "
"câteva momente pentru a o instala și a reporni WPPConnect."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_background_running"
msgid ""
"A WPPConnect update is already downloading in the background. You will be "
"told when it is ready to install."
msgstr ""
"O actualizare WPPConnect se descarcă deja în fundal. Veți fi anunțat când "
"este gata de instalare."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py
msgctxt "wpp_update_background_started"
msgid ""
"Downloading the WPPConnect update in the background. You will be told when "
"it is ready to install."
msgstr ""
"Se descarcă actualizarea WPPConnect în fundal. Veți fi anunțat când este "
"gata de instalare."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_complete"
msgid "WPPConnect updated and restarted successfully."
msgstr "WPPConnect a fost actualizat și repornit cu succes."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
#: client/main_window/wpp_background_update.py
msgctxt "wpp_update_failed_msg"
msgid ""
"Could not update WPPConnect. The previous installation will be kept, if "
"possible."
msgstr ""
"Nu s-a putut actualiza WPPConnect. Instalarea anterioară va fi păstrată, "
"dacă este posibil."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_update_fetch_failed_msg"
msgid ""
"Could not check the latest WPPConnect version. Check your internet "
"connection and try again."
msgstr ""
"Nu s-a putut verifica cea mai recentă versiune WPPConnect. Verificați-vă "
"conexiunea la internet și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_in_progress"
msgid "Updating WPPConnect. Please wait."
msgstr "Se actualizează WPPConnect. Va rugam asteptati."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_not_enough_space"
msgid ""
"There is not enough free space to prepare the update and keep the previous "
"WPPConnect version. Free up disk space and try again. The current "
"installation was preserved."
msgstr ""
"Nu există suficient spațiu liber pentru a pregăti actualizarea și a păstra "
"versiunea anterioară de WPPConnect. Eliberați spațiu pe disc și încercați "
"din nou. Instalarea curentă a fost păstrată."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_other_account_msg"
msgid ""
"Another WinZapp account is still using the WPPConnect Server. Close the "
"other accounts and try again."
msgstr ""
"Un alt cont WinZapp încă folosește WPPConnect Server. Închideți celelalte "
"conturi și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/wpp_server.py
msgctxt "wpp_version_unpinned_warning"
msgid ""
"Warning: could not pin the WhatsApp Web version. Sending to individual "
"contacts may fail silently; groups still work. Please update WinZapp's "
"WhatsApp Web."
msgstr ""
"Avertisment: nu a putut fi fixată versiunea WhatsApp Web. Trimiterea către "
"persoane de contact individuale poate eșua în tăcere; grupurile încă mai "
"funcționează. Vă rugăm să actualizați WhatsApp Web-ul WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/archived_panel.py
