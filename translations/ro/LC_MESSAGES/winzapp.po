msgstr "Seiful demonstrativ s-a blocat; sesiunea fotografiei s-a închis."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_notice"
msgid ""
"Fictional chat; no WhatsApp connection or messages sent. The generated "
"picture contains WINZAPP DEMO 123, a blue rectangle, a red circle and a "
"yellow triangle. Settings and keys are separate from your installed WinZapp."
" Start with Settings, then focus the photo and press Ctrl+Shift+I. Real AI "
"answers require your own API key and may cost money; no simulated answers "
"are supplied."
msgstr ""
"Conversație fictivă; fără conectare la WhatsApp sau trimitere de mesaje. "
"Imaginea generată conține WINZAPP DEMO 123, un dreptunghi albastru, un cerc "
"roșu și un triunghi galben. Setările și cheile sunt separate de WinZapp "
"instalat. Deschide Setări, focalizează fotografia și apasă Ctrl+Shift+I. "
"Răspunsurile reale necesită propria cheie API și pot costa bani; nu există "
"răspunsuri simulate."

