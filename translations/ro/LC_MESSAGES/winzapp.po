msgid "Model in another folder"
msgstr "Model din alt folder"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_read_failed"
msgid ""
"WinZapp could not read the files in the folder {name}, so nothing was added."
msgstr ""
"WinZapp nu a putut citi fișierele din folderul {name}, așa că nu s-a adăugat"
" nimic."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_read_failed_file"
msgid "WinZapp could not read the file {name}, so nothing was added."
msgstr "WinZapp nu a putut citi fișierul {name}, așa că nu s-a adăugat nimic."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_bad_config"
msgid ""
"The config.json file in that folder is not a model configuration WinZapp can"
" read, so the folder cannot be used."
msgstr ""
"Fișierul config.json din acest folder nu este o configurație de model pe "
"care WinZapp o poate citi, așa că folderul nu poate fi folosit."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_inside_root"
msgid ""
"That folder is inside the WinZapp models folder, which WinZapp already "
"manages. Choose a folder outside it."
msgstr ""
"Folderul se află în folderul de modele WinZapp, pe care WinZapp îl "
"gestionează deja. Alegeți un folder din afara lui."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_inside_root_file"
msgid ""
"That file is inside the WinZapp models folder, which WinZapp already "
"manages. Choose a file outside it."
msgstr ""
"Fișierul se află în folderul de modele WinZapp, pe care WinZapp îl "
"gestionează deja. Alegeți un fișier din afara lui."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_refused_not_a_model"
msgid ""
"That folder does not hold a Whisper model WinZapp can use. Missing: {files}."
msgstr ""
"Folderul nu conține un model Whisper pe care WinZapp îl poate folosi. "
"Lipsesc: {files}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_not_ggml"
msgid "That file is empty, so it cannot be a whisper.cpp model."
msgstr "Fișierul este gol, așa că nu poate fi un model whisper.cpp."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_unreachable"
msgid ""
"That folder could not be opened. If it is on an external drive, connect the "
"drive and try again."
msgstr ""
"Folderul nu a putut fi deschis. Dacă se află pe o unitate externă, conectați"
" unitatea și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_unreachable_file"
msgid ""
"That file could not be opened. If it is on an external drive, connect the "
"drive and try again."
msgstr ""
"Fișierul nu a putut fi deschis. Dacă se află pe o unitate externă, conectați"
" unitatea și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_external_root_contains"
msgid ""
"The models folder you chose contains folders of models you added from "
"elsewhere ({folders}). WinZapp deletes files inside it when you remove a "
"model, so choose another folder or forget those models first."
msgstr ""
"Folderul de modele ales conține foldere ale unor modele adăugate din altă "
"parte ({folders}). WinZapp șterge fișiere din el când eliminați un model, "
"așa că alegeți alt folder sau uitați mai întâi acele modele."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_external_root_not_applied"
msgid "The models folder was not changed."
msgstr "Folderul modelelor nu a fost schimbat."

