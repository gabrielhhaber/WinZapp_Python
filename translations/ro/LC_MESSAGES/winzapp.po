msgid "CU&DA libraries"
msgstr "&Biblioteci CUDA"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_runtime_outdated"
msgid ""
"The installed CUDA libraries are from an earlier version. Install them again"
" to update them."
msgstr ""
"Bibliotecile CUDA instalate sunt dintr-o versiune anterioară. Instalați-le "
"din nou pentru a le actualiza."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_verify_btn"
msgid "Verif&y"
msgstr "Verificați"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/message_menu.py
msgctxt "transcription_delete"
msgid "Delete transcription"
msgstr "Ștergeți transcrierea"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_delete_failed"
msgid "The transcription could not be deleted."
msgstr "Transcrierea nu a putut fi ștearsă."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/transcription_flow.py
msgctxt "transcription_delete_question"
msgid ""
"Delete this message's transcription? The message and its audio stay in the "
"conversation."
msgstr ""
"Ștergeți transcrierea acestui mesaj? Mesajul și înregistrarea audio rămân în"
" conversație."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_deleted"
msgid "Transcription deleted."
msgstr "Transcriere ștearsă."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cpu_requested"
msgid "The transcription will run on the processor."
msgstr "Transcrierea va fi efectuată pe procesor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_build_missing"
msgid ""
"The whisper.cpp version for graphics cards is not installed. The "
"transcription will run on the processor. You can install it in the "
"transcription settings."
msgstr ""
"Versiunea whisper.cpp pentru plăci video nu este instalată. Transcrierea va "
"fi efectuată pe procesor. O puteți instala din setările de transcriere."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_build_unsupported"
msgid ""
"The whisper.cpp version for graphics cards does not support this graphics "
"card, or the card could not be identified. The transcription will run on the"
" processor."
msgstr ""
"Versiunea whisper.cpp pentru plăci video nu este compatibilă cu această "
"placă video sau placa nu a putut fi identificată. Transcrierea va fi "
"efectuată pe procesor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_driver_error"
msgid ""
"The graphics card could not be queried. The transcription will run on the "
"processor."
msgstr ""
"Nu s-au putut obține informații despre placa video. Transcrierea va fi "
"efectuată pe procesor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_libraries_missing"
msgid ""
"The CUDA libraries are not installed. The transcription will run on the "
"processor. You can download them in the transcription settings."
msgstr ""
"Bibliotecile CUDA nu sunt instalate. Transcrierea va fi efectuată pe "
"procesor. Le puteți descărca din setările de transcriere."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_selected"
msgid "The transcription will run on the graphics card."
msgstr "Transcrierea va fi efectuată pe placa video."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_unavailable"
msgid "CUDA is not available. The transcription will run on the processor."
msgstr "CUDA nu este disponibil. Transcrierea va fi efectuată pe procesor."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_device_label"
msgid "Whe&re to run the transcription"
msgstr "&Unde se face transcrierea"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_no_cuda_found"
msgid ""
"No compatible graphics card was found. The transcription will run on the "
"processor."
msgstr ""
"Nu a fost găsită nicio placă video compatibilă. Transcrierea va fi efectuată"
" pe procesor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_preference_cpu"
msgid "Processor"
msgstr "Procesor"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_preference_cuda"
msgid "Graphics card"
msgstr "Placă video"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_discarded_withdrawn"
msgid ""
"The message was deleted for everyone while it was being transcribed, so the "
"transcription was discarded."
msgstr ""
"Mesajul a fost șters pentru toată lumea în timp ce era transcris, așa că s-a"
" renunțat la transcriere."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_download_confirm_title"
msgid "Confirm download"
msgstr "Confirmați descărcarea"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_audio_incomplete"
msgid "The audio file is incomplete or damaged."
msgstr "Fișierul audio este incomplet sau deteriorat."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_error"
msgid "An internal error occurred during the transcription."
msgstr "A apărut o eroare internă în timpul transcrierii."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_missing"
msgid "The transcription component is not installed in this copy of WinZapp."
msgstr ""
"Componenta de transcriere nu este instalată în această copie a WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cancelled"
msgid "Transcription cancelled."
msgstr "Transcriere anulată."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_busy"
msgid ""
"Another WinZapp window is using the CUDA libraries folder. Wait for it to "
"finish and try again."
msgstr ""
"O altă fereastră WinZapp folosește folderul bibliotecilor CUDA. Așteptați să"
" termine și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_corrupted"
msgid "The CUDA library files are incomplete or damaged. Install them again."
msgstr ""
"Fișierele bibliotecilor CUDA sunt incomplete sau deteriorate. Instalați-le "
"din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_download_failed"
msgid ""
"The CUDA libraries could not be downloaded. Check your connection and try "
"again."
msgstr ""
"Bibliotecile CUDA nu au putut fi descărcate. Verificați conexiunea și "
"încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_in_use"
msgid ""
"The CUDA libraries are in use by this session. Close and reopen WinZapp, "
"then try again."
msgstr ""
"Bibliotecile CUDA sunt folosite în această sesiune. Închideți și "
"redeschideți WinZapp, apoi încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_unavailable"
msgid ""
"CUDA is not available. Switch the device to the processor in the settings "
"and try again."
msgstr ""
"CUDA nu este disponibil. Schimbați dispozitivul pe procesor în setări și "
"încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed"
msgid ""
"The files in the chosen model's folder have changed since it was verified. "
"Verify the model again in the Local Transcription tab in the settings, or "
"choose another model."
msgstr ""
"Fișierele din folderul modelului ales s-au schimbat de când a fost "
"verificat. Verificați din nou modelul în fila Transcriere locală din setări "
"sau alegeți alt model."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed_file"
msgid ""
"The chosen model's file has changed since it was verified. Verify the model "
"again in the Local Transcription tab in the settings, or choose another "
"model."
msgstr ""
"Fișierul modelului ales s-a schimbat de când a fost verificat. Verificați "
"din nou modelul în fila Transcriere locală din setări sau alegeți alt model."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_missing"
msgid ""
"The folder of the chosen model was not found. If it is on an external drive,"
" connect the drive; if it was deleted, choose another model."
msgstr ""
"Folderul modelului ales nu a fost găsit. Dacă se află pe o unitate externă, "
"conectați unitatea; dacă a fost șters, alegeți alt model."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_missing_file"
msgid ""
"The file of the chosen model was not found. If it is on an external drive, "
"connect the drive; if it was deleted, choose another model."
msgstr ""
"Fișierul modelului ales nu a fost găsit. Dacă se află pe o unitate externă, "
"conectați unitatea; dacă a fost șters, alegeți alt model."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_ffmpeg_failed"
msgid "The audio could not be converted for transcription."
msgstr "Înregistrarea audio nu a putut fi convertită pentru transcriere."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_insufficient_ram"
msgid ""
"The computer does not have enough memory for this model. Choose a smaller "
"model."
msgstr ""
"Memoria computerului nu este suficientă pentru acest model. Alegeți un model"
" mai mic."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_insufficient_vram"
msgid ""
"The graphics card does not have enough memory for this model. Choose a "
"smaller model."
msgstr ""
"Memoria plăcii video nu este suficientă pentru acest model. Alegeți un model"
" mai mic."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_media_not_downloaded"
msgid ""
"The audio has not been downloaded yet. Wait for the download to finish and "
"try again."
msgstr ""
"Înregistrarea audio nu a fost încă descărcată. Așteptați să se termine "
"descărcarea și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_corrupted"
msgid "The model files are incomplete or corrupted. Download the model again."
msgstr ""
"Fișierele modelului sunt incomplete sau deteriorate. Descărcați din nou "
"modelul."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_download_failed"
msgid ""
"The transcription model could not be downloaded. Check your connection and "
"try again."
msgstr ""
"Modelul de transcriere nu a putut fi descărcat. Verificați conexiunea și "
"încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_move_failed"
msgid ""
"The models folder could not be moved. The models are still in the previous "
"folder."
msgstr ""
"Folderul modelelor nu a putut fi mutat. Modelele au rămas în folderul "
"anterior."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_not_installed"
msgid ""
"The selected transcription model is not installed. Download the model before"
" transcribing."
msgstr ""
"Modelul de transcriere ales nu este instalat. Descărcați modelul înainte de "
"a transcrie."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_models_busy"
msgid ""
"Another WinZapp window is using the models folder. Wait for it to finish and"
" try again."
msgstr ""
"O altă fereastră WinZapp folosește folderul modelelor. Așteptați să termine "
"și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_no_disk_space"
msgid "There is not enough disk space for this download."
msgstr "Nu există suficient spațiu pe disc pentru această descărcare."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_precision_unsupported"
msgid ""
"The chosen calculation precision could not be used on this device. Choose "
"another one, or Automatic, in the settings."
msgstr ""
"Precizia calculelor aleasă nu a putut fi folosită pe acest dispozitiv. "
"Alegeți alta sau Automat în setări."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_save_failed"
msgid "The transcription could not be saved."
msgstr "Transcrierea nu a putut fi salvată."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_error_temp_no_disk_space"
msgid ""
"There is no free space on drive {drive} to prepare this message's audio. "
"Free up some space on that drive and try again."
msgstr ""
"Nu există spațiu liber pe unitatea {drive} pentru a pregăti înregistrarea "
"audio a acestui mesaj. Eliberați spațiu pe acea unitate și încercați din "
"nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_temp_no_disk_space_unnamed"
msgid ""
"There is no free space left for Windows' temporary files, so this message's "
"audio could not be prepared. Free up some space on the disk that holds them "
"and try again."
msgstr ""
"Nu mai există spațiu liber pentru fișierele temporare ale Windows, așa că "
"înregistrarea audio a acestui mesaj nu a putut fi pregătită. Eliberați "
"spațiu pe discul pe care se află acestea și încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_unsupported_audio_format"
msgid "This audio format was not recognized and cannot be transcribed."
msgstr ""
"Formatul acestei înregistrări audio nu a fost recunoscut și nu poate fi "
"transcris."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_busy"
msgid ""
"The whisper.cpp program folder is in use by another WinZapp window or by "
"another program, such as an antivirus. Wait a moment and try again."
msgstr ""
"Folderul programului whisper.cpp este folosit de o altă fereastră WinZapp "
"sau de alt program, cum ar fi un antivirus. Așteptați puțin și încercați din"
" nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_corrupted"
msgid ""
"The whisper.cpp program files are incomplete or damaged. Install it again."
msgstr ""
"Fișierele programului whisper.cpp sunt incomplete sau deteriorate. "
"Instalați-l din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_download_failed"
msgid ""
"The whisper.cpp program could not be downloaded. Check your connection and "
"try again."
msgstr ""
"Programul whisper.cpp nu a putut fi descărcat. Verificați conexiunea și "
"încercați din nou."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_not_installed"
msgid ""
"The whisper.cpp program is not installed. Install it in the settings before "
"transcribing."
msgstr ""
"Programul whisper.cpp nu este instalat. Instalați-l din setări înainte de a "
"transcrie."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_actions_group"
msgid "Models in other folders"
msgstr "Modele existente în alte foldere"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_add_btn"
msgid "Add..."
msgstr "Adăugați..."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_added"
msgid ""
"The {model} model in the folder {name} was verified and can now be used."
msgstr ""
"Modelul {model} din folderul {name} a fost verificat și poate fi folosit."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_added_file"
msgid "The {model} model in the file {name} was verified and can now be used."
msgstr ""
"Modelul {model} din fișierul {name} a fost verificat și poate fi folosit."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_external.py
msgctxt "transcription_external_browse_dialog_title"
msgid "Choose the folder that holds the model"
msgstr "Alegeți folderul care conține modelul"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_browse_file_dialog_title"
msgid "Choose the whisper.cpp model file"
msgstr "Alegeți fișierul modelului whisper.cpp"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_changed_while_checked"
msgid ""
"The files in the folder {name} changed while they were being checked, so "
"nothing was added. Try again once whatever is writing there has finished."
msgstr ""
"Fișierele din folderul {name} s-au schimbat în timpul verificării, așa că nu"
" s-a adăugat nimic. Încercați din nou după ce se termină ce scrie în el."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_changed_while_checked_file"
msgid ""
"The file {name} changed while it was being checked, so nothing was added. "
"Try again once whatever is writing to it has finished."
msgstr ""
"Fișierul {name} s-a schimbat în timpul verificării, așa că nu s-a adăugat "
"nimic. Încercați din nou după ce se termină ce scrie în el."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_check_btn"
msgid "Verify"
msgstr "Verificați"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_checked"
msgid ""
"The {model} model in the folder {name} was checked again and can be used."
msgstr ""
"Modelul {model} din folderul {name} a fost verificat din nou și poate fi "
"folosit."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_checked_file"
msgid ""
"The {model} model in the file {name} was checked again and can be used."
msgstr ""
"Modelul {model} din fișierul {name} a fost verificat din nou și poate fi "
"folosit."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_custom_added"
msgid ""
"The model in the folder {name} loaded correctly and was added as a custom "
"model."
msgstr ""
"Modelul din folderul {name} s-a încărcat corect și a fost adăugat ca model "
"personalizat."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_custom_added_file"
msgid ""
"The model in the file {name} loaded correctly and was added as a custom "
"model."
msgstr ""
"Modelul din fișierul {name} s-a încărcat corect și a fost adăugat ca model "
"personalizat."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_custom_checked"
msgid ""
"The custom model in the folder {name} was checked again and loaded "
"correctly."
msgstr ""
"Modelul personalizat din folderul {name} a fost verificat din nou și s-a "
"încărcat corect."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_custom_checked_file"
msgid ""
"The custom model in the file {name} was checked again and loaded correctly."
msgstr ""
"Modelul personalizat din fișierul {name} a fost verificat din nou și s-a "
"încărcat corect."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_digest_mismatch_question"
msgid ""
"The folder {name} has the files of the {model} model, but their contents are"
" not the ones WinZapp knows: it may be a modified or damaged copy. It cannot"
" be used as the {model} model. WinZapp can try to load it and use it as a "
"custom model instead. Do you want to try?"
msgstr ""
"Folderul {name} are fișierele modelului {model}, dar conținutul lor nu este "
"cel pe care îl cunoaște WinZapp: poate fi o copie modificată sau "
"deteriorată. Nu poate fi folosit ca modelul {model}. WinZapp poate încerca "
"să îl încarce și să îl folosească drept model personalizat. Doriți să "
"încercați?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_digest_mismatch_question_file"
msgid ""
"The file {name} has the size of the {model} model, but its contents are not "
"the ones WinZapp knows: it may be a modified or damaged copy. It cannot be "
"used as the {model} model. WinZapp can try to load it and use it as a custom"
" model instead. Do you want to try?"
msgstr ""
"Fișierul {name} are dimensiunea modelului {model}, dar conținutul lui nu "
"este cel pe care îl cunoaște WinZapp: poate fi o copie modificată sau "
"deteriorată. Nu poate fi folosit ca modelul {model}. WinZapp poate încerca "
"să îl încarce și să îl folosească drept model personalizat. Doriți să "
"încercați?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_file_wildcard"
msgid "whisper.cpp models (*.bin)|*.bin|All files (*.*)|*.*"
msgstr "Modele whisper.cpp (*.bin)|*.bin|Toate fișierele (*.*)|*.*"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_find_btn"
msgid "Find..."
msgstr "Căutați..."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_find_item_recognised"
msgid "{name} ({revision}), looks like the {model} model"
msgstr "{name} ({revision}), pare modelul {model}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_find_none"
msgid "No new Whisper models were found in the Hugging Face cache."
msgstr "Nu a fost găsit niciun model Whisper nou în cache-ul Hugging Face."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_find_searching"
msgid "Searching the Hugging Face cache..."
msgstr "Se caută în cache-ul Hugging Face..."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_forget_btn"
msgid "Forget"
msgstr "Uitați"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_forget_question"
msgid ""
"Forget the model in the folder {name}? Only WinZapp's reference to it is "
"removed; the files in the folder are not touched."
msgstr ""
"Uitați modelul din folderul {name}? Se elimină doar referința WinZapp la el;"
" fișierele din folder nu sunt atinse."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_forget_question_file"
msgid ""
"Forget the model in the file {name}? Only WinZapp's reference to it is "
"removed; the file is not touched."
msgstr ""
"Uitați modelul din fișierul {name}? Se elimină doar referința WinZapp la el;"
" fișierul nu este atins."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
