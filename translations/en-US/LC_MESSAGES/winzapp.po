#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py
msgctxt "wa_lists_unconfirmed"
msgid ""
"The change could not be verified. Refresh the lists before trying again; it "
"may already have been applied."
msgstr ""
"The change could not be verified. Refresh the lists before trying again; it "
"may already have been applied."

