#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/chat_lists.py
msgctxt "wa_lists_scope"
msgid ""
"You can add chats shown here to your lists or remove them. Locked chats "
"cannot be selected. Other chats stay in the list."
msgstr ""
"You can add chats shown here to your lists or remove them. Locked chats "
"cannot be selected. Other chats stay in the list."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/chat_lists.py
msgctxt "wa_lists_selection_changed"
msgid ""
"This selection could not be applied. Refresh the lists and select again; "
"choose fewer chats if needed."
msgstr ""
"This selection could not be applied. Refresh the lists and select again; "
"choose fewer chats if needed."

