msgstr "Bu mesaj şu dilde yazıya döküldü: {language}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_language_forced"
msgid ""
"This model only understands {language}, so the message is transcribed in "
"{language}."
msgstr ""
"Bu model yalnızca şu dili anlıyor: {language}. Bu yüzden mesaj şu dilde "
"yazıya dökülür: {language}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_language_overridden"
msgid ""
"This model only understands {language}, so the message is transcribed in "
"{language} and not in {chosen}, the language chosen in the settings."
msgstr ""
"Bu model yalnızca şu dili anlıyor: {language}. Bu yüzden mesaj şu dilde "
"yazıya dökülür: {language}. Ayarlarda seçilen dil ({chosen}) kullanılmaz."

