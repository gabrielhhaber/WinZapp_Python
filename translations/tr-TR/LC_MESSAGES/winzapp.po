#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
#, python-brace-format
msgctxt "network_install_location_message"
msgid ""
"WinZapp is in a network folder and can't run from it:\n"
"\n"
"{path}\n"
"\n"
"This happens, for example, in virtual machines such as Parallels on a Mac, where the Downloads folder is actually a folder on the other computer. Install WinZapp with WinZappInstaller, or move the WinZapp folder to a drive on this computer, such as C:\\WinZapp, and open it from there.\n"
"\n"
"WinZapp will close now."
msgstr ""
"WinZapp bir ağ klasöründe bulunuyor ve buradan çalışamaz:\n"
"\n"
"{path}\n"
"\n"
"Bu durum, örneğin Mac üzerindeki Parallels gibi sanal makinelerde, İndirilenler klasörü aslında diğer bilgisayardaki bir klasör olduğunda yaşanır. WinZapp'i WinZappInstaller ile yükleyin ya da WinZapp klasörünü bu bilgisayardaki bir sürücüye, örneğin C:\\WinZapp konumuna taşıyıp oradan açın.\n"
"\n"
"WinZapp şimdi kapanacak."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "network_install_location_title"
msgid "WinZapp can't run from this folder"
msgstr "WinZapp bu klasörden çalışamaz"

