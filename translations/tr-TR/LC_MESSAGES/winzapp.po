"(önbellek)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_cache.py
msgctxt "transcription_cache_follow"
msgid "Follow the general setting"
msgstr "Genel ayarı izle"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_cache.py
