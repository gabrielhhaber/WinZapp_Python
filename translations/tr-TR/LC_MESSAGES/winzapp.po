msgstr "Tüm &modellerin kayıtlı dökümlerini sil"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_cache.py
msgctxt "transcription_clear_all_cache_confirm"
msgid ""
"Delete every saved transcription of every model, in all chats? This cannot "
"be undone."
msgstr ""
"Tüm modellerin kayıtlı dökümleri tüm sohbetlerde silinsin mi? Bu işlem geri "
"alınamaz."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_clear_all_cache_none"
msgid "No saved transcription was found."
msgstr "Kayıtlı döküm bulunamadı."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_cache.py
msgctxt "transcription_clear_cache_btn"
msgid "Clear t&his model's saved transcriptions"
msgstr "Bu mod&elin kayıtlı dökümlerini sil"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_cache.py
#, python-brace-format
msgctxt "transcription_clear_cache_confirm"
msgid ""
"Delete every saved transcription made by the {model} model, in all chats? "
"Transcriptions made by other models are kept, and this cannot be undone."
msgstr ""
"{model} modelinin yaptığı tüm kayıtlı dökümler, tüm sohbetlerde silinsin mi?"
" Diğer modellerin dökümleri korunur ve bu işlem geri alınamaz."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_clear_cache_done"
msgid "Saved transcriptions deleted: {count}."
msgstr "Silinen kayıtlı dökümler: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_clear_cache_failed"
msgid "The saved transcriptions could not be deleted."
msgstr "Kayıtlı dökümler silinemedi."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_clear_cache_none"
msgid "No saved transcription from this model was found."
msgstr "Bu modele ait kayıtlı döküm bulunamadı."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_confirm_cuda"
msgid "Install the CUDA libraries?"
msgstr "CUDA kütüphaneleri yüklensin mi?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_confirm_cuda_repair"
msgid ""
"Install the CUDA libraries again? The files already in the folder are "
"deleted first."
msgstr ""
"CUDA kütüphaneleri yeniden yüklensin mi? Klasörde zaten bulunan dosyalar "
"önce silinir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_destination"
msgid "Destination folder: {folder}."
msgstr "Hedef klasör: {folder}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_confirm_device_cpu"
msgid "After this, transcription will run on the processor."
msgstr "Bundan sonra yazıya döküm işlemcide yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_confirm_device_cuda"
msgid "After this, transcription will run on the graphics card."
msgstr "Bundan sonra yazıya döküm ekran kartında yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_confirm_does_not_fit"
msgid ""
"Warning: this model does not fit in that device's memory, and transcription "
"may fail for lack of memory."
msgstr ""
"Dikkat: Bu model o cihazın belleğine sığmıyor ve yazıya döküm bellek "
"yetersizliğinden başarısız olabilir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_download_size"
msgid "Download size: {size}."
msgstr "İndirme boyutu: {size}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_free_space"
msgid "Free on that disk: {size}."
msgstr "Bu diskteki boş alan: {size}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_confirm_model"
msgid "Download the {model} model?"
msgstr "{model} modeli indirilsin mi?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_confirm_model_repair"
msgid ""
"Download the {model} model again and verify it? The files already in the "
"folder are deleted first."
msgstr ""
"{model} modeli yeniden indirilip doğrulansın mı? Klasörde zaten bulunan "
"dosyalar önce silinir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_no_resume"
msgid ""
"This is {size} that cannot be resumed: if the download is cancelled or the "
"connection drops, all of it has to be downloaded again from the start."
msgstr ""
"Bu indirmenin boyutu {size} ve yarıda kalırsa sürdürülemez: indirme iptal "
"edilir veya bağlantı kesilirse her şeyin baştan yeniden indirilmesi gerekir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_not_enough_space"
msgid ""
"There is not enough space: {required} is needed and {free} is free. Free "
"some space or choose another models folder."
msgstr ""
"Yeterli alan yok. Gereken alan: {required}. Boş alan: {free}. Yer açın veya "
"modeller için başka bir klasör seçin."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#, python-brace-format
msgctxt "transcription_confirm_queue"
msgid "Download {count} models in sequence: {models}?"
msgstr "{count} model sırayla indirilsin mi: {models}?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#, python-brace-format
msgctxt "transcription_confirm_queue_does_not_fit"
msgid ""
"Warning: these models do not fit in that device's memory, and transcription "
"may fail for lack of memory: {models}."
msgstr ""
"Dikkat: Bu modeller o cihazın belleğine sığmıyor ve yazıya döküm bellek "
"yetersizliğinden başarısız olabilir: {models}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_confirm_remove_cuda"
msgid ""
"Remove the CUDA libraries? Transcription goes back to running on the "
"processor, and they have to be downloaded again to use the graphics card."
msgstr ""
"CUDA kütüphaneleri kaldırılsın mı? Yazıya döküm yeniden işlemcide yapılır ve"
" ekran kartını kullanmak için kütüphaneleri tekrar indirmeniz gerekir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_remove_model"
msgid ""
"Remove the {model} model? Its files are deleted from the disk, and it has to"
" be downloaded again before it can be used."
msgstr ""
"{model} modeli kaldırılsın mı? Dosyaları diskten silinir ve yeniden "
"kullanmak için modeli tekrar indirmeniz gerekir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_whisper_cpp.py
#, python-brace-format
msgctxt "transcription_confirm_remove_whisper_cpp"
msgid ""
"Remove the whisper.cpp program ({build})? Transcription with whisper.cpp "
"goes back to running on the processor, and it has to be downloaded again to "
"use the graphics card."
msgstr ""
"whisper.cpp programı ({build}) kaldırılsın mı? whisper.cpp ile yazıya döküm "
"yeniden işlemcide yapılır ve ekran kartını kullanmak için programı tekrar "
"indirmeniz gerekir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_whisper_cpp.py
msgctxt "transcription_confirm_remove_whisper_cpp_cpu"
msgid ""
"Remove the whisper.cpp program? The graphics card version, if installed, is "
"removed with it, and whisper.cpp cannot transcribe until it is installed "
"again."
msgstr ""
"whisper.cpp programı kaldırılsın mı? Yüklüyse ekran kartı sürümü de onunla "
"birlikte kaldırılır ve whisper.cpp yeniden yüklenene kadar yazıya döküm "
"yapamaz."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_confirm_required_space"
msgid "Disk space needed: {size}."
msgstr "Gereken disk alanı: {size}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_confirm_space_unknown"
msgid "The free space on that disk could not be measured."
msgstr "Bu diskteki boş alan ölçülemedi."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_confirm_whisper_cpp"
msgid "Install the whisper.cpp program ({build})?"
msgstr "whisper.cpp programı ({build}) yüklensin mi?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_confirm_whisper_cpp_repair"
msgid ""
"Install the whisper.cpp program ({build}) again? The installed files are "
"replaced by the new ones."
msgstr ""
"whisper.cpp programı ({build}) yeniden yüklensin mi? Yüklü dosyalar "
"yenileriyle değiştirilir."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_confirm_whisper_cpp_with_cpu"
msgid ""
"The processor version is installed first, because the graphics card version "
"needs it."
msgstr ""
"Ekran kartı sürümü işlemci sürümüne ihtiyaç duyduğu için önce işlemci sürümü"
" yüklenir."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_actions_group"
msgid "CUDA libraries"
msgstr "CUDA kütüphaneleri"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_windows.py
msgctxt "transcription_cuda_button"
msgid "CUDA li&braries..."
msgstr "&CUDA kütüphaneleri..."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_install_btn"
msgid "I&nstall"
msgstr "Yükl&e"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_remove_btn"
msgid "Remo&ve"
msgstr "Ka&ldır"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_repair_btn"
msgid "Repa&ir"
msgstr "&Onar"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
#, python-brace-format
msgctxt "transcription_cuda_runtime_absent"
msgid "The CUDA libraries are not installed. The download is {size}."
msgstr "CUDA kütüphaneleri yüklü değil. İndirme boyutu: {size}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_cuda_runtime_incomplete"
msgid "The CUDA libraries were not fully installed."
msgstr "CUDA kütüphanelerinin yüklenmesi tamamlanmadı."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_cuda_runtime_installed"
msgid "The CUDA libraries are installed."
msgstr "CUDA kütüphaneleri yüklü."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_cuda_runtime_label"
msgid "CU&DA libraries"
msgstr "CUDA &kütüphaneleri"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_runtime_outdated"
msgid ""
"The installed CUDA libraries are from an earlier version. Install them again"
" to update them."
msgstr ""
"Yüklü CUDA kütüphaneleri eski bir sürüme ait. Güncellemek için kütüphaneleri"
" yeniden yükleyin."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_cuda_verify_btn"
msgid "Verif&y"
msgstr "&Doğrula"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/message_menu.py
msgctxt "transcription_delete"
msgid "Delete transcription"
msgstr "Dökümü sil"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_delete_failed"
msgid "The transcription could not be deleted."
msgstr "Döküm silinemedi."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_delete_question"
msgid ""
"Delete this message's transcription? The message and its audio stay in the "
"conversation."
msgstr "Bu mesajın dökümü silinsin mi? Mesaj ve ses kaydı sohbette kalır."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_deleted"
msgid "Transcription deleted."
msgstr "Döküm silindi."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cpu_requested"
msgid "The transcription will run on the processor."
msgstr "Yazıya döküm işlemcide yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_build_missing"
msgid ""
"The whisper.cpp version for graphics cards is not installed. The "
"transcription will run on the processor. You can install it in the "
"transcription settings."
msgstr ""
"whisper.cpp'nin ekran kartı sürümü yüklü değil. Yazıya döküm işlemcide "
"yapılacak. Bu sürümü yazıya döküm ayarlarından yükleyebilirsiniz."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_build_unsupported"
msgid ""
"The whisper.cpp version for graphics cards does not support this graphics "
"card, or the card could not be identified. The transcription will run on the"
" processor."
msgstr ""
"whisper.cpp'nin ekran kartı sürümü bu ekran kartını desteklemiyor ya da kart"
" tanımlanamadı. Yazıya döküm işlemcide yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_driver_error"
msgid ""
"The graphics card could not be queried. The transcription will run on the "
"processor."
msgstr "Ekran kartının bilgileri alınamadı. Yazıya döküm işlemcide yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_libraries_missing"
msgid ""
"The CUDA libraries are not installed. The transcription will run on the "
"processor. You can download them in the transcription settings."
msgstr ""
"CUDA kütüphaneleri yüklü değil. Yazıya döküm işlemcide yapılacak. Bu "
"kütüphaneleri yazıya döküm ayarlarından indirebilirsiniz."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_selected"
msgid "The transcription will run on the graphics card."
msgstr "Yazıya döküm ekran kartında yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_unavailable"
msgid "CUDA is not available. The transcription will run on the processor."
msgstr "CUDA kullanılamıyor. Yazıya döküm işlemcide yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_device_label"
msgid "W&here to run the transcription"
msgstr "Yazıya dökümün ya&pılacağı yer"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_no_cuda_found"
msgid ""
"No compatible graphics card was found. The transcription will run on the "
"processor."
msgstr "Uyumlu bir ekran kartı bulunamadı. Yazıya döküm işlemcide yapılacak."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_preference_cpu"
msgid "Processor"
msgstr "İşlemci"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_preference_cuda"
msgid "Graphics card"
msgstr "Ekran kartı"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_discarded_withdrawn"
msgid ""
"The message was deleted for everyone while it was being transcribed, so the "
"transcription was discarded."
msgstr "Mesaj yazıya dökülürken herkesten silindi, bu yüzden döküm atıldı."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_download_confirm_title"
msgid "Confirm download"
msgstr "İndirmeyi onayla"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_audio_incomplete"
msgid "The audio file is incomplete or damaged."
msgstr "Ses dosyası eksik veya hasarlı."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_error"
msgid "An internal error occurred during the transcription."
msgstr "Yazıya döküm sırasında dahili bir hata oluştu."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_missing"
msgid "The transcription component is not installed in this copy of WinZapp."
msgstr "Yazıya döküm bileşeni WinZapp'in bu kopyasında yüklü değil."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cancelled"
msgid "Transcription cancelled."
msgstr "Yazıya döküm iptal edildi."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_busy"
msgid ""
"Another WinZapp window is using the CUDA libraries folder. Wait for it to "
"finish and try again."
msgstr ""
"Başka bir WinZapp penceresi CUDA kütüphaneleri klasörünü kullanıyor. İşini "
"bitirmesini bekleyip tekrar deneyin."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_corrupted"
msgid "The CUDA library files are incomplete or damaged. Install them again."
msgstr ""
"CUDA kütüphanelerinin dosyaları eksik veya hasarlı. Kütüphaneleri yeniden "
"yükleyin."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_download_failed"
msgid ""
"The CUDA libraries could not be downloaded. Check your connection and try "
"again."
msgstr ""
"CUDA kütüphaneleri indirilemedi. Bağlantınızı kontrol edip tekrar deneyin."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_in_use"
msgid ""
"The CUDA libraries are in use by this session. Close and reopen WinZapp, "
"then try again."
msgstr ""
"CUDA kütüphaneleri bu oturumda kullanılıyor. WinZapp'i kapatıp yeniden açın,"
" ardından tekrar deneyin."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_unavailable"
msgid ""
"CUDA is not available. Switch the device to the processor in the settings "
"and try again."
msgstr ""
"CUDA kullanılamıyor. Ayarlardan cihazı işlemci olarak değiştirip tekrar "
"deneyin."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed"
msgid ""
"The files in the chosen model's folder have changed since it was verified. "
"Verify the model again in the Local Transcription tab in the settings, or "
"choose another model."
msgstr ""
"Seçilen modelin klasöründeki dosyalar, model doğrulandıktan sonra değişti. "
"Modeli Ayarlardaki Yerel yazıya döküm sekmesinde yeniden doğrulayın veya "
