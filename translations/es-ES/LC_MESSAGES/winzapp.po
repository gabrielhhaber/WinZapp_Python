msgid "&Models folder"
msgstr "Ca&rpeta de los modelos"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_models_dir_now_the_new_one"
msgid ""
"Even so, every model is in the new folder, and that is the one the setting "
"now uses."
msgstr ""
"Aun así, todos los modelos están en la carpeta nueva, y es la que la "
"configuración pasa a usar."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/status_tab/my_status_transcription.py
