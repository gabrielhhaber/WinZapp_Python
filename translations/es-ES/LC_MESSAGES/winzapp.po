msgstr "Elige la carpeta de los modelos de transcripción"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_models_dir_busy"
msgid ""
"A download is running in the background. The models folder can be moved once"
" it finishes; until then the current folder stays."
msgstr ""
"Hay una descarga en curso en segundo plano. La carpeta de los modelos se "
"podrá mover cuando termine; hasta entonces se mantiene la carpeta actual."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_models_dir_kept_previous"
msgid ""
"The models folder is still the previous one. Choose the new folder again to "
"move what stayed behind."
msgstr ""
"La carpeta de los modelos sigue siendo la anterior. Elige de nuevo la "
"carpeta nueva para mover lo que se ha quedado."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
