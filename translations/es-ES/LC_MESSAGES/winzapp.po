"no hacen: transcribirlo localmente con Whisper en su línea de la lista, o "
"abrirlo o reproducirlo cuando Intro y Espacio están configurados para "
"transcribir"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_status_transcribe_label"
msgid ""
"Alt+Shift+T: transcribe the audio or video status locally with Whisper, or "
"open the transcription already saved"
msgstr ""
