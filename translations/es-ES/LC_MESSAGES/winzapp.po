msgid "&Readable API key"
msgstr "Clave de API &legible"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_notice"
msgid ""
"The saved key is marked for removal from WinZapp. Save with Apply or OK, or "
"discard with Cancel. The API key in your provider account will not be "
"revoked."
msgstr ""
"Se ha marcado la clave guardada para quitarla de WinZapp. Guarda con Aplicar"
" u OK, o descarta con Cancelar. La clave de API de tu cuenta del proveedor "
"no se revoca."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_pending"
msgid "Key marked for removal."
msgstr "Clave marcada para quitarla."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_saved"
msgid "Key saved"
msgstr "Clave guardada"

