msgctxt "shortcut_alt_shift_p_label"
msgid "Alt+Shift+P: jump to the previous message that replies to you"
msgstr "Alt+Shift+P: ir al mensaje anterior que te responde"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_q_label"
msgid "Alt+Shift+Q: go to quoted message"
msgstr "Alt+Shift+Q: ir al mensaje citado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_r_label"
msgid "Alt+Shift+R: reply privately (groups)"
msgstr "Alt+Shift+R: responder en privado (grupos)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_s_label"
msgid "Alt+Shift+S: open the mute chat menu / unmute"
msgstr "Alt+Shift+S: abrir el menú silenciar conversación / reactivar"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_t_label"
msgid ""
"Alt+Shift+T: transcribe the voice message or audio locally with Whisper, or "
"open the transcription already saved"
msgstr ""
"Alt+Shift+T: transcribir localmente el mensaje de voz o el audio con "
"Whisper, o abrir la transcripción ya guardada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_v_label"
msgid "Alt+Shift+V: chat with participant (groups)"
msgstr "Alt+Shift+V: chatear con participante (grupos)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_t_label"
msgid "Alt+T: announce chat status (last seen, online, typing)"
msgstr ""
"Alt+T: anunciar el estado de la conversación (visto por última vez, en "
"línea, escribiendo)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_archive_chats_label"
msgid "Ctrl+Alt+Shift+A: archive the selected chats"
msgstr "Ctrl+Alt+Shift+A: archivar las conversaciones seleccionadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_clear_chats_label"
msgid "Ctrl+Alt+Shift+L: clear the selected chats"
msgstr "Ctrl+Alt+Shift+L: vaciar las conversaciones seleccionadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_copy_label"
msgid "Ctrl+Alt+Shift+C: copy the selected messages"
msgstr "Ctrl+Alt+Shift+C: copiar los mensajes seleccionados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_chats_label"
msgid "Ctrl+Shift+Delete: delete the selected chats"
msgstr "Ctrl+Shift+Delete: eliminar las conversaciones seleccionadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_label"
msgid "Ctrl+Shift+Delete: delete the selected messages"
msgstr "Ctrl+Shift+Delete: eliminar los mensajes seleccionados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_forward_label"
msgid "Ctrl+Alt+Shift+E: forward the selected messages"
msgstr "Ctrl+Alt+Shift+E: reenviar los mensajes seleccionados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_override_note"
msgid ""
"With \"Replace shortcuts with bulk actions when selecting chats and "
"messages\" enabled (Settings > User Interface), shortcuts like forward, "
"save, clear and delete act on the whole selection whenever one exists."
msgstr ""
"Con la opción \"Sustituir atajos por acciones en masa al seleccionar chats y"
" mensajes\" activada (Configuración > Interfaz de usuario), atajos como "
"reenviar, guardar, limpiar y eliminar actúan sobre toda la selección cuando "
"exista una."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_pin_label"
msgid "Ctrl+Alt+Shift+X: pin the selected messages"
msgstr "Ctrl+Alt+Shift+X: fijar los mensajes seleccionados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_read_chats_label"
msgid "Ctrl+Alt+Shift+R: mark the selected chats as read"
msgstr "Ctrl+Alt+Shift+R: marcar como leídas las conversaciones seleccionadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_save_label"
msgid "Ctrl+Alt+Shift+S: save the selected messages"
msgstr "Ctrl+Alt+Shift+S: guardar los mensajes seleccionados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_star_label"
msgid "Ctrl+Alt+Shift+F: star the selected messages"
msgstr "Ctrl+Alt+Shift+F: destacar los mensajes seleccionados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_unread_chats_label"
msgid "Ctrl+Alt+Shift+U: mark the selected chats as unread"
msgstr ""
"Ctrl+Alt+Shift+U: marcar como no leídas las conversaciones seleccionadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_c_label"
msgid "Ctrl+C: call settings"
msgstr "Ctrl+C: ajustes de la llamada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_m_label"
msgid "Ctrl+M: mute or unmute the microphone"
msgstr "Ctrl+M: silenciar o reactivar el micrófono"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_p_label"
msgid "Ctrl+P: switch a voice call to a video call"
msgstr "Ctrl+P: cambiar una llamada de voz a videollamada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_shift_q_label"
msgid "Ctrl+Shift+Q: end the call"
msgstr "Ctrl+Shift+Q: finalizar la llamada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_v_label"
msgid "Ctrl+V: turn video on or off in a video call"
msgstr "Ctrl+V: activar o desactivar el vídeo en una videollamada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_alt_l_label"
msgid "Alt+L: go to the calls list"
msgstr "Alt+L: ir a la lista de llamadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_shift_r_label"
msgid "Ctrl+Shift+R: call back a missed call"
msgstr "Ctrl+Shift+R: devolver una llamada perdida"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_tab_label"
msgid ""
"Ctrl+Tab and Ctrl+Shift+Tab: switch between the all, missed, declined and "
"answered tabs"
msgstr ""
"Ctrl+Tab y Ctrl+Shift+Tab: cambiar entre las pestañas todas, perdidas, "
"rechazadas y atendidas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_enter_label"
msgid "Enter: open the call's chat"
msgstr "Enter: abrir el chat de la llamada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_f5_label"
msgid "F5: refresh the calls list"
msgstr "F5: actualizar la lista de llamadas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_hint"
msgid ""
"Tab and Shift+Tab move focus. Press Enter or Escape in this field to capture"
" those keys. Tab to OK to confirm, or Cancel to discard."
msgstr ""
"Tab y Mayús+Tab mueven el foco. Pulse Intro o Escape en este campo para "
"capturar esas teclas. Use Tab hasta Aceptar para confirmar, o Cancelar para "
"descartar."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_modifier_required"
msgid "Use Control or Alt with a letter or digit."
msgstr "Use Control o Alt con una letra o un número."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_prompt"
msgid "Press the new key combination"
msgstr "Pulse la nueva combinación de teclas"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_reserved"
msgid "This key combination is reserved by the operating system."
msgstr "Esta combinación de teclas está reservada por el sistema operativo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_wait"
msgid "Press another key while holding the modifiers."
msgstr "Pulse otra tecla mientras mantiene los modificadores."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_change"
msgid "Change"
msgstr "Cambiar"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_change_title"
msgid "Change keyboard shortcut"
msgstr "Cambiar atajo de teclado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
#, python-brace-format
msgctxt "shortcut_conflict"
msgid ""
"This shortcut is already used in an overlapping screen by:\n"
"{actions}\n"
"Remove or change that assignment first."
msgstr ""
"Este atajo ya se usa en una pantalla coincidente para:\n"
"{actions}\n"
"Quite o cambie primero esa asignación."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_num_label"
msgid "Ctrl+Alt+1 to Ctrl+Alt+9: switch to the matching paired account"
msgstr ""
"Ctrl+Alt+1 a Ctrl+Alt+9: cambiar a la cuenta vinculada correspondiente"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_d_label"
msgid "Ctrl+Alt+Shift+D: disconnect"
msgstr "Ctrl+Alt+Shift+D: desconectar"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_g_label"
msgid ""
"Ctrl+Alt+Shift+G: switch the recording device until WinZapp closes, in every"
" open account (then 1 to 0)"
msgstr ""
"Ctrl+Alt+Shift+G: cambiar el dispositivo de grabación hasta cerrar WinZapp, "
"en todas las cuentas abiertas (después, 1 a 0)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_h_label"
msgid ""
"Ctrl+Alt+Shift+H: switch the playback device until WinZapp closes, in every "
"open account (then 1 to 0)"
msgstr ""
"Ctrl+Alt+Shift+H: cambiar el dispositivo de reproducción hasta cerrar "
"WinZapp, en todas las cuentas abiertas (después, 1 a 0)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_num_label"
msgid "Ctrl+Alt+Shift+0 to Ctrl+Alt+Shift+9: remove a temporary bookmark"
msgstr "Ctrl+Alt+Shift+0 a Ctrl+Alt+Shift+9: eliminar un marcador temporal"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_o_label"
msgid "Ctrl+Alt+Shift+O: toggle offline mode"
msgstr "Ctrl+Alt+Shift+O: activar/desactivar el modo sin conexión"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_p_label"
msgid ""
"Ctrl+Alt+Shift+P: pause/resume whichever audio is currently playing, from "
"any panel"
msgstr ""
"Ctrl+Alt+Shift+P: pausar/reproducir el audio que esté sonando, desde "
"cualquier panel"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_q_label"
msgid "Ctrl+Alt+Shift+Q: exit WinZapp"
msgstr "Ctrl+Alt+Shift+Q: salir de WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_c_label"
msgid "Ctrl+C: copy message"
msgstr "Ctrl+C: copiar mensaje"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_comma_label"
msgid "Ctrl+comma: settings"
msgstr "Ctrl+coma: configuración"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_f4_label"
msgid "Ctrl+F4: close the current account, keeping the others open"
msgstr "Ctrl+F4: cerrar la cuenta actual, manteniendo las demás abiertas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_left_label"
msgid "Ctrl+Left: previous status"
msgstr "Ctrl+Izquierda: estado anterior"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_n_label"
msgid "Ctrl+N: new chat"
msgstr "Ctrl+N: nueva conversación"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_num_label"
msgid ""
"Ctrl+0 to Ctrl+9: bookmark the focused message, or jump to an existing "
"bookmark"
msgstr ""
"Ctrl+0 a Ctrl+9: marcar el mensaje enfocado, o ir a un marcador ya creado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_r_label"
msgid "Ctrl+R: record voice message"
msgstr "Ctrl+R: grabar mensaje de voz"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_right_label"
msgid "Ctrl+Right: next status"
msgstr "Ctrl+Derecha: siguiente estado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_alt_b_label"
msgid "Ctrl+Shift+Alt+B: download media"
msgstr "Ctrl+Shift+Alt+B: descargar multimedia"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_alt_m_label"
msgid "Ctrl+Shift+Alt+M: mark all chats as read"
msgstr "Ctrl+Shift+Alt+M: marcar todas las conversaciones como leídas"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_b_label"
msgid "Ctrl+Shift+B: block contact"
msgstr "Ctrl+Shift+B: bloquear contacto"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_c_label"
msgid "Ctrl+Shift+C: copy caption (photo/video/document)"
msgstr "Ctrl+Shift+C: copiar leyenda (foto/vídeo/documento)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_d_label"
msgid "Ctrl+Shift+D: chat data / discard recording"
msgstr "Ctrl+Shift+D: datos de conversación / descartar grabación"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_e_label"
msgid "Ctrl+Shift+E: forward message"
msgstr "Ctrl+Shift+E: reenviar mensaje"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_f_label"
msgid "Ctrl+Shift+F: search in chat"
msgstr "Ctrl+Shift+F: buscar en la conversación"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_g_label"
msgid ""
"Ctrl+Shift+G: record voice message in the other mode (stereo if the default "
"is mono, mono if it is stereo)"
msgstr ""
"Ctrl+Shift+G: grabar mensaje de voz en el otro modo (en estéreo si el "
"predeterminado es mono, en mono si es estéreo)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_h_label"
msgid "Ctrl+Shift+H: record microphone and computer audio"
msgstr "Ctrl+Shift+H: grabar micrófono y audio del ordenador"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_i_label"
msgid ""
"Ctrl+Shift+I: transcribe, describe or convert the media of the focused "
"message with online AI"
msgstr ""
"Ctrl+Shift+I: transcribir, describir o convertir el contenido del mensaje "
"enfocado con IA en línea"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_j_label"
msgid "Ctrl+Shift+A: add attachment"
msgstr "Ctrl+Shift+A: agregar archivo adjunto"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_k_vault_label"
msgid "Ctrl+Shift+K: close and hide the locked-chats vault"
msgstr "Ctrl+Shift+K: cerrar y ocultar la caja fuerte de chats bloqueados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_l_label"
msgid "Ctrl+Shift+L: clear chat"
msgstr "Ctrl+Shift+L: limpiar conversación"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_m_label"
msgid "Ctrl+Shift+M: mark as read/unread"
msgstr "Ctrl+Shift+M: marcar como leída/no leída"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_num_label"
msgid "Ctrl+Shift+0 to Ctrl+Shift+9: remove a bookmark"
msgstr "Ctrl+Shift+0 a Ctrl+Shift+9: eliminar un marcador"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_o_label"
msgid "Ctrl+Shift+O: star/favourite message"
msgstr "Ctrl+Shift+O: destacar mensaje"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_p_label"
msgid ""
"Ctrl+Shift+P: pause/resume recording (or pin/unpin the selected message, "
"when not recording)"
msgstr ""
"Ctrl+Shift+P: pausar/reanudar grabación (o fijar/desfijar el mensaje "
"seleccionado, si no se está grabando)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_q_list_label"
msgid "Ctrl+Shift+Q: archive/unarchive the selected chat in the list"
msgstr ""
"Ctrl+Shift+Q: archivar/desarchivar la conversación seleccionada en la lista"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_r_label"
msgid "Ctrl+Shift+R: react to message; on a missed call, call back"
msgstr ""
"Ctrl+Shift+R: reaccionar al mensaje; en una llamada perdida, devolver la "
"llamada"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_s_label"
msgid "Ctrl+Shift+S: save/download media"
msgstr "Ctrl+Shift+S: guardar/descargar medios"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_space_label"
msgid ""
"Ctrl+Shift+Space: select every chat or message, or deselect all if "
"everything is already selected"
msgstr ""
"Ctrl+Shift+Espacio: marcar todos los chats o mensajes, o desmarcar todos si "
"ya están todos marcados"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_t_list_label"
msgid "Ctrl+Shift+T: lock the selected chat in the list"
msgstr "Ctrl+Shift+T: bloquear el chat seleccionado en la lista"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_space_label"
msgid "Ctrl+Space: select/deselect the focused chat or message"
msgstr "Ctrl+Espacio: marcar/desmarcar el chat o mensaje enfocado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_delete_label"
msgid ""
"Delete: delete the message or chat (or every selected one, if there's a "
"selection)"
msgstr ""
"Delete: eliminar el mensaje o la conversación (o todos los seleccionados, si"
" hay una selección)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_esc_ctrl_w_label"
msgid ""
"Esc / Ctrl+W: close chat. With messages selected, the first Esc only "
"deselects them all and just the second one closes the chat, if the option is"
" enabled in Settings, User Interface"
msgstr ""
"Esc / Ctrl+W: cerrar conversación. Con mensajes marcados, el primer Esc solo"
" los desmarca todos y únicamente el segundo cierra la conversación, si la "
"opción está activada en Configuración, Interfaz de usuario"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_f1_label"
msgid "F1: show keyboard shortcuts"
msgstr "F1: mostrar atajos de teclado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_f5_label"
msgid "F5: resync all chats"
msgstr "F5: resincronizar todas las conversaciones"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_filter_all_label"
msgid "Alt+Shift+A: show all chats"
msgstr "Alt+Shift+A: mostrar todas las conversaciones"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_filter_groups_label"
msgid "Alt+Shift+G: show group chats"
msgstr "Alt+Shift+G: mostrar los grupos"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_filter_individual_label"
msgid "Alt+Shift+I: show individual chats"
msgstr "Alt+Shift+I: mostrar las conversaciones individuales"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_filter_unread_label"
