#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_pageup_label"
msgid "Shift+Page Up: rewind audio/video 1 minute"
msgstr "Shift+Av Pág: retroceder audio/video 1 minuto"

