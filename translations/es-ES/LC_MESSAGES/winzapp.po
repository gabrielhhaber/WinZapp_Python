msgid ""
"Select a command, press Tab to Change, then press the new keys. Confirm with"
" OK. Changes take effect when you apply or save Settings. The same key can "
"serve different screens; a new conflicting assignment is refused."
msgstr ""
"Seleccione un comando, pulse Tab hasta Cambiar y pulse las nuevas teclas. "
"Confirme con Aceptar. Los cambios se aplican al aplicar o guardar la "
"Configuración. La misma tecla puede servir en distintas pantallas; se "
"rechaza una nueva asignación en conflicto."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_settings_list"
msgid "Commands and keyboard shortcuts"
msgstr "Comandos y atajos de teclado"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_shift_down_label"
