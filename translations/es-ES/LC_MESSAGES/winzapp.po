#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_progress_verify_file"
msgid "Verifying the model in the file {name}. This can take a minute..."
msgstr ""
"Verificando el modelo del archivo {name}. Esto puede tardar un minuto..."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_external.py
msgctxt "transcription_external_question_title"
msgid "Model in another folder"
msgstr "Modelo en otra carpeta"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_read_failed"
msgid ""
"WinZapp could not read the files in the folder {name}, so nothing was added."
msgstr ""
"WinZapp no ha podido leer los archivos de la carpeta {name}, así que no se "
"ha añadido nada."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_external_read_failed_file"
msgid "WinZapp could not read the file {name}, so nothing was added."
msgstr ""
"WinZapp no ha podido leer el archivo {name}, así que no se ha añadido nada."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_refused_bad_config"
msgid ""
"The config.json file in that folder is not a model configuration WinZapp can"
" read, so the folder cannot be used."
msgstr ""
"El archivo config.json de esa carpeta no es una configuración de modelo que "
"WinZapp pueda leer, así que la carpeta no se puede usar."

#: translations/en-US/LC_MESSAGES/winzapp.po
