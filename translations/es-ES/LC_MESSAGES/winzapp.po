#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_mic_permission_denied"
msgid ""
"WinZapp does not have microphone permission. Turn it on in System Settings, "
"Privacy and Security, Microphone."
msgstr ""
"WinZapp no tiene permiso para el micrófono. Actívalo en Ajustes del Sistema,"
" Privacidad y Seguridad, Micrófono."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_mic_permission_waiting"
msgid ""
"macOS is asking for microphone permission. Recording starts once you allow "
"it, and the prompt may be waiting behind another permission prompt."
msgstr ""
"macOS está pidiendo permiso para el micrófono. La grabación empieza en "
"cuanto lo permitas, y la solicitud puede estar detrás de otra solicitud de "
"permiso."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_not_yet_available"
msgid "not yet available on Mac"
msgstr "aún no disponible en Mac"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_system_audio_permission_denied"
msgid ""
"WinZapp does not have permission to record system audio, so computer audio "
"will be silent. Turn it on in System Settings, Privacy and Security, Screen "
"and System Audio Recording."
msgstr ""
"WinZapp no tiene permiso para grabar el audio del sistema, así que el audio "
"del ordenador quedará en silencio. Actívalo en Ajustes del Sistema, "
"Privacidad y Seguridad, Grabación de Pantalla y Audio del Sistema."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_system_audio_permission_waiting"
msgid ""
"macOS is asking for permission to record system audio. Recording starts once"
" you answer, and the prompt may be waiting behind another permission prompt."
msgstr ""
"macOS está pidiendo permiso para grabar el audio del sistema. La grabación "
"empieza en cuanto respondas, y la solicitud puede estar detrás de otra "
"solicitud de permiso."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_available_reminder"
msgid ""
"A new version of WinZapp is available (v{new_version}). To install it, "
"choose Help > Check for updates, or switch to WinZapp."
msgstr ""
"Hay una nueva versión de WinZapp disponible (v{new_version}). Para "
"instalarla, elige Ayuda > Comprobar actualizaciones o cambia a WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_downloaded_reminder"
msgid ""
"WinZapp update v{new_version} has been downloaded and will be installed when"
" you quit WinZapp. To install it now, choose Help > Check for updates, or "
"switch to WinZapp."
msgstr ""
"La actualización v{new_version} de WinZapp se ha descargado y se instalará "
"cuando salgas de WinZapp. Para instalarla ahora, elige Ayuda > Comprobar "
"actualizaciones o cambia a WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_ready_to_install"
msgid ""
"WinZapp update v{new_version} has been downloaded and is ready to install. "
"Choose Install and Relaunch in the Software Update window."
msgstr ""
"La actualización v{new_version} de WinZapp se ha descargado y está lista "
"para instalarse. Elige Instalar y volver a abrir en la ventana Actualización"
" de software."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_reopened_other_accounts"
msgid ""
"The update was not installed. The other WinZapp accounts that were closed "
"for it have been opened again."
msgstr ""
"La actualización no se instaló. Las otras cuentas de WinZapp que se cerraron"
" para ella se han vuelto a abrir."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_access_denied"
msgid "GitHub refused access to the verification request."
msgstr "GitHub ha denegado el acceso a la solicitud de verificación."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_connection"
msgid "The connection to GitHub failed. Check your internet connection."
msgstr "Ha fallado la conexión con GitHub. Compruebe su conexión a Internet."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_dns"
msgid ""
"GitHub's address could not be resolved. Check your internet connection."
msgstr ""
"No se ha podido resolver la dirección de GitHub. Compruebe su conexión a "
"Internet."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_file"
msgid ""
"Could not retrieve the update verification file.\n"
"{reason}"
msgstr ""
"No se ha podido obtener el archivo de verificación de la actualización.\n"
"{reason}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_http_error"
msgid "GitHub returned an unexpected response."
msgstr "GitHub ha devuelto una respuesta inesperada."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_not_found"
msgid "The verification resource was not found on GitHub."
msgstr "No se ha encontrado el recurso de verificación en GitHub."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_rate_limited"
msgid "GitHub's request limit was reached."
msgstr "Se ha alcanzado el límite de solicitudes de GitHub."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_server"
msgid "GitHub reported a temporary server error. Try again later."
msgstr ""
"GitHub ha indicado un error temporal del servidor. Inténtelo de nuevo más "
"tarde."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_tag"
msgid ""
"Could not verify the official release tag.\n"
"{reason}"
msgstr ""
"No se ha podido verificar la etiqueta de la versión oficial.\n"
"{reason}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_timeout"
msgid "The verification request timed out. Try again later."
msgstr ""
"La solicitud de verificación ha agotado el tiempo de espera. Inténtelo de "
"nuevo más tarde."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_tls"
msgid ""
"The secure connection could not be verified. Check the date, time and "
"network certificate settings."
msgstr ""
"No se ha podido verificar la conexión segura. Compruebe la fecha, la hora y "
"la configuración de certificados de red."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_unexpected"
