msgctxt "transcription_not_saved_unsent"
msgid ""
"This transcription was not saved, because the message has not been sent yet."
" Once it is sent, transcribe it again to save it."
msgstr ""
"Esta transcripción no se guardó porque el mensaje aún no se ha enviado. "
"Cuando se envíe, vuelve a transcribirlo para guardarla."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_language_differs"
