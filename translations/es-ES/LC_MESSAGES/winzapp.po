msgid ""
"{chat}: Star sync: {confirmed} confirmed, {refused} refused, {unknown} "
"unverified, {skipped} not processed."
msgstr ""
"{chat}: Sincronización de destacados: {confirmed} confirmados, {refused} "
"rechazados, {unknown} sin verificar, {skipped} sin procesar."

