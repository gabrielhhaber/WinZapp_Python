msgctxt "shortcut_status_delete_label"
msgid ""
"Delete: in My status, delete the status being shown, for everyone who "
"received it"
msgstr ""
"Delete: en Mi estado, eliminar el estado que se muestra, para todos los que "
"lo recibieron"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_status_delete_transcription_label"
msgid "Alt+Shift+Delete: delete the saved local transcription of the status"
msgstr "Alt+Shift+Delete: eliminar la transcripción local guardada del estado"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_status_transcribe_inline_label"
msgid ""
"Alt+Shift+N: on an audio or video status, do what Enter and Space do not: "
"transcribe it locally with Whisper into its line in the list, or open or "
"play it when Enter and Space are set to transcribe"
msgstr ""
