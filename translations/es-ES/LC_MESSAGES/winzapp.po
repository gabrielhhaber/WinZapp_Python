msgctxt "ai_kind_audio"
msgid "voice messages"
msgstr "mensajes de voz"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_kind_image"
msgid "photos"
msgstr "fotos"

#: translations/en-US/LC_MESSAGES/winzapp.po
