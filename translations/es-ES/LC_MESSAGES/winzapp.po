msgid "Describe"
msgstr "Describir"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_images_label"
msgid "Describe received ima&ges"
msgstr "Describir imágenes &recibidas"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_sticker_menu"
msgid "Describe sticker"
msgstr "Describir sticker"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_stickers_label"
msgid "&Describe received stickers"
msgstr "&Describir stickers recibidos"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_describe_video_menu"
msgid "Describe"
msgstr "Describir"

