msgid "Detailed"
msgstr "Detallada"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_launch.py
#: client/ui/conversation_panel/ai_actions.py
msgctxt "ai_disabled"
msgid ""
"Turn on AI features, add a key for a provider and enable this kind of media "
"in Settings > Online AI: Transcriptions and Descriptions first."
msgstr ""
"Primero activa las funciones de IA, introduce la clave de un proveedor y "
"habilita este tipo de contenido en Ajustes > IA en línea: Transcripciones y "
"Descripciones."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_authentication"
msgid ""
"The provider rejected the key or access to this model. Check the key and "
"permissions."
msgstr ""
"El proveedor rechazó la clave o el acceso al modelo. Revisa la clave y los "
"permisos."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_busy"
msgid ""
"An operation is already running. Wait or cancel it before starting another."
msgstr ""
"Ya hay una operación en curso. Espera o cancélala antes de iniciar otra."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_cancelled"
msgid "The request was cancelled."
msgstr "La petición se canceló."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_credentials"
msgid ""
"The API key cannot be read or saved. Re-enter it; for a damaged credential "
"store, explicitly reset all AI keys first."
msgstr ""
"No se puede leer o guardar la clave de API. Introdúcela de nuevo; si el "
"almacén está dañado, restablece explícitamente todas las claves de IA "
"primero."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_limit"
msgid ""
"This session reached its request or conversation limit. Close it before "
"starting a new session."
msgstr ""
"Esta sesión alcanzó su límite de peticiones o preguntas. Cierra la ventana "
"antes de iniciar otra sesión."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media"
msgid ""
"The original media could not be downloaded or read. It may no longer be "
"available on WhatsApp."
msgstr ""
"No se pudo descargar o leer el contenido original. Puede que ya no esté "
"disponible en WhatsApp."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media_format"
msgid "This file is not in a supported, readable format."
msgstr "Este archivo no está en un formato legible y admitido."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_media_size"
msgid "This file exceeds the size limit for sending to an AI provider."
msgstr ""
"Este archivo supera el límite de tamaño para enviarlo a un proveedor de IA."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_network"
msgid ""
"Could not connect to the provider. Check your connection; no automatic retry"
" was made."
msgstr ""
"No se pudo conectar al proveedor. Revisa la conexión; no se reintentó "
"automáticamente."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_output_limit"
msgid ""
"The response exceeds the supported text limit for a transcript or PDF. No "
"partial result was shown and no other provider was tried automatically. Try "
"a shorter file."
msgstr ""
"La respuesta supera el límite de texto admitido para una transcripción o "
"PDF. No se mostró un resultado incompleto ni se probó otro proveedor "
"automáticamente. Prueba con un archivo más corto."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_providers"
msgid ""
"No AI provider is available for this kind of media. In Settings > Online AI:"
" Transcriptions and Descriptions, add a key to a provider that handles it "
"and turn it on."
msgstr ""
"Ningún proveedor de IA está disponible para este tipo de contenido. En "
"Ajustes > IA en línea: Transcripciones y Descripciones, introduce la clave "
"de un proveedor que lo admita y actívalo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_question"
msgid "Enter a question of no more than 2,000 characters."
msgstr "Escribe una pregunta de hasta 2.000 caracteres."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_quota"
msgid ""
"The provider's quota or rate limit was reached. Check usage and billing "
"before trying again."
msgstr ""
"Se alcanzó la cuota o el límite de peticiones del proveedor. Revisa el uso y"
" la facturación antes de volver a intentarlo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_refusal"
msgid "The provider declined to process this media or answer the question."
msgstr ""
"El proveedor se negó a procesar este contenido o responder a la pregunta."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_request"
msgid ""
"The provider rejected the request. Check the model identifier and settings."
msgstr ""
"El proveedor rechazó la petición. Revisa el identificador del modelo y los "
"ajustes."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_response"
msgid "No usable answer was received from the provider."
msgstr "No se recibió una respuesta utilizable del proveedor."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_server"
msgid ""
"The provider is temporarily unavailable. The request was not retried "
"automatically."
msgstr ""
"El proveedor no está disponible temporalmente. La petición no se repitió "
"automáticamente."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_error_timeout"
msgid ""
"The request timed out. It was not retried; a request already received may "
"still be charged."
msgstr ""
"La petición agotó el tiempo de espera. No se repitió; si ya se recibió, aún "
"puede cobrarse."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_fast"
msgid "Quick"
msgstr "Rápida"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_gemini_notice"
msgid ""
"Gemini: unpaid services may use inputs for product improvement and human "
"review. Do not send sensitive or personal information under those terms. "
"Paid-service terms differ; check your project's billing. WinZapp cannot "
"infer this from an API key."
msgstr ""
"Gemini: los servicios gratuitos pueden usar las entradas para mejorar "
"productos y para revisión humana. No envíes información personal o sensible "
"bajo esas condiciones. Las condiciones de pago son distintas; comprueba la "
"facturación del proyecto. WinZapp no puede deducirlo de la clave de API."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_get_key"
msgid "Get an API &key"
msgstr "Obtener &una clave de API"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_get_models"
msgid "&Get models"
msgstr "O&btener modelos"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_hide_action_button"
msgid ""
"&Hide the online AI button after the message list (the message menu still "
"offers it)"
msgstr ""
"Ocultar el botón de IA en línea &que aparece después de la lista de mensajes"
" (el menú del mensaje lo sigue ofreciendo)"

