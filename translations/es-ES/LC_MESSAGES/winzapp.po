msgctxt "transcription_download_confirm_title"
msgid "Confirm download"
msgstr "Confirmar descarga"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_audio_incomplete"
msgid "The audio file is incomplete or damaged."
msgstr "El archivo de audio está incompleto o dañado."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_error"
msgid "An internal error occurred during the transcription."
msgstr "Se produjo un error interno durante la transcripción."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_missing"
msgid "The transcription component is not installed in this copy of WinZapp."
msgstr ""
"El componente de transcripción no está instalado en esta copia de WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cancelled"
msgid "Transcription cancelled."
msgstr "Transcripción cancelada."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_busy"
msgid ""
"Another WinZapp window is using the CUDA libraries folder. Wait for it to "
"finish and try again."
msgstr ""
"Otra ventana de WinZapp está usando la carpeta de las bibliotecas CUDA. "
"Espera a que termine e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_corrupted"
msgid "The CUDA library files are incomplete or damaged. Install them again."
msgstr ""
"Los archivos de las bibliotecas CUDA están incompletos o dañados. Vuelve a "
"instalarlas."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_download_failed"
msgid ""
"The CUDA libraries could not be downloaded. Check your connection and try "
"again."
msgstr ""
"No se pudieron descargar las bibliotecas CUDA. Comprueba la conexión e "
"inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_in_use"
msgid ""
"The CUDA libraries are in use by this session. Close and reopen WinZapp, "
"then try again."
msgstr ""
"Las bibliotecas CUDA están en uso en esta sesión. Cierra WinZapp, vuelve a "
"abrirlo e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_unavailable"
msgid ""
"CUDA is not available. Switch the device to the processor in the settings "
"and try again."
msgstr ""
"CUDA no está disponible. Cambia el dispositivo a procesador en la "
"configuración e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed"
msgid ""
"The files in the chosen model's folder have changed since it was verified. "
"Verify the model again in the Local Transcription tab in the settings, or "
"choose another model."
msgstr ""
"Los archivos de la carpeta del modelo elegido han cambiado desde que se "
"verificó. Vuelve a verificar el modelo en la pestaña Transcripción local de "
"la configuración o elige otro modelo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed_file"
msgid ""
"The chosen model's file has changed since it was verified. Verify the model "
"again in the Local Transcription tab in the settings, or choose another "
"model."
msgstr ""
"El archivo del modelo elegido ha cambiado desde que se verificó. Vuelve a "
"verificar el modelo en la pestaña Transcripción local de la configuración o "
"elige otro modelo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_missing"
msgid ""
"The folder of the chosen model was not found. If it is on an external drive,"
" connect the drive; if it was deleted, choose another model."
msgstr ""
"No se encontró la carpeta del modelo elegido. Si está en un disco externo, "
"conecta el disco; si se eliminó, elige otro modelo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_missing_file"
msgid ""
"The file of the chosen model was not found. If it is on an external drive, "
"connect the drive; if it was deleted, choose another model."
msgstr ""
"No se encontró el archivo del modelo elegido. Si está en un disco externo, "
"conecta el disco; si se eliminó, elige otro modelo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_ffmpeg_failed"
msgid "The audio could not be converted for transcription."
msgstr "No se pudo convertir el audio para transcribirlo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_insufficient_ram"
msgid ""
"The computer does not have enough memory for this model. Choose a smaller "
"model."
msgstr ""
"El equipo no tiene memoria suficiente para este modelo. Elige un modelo más "
"pequeño."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_insufficient_vram"
msgid ""
"The graphics card does not have enough memory for this model. Choose a "
"smaller model."
msgstr ""
"La tarjeta gráfica no tiene memoria suficiente para este modelo. Elige un "
"modelo más pequeño."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_media_not_downloaded"
msgid ""
"The audio has not been downloaded yet. Wait for the download to finish and "
"try again."
msgstr ""
"El audio aún no se ha descargado. Espera a que termine la descarga e "
"inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_corrupted"
msgid "The model files are incomplete or corrupted. Download the model again."
msgstr ""
"Los archivos del modelo están incompletos o dañados. Descarga el modelo de "
"nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_download_failed"
msgid ""
"The transcription model could not be downloaded. Check your connection and "
"try again."
msgstr ""
"No se pudo descargar el modelo de transcripción. Comprueba la conexión e "
"inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_move_failed"
msgid ""
"The models folder could not be moved. The models are still in the previous "
"folder."
msgstr ""
"No se pudo mover la carpeta de los modelos. Los modelos siguen en la carpeta"
" anterior."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_not_installed"
msgid ""
"The selected transcription model is not installed. Download the model before"
" transcribing."
msgstr ""
"El modelo de transcripción elegido no está instalado. Descarga el modelo "
"antes de transcribir."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_models_busy"
msgid ""
"Another WinZapp window is using the models folder. Wait for it to finish and"
" try again."
msgstr ""
"Otra ventana de WinZapp está usando la carpeta de modelos. Espera a que "
"termine e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_no_audio_track"
msgid "This video has no sound, so there is nothing to transcribe."
msgstr "Este vídeo no tiene sonido, así que no hay nada que transcribir."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_no_disk_space"
msgid "There is not enough disk space for this download."
msgstr "No hay suficiente espacio en disco para esta descarga."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_precision_unsupported"
msgid ""
"The chosen calculation precision could not be used on this device. Choose "
"another one, or Automatic, in the settings."
msgstr ""
"No se pudo usar la precisión de cálculo elegida en este dispositivo. Elige "
"otra, o Automático, en la configuración."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_save_failed"
msgid "The transcription could not be saved."
msgstr "No se pudo guardar la transcripción."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_error_temp_no_disk_space"
msgid ""
"There is no free space on drive {drive} to prepare this message's audio. "
"Free up some space on that drive and try again."
msgstr ""
"No hay espacio libre en el disco {drive} para preparar el audio de este "
"mensaje. Libera espacio en ese disco e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_temp_no_disk_space_unnamed"
msgid ""
"There is no free space left for Windows' temporary files, so this message's "
"audio could not be prepared. Free up some space on the disk that holds them "
"and try again."
msgstr ""
"No queda espacio libre para los archivos temporales de Windows, así que no "
"se pudo preparar el audio de este mensaje. Libera espacio en el disco donde "
"se guardan e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_unsupported_audio_format"
msgid "This audio format was not recognized and cannot be transcribed."
msgstr "No se reconoció el formato de este audio y no se puede transcribir."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_busy"
msgid ""
"The whisper.cpp program folder is in use by another WinZapp window or by "
"another program, such as an antivirus. Wait a moment and try again."
msgstr ""
"La carpeta del programa whisper.cpp está en uso por otra ventana de WinZapp "
"o por otro programa, como un antivirus. Espera un momento e inténtalo de "
"nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_corrupted"
msgid ""
"The whisper.cpp program files are incomplete or damaged. Install it again."
msgstr ""
"Los archivos del programa whisper.cpp están incompletos o dañados. Vuelve a "
"instalarlo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_download_failed"
msgid ""
"The whisper.cpp program could not be downloaded. Check your connection and "
"try again."
msgstr ""
"No se pudo descargar el programa whisper.cpp. Comprueba la conexión e "
"inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_whisper_cpp_not_installed"
msgid ""
"The whisper.cpp program is not installed. Install it in the settings before "
"transcribing."
msgstr ""
"El programa whisper.cpp no está instalado. Instálalo en la configuración "
"antes de transcribir."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_actions_group"
msgid "Models in other folders"
msgstr "Modelos guardados en otras carpetas"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_external_add_btn"
msgid "A&dd..."
msgstr "Aña&dir..."

