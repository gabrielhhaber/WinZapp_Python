#: client/ui/conversation_panel/message_stars.py
msgctxt "star_sync_unknown"
msgid ""
"Some results could not be verified. Refresh the open chat with Shift+F5 "
"before retrying; an unverified action may already have succeeded."
msgstr ""
"No se pudieron verificar algunos resultados. Actualiza el chat abierto con "
"Shift+F5 antes de reintentar; una acción sin verificar podría haberse "
"completado."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "star_unverified"
msgid ""
"Could not verify this star change. Refresh the open chat with Shift+F5 "
"before retrying; it may already have been applied."
msgstr ""
"No se pudo verificar este cambio de destacado. Actualiza el chat abierto con"
" Shift+F5 antes de reintentar; puede que ya se haya aplicado."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/neonize_bridge.py
msgctxt "starting_api"
msgid "Starting WinZapp, please wait..."
msgstr "Iniciando WinZapp, espera por favor..."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "startup_account_manager_unavailable"
msgid ""
"There are no accounts available to start. The account manager is not "
"available yet."
msgstr ""
"No hay cuentas disponibles para iniciar. El administrador de cuentas aún no "
"está disponible."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "startup_account_not_answering"
msgid ""
"This WinZapp account is already running but did not answer, possibly because"
" it is still closing. Wait a few seconds and open it again. If it keeps "
"happening, end WinZapp.exe in Task Manager and open WinZapp again."
msgstr ""
"Esta cuenta de WinZapp ya está abierta, pero no respondió; quizá todavía se "
"esté cerrando. Espere unos segundos y vuelva a abrirla. Si sigue ocurriendo,"
" finalice WinZapp.exe en el Administrador de tareas y vuelva a abrir "
"WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main.py
#, python-brace-format
msgctxt "startup_critical_message"
msgid ""
"WinZapp encountered a critical error during startup and could not continue.\n"
"\n"
"Details were saved to:\n"
"{path}\n"
"\n"
"{details}"
msgstr ""
"WinZapp encontró un error crítico durante el inicio y no pudo continuar.\n"
"\n"
"Los detalles se guardaron en:\n"
"{path}\n"
"\n"
"{details}"

#: translations/en-US/LC_MESSAGES/winzapp.po client/main.py
msgctxt "startup_critical_title"
msgid "WinZapp — Startup error"
msgstr "WinZapp — Error de inicio"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "startup_invalid_account"
msgid ""
"WinZapp could not open the requested account ({account}): it does not exist,"
" has been archived or is being deleted."
msgstr ""
"WinZapp no pudo abrir la cuenta solicitada ({account}): no existe, se ha "
"archivado o se está eliminando."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "startup_update_in_progress"
msgid ""
"WinZapp is still finishing an update and cannot open yet. It opens by itself"
" when the installation is done. If it has not opened within a few minutes, "
"end WinZapp.exe in Task Manager and open WinZapp again."
msgstr ""
"WinZapp todavía está terminando de instalar una actualización y no puede "
"abrirse ahora. Se abrirá solo cuando termine la instalación. Si no se abre "
"en unos minutos, finalice WinZapp.exe en el Administrador de tareas y vuelva"
" a abrir WinZapp."

