#, python-brace-format
msgctxt "transcription_confirm_not_enough_space"
msgid "There is not enough space: {required} is needed and {free} is free. Free some space or choose another models folder."
msgstr "Za mało miejsca: potrzeba {required}, a wolne jest {free}. Zwolnij miejsce albo wybierz inny folder modeli."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/transcription_tab.py
msgctxt "transcription_confirm_remove_cuda"
msgid "Remove the CUDA libraries? Transcription goes back to running on the processor, and they have to be downloaded again to use the graphics card."
msgstr "Usunąć biblioteki CUDA? Transkrypcja będzie ponownie wykonywana przez procesor. Aby korzystać z karty graficznej, trzeba będzie ponownie pobrać te biblioteki."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/transcription_tab.py
