msgstr "Alt+3: przejdź do nieprzeczytanych wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt4_label"
msgid "Alt+4: go to archived chats"
msgstr "Alt+4: przejdź do zarchiwizowanych czatów"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt5_label"
msgid "Alt+5: go to status"
msgstr "Alt+5: przejdź do statusów"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt6_label"
msgid "Alt+6: go to calls"
msgstr "Alt+6: przejdź do połączeń"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt7_label"
msgid "Alt+7: open locked chats"
msgstr "Alt+7: otwórz zabezpieczone czaty"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt8_communities_label"
msgid "Alt+8: open communities"
msgstr "Alt+8: otwórz społeczności"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_c_label"
msgid "Alt+C: show message text in popup"
msgstr "Alt+C: pokaż tekst wiadomości w okienku"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_comma_label"
msgid "Alt+,: decrease playback speed"
msgstr "Alt+,: zmniejsz prędkość odtwarzania"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_e_label"
msgid "Alt+E: edit message"
msgstr "Alt+E: edytuj wiadomość"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_l_label"
msgid "Alt+L: read the rest of a text message truncated in the list"
msgstr "Alt+L: przeczytaj resztę wiadomości tekstowej skróconej na liście"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
#, python-brace-format
msgctxt "shortcut_alt_nav_label"
msgid "Alt+{letter}: focus the main navigation"
msgstr "Alt+{letter}: przejdź do głównej nawigacji"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_period_label"
msgid "Alt+.: increase playback speed"
msgstr "Alt+.: zwiększ prędkość odtwarzania"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_r_label"
msgid "Alt+R: reply to message"
msgstr "Alt+R: odpowiedz na wiadomość"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_b_catalog_label"
msgid "Alt+Shift+B: in a chat with a business, its catalog and cart"
msgstr "Alt+Shift+B: otwórz katalog i koszyk firmy, z którą prowadzisz czat"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_c_label"
msgid "Alt+Shift+C: copy phone number"
msgstr "Alt+Shift+C: kopiuj numer telefonu"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_d_label"
msgid "Alt+Shift+D: message data"
msgstr "Alt+Shift+D: informacje o wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_f_filter_label"
msgid "Alt+Shift+F: go to the chat filters"
msgstr "Alt+Shift+F: przejdź do filtrów czatów"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_j_label"
msgid "Alt+Shift+J: jump to the next message that mentions you"
msgstr "Alt+Shift+J: przejdź do następnej wiadomości ze wzmianką o Tobie"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_k_label"
msgid "Alt+Shift+K: announce the focused message's date and time"
msgstr "Alt+Shift+K: odczytaj datę i godzinę zaznaczonej wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_l_label"
msgid "Alt+Shift+L: announce the focused message's status"
msgstr "Alt+Shift+L: odczytaj status zaznaczonej wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_m_label"
msgid "Alt+Shift+M: jump to the previous message that mentions you"
msgstr "Alt+Shift+M: przejdź do poprzedniej wiadomości ze wzmianką o Tobie"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_n_label"
msgid ""
"Alt+Shift+N: on a voice message or video, do what Enter and Space do not: "
"transcribe it locally with Whisper into its line in the list, or play, pause"
" or open it when Enter and Space are set to transcribe (Settings > User "
"Interface)"
msgstr ""
"Alt+Shift+N: transkrybuj lokalnie wiadomość głosową lub wideo za pomocą "
"Whispera i wyświetl tekst w wierszu wiadomości. Jeśli Enter i Spacja służą "
"do transkrypcji, ten skrót odtwarza, wstrzymuje lub otwiera wiadomość "
"(Ustawienia > Dźwięk)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_num_label"
msgid ""
"Alt+Shift+0 to Alt+Shift+9: temporarily bookmark the focused message, or "
"jump to an existing temporary bookmark (cleared when you leave the chat)"
msgstr ""
"Alt+Shift+0 do Alt+Shift+9: ustaw zakładkę tymczasową na zaznaczonej "
"wiadomości lub przejdź do istniejącej zakładki tymczasowej (usuwane po "
"opuszczeniu czatu)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_o_label"
msgid "Alt+Shift+O: jump to the next message that replies to you"
msgstr "Alt+Shift+O: przejdź do następnej odpowiedzi na Twoją wiadomość"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_p_label"
msgid "Alt+Shift+P: jump to the previous message that replies to you"
msgstr "Alt+Shift+P: przejdź do poprzedniej odpowiedzi na Twoją wiadomość"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_q_label"
msgid "Alt+Shift+Q: go to quoted message"
msgstr "Alt+Shift+Q: przejdź do cytowanej wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_r_label"
msgid "Alt+Shift+R: reply privately (groups)"
msgstr "Alt+Shift+R: odpowiedz prywatnie (grupy)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_s_label"
msgid "Alt+Shift+S: open the mute chat menu / unmute"
msgstr "Alt+Shift+S: wycisz/wyłącz wyciszenie czatu"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_t_label"
msgid ""
"Alt+Shift+T: transcribe the voice message or audio locally with Whisper, or "
"open the transcription already saved"
msgstr ""
"Alt+Shift+T: transkrybuj lokalnie wiadomość głosową lub nagranie audio za "
"pomocą Whispera albo otwórz zapisaną transkrypcję"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_v_label"
msgid "Alt+Shift+V: chat with participant (groups)"
msgstr "Alt+Shift+V: rozpocznij czat z członkiem grupy"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_t_label"
msgid "Alt+T: announce chat status (last seen, online, typing)"
msgstr "Alt+T: ogłoś status czatu (widziano, online, pisze)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_archive_chats_label"
msgid "Ctrl+Alt+Shift+A: archive the selected chats"
msgstr "Ctrl+Alt+Shift+A: archiwizuj zaznaczone czaty"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_clear_chats_label"
msgid "Ctrl+Alt+Shift+L: clear the selected chats"
msgstr "Ctrl+Alt+Shift+L: wyczyść zaznaczone czaty"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_copy_label"
msgid "Ctrl+Alt+Shift+C: copy the selected messages"
msgstr "Ctrl+Alt+Shift+C: kopiuj zaznaczone wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_chats_label"
msgid "Ctrl+Shift+Delete: delete the selected chats"
msgstr "Ctrl+Shift+Delete: usuń zaznaczone czaty"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_label"
msgid "Ctrl+Shift+Delete: delete the selected messages"
msgstr "Ctrl+Shift+Delete: usuń zaznaczone wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_delete_transcriptions_label"
msgid ""
"Ctrl+Alt+Shift+Delete: delete the saved local transcriptions of the selected"
" messages"
msgstr ""
"Ctrl+Alt+Shift+Delete: usuń zapisane lokalne transkrypcje zaznaczonych "
"wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_forward_label"
msgid "Ctrl+Alt+Shift+E: forward the selected messages"
msgstr "Ctrl+Alt+Shift+E: przekaż zaznaczone wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_override_note"
msgid ""
"With \"Replace shortcuts with bulk actions when selecting chats and "
"messages\" enabled (Settings > User Interface), shortcuts like forward, "
"save, clear and delete act on the whole selection whenever one exists."
msgstr ""
"Gdy włączona jest opcja \"Zastąp skróty akcjami masowymi podczas zaznaczania"
" czatów i wiadomości\" (Ustawienia > Interfejs > Czaty), skróty takie jak "
"przekazywanie, zapisywanie, czyszczenie i usuwanie działają na całym "
"zaznaczeniu, jeśli istnieje."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_pin_label"
msgid "Ctrl+Alt+Shift+X: pin the selected messages"
msgstr "Ctrl+Alt+Shift+X: przypnij zaznaczone wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_read_chats_label"
msgid "Ctrl+Alt+Shift+R: mark the selected chats as read"
msgstr "Ctrl+Alt+Shift+R: oznacz zaznaczone czaty jako przeczytane"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_save_label"
msgid "Ctrl+Alt+Shift+S: save the selected messages"
msgstr "Ctrl+Alt+Shift+S: zapisz zaznaczone wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_star_label"
msgid "Ctrl+Alt+Shift+F: star the selected messages"
msgstr "Ctrl+Alt+Shift+F: oznacz gwiazdką zaznaczone wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_transcribe_inline_label"
msgid ""
"Ctrl+Alt+Shift+N: transcribe the selected messages locally with Whisper into"
" their lines"
msgstr ""
"Ctrl+Alt+Shift+N: transkrybuj zaznaczone wiadomości lokalnie za pomocą "
"Whispera i wyświetl tekst w ich wierszach"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_transcribe_label"
msgid ""
"Ctrl+Alt+Shift+T: transcribe the selected messages locally with Whisper and "
"show them together"
msgstr ""
"Ctrl+Alt+Shift+T: transkrybuj lokalnie za pomocą Whispera zaznaczone "
"wiadomości i pokaż je razem"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_unread_chats_label"
msgid "Ctrl+Alt+Shift+U: mark the selected chats as unread"
msgstr "Ctrl+Alt+Shift+U: oznacz zaznaczone czaty jako nieprzeczytane"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_c_label"
msgid "Ctrl+C: call settings"
msgstr "Ctrl+C: ustawienia połączenia"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_m_label"
msgid "Ctrl+M: mute or unmute the microphone"
msgstr "Ctrl+M: wycisz lub włącz mikrofon"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_p_label"
msgid "Ctrl+P: switch a voice call to a video call"
msgstr "Ctrl+P: przełącz połączenie głosowe na połączenie wideo"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_shift_q_label"
msgid "Ctrl+Shift+Q: end the call"
msgstr "Ctrl+Shift+Q: zakończ połączenie"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_v_label"
msgid "Ctrl+V: turn video on or off in a video call"
msgstr "Ctrl+V: włącz lub wyłącz wideo w połączeniu wideo"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_alt_l_label"
msgid "Alt+L: go to the calls list"
msgstr "Alt+L: przejdź do listy połączeń"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_shift_r_label"
msgid "Ctrl+Shift+R: call back a missed call"
msgstr "Ctrl+Shift+R: oddzwoń na nieodebrane połączenie"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_tab_label"
msgid ""
"Ctrl+Tab and Ctrl+Shift+Tab: switch between the all, missed, declined and "
"answered tabs"
msgstr ""
"Ctrl+Tab i Ctrl+Shift+Tab: przełączaj karty wszystkie, nieodebrane, "
"odrzucone i odebrane"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_enter_label"
msgid "Enter: open the call's chat"
msgstr "Enter: otwórz czat połączenia"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_f5_label"
msgid "F5: refresh the calls list"
msgstr "F5: odśwież listę połączeń"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_hint"
msgid ""
"Tab and Shift+Tab move focus. Press Enter or Escape in this field to capture"
" those keys. Tab to OK to confirm, or Cancel to discard."
msgstr ""
"Tab i Shift+Tab przenoszą fokus. Naciśnij Enter lub Escape w tym polu, aby "
"przechwycić te klawisze. Przejdź klawiszem Tab do OK, aby potwierdzić, lub "
"Anuluj, aby odrzucić."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_modifier_required"
msgid "Use Control or Alt with a letter or digit."
msgstr "Użyj Ctrl lub Alt z literą albo cyfrą."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_prompt"
msgid "Press the new key combination"
msgstr "Naciśnij nową kombinację klawiszy"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_reserved"
msgid "This key combination is reserved by the operating system."
msgstr "Ta kombinacja klawiszy jest zarezerwowana przez system operacyjny."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_wait"
msgid "Press another key while holding the modifiers."
msgstr "Naciśnij inny klawisz, przytrzymując klawisze modyfikujące."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_change"
msgid "&Change"
msgstr "&Zmień"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py client/ui/dialogs/shortcuts_tab.py
msgctxt "shortcut_change_title"
msgid "Change keyboard shortcut"
msgstr "Zmień skrót klawiszowy"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_tab.py
#, python-brace-format
msgctxt "shortcut_conflict"
msgid ""
"This shortcut is already used in an overlapping screen by:\n"
"{actions}\n"
"Remove or change that assignment first."
msgstr ""
"Ten skrót jest już przypisany do poleceń dostępnych w tym samym miejscu:\n"
"{actions}\n"
"Najpierw usuń lub zmień ich przypisania."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_num_label"
msgid "Ctrl+Alt+1 to Ctrl+Alt+9: switch to the matching paired account"
msgstr "Ctrl+Alt+1 do Ctrl+Alt+9: przełącz na odpowiednie połączone konto"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_d_label"
msgid "Ctrl+Alt+Shift+D: disconnect"
msgstr "Ctrl+Alt+Shift+D: rozłącz"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_g_label"
msgid ""
"Ctrl+Alt+Shift+G: switch the recording device until WinZapp closes, in every"
" open account (then 1 to 0)"
msgstr ""
"Ctrl+Alt+Shift+G: zmień urządzenie nagrywające we wszystkich otwartych "
"kontach do czasu zamknięcia programu WinZapp (następnie naciśnij 1–9 lub 0)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_h_label"
msgid ""
"Ctrl+Alt+Shift+H: switch the playback device until WinZapp closes, in every "
"open account (then 1 to 0)"
msgstr ""
"Ctrl+Alt+Shift+H: zmień urządzenie odtwarzające we wszystkich otwartych "
"kontach do czasu zamknięcia programu WinZapp (następnie naciśnij 1–9 lub 0)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_num_label"
msgid "Ctrl+Alt+Shift+0 to Ctrl+Alt+Shift+9: remove a temporary bookmark"
msgstr "Ctrl+Alt+Shift+0 do Ctrl+Alt+Shift+9: usuń zakładkę tymczasową"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_o_label"
msgid "Ctrl+Alt+Shift+O: toggle offline mode"
msgstr "Ctrl+Alt+Shift+O: przełącz tryb offline"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_alt_shift_p_label"
msgid ""
"Ctrl+Alt+Shift+P: pause/resume whichever audio is currently playing, from "
