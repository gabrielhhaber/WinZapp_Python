msgid "&Readable API key"
msgstr "Widocz&ny klucz API"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_notice"
msgid ""
"The saved key is marked for removal from WinZapp. Save with Apply or OK, or "
"discard with Cancel. The API key in your provider account will not be "
"revoked."
msgstr ""
"Zapisany klucz oznaczono do usunięcia z WinZapp. Aby zatwierdzić usunięcie, "
"wybierz Zastosuj lub OK; aby je anulować, wybierz Anuluj. Klucz API na "
"koncie dostawcy nie zostanie unieważniony."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_pending"
msgid "Key marked for removal."
msgstr "Klucz oznaczony do usunięcia."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_saved"
msgid "Key saved"
msgstr "Klucz zapisany"

