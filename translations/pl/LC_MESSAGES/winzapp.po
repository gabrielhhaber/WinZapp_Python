#, python-brace-format
msgctxt "acc_delete_last_confirm"
msgid ""
"\"{name}\" is the only account. Permanently delete it with all its messages,"
" media, preferences and profile backups, and close WinZapp? This cannot be "
"undone."
msgstr ""
"„{name}” to jedyne konto. Trwale usunąć je razem ze wszystkimi "
"wiadomościami, multimediami, preferencjami i kopiami zapasowymi profilu oraz"
" zamknąć WinZapp? Tej operacji nie można cofnąć."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "acc_err_archive_current"
msgid "Can't archive the account in use. Switch to another account first."
msgstr ""
"Nie można zarchiwizować używanego konta. Najpierw przełącz się na inne "
"konto."

