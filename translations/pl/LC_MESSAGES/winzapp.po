#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_model_unavailable_auto"
msgid ""
"No transcription model is ready to use. In the Local Transcription tab of "
"the settings, download one before transcribing."
msgstr ""
"Żaden model nie jest gotowy do użycia. Pobierz jeden na karcie „Transkrypcja"
" lokalna” w ustawieniach."

#: translations/en-US/LC_MESSAGES/winzapp.po
