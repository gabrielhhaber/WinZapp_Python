#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt2_label"
msgid "Alt+2: go to last message"
msgstr "Alt+2: przejdź do ostatniej wiadomości"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt3_label"
