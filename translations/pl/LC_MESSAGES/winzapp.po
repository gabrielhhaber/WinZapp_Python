msgstr "Brak dziennika zmian dla tej wersji."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/window_chrome.py
msgctxt "whats_new_none_title"
msgid "No news"
msgstr "Brak nowości"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "whats_new_title"
msgid "What's new in WinZapp"
msgstr "Co nowego w WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
#, python-brace-format
msgctxt "wpp_force_reinstall_confirm_msg"
msgid "This will temporarily interrupt WPPConnect and download and reinstall the latest version (v{version}), even if it is already installed. Continue?"
msgstr "Spowoduje to tymczasowe przerwanie działania WPPConnect oraz pobranie i ponowną instalację najnowszej wersji (v{version}), nawet jeśli jest już zainstalowana. Kontynuować?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_force_reinstall_confirm_title"
msgid "Force reinstall WPPConnect"
msgstr "Wymuś ponowną instalację WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/settings_dialog.py
msgctxt "wpp_port_label"
msgid "API port (WPPConnect):"
msgstr "Port API (WPPConnect):"

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "wpp_reinstall_notice_message"
msgid "Your current WPPConnect installation may be missing the latest features, such as voice and video calls. Do you want to reinstall WPPConnect now? If you change your mind, you can always access this option from the Help menu (alt+h)."
msgstr "Twoja obecna instalacja WPPConnect może nie mieć wszystkich najnowszych funkcji, takich jak połączenia głosowe i wideo. Czy chcesz teraz ponownie zainstalować WPPConnect? Jeśli zmienisz zdanie, zawsze możesz uzyskać dostęp do tej opcji w menu pomocy (alt+c)."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "wpp_reinstall_notice_title"
msgid "WPPConnect update recommended"
msgstr "Zalecana aktualizacja WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
#, python-brace-format
msgctxt "wpp_update_available_msg"
msgid "A recommended update for WPPConnect Server is available (current: {current}, new: {new}). It is not mandatory. Update now? WinZapp will stop the API, install the new version, and restart it automatically."
msgstr "Dostępna jest zalecana aktualizacja WPPConnect Server (obecna wersja: {current}, nowa: {new}). Aktualizacja nie jest obowiązkowa. Zaktualizować teraz? WinZapp zatrzyma API, zainstaluje nową wersję i automatycznie uruchomi je ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_update_available_title"
msgid "WPPConnect update available"
msgstr "Dostępna aktualizacja WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/wpp_background_update.py
#, python-brace-format
msgctxt "wpp_update_background_ready_msg"
msgid "WPPConnect update {version} has been downloaded. WinZapp will go offline for a moment to install it and restart WPPConnect."
msgstr "Aktualizacja WPPConnect {version} została pobrana. WinZapp przejdzie na chwilę w tryb offline, aby ją zainstalować i ponownie uruchomić WPPConnect."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_background_running"
msgid "A WPPConnect update is already downloading in the background. You will be told when it is ready to install."
msgstr "Aktualizacja WPPConnect jest już pobierana w tle. Otrzymasz powiadomienie, gdy będzie gotowa do instalacji."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/wpp_background_update.py
msgctxt "wpp_update_background_started"
msgid "Downloading the WPPConnect update in the background. You will be told when it is ready to install."
msgstr "Pobieranie aktualizacji WPPConnect w tle. Otrzymasz powiadomienie, gdy będzie gotowa do instalacji."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_complete"
msgid "WPPConnect updated and restarted successfully."
msgstr "WPPConnect zaktualizowany i uruchomiony ponownie pomyślnie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py client/main_window/wpp_background_update.py
msgctxt "wpp_update_failed_msg"
msgid "Could not update WPPConnect. The previous installation will be kept, if possible."
msgstr "Nie udało się zaktualizować WPPConnect. Jeśli to możliwe, poprzednia instalacja zostanie zachowana."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_update_fetch_failed_msg"
msgid "Could not check the latest WPPConnect version. Check your internet connection and try again."
msgstr "Nie udało się sprawdzić najnowszej wersji WPPConnect. Sprawdź połączenie z internetem i spróbuj ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_in_progress"
msgid "Updating WPPConnect. Please wait."
msgstr "Aktualizowanie WPPConnect. Proszę czekać."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_not_enough_space"
msgid "There is not enough free space to prepare the update and keep the previous WPPConnect version. Free up disk space and try again. The current installation was preserved."
msgstr "Brak wystarczającej ilości wolnego miejsca, aby przygotować aktualizację i zachować poprzednią wersję WPPConnect. Zwolnij miejsce na dysku i spróbuj ponownie. Bieżąca instalacja została zachowana."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_other_account_msg"
msgid "Another WinZapp account is still using the WPPConnect Server. Close the other accounts and try again."
msgstr "Inne konto WinZapp nadal korzysta z WPPConnect Server. Zamknij pozostałe konta i spróbuj ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/wpp_server.py
msgctxt "wpp_version_unpinned_warning"
msgid "Warning: could not pin the WhatsApp Web version. Sending to individual contacts may fail silently; groups still work. Please update WinZapp's WhatsApp Web."
msgstr "Ostrzeżenie: nie udało się przypiąć wersji WhatsApp Web. Wysyłanie do pojedynczych kontaktów może po cichu zawodzić; grupy nadal działają. Zaktualizuj WhatsApp Web w WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/conversation_panel/archived_panel.py client/ui/conversation_panel/chat_list_selection.py client/ui/conversation_panel/chat_menu.py
msgctxt "yes_button"
msgid "&Yes"
msgstr "&Tak"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/conversation_panel/formatting.py
