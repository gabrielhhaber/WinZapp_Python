msgctxt "ai_kind_audio"
msgid "voice messages"
msgstr "wiadomości głosowe"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_kind_image"
msgid "photos"
msgstr "zdjęcia"

#: translations/en-US/LC_MESSAGES/winzapp.po
