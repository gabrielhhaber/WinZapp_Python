msgid "videos"
msgstr "wideo"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_locked_consent"
msgid ""
"This media is from a locked chat. Sending it outside WhatsApp needs fresh "
"consent each time this window is opened. Locking the vault closes this "
"window and discards local results."
msgstr ""
"Ten plik pochodzi z zabezpieczonego czatu. Wysłanie go poza WhatsApp wymaga "
"ponownej zgody przy każdym otwarciu tego okna. Zamknięcie sejfu zamknie to "
"okno i usunie lokalne wyniki."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_metadata_notice"
msgid ""
"Voice messages and PDFs are sent exactly as they are, including any "
"information stored inside the file, such as author or location."
msgstr ""
"Wiadomości głosowe i pliki PDF są wysyłane w niezmienionej postaci, razem z "
"informacjami zapisanymi w pliku, takimi jak autor czy lokalizacja."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_model"
msgid "Model &identifier (advanced)"
msgstr "&Identyfikator modelu (dla zaawansowanych)"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_model_automatic"
