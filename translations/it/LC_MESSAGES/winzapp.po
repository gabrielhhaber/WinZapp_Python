msgctxt "star_sync_confirm"
msgid ""
"{chat}: Star {count} old locally starred messages from this chat in "
"WhatsApp? This only adds stars; it does not remove any. Messages unavailable"
" to the linked device may not be synchronized."
msgstr ""
"{chat}: vuoi contrassegnare con una stella {count} vecchi messaggi di questa"
