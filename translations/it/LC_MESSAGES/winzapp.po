msgstr "Ctrl+Alt+Shift+A: archivia le chat selezionate"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_clear_chats_label"
msgid "Ctrl+Alt+Shift+L: clear the selected chats"
msgstr "Ctrl+Alt+Shift+L: cancella le chat selezionate"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_copy_label"
msgid "Ctrl+Alt+Shift+C: copy the selected messages"
msgstr "Ctrl+Alt+Shift+C: copia i messaggi selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_chats_label"
msgid "Ctrl+Shift+Delete: delete the selected chats"
msgstr "Ctrl+Shift+Delete: elimina le chat selezionate"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_delete_label"
msgid "Ctrl+Shift+Delete: delete the selected messages"
msgstr "Ctrl+Shift+Delete: elimina i messaggi selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_delete_transcriptions_label"
msgid ""
"Ctrl+Alt+Shift+Delete: delete the saved local transcriptions of the selected"
" messages"
msgstr ""
"Ctrl+Alt+Shift+Delete: elimina le trascrizioni locali salvate dei messaggi "
"selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_forward_label"
msgid "Ctrl+Alt+Shift+E: forward the selected messages"
msgstr "Ctrl+Alt+Shift+E: inoltra i messaggi selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_override_note"
msgid ""
"With \"Replace shortcuts with bulk actions when selecting chats and "
"messages\" enabled (Settings > User Interface), shortcuts like forward, "
"save, clear and delete act on the whole selection whenever one exists."
msgstr ""
"Con l'opzione \"Sostituisci le scorciatoie con azioni in blocco quando si "
"selezionano chat e messaggi\" abilitata (Impostazioni > Interfaccia utente),"
" le scorciatoie come \"Inoltra\", \"Salva\", \"Cancella\" ed \"Elimina\" "
"agiscono sull'intera selezione, se presente."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_pin_label"
msgid "Ctrl+Alt+Shift+X: pin the selected messages"
msgstr "Ctrl+Alt+Shift+X: blocca i messaggi selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_read_chats_label"
msgid "Ctrl+Alt+Shift+R: mark the selected chats as read"
msgstr "Ctrl+Alt+Shift+R: contrassegna le chat selezionate come lette"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_save_label"
msgid "Ctrl+Alt+Shift+S: save the selected messages"
msgstr "Ctrl+Alt+Shift+S: salva i messaggi selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_star_label"
msgid "Ctrl+Alt+Shift+F: star the selected messages"
msgstr "Ctrl+Alt+Shift+F: contrassegna con una stella i messaggi selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_transcribe_inline_label"
msgid ""
"Ctrl+Alt+Shift+N: transcribe the selected messages locally with Whisper into"
" their lines"
msgstr ""
"Ctrl+Alt+Shift+N: trascrivi localmente i messaggi selezionati con Whisper "
"nelle rispettive righe"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_bulk_transcribe_label"
msgid ""
"Ctrl+Alt+Shift+T: transcribe the selected messages locally with Whisper and "
"show them together"
msgstr ""
"Ctrl+Alt+Shift+T: trascrivi localmente i messaggi selezionati con Whisper e "
"visualizzali insieme"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_bulk_unread_chats_label"
msgid "Ctrl+Alt+Shift+U: mark the selected chats as unread"
msgstr "Ctrl+Alt+Shift+U: contrassegna le chat selezionate come non lette"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_c_label"
msgid "Ctrl+C: call settings"
msgstr "Ctrl+C: impostazioni chiamata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_m_label"
msgid "Ctrl+M: mute or unmute the microphone"
msgstr "Ctrl+M: attiva o disattiva il microfono"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_p_label"
msgid "Ctrl+P: switch a voice call to a video call"
msgstr "Ctrl+P: passa da una chiamata vocale a una videochiamata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_shift_p_label"
msgid "Ctrl+Shift+P: show the call participants"
msgstr "Ctrl+Shift+P: mostra i partecipanti della chiamata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_shift_q_label"
msgid "Ctrl+Shift+Q: end the call"
msgstr "Ctrl+Shift+Q: termina la chiamata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_call_ctrl_v_label"
msgid "Ctrl+V: turn video on or off in a video call"
msgstr "Ctrl+V: attiva o disattiva il video in una videochiamata"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_call_participants_f5_label"
msgid "F5: read the participants again"
msgstr "F5: rileggi i partecipanti"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_alt_l_label"
msgid "Alt+L: go to the calls list"
msgstr "Alt+L: vai all'elenco delle chiamate"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_shift_r_label"
msgid "Ctrl+Shift+R: call back a missed call"
msgstr ""
"Ctrl+Shift+R: richiamare un numero da cui si è ricevuta una chiamata persa"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_ctrl_tab_label"
msgid ""
"Ctrl+Tab and Ctrl+Shift+Tab: switch between the all, missed, declined and "
"answered tabs"
msgstr ""
"Ctrl+Tab e Ctrl+Shift+Tab: passare dalle schede Tutte, Perse, Rifiutate e "
"Risposte"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_enter_label"
msgid "Enter: open the call's chat"
msgstr "Invio: apri la chat della chiamata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_calls_f5_label"
msgid "F5: refresh the calls list"
msgstr "F5: aggiorna l'elenco delle chiamate"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_hint"
msgid ""
"Tab and Shift+Tab move focus. Press Enter or Escape in this field to capture"
" those keys. Tab to OK to confirm, or Cancel to discard."
msgstr ""
"Tab e Shift+Tab spostano il focus. Premi Invio o Esc in questo campo per "
"acquisire quei tasti. Premi Tab per selezionare OK e confermare oppure "
"Annulla per scartare."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_modifier_required"
msgid "Use Control or Alt with a letter or digit."
msgstr "Usa Control o Alt con una lettera o un numero."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcut_capture.py
msgctxt "shortcut_capture_prompt"
msgid "Press the new key combination"
msgstr "Premi la nuova combinazione di tasti"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_reserved"
msgid "This key combination is reserved by the operating system."
msgstr "Questa combinazione di tasti è riservata dal sistema operativo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "shortcut_capture_wait"
