"be undone."
msgstr ""
"Vuoi eliminare tutte le trascrizioni salvate di ogni modello, in tutte le "
"chat? Questa operazione non può essere annullata."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_clear_all_cache_none"
