msgid "Verif&y"
msgstr "&Verifica"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/message_menu.py
msgctxt "transcription_delete"
msgid "Delete transcription"
msgstr "Elimina trascrizione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_delete_failed"
msgid "The transcription could not be deleted."
msgstr "Impossibile eliminare la trascrizione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_delete_question"
msgid ""
"Delete this message's transcription? The message and its audio stay in the "
"conversation."
msgstr ""
"Vuoi eliminare la trascrizione di questo messaggio? Il messaggio e il "
"relativo audio rimangono nella conversazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_deleted"
msgid "Transcription deleted."
msgstr "Trascrizione eliminata."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cpu_requested"
msgid "The transcription will run on the processor."
msgstr "La trascrizione verrà eseguita sul processore."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_build_missing"
msgid ""
"The whisper.cpp version for graphics cards is not installed. The "
"transcription will run on the processor. You can install it in the "
"transcription settings."
msgstr ""
"La versione di whisper.cpp per le schede grafiche non è installata. La "
"trascrizione verrà eseguita sul processore. Puoi installarla nelle "
"impostazioni di trascrizione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_build_unsupported"
msgid ""
"The whisper.cpp version for graphics cards does not support this graphics "
"card, or the card could not be identified. The transcription will run on the"
" processor."
msgstr ""
"La versione di whisper.cpp per le schede grafiche non supporta questa scheda"
" grafica oppure la scheda non è stata riconosciuta. La trascrizione verrà "
"eseguita sul processore."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_driver_error"
msgid ""
"The graphics card could not be queried. The transcription will run on the "
"processor."
msgstr ""
"Impossibile eseguire una query sulla scheda grafica. La trascrizione verrà "
"eseguita sul processore."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_libraries_missing"
msgid ""
"The CUDA libraries are not installed. The transcription will run on the "
"processor. You can download them in the transcription settings."
msgstr ""
"Le librerie CUDA non sono installate. La trascrizione verrà eseguita sul "
"processore. Puoi scaricarle nelle impostazioni di trascrizione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_selected"
msgid "The transcription will run on the graphics card."
msgstr "La trascrizione verrà eseguita sulla scheda grafica."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_cuda_unavailable"
msgid "CUDA is not available. The transcription will run on the processor."
msgstr ""
"CUDA non è disponibile. La trascrizione verrà eseguita sul processore."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_device_label"
msgid "W&here to run the transcription"
msgstr "&Dove eseguire la trascrizione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_no_cuda_found"
msgid ""
"No compatible graphics card was found. The transcription will run on the "
"processor."
msgstr ""
"Non è stata trovata alcuna scheda grafica compatibile. La trascrizione verrà"
" eseguita sul processore."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_preference_cpu"
msgid "Processor"
msgstr "Elaboratore"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_device_preference_cuda"
msgid "Graphics card"
msgstr "Scheda grafica"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_discarded_withdrawn"
msgid ""
"The message was deleted for everyone while it was being transcribed, so the "
"transcription was discarded."
msgstr ""
"Il messaggio è stato eliminato per tutti durante la trascrizione, quindi la "
"trascrizione è stata scartata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/noise_model_section.py
#: client/ui/dialogs/noise_reducer_dialog.py
#: client/ui/dialogs/transcription_queue.py
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_download_confirm_title"
msgid "Confirm download"
msgstr "Conferma download"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_audio_incomplete"
msgid "The audio file is incomplete or damaged."
msgstr "Il file audio è incompleto o danneggiato."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_error"
msgid "An internal error occurred during the transcription."
msgstr "Si è verificato un errore interno durante la trascrizione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_backend_missing"
msgid "The transcription component is not installed in this copy of WinZapp."
msgstr ""
"Il componente di trascrizione non è installato in questa copia di WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cancelled"
msgid "Transcription cancelled."
msgstr "Trascrizione annullata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/noise_reducer_dialog.py
msgctxt "transcription_error_cuda_runtime_busy"
msgid ""
"Another WinZapp window is using the CUDA libraries folder. Wait for it to "
"finish and try again."
msgstr ""
"Un'altra finestra di WinZapp sta utilizzando la cartella delle librerie "
"CUDA. Attendi il completamento dell'operazione e riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_corrupted"
msgid "The CUDA library files are incomplete or damaged. Install them again."
msgstr ""
"I file della libreria CUDA sono incompleti o danneggiati. Installali di "
"nuovo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_download_failed"
msgid ""
"The CUDA libraries could not be downloaded. Check your connection and try "
"again."
msgstr ""
"Impossibile scaricare le librerie CUDA. Controlla la connessione e riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_runtime_in_use"
msgid ""
"The CUDA libraries are in use by this session. Close and reopen WinZapp, "
"then try again."
msgstr ""
"Le librerie CUDA sono utilizzate da questa sessione. Chiudi e riapri "
"WinZapp, quindi riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_cuda_unavailable"
msgid ""
"CUDA is not available. Switch the device to the processor in the settings "
"and try again."
msgstr ""
"CUDA non è disponibile. Passa dal dispositivo al processore nelle "
"impostazioni e riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed"
msgid ""
"The files in the chosen model's folder have changed since it was verified. "
"Verify the model again in the Local Transcription tab in the settings, or "
"choose another model."
msgstr ""
"I file nella cartella del modello scelto sono stati modificati dopo la "
"verifica. Verifica nuovamente il modello nella scheda Trascrizione locale "
"nelle impostazioni oppure scegli un altro modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_changed_file"
msgid ""
"The chosen model's file has changed since it was verified. Verify the model "
"again in the Local Transcription tab in the settings, or choose another "
"model."
msgstr ""
"Il file del modello scelto è cambiato da quando è stato verificato. Verifica"
" nuovamente il modello nella scheda Trascrizione locale nelle impostazioni "
"oppure scegli un altro modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_missing"
msgid ""
"The folder of the chosen model was not found. If it is on an external drive,"
" connect the drive; if it was deleted, choose another model."
msgstr ""
"La cartella del modello scelto non è stata trovata. Se si trova su un'unità "
"esterna, collegare l'unità; se è stata eliminata, scegliere un altro "
"modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_external_model_missing_file"
msgid ""
"The file of the chosen model was not found. If it is on an external drive, "
"connect the drive; if it was deleted, choose another model."
msgstr ""
"Il file del modello scelto non è stato trovato. Se si trova su un'unità "
"esterna, collegare l'unità; se è stato eliminato, scegliere un altro "
"modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_ffmpeg_failed"
msgid "The audio could not be converted for transcription."
msgstr "Impossibile convertire l'audio per la trascrizione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_insufficient_ram"
msgid ""
"The computer does not have enough memory for this model. Choose a smaller "
"model."
msgstr ""
"Il computer non dispone di memoria sufficiente per questo modello. Scegli un"
" modello più piccolo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_insufficient_vram"
msgid ""
"The graphics card does not have enough memory for this model. Choose a "
"smaller model."
msgstr ""
"La scheda grafica non dispone di memoria sufficiente per questo modello. "
"Scegli un modello più piccolo."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_media_not_downloaded"
msgid ""
"The audio has not been downloaded yet. Wait for the download to finish and "
"try again."
msgstr ""
"L'audio non è ancora stato scaricato. Attendi il completamento del download "
"e riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_corrupted"
msgid "The model files are incomplete or corrupted. Download the model again."
msgstr ""
"I file del modello sono incompleti o danneggiati. Scarica nuovamente il "
"modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_error_model_download_failed"
msgid ""
"The transcription model could not be downloaded. Check your connection and "
"try again."
msgstr ""
