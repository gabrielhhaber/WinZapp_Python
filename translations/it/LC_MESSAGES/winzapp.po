msgctxt "ai_key_readable"
msgid "&Readable API key"
msgstr "Chiave API &di sola lettura"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_notice"
msgid ""
"The saved key is marked for removal from WinZapp. Save with Apply or OK, or "
"discard with Cancel. The API key in your provider account will not be "
"revoked."
msgstr ""
"La chiave salvata è contrassegnata per la rimozione da WinZapp. Salva con "
"Applica o OK, oppure scarta con Annulla. La chiave API nel tuo account "
"provider non verrà revocata."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_removal_pending"
msgid "Key marked for removal."
msgstr "Chiave contrassegnata per la rimozione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_key_saved"
msgid "Key saved"
msgstr "Nessuna chiave salvata"

