msgctxt "mac_update_available_reminder"
msgid ""
"A new version of WinZapp is available (v{new_version}). To install it, "
"choose Help > Check for updates, or switch to WinZapp."
msgstr ""
"È disponibile una nuova versione di WinZapp (v{new_version}). Per "
"installarla, scegli Guida > Verifica disponibilità aggiornamenti oppure "
"passa a WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_downloaded_reminder"
msgid ""
"WinZapp update v{new_version} has been downloaded and will be installed when"
" you quit WinZapp. To install it now, choose Help > Check for updates, or "
"switch to WinZapp."
msgstr ""
"L'aggiornamento di WinZapp v{new_version} è stato scaricato e verrà "
"installato quando uscirai da WinZapp. Per installarlo subito, scegli Guida >"
" Verifica disponibilità aggiornamenti oppure passa a WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_ready_to_install"
msgid ""
"WinZapp update v{new_version} has been downloaded and is ready to install. "
"Choose Install and Relaunch in the Software Update window."
msgstr ""
"L'aggiornamento di WinZapp v{new_version} è stato scaricato ed è pronto per "
"l'installazione. Scegli Installa e riavvia nella finestra Aggiornamento "
"software."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_reopened_other_accounts"
msgid ""
"The update was not installed. The other WinZapp accounts that were closed "
"for it have been opened again."
msgstr ""
"L'aggiornamento non è stato installato. Gli altri account WinZapp che erano "
"stati chiusi per questo motivo sono stati riaperti."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_access_denied"
msgid "GitHub refused access to the verification request."
msgstr "GitHub ha negato l'accesso alla richiesta di verifica."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_connection"
msgid "The connection to GitHub failed. Check your internet connection."
msgstr ""
"La connessione a GitHub non è riuscita. Verifica la tua connessione a "
"Internet."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_dns"
msgid ""
"GitHub's address could not be resolved. Check your internet connection."
msgstr ""
"Impossibile risolvere l'indirizzo di Github. Controlla la connessione "
"internet."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_file"
msgid ""
"Could not retrieve the update verification file.\n"
"{reason}"
msgstr ""
"Impossibile recuperare il file di verifica dell'aggiornamento.\n"
"{reason}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_http_error"
msgid "GitHub returned an unexpected response."
msgstr "GitHub ha restituito una risposta inattesa."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_not_found"
msgid "The verification resource was not found on GitHub."
msgstr "La risorsa di verifica non è stata trovata su GitHub."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_rate_limited"
msgid "GitHub's request limit was reached."
msgstr "È stato raggiunto il limite di richieste di GitHub."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_server"
msgid "GitHub reported a temporary server error. Try again later."
msgstr ""
"GitHub ha segnalato un errore temporaneo del server. Riprova più tardi."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "mac_update_verify_tag"
msgid ""
"Could not verify the official release tag.\n"
"{reason}"
msgstr ""
"Non posso verificare il tag della release ufficiale.\n"
"{reason}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_timeout"
msgid "The verification request timed out. Try again later."
msgstr "La richiesta di verifica è scaduta. Riprova più tardi."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_tls"
msgid ""
"The secure connection could not be verified. Check the date, time and "
"network certificate settings."
msgstr ""
"Impossibile verificare la connessione sicura. Controllare la data, l'ora e "
"le impostazioni del certificato di rete."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_update_verify_unexpected"
msgid "The verification request failed unexpectedly. Try again later."
msgstr ""
"La richiesta di verifica non è andata a buon fine in modo imprevisto. "
"Riprova più tardi."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
