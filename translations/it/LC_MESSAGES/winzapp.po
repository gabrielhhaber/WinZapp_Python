msgctxt "shortcut_alt_shift_j_label"
msgid "Alt+Shift+J: jump to the next message that mentions you"
msgstr "Alt+Shift+J: passa al messaggio successivo in cui vieni menzionato"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_k_label"
msgid "Alt+Shift+K: announce the focused message's date and time"
msgstr ""
"Alt+Shift+K: annuncia la data e l'ora del messaggio su cui è attivo il focus"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_l_label"
msgid "Alt+Shift+L: announce the focused message's status"
msgstr "Alt+Shift+L: annuncia lo stato del messaggio su cui è attivo il fuoco"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_m_label"
msgid "Alt+Shift+M: jump to the previous message that mentions you"
msgstr "Alt+Shift+M: vai al messaggio precedente in cui sei menzionato"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_n_label"
msgid ""
"Alt+Shift+N: on a voice message or video, do what Enter and Space do not: "
"transcribe it locally with Whisper into its line in the list, or play, pause"
" or open it when Enter and Space are set to transcribe (Settings > User "
"Interface)"
msgstr ""
"Alt+Shift+N: su un messaggio vocale o un video, esegui ciò che Invio e "
"Spazio non fanno: trascrivilo localmente con Whisper nella sua riga "
"nell'elenco oppure riproducilo, mettilo in pausa o aprilo quando Invio e "
"Spazio sono impostati per la trascrizione (Impostazioni > Interfaccia "
"utente)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_num_label"
msgid ""
"Alt+Shift+0 to Alt+Shift+9: temporarily bookmark the focused message, or "
"jump to an existing temporary bookmark (cleared when you leave the chat)"
msgstr ""
"Da Alt+Shift+0 a Alt+Shift+9: aggiungi temporaneamente un segnalibro al "
"messaggio attivo o vai a un segnalibro temporaneo esistente (viene rimosso "
"quando esci dalla chat)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_o_label"
msgid "Alt+Shift+O: jump to the next message that replies to you"
msgstr ""
"Alt+Shift+O: passa al messaggio successivo che contiene una risposta per te"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_p_label"
msgid "Alt+Shift+P: jump to the previous message that replies to you"
msgstr "Alt+Shift+P: vai al messaggio precedente che ti risponde"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_q_label"
msgid "Alt+Shift+Q: go to quoted message"
msgstr "Alt+Shift+Q: vai al messaggio citato"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_r_label"
msgid "Alt+Shift+R: reply privately (groups)"
msgstr "Alt+Shift+R:Rispondi al messaggio privatamente"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_alt_shift_s_label"
