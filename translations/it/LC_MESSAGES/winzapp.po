#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_mic_permission_denied"
msgid ""
"WinZapp does not have microphone permission. Turn it on in System Settings, "
"Privacy and Security, Microphone."
msgstr ""
"Winzapp non ha il permesso di usare il microfono. Verifica che sia collegato"
" e che WinZapp sia autorizzato a utilizzarlo in Impostazioni di sistema, "
"alla voce Privacy e sicurezza, Microfono."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_mic_permission_waiting"
msgid ""
"macOS is asking for microphone permission. Recording starts once you allow "
"it, and the prompt may be waiting behind another permission prompt."
msgstr ""
"macOS sta richiedendo l'autorizzazione per il microfono. La registrazione "
"inizierà una volta concessa e la richiesta di autorizzazione potrebbe essere"
" nascosta dietro un'altra richiesta di autorizzazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_not_yet_available"
msgid "not yet available on Mac"
msgstr "non ancora disponibile su Mac"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_system_audio_permission_denied"
msgid ""
"WinZapp does not have permission to record system audio, so computer audio "
"will be silent. Turn it on in System Settings, Privacy and Security, Screen "
"and System Audio Recording."
msgstr ""
"WinZapp non ha l'autorizzazione per registrare l'audio di sistema, quindi "
"l'audio del computer sarà disattivato. Attivala in Impostazioni di sistema, "
"Privacy e sicurezza, Registrazione audio dello schermo e del sistema."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "mac_system_audio_permission_waiting"
msgid ""
"macOS is asking for permission to record system audio. Recording starts once"
" you answer, and the prompt may be waiting behind another permission prompt."
msgstr ""
"macOS sta chiedendo l'autorizzazione per registrare l'audio di sistema. La "
"registrazione inizierà non appena si risponde e la richiesta di "
"autorizzazione potrebbe essere nascosta dietro un'altra richiesta di "
"autorizzazione."

