msgstr "Cancella le trascrizioni salvate di &questo modello"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_cache.py
#, python-brace-format
msgctxt "transcription_clear_cache_confirm"
msgid ""
"Delete every saved transcription made by the {model} model, in all chats? "
"Transcriptions made by other models are kept, and this cannot be undone."
msgstr ""
"Vuoi eliminare tutte le trascrizioni salvate create dal modello {model} in "
"tutte le chat? Le trascrizioni effettuate da altri modelli vengono "
"conservate e questa operazione non può essere annullata."

