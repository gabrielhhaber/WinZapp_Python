#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_owner_note"
msgid ""
"Models, runtimes, backups, logs, databases and login data stay protected "
"here. Use their existing settings to manage them. Unknown files are not "
"declared unnecessary. Only verified cache files and matched received-media "
"copies can enter a preview."
msgstr ""
"Modelli, runtime, backup, log, database e dati di accesso restano protetti "
"qui. Usa le loro impostazioni per gestirli. I file sconosciuti non vengono "
"dichiarati inutili. Nell'anteprima possono entrare solo i file della cache "
"verificati e le copie dei media ricevuti associate."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_pause_day"
msgid "Pause scheduled evaluations for one day"
msgstr "Sospendi le valutazioni pianificate per un giorno"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_options.py
msgctxt "storage_pause_downloads"
msgid "Pause new automatic media downloads"
msgstr "Sospendi i nuovi download automatici dei media"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_pause_hour"
msgid "Pause scheduled evaluations for one hour"
msgstr "Sospendi le valutazioni pianificate per un'ora"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager.py client/ui/dialogs/storage_rules.py
msgctxt "storage_preferences_invalid"
msgid ""
"Check the numeric fields and preference file. Unsupported or unreadable "
"protection settings block file actions. Explicit Reset can restore this "
"account's defaults."
msgstr ""
"Controlla i campi numerici e il file delle preferenze. Le impostazioni di "
"protezione non supportate o illeggibili bloccano le azioni sui file. Un "
"Ripristino esplicito può ripristinare i valori predefiniti di questo "
"account."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_preferences_limit"
msgid ""
"The preference size limit was reached. Previous readable settings were kept."
" Select fewer protection entries or use smaller batches, then retry."
msgstr ""
"È stato raggiunto il limite di dimensione delle preferenze. Le impostazioni "
"leggibili precedenti sono state mantenute. Seleziona meno protezioni o usa "
"lotti più piccoli, poi riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
#: client/ui/dialogs/storage_manager_auxiliary.py
msgctxt "storage_preferences_saved"
msgid "Storage preferences saved. No file operation was started."
msgstr ""
"Preferenze di archiviazione salvate. Nessuna operazione sui file è stata "
"avviata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_preview"
msgid "Preview selection"
msgstr "Anteprima della selezione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_preview_limit"
msgid ""
"Select at most 500 eligible files per preview, or fewer if their paths are "
"unusually long. No part of this selection was applied."
msgstr ""
"Seleziona al massimo 500 file idonei per anteprima, o meno se i loro "
"percorsi sono insolitamente lunghi. Nessuna parte di questa selezione è "
"stata applicata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
#, python-brace-format
msgctxt "storage_preview_summary"
msgid ""
"Selected: {selected}; eligible: {count}; logical size: {size}. Method: "
"{method}. Protected and in-use files are excluded. Holding does not free "
"disk space."
msgstr ""
"Selezionati: {selected}; idonei: {count}; dimensione logica: {size}. Metodo:"
" {method}. I file protetti e in uso sono esclusi. Trattenere non libera "
"spazio su disco."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_previous_page"
msgid "Previous page"
msgstr "Pagina precedente"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_matching.py
#: client/ui/dialogs/storage_presentation.py
#: client/ui/dialogs/storage_protections.py
#, python-brace-format
msgctxt "storage_private_item"
msgid "Local item {number}"
msgstr "Elemento locale {number}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect"
msgid "Protect selected files"
msgstr "Proteggi i file selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_category"
msgid "Protect this category"
msgstr "Proteggi questa categoria"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_chats"
msgid "Protect selected conversations"
msgstr "Proteggi le conversazioni selezionate"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_scope"
msgid "Protection scope"
msgstr "Ambito della protezione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_scope_account"
msgid "This account"
msgstr "Questo account"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protect_scope_shared"
msgid "Shared components, across accounts"
msgstr "Componenti condivisi, tra tutti gli account"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_protections.py
#, python-brace-format
msgctxt "storage_protection_count"
msgid "Saved protections: {count}."
msgstr "Protezioni salvate: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protection_note"
msgid ""
"Protection wins over manual selection and rules. Shared protection applies "
"across this installation's accounts. Removing protection grants no new "
"selection. Missing or currently unnamed items keep a private numbered label."
msgstr ""
"La protezione prevale sulla selezione manuale e sulle regole. La protezione "
"condivisa vale per tutti gli account di questa installazione. Rimuovere una "
"protezione non seleziona nulla di nuovo. Gli elementi mancanti o senza nome "
"al momento conservano un'etichetta numerata privata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_protections.py
#, python-brace-format
msgctxt "storage_protection_row"
msgid "{scope}: {name}"
msgstr "{scope}: {name}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_protection_saved"
msgid "Protection choices saved. Previous preview cleared."
msgstr ""
"Scelte di protezione salvate. L'anteprima precedente è stata cancellata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_protections_tab"
msgid "Protections"
msgstr "Protezioni"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_purge_held"
msgid "Permanently remove selected held files"
msgstr "Rimuovi definitivamente i file trattenuti selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_purge_held_confirm"
msgid ""
"Permanently remove {count} held files ({size})? This cannot be undone here; "
"WhatsApp may no longer have the media."
msgstr ""
"Rimuovere definitivamente {count} file trattenuti ({size})? Non può essere "
"annullato da qui; WhatsApp potrebbe non avere più il contenuto multimediale."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_purge_matching_required"
msgid ""
"To permanently remove held media, enable media matching and select "
"conversations in Preferences, save, then retry. Only currently visible, "
"unlocked and completely matched media without a protection can be removed."
msgstr ""
"Per rimuovere definitivamente i media trattenuti, attiva l'associazione dei "
"media e seleziona le conversazioni nelle Preferenze, salva e riprova. "
"Possono essere rimossi solo i media attualmente visibili, sbloccati, "
"associati completamente e senza protezione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_critical"
msgid "Required component or critical data; managed by its owner"
msgstr "Componente necessario o dato critico; gestito dal suo proprietario"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_external"
msgid "Information only; outside this manager's file-action scope"
msgstr ""
"Solo informativo; fuori dall'ambito delle azioni sui file di questa gestione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_important"
msgid "Sent, pending, failed or starred content; protected"
msgstr "Contenuto inviato, in sospeso, non riuscito o con stella; protetto"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_in_use"
msgid "In use or current ownership is uncertain; protected"
msgstr "In uso o proprietà attuale incerta; protetto"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_local_copy"
msgid "Received-media local copy; may be impossible to download again"
msgstr ""
"Copia locale di un media ricevuto; potrebbe non essere più possibile "
"scaricarlo di nuovo"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_protected"
msgid "Unknown or unsupported file; protected"
msgstr "File sconosciuto o non supportato; protetto"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_reproducible"
msgid "Verified compile-cache layout; regenerable"
msgstr "Struttura della cache di compilazione verificata; rigenerabile"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_unmatched"
msgid "Local history not matched completely; protected"
msgstr "Cronologia locale non associata completamente; protetto"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reason_user_protected"
msgid "Protected by your keep-list"
msgstr "Protetto dal tuo elenco di elementi da conservare"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_refresh_held"
msgid "Refresh held files"
msgstr "Aggiorna i file trattenuti"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_refresh_history"
msgid "Refresh summary history"
msgstr "Aggiorna la cronologia dei riepiloghi"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_refresh_protections"
msgid "Refresh protections"
msgstr "Aggiorna le protezioni"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_remove_protection"
msgid "Remove selected protections"
msgstr "Rimuovi le protezioni selezionate"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_remove_protection_confirm"
msgid ""
"Remove {count} selected protections? Files are not selected or removed by "
"this action."
msgstr ""
"Rimuovere {count} protezioni selezionate? Questa azione non seleziona né "
"rimuove file."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_remove_rule"
msgid "Remove rule draft"
msgstr "Rimuovi la bozza della regola"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reset_confirm"
msgid ""
"Reset this account's storage preferences, rules and keep-list? Shared "
"protections, held files and media download blocks stay. No files are "
"cleaned."
msgstr ""
"Ripristinare le preferenze di archiviazione, le regole e l'elenco di "
"elementi da conservare di questo account? Le protezioni condivise, i file "
"trattenuti e i blocchi dei download dei media restano. Nessun file viene "
"pulito."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reset_preferences"
msgid "Reset account storage preferences"
msgstr "Ripristina le preferenze di archiviazione dell'account"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reset_target"
msgid "Reset only the target fields"
msgstr "Ripristina solo i campi dell'obiettivo"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_restore_held"
msgid "Restore selected held files"
msgstr "Ripristina i file trattenuti selezionati"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_restore_held_confirm"
msgid ""
"Restore {count} held files ({size}) to their original local locations? "
"Existing files will not be overwritten."
msgstr ""
"Ripristinare {count} file trattenuti ({size}) nelle loro posizioni locali "
"originali? I file esistenti non verranno sovrascritti."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/media_files.py
msgctxt "storage_restore_media_confirm"
msgid ""
"Request this cleaned local copy once more from WhatsApp? It may no longer be"
" available. Other cleaned files stay blocked, and automatic downloading "
"stays blocked for this item too."
msgstr ""
"Richiedere di nuovo a WhatsApp questa copia locale pulita? Potrebbe non "
"essere più disponibile. Gli altri file puliti restano bloccati e anche il "
"download automatico resta bloccato per questo elemento."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_resume_schedule"
msgid "Resume scheduled evaluations"
msgstr "Riprendi le valutazioni pianificate"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_retire_tokens"
msgid "Remove expired completed-operation records"
msgstr "Rimuovi i record delle operazioni completate scaduti"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_retire_tokens_confirm"
msgid ""
"Remove empty operation records older than two days? Held files and active "
"recovery records are kept. Previews expire after one day."
msgstr ""
"Rimuovere i record delle operazioni vuoti più vecchi di due giorni? I file "
"trattenuti e i record di ripristino attivi vengono conservati. Le anteprime "
"scadono dopo un giorno."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_auxiliary.py
#, python-brace-format
msgctxt "storage_retire_tokens_result"
msgid "Expired empty operation records removed: {count}."
msgstr "Record delle operazioni vuoti scaduti rimossi: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_reverse_order"
msgid "Reverse sort order"
msgstr "Inverti l'ordinamento"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_automatic"
msgid "Automatically remove verified compile cache"
msgstr "Rimuovi automaticamente la cache di compilazione verificata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rule_automatic_confirm"
msgid ""
"Enable automatic permanent removal of matching verified compile-cache files "
"during saved startup/interval evaluations? Personal media, models and "
"unknown files are excluded. Protection wins; no files are removed by saving "
"this draft."
msgstr ""
"Attivare la rimozione permanente automatica dei file della cache di "
"compilazione verificati e corrispondenti durante le valutazioni salvate "
"all'avvio o a intervalli? I media personali, i modelli e i file sconosciuti "
"sono esclusi. La protezione prevale; salvando questa bozza non viene rimosso"
" nessun file."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_rule_combine"
msgid "Condition combination"
msgstr "Combinazione delle condizioni"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_days"
msgid "Minimum age in days; 0: no age condition"
msgstr "Età minima in giorni; 0: nessuna condizione di età"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rule_editor"
msgid "Storage rule"
msgstr "Regola di archiviazione"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rule_enabled"
msgid "Enable this rule after saving preferences"
msgstr "Attiva questa regola dopo aver salvato le preferenze"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_limit"
msgid "Up to 100 rules can be saved."
msgstr "Si possono salvare fino a 100 regole."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_minimum_mib"
msgid "Minimum size in MiB; 0: no size condition"
msgstr "Dimensione minima in MiB; 0: nessuna condizione di dimensione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_mode"
msgid "Rule action"
msgstr "Azione della regola"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_notify"
msgid "Notify about matches"
msgstr "Notifica le corrispondenze"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_off"
msgid "Off"
msgstr "Disattivata"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_on"
msgid "On"
msgstr "Attivata"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
#, python-brace-format
msgctxt "storage_rule_row"
msgid "{category}; {mode}; {state}; age {days} days; minimum {size}"
msgstr "{category}; {mode}; {state}; età {days} giorni; minimo {size}"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_rule_suggest"
msgid "Suggest for manual review"
msgstr "Suggerisci per la revisione manuale"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rules_note"
msgid ""
"Age and size are conditions, not proof of uselessness. Protection wins. A "
"suggestion or notification rule wins over an automatic rule on the same "
"file. Automatic mode is available only for verified regenerable compile "
"cache."
msgstr ""
"L'età e la dimensione sono condizioni, non prova di inutilità. La protezione"
" prevale. Una regola di suggerimento o di notifica prevale su una regola "
"automatica sullo stesso file. La modalità automatica è disponibile solo per "
"la cache di compilazione rigenerabile verificata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_options.py client/ui/dialogs/storage_rules.py
msgctxt "storage_rules_save_note"
msgid ""
"These are drafts. Save preferences to apply rule and matching-scope changes."
msgstr ""
"Queste sono bozze. Salva le preferenze per applicare le modifiche alle "
"regole e all'ambito di associazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
#: client/ui/dialogs/storage_rules.py
msgctxt "storage_rules_tab"
msgid "Rules"
msgstr "Regole"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_save_preferences"
msgid "Save preferences and rule drafts"
msgstr "Salva le preferenze e le bozze delle regole"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scan"
msgid "Scan now"
msgstr "Scansiona ora"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
msgctxt "storage_scan_cancelled"
msgid "Stopped. Results cover only items measured before cancellation."
msgstr ""
"Interrotta. I risultati riguardano solo gli elementi misurati prima "
"dell'annullamento."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scan_complete"
msgid "Scan finished for the selected known locations."
msgstr "Scansione terminata per le posizioni note selezionate."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scan_partial"
msgid ""
"Scan finished with incomplete coverage. Unavailable items stay protected."
msgstr ""
"Scansione terminata con copertura incompleta. Gli elementi non disponibili "
"restano protetti."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager.py
#, python-brace-format
msgctxt "storage_scan_progress"
msgid "Files measured: {count}."
msgstr "File misurati: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_actions.py
msgctxt "storage_scanning"
msgid "Measuring storage. You can stop this job."
msgstr ""
"Misurazione dell'archiviazione in corso. Puoi interrompere questa "
"operazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scheduled_failed"
msgid ""
"The optional scheduled storage operation could not finish. Open Storage "
"manager, review held files and scan again."
msgstr ""
"L'operazione di archiviazione pianificata facoltativa non è stata "
"completata. Apri la Gestione archiviazione, controlla i file trattenuti ed "
"esegui di nuovo la scansione."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/storage_runtime.py
#, python-brace-format
msgctxt "storage_scheduled_notice"
msgid ""
"Storage evaluation: {total}. Notification-rule matches: {count}. A warning "
"or usage target may be reached. Open Storage manager for details."
msgstr ""
"Valutazione dell'archiviazione: {total}. Corrispondenze delle regole di "
"notifica: {count}. Potrebbe essere stato raggiunto un avviso o un obiettivo "
"di utilizzo. Apri la Gestione archiviazione per i dettagli."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "storage_scheduled_result"
msgid ""
"Optional cache rule: completed {completed}; skipped {skipped}; failed "
"{failed}."
msgstr ""
"Regola facoltativa della cache: completati {completed}; saltati {skipped}; "
"non riusciti {failed}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scope_all"
msgid ""
"Scope: this installation, shared components and the previously selected "
"other account folders. Other accounts are information only."
msgstr ""
"Ambito: questa installazione, i componenti condivisi e le cartelle degli "
"altri account selezionate in precedenza. Gli altri account sono solo "
"informativi."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scope_current"
msgid ""
"Scope: this installation, this account and shared components. Other account "
"folders are excluded."
msgstr ""
"Ambito: questa installazione, questo account e i componenti condivisi. Le "
"cartelle degli altri account sono escluse."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scope_external"
msgid "Known external model files"
msgstr "File dei modelli esterni noti"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scope_other_accounts"
msgid "Previously selected other account folders"
msgstr "Cartelle degli altri account selezionate in precedenza"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_scope_program"
msgid "This installation's program data"
msgstr "Dati del programma di questa installazione"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager_views.py
msgctxt "storage_search"
msgid "Search visible item names"
msgstr "Cerca nei nomi degli elementi visibili"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_select_suggested"
msgid "Select rule suggestions"
msgstr "Seleziona i suggerimenti delle regole"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_select_visible"
msgid "Select this page"
msgstr "Seleziona questa pagina"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager.py
#, python-brace-format
msgctxt "storage_selected_count"
msgid "Selected files: {count}."
msgstr "File selezionati: {count}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/storage_manager.py
#, python-brace-format
msgctxt "storage_selection_summary"
msgid ""
"Selected: {selected}; on this page: {visible}; filtered total: {total}; "
"page: {page}."
msgstr ""
"Selezionati: {selected}; in questa pagina: {visible}; totale filtrato: "
"{total}; pagina: {page}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_size"
msgid "Logical size"
msgstr "Dimensione logica"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_sort"
msgid "Sort by"
msgstr "Ordina per"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_state"
msgid "Decision"
msgstr "Decisione"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_state_all"
msgid "All decisions"
msgstr "Tutte le decisioni"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_state_eligible"
msgid "Potentially eligible; current use checked again"
msgstr "Potenzialmente idoneo; l'uso attuale viene ricontrollato"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_state_protected"
msgid "Protected or information only"
msgstr "Protetto o solo informativo"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "storage_stop"
msgid "Stop current job"
