msgstr ""
"Tratta come una chat bloccata e simula il blocco della vault dopo 15 secondi"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_locked"
msgid "The demo vault locked; the photo session was closed."
msgstr ""
"Il vault demo è stato bloccato; la sessione fotografica è stata chiusa."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_notice"
msgid ""
"Fictional chat; no WhatsApp connection or messages sent. The generated "
"picture contains WINZAPP DEMO 123, a blue rectangle, a red circle and a "
"yellow triangle. Settings and keys are separate from your installed WinZapp."
" Start with Settings, then focus the photo and press Ctrl+Shift+I. Real AI "
"answers require your own API key and may cost money; no simulated answers "
"are supplied."
msgstr ""
"Chat fittizia; nessuna connessione a WhatsApp o messaggi inviati. L'immagine"
" generata contiene WINZAPP DEMO 123, un rettangolo blu, un cerchio rosso e "
"un triangolo giallo. Le impostazioni e le chiavi sono separate dal WinZapp "
"installato. Inizia dalle Impostazioni, quindi metti a fuoco la foto e premi "
"Ctrl+Shift+I. Le risposte reali dell'IA richiedono la tua chiave API e "
"potrebbero comportare dei costi; non vengono fornite risposte simulate."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_photo"
msgid "Demo contact: Generated test picture (no personal information)"
msgstr "Contatto demo: immagine di prova generata (nessun dato personale)"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_text"
msgid "Demo contact: This is a fictional message; nothing was sent."
msgstr ""
"Contatto demo: questo è un messaggio fittizio; non è stato inviato nulla."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py
msgctxt "ai_demo_title"
msgid "WinZapp — manual photo demo (no WhatsApp)"
msgstr "WinZapp — demo fotografica manuale (senza WhatsApp)"

