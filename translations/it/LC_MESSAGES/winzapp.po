msgstr "Non è stata trovata alcuna trascrizione salvata da questo modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_confirm_cuda"
msgid "Install the CUDA libraries?"
msgstr "Installare le librerie CUDA?"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_confirm_cuda_repair"
msgid ""
"Install the CUDA libraries again? The files already in the folder are "
"deleted first."
msgstr ""
"Installare di nuovo le librerie CUDA? I file già presenti nella cartella "
"vengono eliminati per primi."

#: translations/en-US/LC_MESSAGES/winzapp.po
