#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_cancel_notice"
msgid ""
"Cancelled locally. A request already received by the provider may still be "
"charged."
msgstr ""
"Annullato localmente. Una richiesta già ricevuta dal provider potrebbe "
"comunque essere addebitata."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_chain_failed"
msgid "None of the providers could process this media:"
msgstr "Nessuno dei provider è riuscito a elaborare questo media:"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_connection_loading"
msgid "Checking the connection…"
msgstr "Verifica connessione…"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "ai_connection_ok"
msgid ""
"The provider accepted the key check. This does not verify quality, billing "
"or available quota."
msgstr ""
"Il provider ha accettato la verifica della chiave. Ciò non verifica la "
"qualità, la fatturazione o il plafond disponibile."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
#, python-brace-format
msgctxt "ai_consent"
msgid ""
"The selected media and, for photos and videos, your questions and the "
"previous answers in this window may be sent to {providers}, in that order, "
"if the earlier ones fail. This may incur API charges. Chat names and "
"captions are not sent. Provider data policies apply; the result can be "
"wrong. Do you want to continue?"
msgstr ""
"I media selezionati e, per foto e video, le tue domande e le risposte "
"precedenti in questa finestra possono essere inviati a {providers}, in "
"quest'ordine, se quelli precedenti non funzionano. Ciò potrebbe comportare "
"costi per l'API. I nomi delle chat e le didascalie non vengono inviati. Si "
"applicano le informative sui dati del provider; il risultato potrebbe essere"
" errato. Vuoi continuare?"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
msgctxt "ai_consent_title"
msgid "Send media to an AI provider?"
msgstr "Inviare media a un fornitore di IA?"

