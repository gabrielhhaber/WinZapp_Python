#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_models_dir_browse_dialog_title"
msgid "Choose the folder for the transcription models"
msgstr "Scegli la cartella per i modelli di trascrizione"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_models_dir_busy"
msgid ""
"A download is running in the background. The models folder can be moved once"
" it finishes; until then the current folder stays."
msgstr ""
"È in corso un download in background. La cartella dei modelli può essere "
"spostata una volta completato il processo; fino ad allora, la cartella "
"corrente rimane invariata."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_models_dir_kept_previous"
msgid ""
"The models folder is still the previous one. Choose the new folder again to "
"move what stayed behind."
msgstr ""
"La cartella dei modelli è ancora quella precedente. Seleziona nuovamente la "
"nuova cartella per spostare gli elementi rimasti."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_tab.py
msgctxt "transcription_models_dir_label"
msgid "&Models folder"
msgstr "&Cartella modelli"

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_models_dir_now_the_new_one"
msgid ""
"Even so, every model is in the new folder, and that is the one the setting "
"now uses."
msgstr ""
"Ciononostante, tutti i modelli si trovano nella nuova cartella, che è quella"
" attualmente utilizzata dall'impostazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/status_tab/my_status_transcription.py
#: client/status_tab/status_transcription.py
msgctxt "transcription_no_audio"
msgid "This message has no audio to transcribe."
msgstr "Questo messaggio non contiene audio da trascrivere."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/transcription_options.py
msgctxt "transcription_no_dialog_check"
msgid ""
"&Transcribe without the progress window: stay on the messages or statuses "
"until the text is ready (the same shortcut cancels)"
msgstr ""
"&Trascrivi senza la finestra di avanzamento: rimani sui messaggi o sugli "
"stati fino a quando il testo non è pronto (lo stesso tasto di scelta rapida "
"annulla l'operazione)"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/status_tab/my_status_transcription.py
#: client/status_tab/status_transcription.py
#: client/ui/conversation_panel/transcription_delete.py
msgctxt "transcription_none_to_delete"
msgid "There is no saved local transcription to delete here."
msgstr "Non ci sono trascrizioni locali salvate da eliminare qui."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_not_saved_cache_off"
msgid ""
"This transcription was not saved because the cache is off for this model."
msgstr ""
"Questa trascrizione non è stata salvata perché la cache è disattivata per "
"questo modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_not_saved_missing"
msgid ""
"This transcription was not saved, because the message is no longer in this "
"conversation."
msgstr ""
"Questa trascrizione non è stata salvata perché il messaggio non è più "
"presente in questa conversazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_not_saved_unsent"
msgid ""
"This transcription was not saved, because the message has not been sent yet."
" Once it is sent, transcribe it again to save it."
msgstr ""
"Questa trascrizione non è stata salvata perché il messaggio non è ancora "
"stato inviato. Una volta inviato, trascrivilo di nuovo per salvarlo."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_language_differs"
msgid "This message was transcribed in {language}."
msgstr "Questo messaggio è stato trascritto in {language}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_language_forced"
msgid ""
"This model only understands {language}, so the message is transcribed in "
"{language}."
msgstr ""
"Questo modello comprende solo il {language}, quindi il messaggio viene "
"trascritto in {language}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_language_overridden"
msgid ""
"This model only understands {language}, so the message is transcribed in "
"{language} and not in {chosen}, the language chosen in the settings."
msgstr ""
"Questo modello comprende solo il {language}, quindi il messaggio viene "
"trascritto in {language} e non in {chosen}, la lingua scelta nelle "
"impostazioni."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_note_low_confidence"
msgid ""
"The language of this message was not identified with certainty, so the text "
"may be wrong. You can choose the language in the transcription settings."
msgstr ""
"La lingua di questo messaggio non è stata identificata con certezza, quindi "
"il testo potrebbe essere errato. Puoi scegliere la lingua nelle impostazioni"
" di trascrizione."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_note_no_speech"
msgid ""
"No speech was found in this message, so the transcription came out empty."
msgstr ""
"Non è stato rilevato alcun parlato in questo messaggio, quindi la "
"trascrizione è risultata vuota."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_precision_replaced"
msgid ""
"The chosen calculation precision, {chosen}, cannot be used here, so {used} "
"is used instead."
msgstr ""
"La precisione di calcolo scelta, {chosen}, non può essere utilizzata qui, "
"quindi viene utilizzata {used}."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_note_precision_used"
msgid "Calculation precision: {precision}."
msgstr "Precisione del calcolo: {precision}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_note_vad_unavailable"
msgid ""
"The voice filter could not be used for this transcription, so it may not be "
"reliable."
msgstr ""
"Non è stato possibile utilizzare il filtro vocale per questa trascrizione, "
"quindi potrebbe non essere affidabile."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_notice_language_forced"
msgid ""
"The selected model only understands one language, the one named in its line "
"in the list. Transcriptions with it use that language instead of detecting "
"it."
msgstr ""
"Il modello selezionato comprende solo una lingua, quella indicata nella sua "
"riga dell'elenco. Le trascrizioni effettuate con questo modello utilizzano "
"quella lingua anziché rilevarla."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_notice_language_overridden"
msgid ""
"The selected model only understands one language, the one named in its line "
"in the list, and it is not the transcription language chosen below. "
"Transcriptions with it will use the model's language."
msgstr ""
"Il modello selezionato comprende solo una lingua, quella indicata nella sua "
"riga dell'elenco, e non è la lingua di trascrizione scelta di seguito. Le "
"trascrizioni effettuate con questo modello utilizzeranno la lingua del "
"modello."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "transcription_notice_precision_replaced"
msgid ""
"The chosen calculation precision, {chosen}, cannot be used where the "
"transcription will run, so {used} will be used instead."
msgstr ""
"La precisione di calcolo scelta, {chosen}, non può essere utilizzata nel "
"contesto in cui verrà eseguita la trascrizione, pertanto verrà utilizzata "
"{used}."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "transcription_online_auto_replaces_local"
msgid ""
"Turning this on turns off the automatic transcription with the local models "
"(Transcription tab), so a voice message is not transcribed twice. Continue?"
msgstr ""
"Attivando questa opzione, si disattiva la trascrizione automatica con i "
"modelli locali (scheda Trascrizione), in modo che un messaggio vocale non "
"venga trascritto due volte. Vuoi continuare?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/transcription_flow.py
msgctxt "transcription_open_settings_question"
msgid "Do you want to open the Local Transcription tab in the settings now?"
msgstr "Vuoi aprire la scheda Trascrizione locale nelle impostazioni ora?"

#: translations/en-US/LC_MESSAGES/winzapp.po
