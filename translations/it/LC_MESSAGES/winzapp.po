#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/group_invitation_links.py
msgctxt "whatsapp_links_enabled_message"
msgid ""
"WinZapp is now registered for WhatsApp links. When you use the join button "
"on a group invitation page, or the button that opens a chat from a wa.me or "
"WhatsApp link, Windows may ask which app to use the first time: choose "
"WinZapp. If another WhatsApp app is installed, you can also choose WinZapp "
"for the \"whatsapp\" link type in Windows Settings, under Apps, Default "
"apps."
msgstr ""
"WinZapp è ora registrato per i link di WhatsApp. Quando utilizzi il pulsante"
" \"Partecipa\" in una pagina di invito a un gruppo, o il pulsante che apre "
"una chat da un link wa.me o di WhatsApp, la prima volta Windows potrebbe "
"chiederti quale app utilizzare: scegli WinZapp. Se è installata un'altra app"
" di WhatsApp, puoi anche scegliere WinZapp per il tipo di link \"whatsapp\" "
"nelle Impostazioni di Windows, alla voce App, App predefinite."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/group_invitation_links.py
msgctxt "whatsapp_links_error_message"
msgid "Could not change the registration for WhatsApp links."
msgstr "Impossibile modificare la registrazione per i link WhatsApp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/settings_dialog.py
msgctxt "whatsapp_links_label"
msgid ""
"Let &Windows open WhatsApp links (group invitations and chats) with WinZapp"
msgstr ""
"Consenti a Windows &di aprire i link di WhatsApp (inviti ai gruppi e chat) "
"con WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
#, python-brace-format
msgctxt "wpp_force_reinstall_confirm_msg"
msgid ""
"This will temporarily interrupt WPPConnect and download and reinstall the "
"version this WinZapp supports (v{version}), even if it is already installed."
" Continue?"
msgstr ""
"Questa operazione interromperà temporaneamente WPPConnect e scaricherà e "
"reinstallerà la versione supportata da questo WinZapp (v{version}), anche se"
" è già installata. Vuoi continuare?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_force_reinstall_confirm_title"
msgid "Force reinstall WPPConnect"
msgstr "Forza la reinstallazione di WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/settings_dialog.py
msgctxt "wpp_port_label"
msgid "API &port (WPPConnect):"
msgstr "Po&rta API (WPPConnect):"

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "wpp_reinstall_notice_message"
msgid ""
"Your current WPPConnect installation may be missing the latest features, "
"such as voice and video calls. Do you want to reinstall WPPConnect now? If "
"you change your mind, you can always access this option from the Help menu "
"(alt+h)."
msgstr ""
"È possibile che la tua attuale installazione di WPPConnect non disponga "
"delle funzionalità più recenti, come le chiamate vocali e video. Vuoi "
"reinstallare WPPConnect ora? Se cambi idea, puoi sempre accedere a questa "
"opzione dal menu Guida (alt+h)."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/settings.py
msgctxt "wpp_reinstall_notice_title"
msgid "WPPConnect update recommended"
msgstr "Aggiornamento di WPPConnect consigliato"

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "wpp_update_available_msg"
msgid ""
"A recommended update for WPPConnect Server is available (current: {current},"
" new: {new}). It is not mandatory. Update now? WinZapp will stop the API, "
"install the new version, and restart it automatically."
msgstr ""
"È disponibile un aggiornamento consigliato per WPPConnect Server (attuale: "
"{current}, nuovo: {new}). Non è obbligatorio. Vuoi aggiornare ora? WinZapp "
"interromperà l'API, installerà la nuova versione e la riavvierà "
"automaticamente."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_update_available_title"
msgid "WPPConnect update available"
msgstr "Aggiornamento di WPPConnect disponibile"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py
#, python-brace-format
msgctxt "wpp_update_background_ready_msg"
msgid ""
"WPPConnect update {version} has been downloaded. WinZapp will go offline for"
" a moment to install it and restart WPPConnect."
msgstr ""
"L'aggiornamento di WPPConnect {version} è stato scaricato. WinZapp andrà "
"offline per un momento per installarlo e riavviare WPPConnect."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_background_running"
msgid ""
"A WPPConnect update is already downloading in the background. You will be "
"told when it is ready to install."
msgstr ""
"Un aggiornamento di WPPConnect è già in fase di download in background. Ti "
"verrà comunicato quando sarà pronto per l'installazione."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py
msgctxt "wpp_update_background_started"
msgid ""
"Downloading the WPPConnect update in the background. You will be told when "
"it is ready to install."
msgstr ""
"Download dell'aggiornamento di WinZapp in background. Ti verrà comunicato "
"quando sarà pronto per l'installazione."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_complete"
msgid "WPPConnect updated and restarted successfully."
msgstr "WPPConnect è stato aggiornato e riavviato correttamente."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
#: client/main_window/wpp_background_update.py
msgctxt "wpp_update_failed_msg"
msgid ""
"Could not update WPPConnect. The previous installation will be kept, if "
"possible."
msgstr ""
"Impossibile aggiornare WPPConnect. L'installazione precedente verrà "
"mantenuta, se possibile."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py
msgctxt "wpp_update_fetch_failed_msg"
msgid ""
"Could not check the latest WPPConnect version. Check your internet "
"connection and try again."
msgstr ""
"Impossibile verificare l'ultima versione di WPPConnect. Controlla la "
"connessione Internet e riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "wpp_update_health_failed"
msgid "The updated API did not pass the health and process identity checks."
msgstr ""
"L'API aggiornata non ha superato i controlli di integrità e di identità del "
"processo."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_in_progress"
msgid "Updating WPPConnect. Please wait."
msgstr "Aggiornamento di WPPConnect in corso. Attendi."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_not_enough_space"
msgid ""
"There is not enough free space to prepare the update and keep the previous "
"WPPConnect version. Free up disk space and try again. The current "
"installation was preserved."
msgstr ""
"Non c'è spazio libero sufficiente per preparare l'aggiornamento e mantenere "
"la versione precedente di WPPConnect. Libera spazio su disco e riprova. "
"L'installazione corrente è stata conservata."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py
msgctxt "wpp_update_other_account_msg"
msgid ""
"Another WinZapp account is still using the WPPConnect Server. Close the "
"other accounts and try again."
msgstr ""
"Un altro account WinZapp sta ancora utilizzando il server WPPConnect. Chiudi"
" gli altri account e riprova."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "wpp_update_restore_failed"
msgid "The previous API could not be restored or restarted."
msgstr "Non è stato possibile ripristinare o riavviare l'API precedente."

#: translations/en-US/LC_MESSAGES/winzapp.po
msgctxt "wpp_update_start_failed"
msgid "The updated API did not finish starting."
msgstr "L'avvio dell'API aggiornata non è stato completato."

#: translations/en-US/LC_MESSAGES/winzapp.po
#, python-brace-format
msgctxt "wpp_update_unvetted_msg"
msgid ""
"A new WPPConnect Server version is available (current: {current}, new: "
"{new}). The WinZapp maintainers have not checked it yet, so some features "
"may not work with it. Update now? WinZapp will stop the API, install the new"
" version, and restart it automatically."
msgstr ""
"È disponibile una nuova versione di WPPConnect Server (attuale: {current}, "
"nuova: {new}). Gli sviluppatori di WinZapp non l'hanno ancora testata, "
"quindi alcune funzionalità potrebbero non funzionare correttamente. Vuoi "
"Aggiornare ora? WinZapp interromperà l'API, installerà la nuova versione e "
"la riavvierà automaticamente."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/wpp_server.py
msgctxt "wpp_version_unpinned_warning"
msgid ""
"Warning: could not pin the WhatsApp Web version. Sending to individual "
"contacts may fail silently; groups still work. Please update WinZapp's "
"WhatsApp Web."
msgstr ""
"Attenzione: non è stato possibile fissare la versione di WhatsApp Web. "
"L'invio a singoli contatti potrebbe non riuscire senza alcun messaggio di "
"errore; i gruppi funzionano correttamente. Si prega di aggiornare WhatsApp "
"Web di WinZapp."

