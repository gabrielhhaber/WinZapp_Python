#: client/ui/dialogs/shortcuts_dialog.py
msgctxt "shortcut_ctrl_shift_h_label"
msgid "Ctrl+Shift+H: record microphone and computer audio"
msgstr "Ctrl+Shift+H: gravar microfone e áudio do computador"

