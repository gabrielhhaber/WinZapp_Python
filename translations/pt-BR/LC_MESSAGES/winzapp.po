#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/ai_result_dialog.py
#, python-brace-format
msgctxt "ai_consent"
msgid ""
"The selected media and, for photos and videos, your questions and the "
"previous answers in this window may be sent to {providers}, in that order, "
"if the earlier ones fail. This may incur API charges. Chat names and "
"captions are not sent. Provider data policies apply; the result can be "
"wrong. Do you want to continue?"
msgstr ""
"A mídia selecionada e, no caso de fotos e vídeos, suas perguntas e respostas"
" anteriores nesta janela podem ser enviadas para {providers}, nessa ordem, "
"se os anteriores falharem. Isso pode gerar custos de API. Nomes de conversas"
" e legendas não são enviados. Os termos de dados do provedor se aplicam; o "
"resultado pode estar errado. Deseja continuar?"

