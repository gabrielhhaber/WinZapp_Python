  "ai_summary_voice_model": "Online transcription model",
  "ai_summary_voice_online_consent": "{count} voice messages will be sent, exactly as they are, to {provider} to be transcribed for this summary. This may use your quota or incur charges with this provider. Provider data policies apply, and the transcription can be wrong. Do you want to continue?",
  "ai_summary_voice_over_limit": "{count} older voice messages were over the limit of {limit} per summary and appear only as voice message markers.",
  "ai_summary_voice_progress": "Transcribing voice message {index} of {total} for the summary.",
  "ai_summary_voice_provider": "Online transcription provider",
  "ai_summary_voice_running": "A summary is transcribing voice messages. Wait for it, or cancel it first.",
  "ai_technical_info": "Technical in&formation",
  "ai_technical_notice": "Keys are encrypted locally with a separate portable key; anyone with the entire data folder can still decrypt them. This feature saves no extra copies of media or answer histories: the media is decrypted in memory only for the request. Downloading the original may add it to the usual encrypted WhatsApp cache.\n\nOpenAI requests use store=false, which does not guarantee zero retention. For Gemini, unpaid and paid services have different data terms; WinZapp cannot detect billing status from your key. Do not send sensitive or personal media using unpaid Gemini services.",
  "ai_test_connection": "Test connection &without sending media",
  "ai_transcribe_audio_label": "Transcribe &voice messages",
  "ai_transcribe_audio_menu": "Transcribe with online AI",
  "ai_translate_consent": "The text will be sent to Google Translate through the same address its web page uses, without an account or API key. That address is not a published service and could stop working without notice. Google's terms apply; the translation can be wrong. Do you want to continue?",
  "ai_video_frame_notice": "Only one still picture taken from the video is sent, without its sound and with its information removed.",
