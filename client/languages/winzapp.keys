  "ai_send_media": "Send &media",
  "ai_settings_help": "&Usage and privacy information",
  "ai_settings_notice": "Transcriptions and descriptions turn voice messages into text, describe photos, stickers and videos, answer questions about them and convert PDFs into accessible text. Turn the feature on, add your API key to at least one provider and, if you like, set the order in which providers are tried. If you do not have a key, use “Get an API key” in a provider's settings.\n\nWhen you use an action, the selected media is sent to the first provider in your list that handles it; if that provider fails, the next one is tried. For photos and videos, your questions and previous answers in this window are sent too. Chat names and captions are not sent. Results are guidance; check important details.\n\nYour provider may charge for API usage. A ChatGPT or Claude subscription does not include API usage. Use the billing button to review usage and costs.\n\nYou can review each provider's data terms before sending media. Do not use personal or sensitive media with unpaid Gemini services; paid services have different terms.",
  "ai_show_key": "Show or &hide key",
  "ai_status_label": "S&tatus",
  "ai_summary_button": "Summarize unread messages",
  "ai_summary_cancelled": "Summary cancelled.",
  "ai_summary_consent": "The text of the chosen messages, with the names of the people who wrote them and, for voice messages, their transcription, and your questions and the previous answers in this window may be sent to {providers}, in that order, if the earlier ones fail. This may incur API charges. Provider data policies apply; the summary can be wrong. Do you want to continue?",
  "ai_summary_disclaimer": "Summary made by AI; it may contain errors.",
  "ai_summary_from_here_menu": "Summarize with AI from here to the end",
  "ai_summary_left_out": "Messages in this summary: {count}, the most recent ones. Older messages left out: {left_out}.",
  "ai_summary_locked_consent": "These messages are from a locked chat. Sending them outside WhatsApp needs fresh consent every time, and it is never remembered. Locking the vault closes this window and discards the summary.",
  "ai_summary_not_available": "No summary available here: there are no messages to summarize, or Online AI is not on with the key of a provider that takes text.",
  "ai_summary_nothing": "There are no text messages to summarize here.",
  "ai_summary_remember_consent": "Remember this consent &for summaries outside locked chats",
  "ai_summary_selected_menu": "Summarize selected messages with AI",
  "ai_summary_send": "Send te&xt",
  "ai_summary_unread_menu": "Summarize unread messages with AI",
  "ai_summary_voice_busy": "Another transcription is running. Wait for it to finish, then summarize again.",
  "ai_summary_voice_choice_intro": "{count} voice messages in this summary have no saved transcription. Choose how to transcribe them. Nothing is sent or transcribed until you continue.",
  "ai_summary_voice_choice_title": "Voice messages in the summary",
  "ai_summary_voice_continue": "Continue",
