From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WinZapp build <build@winzapp.invalid>
Date: Wed, 4 Nov 2026 12:43:33 -0300
Subject: [PATCH] send: a status goes to its recipients' numbers, never to a
 LID

The contact store keys a saved name by the JID of the app state mutation
that carried it, and WhatsApp now also sends contact mutations indexed by
the LID (contact[lid]). getStatusBroadcastRecipients listed that contact as
<user>@lid among the phone numbers, and the server answered every status
with 400 from the first such mutation on. The recipients (whitelist,
contacts and blacklist alike) now go by number, each one once; a LID whose
number is unknown is left out.
---
 broadcast.go              | 13 +++++++++-
 status_recipients.go      | 52 +++++++++++++++++++++++++++++++++++++++
 status_recipients_test.go | 38 ++++++++++++++++++++++++++++
 3 files changed, 102 insertions(+), 1 deletion(-)
 create mode 100644 status_recipients.go
 create mode 100644 status_recipients_test.go

diff --git a/broadcast.go b/broadcast.go
index d376829..81484da 100644
--- a/broadcast.go
+++ b/broadcast.go
@@ -52,7 +52,7 @@ func (cli *Client) getStatusBroadcastRecipients(ctx context.Context) ([]types.JI
 	statusPrivacy := statusPrivacyOptions[0]
 	if statusPrivacy.Type == types.StatusPrivacyTypeWhitelist {
 		// Whitelist mode, just return the list
-		return statusPrivacy.List, nil
+		return cli.statusRecipientsOf(ctx, statusPrivacy.List), nil
 	}
 
 	// Blacklist or all contacts mode. Find all contacts from database, then filter them appropriately.
@@ -66,6 +66,9 @@ func (cli *Client) getStatusBroadcastRecipients(ctx context.Context) ([]types.JI
 		for _, jid := range statusPrivacy.List {
 			blacklist[jid] = struct{}{}
 		}
+		for _, jid := range cli.statusRecipientsOf(ctx, statusPrivacy.List) {
+			blacklist[jid] = struct{}{}
+		}
 	}
 
 	var contactsArray []types.JID
@@ -79,6 +82,14 @@ func (cli *Client) getStatusBroadcastRecipients(ctx context.Context) ([]types.JI
 			contactsArray = append(contactsArray, jid)
 		}
 	}
+	contactsArray = cli.statusRecipientsOf(ctx, contactsArray)
+	// A blacklisted contact stored under its LID has its number listed now
+	for i := 0; i < len(contactsArray); i++ {
+		if _, isBlacklisted := blacklist[contactsArray[i]]; isBlacklisted {
+			contactsArray = append(contactsArray[:i], contactsArray[i+1:]...)
+			i--
+		}
+	}
 	return contactsArray, nil
 }
 
diff --git a/status_recipients.go b/status_recipients.go
new file mode 100644
index 0000000..ccd9b61
--- /dev/null
+++ b/status_recipients.go
@@ -0,0 +1,52 @@
+package whatsmeow
+
+import (
+	"context"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// statusRecipients puts the status broadcast's recipients in the phone number
+// form, as WhatsApp's own clients send them, without repeating anyone.
+//
+// The contact store keys a saved name by the JID of the app state mutation
+// that carried it, and WhatsApp now also sends contact mutations indexed by
+// the LID ("contact[lid]"). getStatusBroadcastRecipients then listed that
+// contact as <user>@lid among the @s.whatsapp.net ones, and the server
+// answered every status (text, image, video, voice) with 400 from the moment
+// the first such mutation arrived. A LID whose number is unknown is left out:
+// its number, if stored, is in the list already.
+func statusRecipients(list []types.JID, pnOf func(types.JID) (types.JID, bool)) []types.JID {
+	seen := make(map[types.JID]struct{}, len(list))
+	out := make([]types.JID, 0, len(list))
+	for _, jid := range list {
+		switch jid.Server {
+		case types.DefaultUserServer:
+		case types.HiddenUserServer:
+			pn, ok := pnOf(jid)
+			if !ok || pn.IsEmpty() {
+				continue
+			}
+			jid = pn
+		default:
+			continue
+		}
+		jid = jid.ToNonAD()
+		if _, dup := seen[jid]; dup {
+			continue
+		}
+		seen[jid] = struct{}{}
+		out = append(out, jid)
+	}
+	return out
+}
+
+func (cli *Client) statusRecipientsOf(ctx context.Context, list []types.JID) []types.JID {
+	return statusRecipients(list, func(lid types.JID) (types.JID, bool) {
+		if cli.Store.LIDs == nil {
+			return types.JID{}, false
+		}
+		pn, err := cli.Store.LIDs.GetPNForLID(ctx, lid)
+		return pn, err == nil
+	})
+}
diff --git a/status_recipients_test.go b/status_recipients_test.go
new file mode 100644
index 0000000..e1820b1
--- /dev/null
+++ b/status_recipients_test.go
@@ -0,0 +1,38 @@
+package whatsmeow
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+func TestStatusRecipientsUseTheNumberOfALID(t *testing.T) {
+	pn := types.NewJID("5511999990000", types.DefaultUserServer)
+	other := types.NewJID("5511888880000", types.DefaultUserServer)
+	lid := types.NewJID("123456789", types.HiddenUserServer)
+	unknown := types.NewJID("987654321", types.HiddenUserServer)
+	pnOf := func(j types.JID) (types.JID, bool) {
+		if j == lid {
+			return pn, true
+		}
+		return types.JID{}, false
+	}
+	got := statusRecipients([]types.JID{other, lid, pn, unknown, types.NewJID("1-2", types.GroupServer)}, pnOf)
+	want := []types.JID{other, pn}
+	if len(got) != len(want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v, want %v", got, want)
+		}
+	}
+}
+
+func TestStatusRecipientsDropTheDeviceOfAJID(t *testing.T) {
+	device := types.NewADJID("5511999990000", 0, 3)
+	got := statusRecipients([]types.JID{device}, func(types.JID) (types.JID, bool) { return types.JID{}, false })
+	if len(got) != 1 || got[0] != device.ToNonAD() {
+		t.Fatalf("got %v", got)
+	}
+}
