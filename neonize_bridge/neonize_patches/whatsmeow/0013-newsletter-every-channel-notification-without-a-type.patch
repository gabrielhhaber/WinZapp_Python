+	}
+}
+
+const newsletterNotifyPrefix = "xwa2_notify_newsletter_"
+
+// newsletterChanges are the channel notifications in a mex update that have no
+// typed event (see events.NewsletterChange). The channel is the payload's "id",
+// or its "newsletter_id" / "jid"; an unparseable one leaves ID empty.
+func newsletterChanges(data []byte) []*events.NewsletterChange {
+	var wrapper struct {
+		Data map[string]json.RawMessage `json:"data"`
+	}
+	if json.Unmarshal(data, &wrapper) != nil {
+		return nil
+	}
+	var changes []*events.NewsletterChange
+	for key, raw := range wrapper.Data {
+		op, ok := strings.CutPrefix(key, newsletterNotifyPrefix)
+		if !ok || op == "on_join" || op == "on_leave" || op == "on_mute_change" {
+			continue
+		}
+		var ids struct {
+			ID           string `json:"id"`
+			NewsletterID string `json:"newsletter_id"`
+			JID          string `json:"jid"`
+		}
+		_ = json.Unmarshal(raw, &ids)
+		change := &events.NewsletterChange{Op: op, Payload: string(raw)}
+		for _, text := range []string{ids.ID, ids.NewsletterID, ids.JID} {
+			if jid, err := types.ParseJID(text); err == nil && text != "" {
+				change.ID = jid
+				break
+			}
 		}
+		changes = append(changes, change)
 	}
+	return changes
 }
 
