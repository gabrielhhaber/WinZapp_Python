From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Mon, 9 Nov 2026 03:15:57 -0300
Subject: [PATCH] newsletter: every channel notification without a typed event
 arrives as NewsletterChange

handleMexNotification dispatched only on_join, on_leave and on_mute_change
and dropped the rest. WhatsApp Web handles more: admin promote, demote and
invite revoke, metadata, admin and owner metadata updates, state, user
settings, milestones, AI content, paid partnerships, blocked users and
question responses. Each now arrives as events.NewsletterChange with the
op name (xwa2_notify_newsletter_ removed), the channel and the JSON payload.
---
 newsletterchange_test.go | 34 ++++++++++++++++++++++++++++++++
 notification.go          | 42 ++++++++++++++++++++++++++++++++++++++++
 types/events/events.go   | 14 ++++++++++++++
 3 files changed, 90 insertions(+)
 create mode 100644 newsletterchange_test.go

diff --git a/newsletterchange_test.go b/newsletterchange_test.go
new file mode 100644
index 0000000..3463364
--- /dev/null
+++ b/newsletterchange_test.go
@@ -0,0 +1,34 @@
+package whatsmeow
+
+import (
+	"testing"
+)
+
+func TestNewsletterChangesNameTheOpAndTheChannel(t *testing.T) {
+	data := []byte(`{"data":{"xwa2_notify_newsletter_on_metadata_update":{"id":"120363000000000001@newsletter","thread_metadata":{}}}}`)
+	changes := newsletterChanges(data)
+	if len(changes) != 1 || changes[0].Op != "on_metadata_update" ||
+		changes[0].ID.String() != "120363000000000001@newsletter" ||
+		changes[0].Payload != `{"id":"120363000000000001@newsletter","thread_metadata":{}}` {
+		t.Fatalf("changes: %+v", changes)
+	}
+}
+
+func TestNewsletterChangesSkipTheTypedOnesAndOthers(t *testing.T) {
+	for _, data := range []string{
+		`{"data":{"xwa2_notify_newsletter_on_join":{"id":"1@newsletter"}}}`,
+		`{"data":{"xwa2_notify_account_reachout_timelock":{}}}`,
+		`not json`,
+	} {
+		if changes := newsletterChanges([]byte(data)); len(changes) != 0 {
+			t.Fatalf("%s: %+v", data, changes)
+		}
+	}
+}
+
+func TestNewsletterChangeWithoutAnIdStillArrives(t *testing.T) {
+	changes := newsletterChanges([]byte(`{"data":{"xwa2_notify_newsletter_admin_promote":{"role":"ADMIN"}}}`))
+	if len(changes) != 1 || changes[0].Op != "admin_promote" || !changes[0].ID.IsEmpty() {
+		t.Fatalf("changes: %+v", changes)
+	}
+}
