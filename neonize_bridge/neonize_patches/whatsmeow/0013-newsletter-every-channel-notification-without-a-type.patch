 }
 
+// NewsletterChange is a channel notification with no typed event of its own:
+// a channel's metadata, admins, owner, state or settings changed (on this or
+// another device, or by another admin). Op is the notification's name without
+// "xwa2_notify_newsletter_" (on_metadata_update, admin_promote, ...), ID the
+// channel when the notification names it. WhatsApp Web handles each with a
+// WAWebMex...NotificationHandler; whatsmeow used to drop them. Payload is the
+// notification's JSON as the server sent it, for what each one carries.
+type NewsletterChange struct {
+	Mex     MexNotificationData `json:"-"`
+	ID      types.JID
+	Op      string
+	Payload string
+}
