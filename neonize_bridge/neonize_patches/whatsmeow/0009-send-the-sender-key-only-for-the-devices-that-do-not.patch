diff --git a/send_senderkey.go b/send_senderkey.go
new file mode 100644
index 0000000..7956cef
--- /dev/null
+++ b/send_senderkey.go
@@ -0,0 +1,88 @@
+package whatsmeow
+
+import (
+	"sync"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// senderKeyMemory remembers which devices of each group already hold this
+// client's sender key, so a group message only pays for the devices that do
+// not: WhatsApp's own clients distribute the key once, while encrypting it for
+// every device of the group on every message costs one pairwise encryption per
+// device (1.2 s for a text to a group of about 65 people, against 0.16 s to a
+// person). A device that lost the key asks for it with a retry receipt, which
+// handleRetryReceipt answers with the key whatever is remembered here, so the
+// memory lives in RAM and a doubt only ever costs one full distribution.
+type senderKeyMemory struct {
+	lock   sync.Mutex
+	groups map[types.JID]map[types.JID]struct{}
+}
+
+// missing returns the devices with no record of holding the group's key.
+func (m *senderKeyMemory) missing(group types.JID, devices []types.JID) []types.JID {
+	m.lock.Lock()
+	defer m.lock.Unlock()
+	known := m.groups[group]
+	missing := make([]types.JID, 0, len(devices))
+	for _, device := range devices {
+		if _, ok := known[device]; !ok {
+			missing = append(missing, device)
+		}
+	}
+	return missing
+}
+
+// remember records the devices the key was just sent to.
+func (m *senderKeyMemory) remember(group types.JID, devices []types.JID) {
+	m.lock.Lock()
+	defer m.lock.Unlock()
+	if m.groups == nil {
+		m.groups = make(map[types.JID]map[types.JID]struct{})
+	}
+	known := m.groups[group]
+	if known == nil {
+		known = make(map[types.JID]struct{}, len(devices))
+		m.groups[group] = known
+	}
+	for _, device := range devices {
+		known[device] = struct{}{}
+	}
+}
+
+// forget drops the group's record: its next message goes to every device again.
+func (m *senderKeyMemory) forget(group types.JID) {
+	m.lock.Lock()
+	defer m.lock.Unlock()
+	delete(m.groups, group)
+}
+
+// senderKeyRecipients lists the devices a <message> node carries the key for.
+func senderKeyRecipients(node *waBinary.Node) []types.JID {
+	participants, ok := node.GetOptionalChildByTag("participants")
+	if !ok {
+		return nil
+	}
+	children := participants.GetChildren()
+	devices := make([]types.JID, 0, len(children))
+	for _, to := range children {
+		if jid, ok := to.Attrs["jid"].(types.JID); ok {
+			devices = append(devices, jid)
+		}
+	}
+	return devices
+}
+
+// withoutEmptyParticipants leaves out a <participants> with nobody in it: with
+// every device holding the key, a group message is just its <enc type="skmsg">.
+func withoutEmptyParticipants(content []waBinary.Node) []waBinary.Node {
+	kept := make([]waBinary.Node, 0, len(content))
+	for _, child := range content {
+		if child.Tag == "participants" && len(child.GetChildren()) == 0 {
+			continue
+		}
+		kept = append(kept, child)
+	}
+	return kept
+}
diff --git a/send_senderkey_test.go b/send_senderkey_test.go
new file mode 100644
index 0000000..d82d332
--- /dev/null
+++ b/send_senderkey_test.go
@@ -0,0 +1,104 @@
+package whatsmeow
+
+import (
+	"reflect"
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+var (
+	skGroup  = types.NewJID("120363000000000001", types.GroupServer)
+	skOther  = types.NewJID("120363000000000002", types.GroupServer)
+	skDevice = types.NewJID("111", types.HiddenUserServer)
+	skPhone  = types.NewJID("222", types.HiddenUserServer)
+)
+
+func TestAGroupNotSeenBeforeNeedsTheKeyEverywhere(t *testing.T) {
+	var memory senderKeyMemory
+	devices := []types.JID{skDevice, skPhone}
+	if got := memory.missing(skGroup, devices); !reflect.DeepEqual(got, devices) {
+		t.Fatalf("missing = %v", got)
+	}
+}
+
+func TestTheKeyGoesOnlyToWhoDoesNotHaveIt(t *testing.T) {
+	var memory senderKeyMemory
+	memory.remember(skGroup, []types.JID{skDevice})
+	got := memory.missing(skGroup, []types.JID{skDevice, skPhone})
+	if !reflect.DeepEqual(got, []types.JID{skPhone}) {
+		t.Fatalf("missing = %v", got)
+	}
+}
+
+func TestEveryDeviceHoldingTheKeyLeavesNobodyToSendItTo(t *testing.T) {
+	var memory senderKeyMemory
+	memory.remember(skGroup, []types.JID{skDevice, skPhone})
+	if got := memory.missing(skGroup, []types.JID{skDevice, skPhone}); len(got) != 0 {
+		t.Fatalf("missing = %v", got)
+	}
+}
+
+func TestOneGroupSaysNothingAboutAnother(t *testing.T) {
+	var memory senderKeyMemory
+	memory.remember(skGroup, []types.JID{skDevice})
+	if got := memory.missing(skOther, []types.JID{skDevice}); len(got) != 1 {
+		t.Fatalf("missing = %v", got)
+	}
+}
+
+func TestAFailedSendSendsTheKeyToEveryoneAgain(t *testing.T) {
+	var memory senderKeyMemory
+	memory.remember(skGroup, []types.JID{skDevice, skPhone})
+	memory.forget(skGroup)
+	if got := memory.missing(skGroup, []types.JID{skDevice, skPhone}); len(got) != 2 {
+		t.Fatalf("missing = %v", got)
+	}
+}
+
+func TestForgettingAGroupNeverSeenDoesNothing(t *testing.T) {
+	var memory senderKeyMemory
+	memory.forget(skGroup)
+}
+
+func TestTheRecipientsAreTheDevicesOfTheNode(t *testing.T) {
+	node := waBinary.Node{Tag: "message", Content: []waBinary.Node{
+		{Tag: "participants", Content: []waBinary.Node{
+			{Tag: "to", Attrs: waBinary.Attrs{"jid": skDevice}},
+			{Tag: "to", Attrs: waBinary.Attrs{"jid": skPhone}},
+		}},
+		{Tag: "enc"},
+	}}
+	got := senderKeyRecipients(&node)
+	if !reflect.DeepEqual(got, []types.JID{skDevice, skPhone}) {
+		t.Fatalf("recipients = %v", got)
+	}
+}
+
+func TestAMessageWithNoParticipantsHasNoRecipients(t *testing.T) {
+	node := waBinary.Node{Tag: "message", Content: []waBinary.Node{{Tag: "enc"}}}
+	if got := senderKeyRecipients(&node); got != nil {
+		t.Fatalf("recipients = %v", got)
+	}
+}
+
+func TestAnEmptyParticipantsNodeIsLeftOut(t *testing.T) {
+	content := []waBinary.Node{
+		{Tag: "participants", Content: []waBinary.Node{}},
+		{Tag: "device-identity"},
+	}
+	got := withoutEmptyParticipants(content)
+	if len(got) != 1 || got[0].Tag != "device-identity" {
+		t.Fatalf("content = %v", got)
+	}
+}
+
+func TestParticipantsWithSomeoneStay(t *testing.T) {
+	content := []waBinary.Node{{Tag: "participants", Content: []waBinary.Node{
+		{Tag: "to", Attrs: waBinary.Attrs{"jid": skDevice}},
+	}}}
+	if got := withoutEmptyParticipants(content); len(got) != 1 {
+		t.Fatalf("content = %v", got)
+	}
+}
