+package whatsmeow
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waHistorySync"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestOmittedHistoryConversationsAndLIDExtraction(t *testing.T) {
+	c1 := &waHistorySync.Conversation{
+		ID:         proto.String("111@lid"),
+		PnJID:      proto.String("5511999990001@s.whatsapp.net"),
+		AccountLid: proto.String("111@lid"),
+	}
+	c2 := &waHistorySync.Conversation{
+		ID:     proto.String("5511999990002:0@s.whatsapp.net"),
+		LidJID: proto.String("222@lid"),
+	}
+	c1Raw, err := proto.Marshal(c1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c2Raw, err := proto.Marshal(c2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var meta []byte
+	meta = protowire.AppendTag(meta, 1, protowire.BytesType)
+	meta = protowire.AppendString(meta, "snap-1")
+	meta = protowire.AppendTag(meta, 3, protowire.VarintType)
+	meta = protowire.AppendVarint(meta, 0)
+	meta = protowire.AppendTag(meta, omittedMetadataFieldConvs, protowire.BytesType)
+	meta = protowire.AppendBytes(meta, c1Raw)
+	meta = protowire.AppendTag(meta, omittedMetadataFieldConvs, protowire.BytesType)
+	meta = protowire.AppendBytes(meta, c2Raw)
+
+	var unknown []byte
+	unknown = protowire.AppendTag(unknown, historySyncFieldOmittedMetadata, protowire.BytesType)
+	unknown = protowire.AppendBytes(unknown, meta)
+
+	convs := omittedHistoryConversations(unknown)
+	if len(convs) != 2 {
+		t.Fatalf("expected 2 conversations, got %d", len(convs))
+	}
+	pairs := extractConversationLIDMappings(convs, nil, types.EmptyJID, types.EmptyJID)
+	if len(pairs) != 2 {
+		t.Fatalf("expected 2 LID mappings, got %d: %+v", len(pairs), pairs)
+	}
+	if pairs[0].LID.String() != "111@lid" || pairs[0].PN.String() != "5511999990001@s.whatsapp.net" {
+		t.Fatalf("unexpected first pair: %+v", pairs[0])
+	}
+	if pairs[1].LID.String() != "222@lid" || pairs[1].PN.String() != "5511999990002@s.whatsapp.net" {
+		t.Fatalf("unexpected second pair: %+v", pairs[1])
+	}
+}
+
+func TestConversationLIDMappingsPreferLidJIDAndKeepExplicitAndOwn(t *testing.T) {
+	own := types.NewJID("5511999990000", types.DefaultUserServer)
+	ownLID := types.NewJID("999", types.HiddenUserServer)
+	convs := []*waHistorySync.Conversation{
+		// lidJID before accountLid: accountLid can be the user's own LID
+		{ID: proto.String("5511999990003@s.whatsapp.net"), LidJID: proto.String("333@lid"), AccountLid: proto.String("999@lid")},
+		// the explicit mapping of this history sync wins, by LID and by phone
+		{ID: proto.String("5511999990009@s.whatsapp.net"), LidJID: proto.String("111@lid")},
+		{ID: proto.String("5511999990001@s.whatsapp.net"), LidJID: proto.String("777@lid")},
+		// the own LID is not lent to someone else's chat, but is the user's own
+		{ID: proto.String("5511999990002@s.whatsapp.net"), AccountLid: proto.String("999@lid")},
+		{ID: proto.String("5511999990000@s.whatsapp.net"), AccountLid: proto.String("999@lid")},
+	}
+	explicit := []*waHistorySync.PhoneNumberToLIDMapping{
+		{LidJID: proto.String("111@lid"), PnJID: proto.String("5511999990001@s.whatsapp.net")},
+	}
+	pairs := extractConversationLIDMappings(convs, explicit, ownLID, own)
+	if len(pairs) != 2 {
+		t.Fatalf("expected 2 mappings, got %d: %+v", len(pairs), pairs)
+	}
+	if pairs[0].LID.String() != "333@lid" || pairs[0].PN.String() != "5511999990003@s.whatsapp.net" {
+		t.Fatalf("unexpected first pair: %+v", pairs[0])
+	}
+	if pairs[1].LID.String() != "999@lid" || pairs[1].PN.String() != "5511999990000@s.whatsapp.net" {
+		t.Fatalf("unexpected own pair: %+v", pairs[1])
+	}
+}
