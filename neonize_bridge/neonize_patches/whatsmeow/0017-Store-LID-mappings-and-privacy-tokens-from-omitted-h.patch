+package whatsmeow
+
+import (
+	"context"
+
+	"go.mau.fi/whatsmeow/proto/waHistorySync"
+	"go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+const (
+	historySyncFieldOmittedMetadata protowire.Number = 25
+	omittedMetadataFieldConvs       protowire.Number = 6
+)
+
+func consumeLengthFields(b []byte, target protowire.Number, fn func([]byte)) {
+	for len(b) > 0 {
+		num, typ, n := protowire.ConsumeTag(b)
+		if n < 0 {
+			return
+		}
+		b = b[n:]
+		if typ == protowire.BytesType {
+			val, m := protowire.ConsumeBytes(b)
+			if m < 0 {
+				return
+			}
+			b = b[m:]
+			if num == target {
+				fn(val)
+			}
+		} else {
+			m := protowire.ConsumeFieldValue(num, typ, b)
+			if m < 0 {
+				return
+			}
+			b = b[m:]
+		}
+	}
+}
+
+func omittedHistoryConversations(unknown []byte) []*waHistorySync.Conversation {
+	var convs []*waHistorySync.Conversation
+	consumeLengthFields(unknown, historySyncFieldOmittedMetadata, func(metaBytes []byte) {
+		consumeLengthFields(metaBytes, omittedMetadataFieldConvs, func(convBytes []byte) {
+			var conv waHistorySync.Conversation
+			if err := proto.Unmarshal(convBytes, &conv); err == nil {
+				convs = append(convs, &conv)
+			}
+		})
+	})
+	return convs
+}
+
+// extractConversationLIDMappings derives LID-PN pairs from conversations. The
+// explicit mappings of the same history sync win over what a conversation
+// implies (the store replaces by LID), and a pair that gives the account's own
+// LID to a phone other than its own is dropped: accountLid is the account's,
+// so it can be the user's own LID on a chat that is not the user's.
+func extractConversationLIDMappings(conversations []*waHistorySync.Conversation, explicit []*waHistorySync.PhoneNumberToLIDMapping, ownLID, ownPN types.JID) []store.LIDMapping {
+	type pairKey struct{ lid, pn types.JID }
+	seen := make(map[pairKey]struct{})
+	explicitLIDs := make(map[types.JID]struct{})
+	explicitPNs := make(map[types.JID]struct{})
+	for _, mapping := range explicit {
+		if lid, err := types.ParseJID(mapping.GetLidJID()); err == nil {
+			explicitLIDs[lid.ToNonAD()] = struct{}{}
+		}
+		if pn, err := types.ParseJID(mapping.GetPnJID()); err == nil {
+			if pn.Server == types.LegacyUserServer {
+				pn.Server = types.DefaultUserServer
+			}
+			explicitPNs[pn.ToNonAD()] = struct{}{}
+		}
+	}
+	ownLID, ownPN = ownLID.ToNonAD(), ownPN.ToNonAD()
+	var pairs []store.LIDMapping
+	for _, conv := range conversations {
+		if conv == nil {
+			continue
+		}
+		cid, _ := types.ParseJID(conv.GetID())
+		pn, _ := types.ParseJID(conv.GetPnJID())
+		if pn.IsEmpty() && cid.Server == types.DefaultUserServer {
+			pn = cid
+		}
+		if pn.Server == types.LegacyUserServer {
+			pn.Server = types.DefaultUserServer
+		}
+		var lid types.JID
+		for _, candidate := range []string{conv.GetLidJID(), conv.GetID(), conv.GetAccountLid()} {
+			if parsed, err := types.ParseJID(candidate); err == nil && parsed.Server == types.HiddenUserServer {
+				lid = parsed
+				break
+			}
+		}
+		lid = lid.ToNonAD()
+		pn = pn.ToNonAD()
+		if lid.Server == types.HiddenUserServer && pn.Server == types.DefaultUserServer && !lid.IsEmpty() && !pn.IsEmpty() {
+			if _, ok := explicitLIDs[lid]; ok {
+				continue
+			}
+			if _, ok := explicitPNs[pn]; ok {
+				continue
+			}
+			if !ownLID.IsEmpty() && lid == ownLID && pn != ownPN {
+				continue
+			}
+			k := pairKey{lid: lid, pn: pn}
+			if _, ok := seen[k]; !ok {
+				seen[k] = struct{}{}
+				pairs = append(pairs, store.LIDMapping{LID: lid, PN: pn})
+			}
+		}
+	}
+	return pairs
+}
+
+func (cli *Client) storeConversationPNLIDMappings(ctx context.Context, conversations []*waHistorySync.Conversation, explicit []*waHistorySync.PhoneNumberToLIDMapping) {
+	if cli == nil || cli.Store == nil || cli.Store.LIDs == nil {
+		return
+	}
+	var ownPN types.JID
+	if cli.Store.ID != nil {
+		ownPN = *cli.Store.ID
+	}
+	lidPairs := extractConversationLIDMappings(conversations, explicit, cli.Store.LID, ownPN)
+	if len(lidPairs) == 0 {
+		return
+	}
+	err := cli.Store.LIDs.PutManyLIDMappings(ctx, lidPairs)
+	if err != nil {
+		cli.Log.Errorf("Failed to store conversation PN-LID mappings from history sync: %v", err)
+	} else {
+		cli.Log.Debugf("Stored %d conversation PN-LID mappings from history sync", len(lidPairs))
+	}
+}
