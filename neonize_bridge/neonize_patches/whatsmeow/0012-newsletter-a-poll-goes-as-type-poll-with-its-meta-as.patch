+++ b/send.go
@@ -744,10 +744,15 @@ func (cli *Client) sendNewsletter(
 			plaintextNode.Attrs["mediatype"] = mediaType
 		}
 	}
+	content := []waBinary.Node{plaintextNode}
+	if meta := newsletterPollMeta(message); meta != nil {
