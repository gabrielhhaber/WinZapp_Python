 	start = time.Now()
 	data, err := cli.sendNodeAndGetData(ctx, node)
@@ -923,6 +928,28 @@ func (cli *Client) sendDM(
 	return phash, data, nil
 }
 
+// newsletterPollMeta is the <meta> a poll posted to a channel carries, or nil
+// for anything else. WhatsApp Web sends a channel's poll as
+// <message type="poll"><plaintext/><meta polltype="creation"
+// contenttype="text"/></message> (WASmaxOutMessagePublishContentTypePoll
+// CreationMixin, read on 2026-11-08), whichever poll version the message holds
+// (pollCreationMessage, or V3 for a single answer: WAWebPollsGeneratePoll
+// CreationMessageProto). sendNewsletter sent it as type "text" with no meta.
+func newsletterPollMeta(msg *waE2E.Message) *waBinary.Node {
+	if msg == nil {
+		return nil
+	}
+	if msg.PollCreationMessage == nil && msg.PollCreationMessageV2 == nil &&
+		msg.PollCreationMessageV3 == nil && msg.PollCreationMessageV5 == nil &&
+		msg.PollCreationMessageV6 == nil {
+		return nil
+	}
+	return &waBinary.Node{
+		Tag:   "meta",
+		Attrs: waBinary.Attrs{"polltype": "creation", "contenttype": "text"},
+	}
+}
