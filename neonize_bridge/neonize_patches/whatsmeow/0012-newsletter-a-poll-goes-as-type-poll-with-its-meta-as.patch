From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Sun, 8 Nov 2026 23:00:20 -0300
Subject: [PATCH] newsletter: a poll goes as type poll with its meta, as
 WhatsApp Web sends it

sendNewsletter sent a channel's poll as <message type="text"> with only
the plaintext. WhatsApp Web sends <message type="poll"> with
<meta polltype="creation" contenttype="text"/> next to the plaintext,
for pollCreationMessage and its V3 (single answer) alike.
---
 newsletterpoll_test.go | 28 ++++++++++++++++++++++++++++
 send.go                | 29 ++++++++++++++++++++++++++++-
 2 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 newsletterpoll_test.go

diff --git a/newsletterpoll_test.go b/newsletterpoll_test.go
new file mode 100644
index 0000000..4fc74b6
--- /dev/null
+++ b/newsletterpoll_test.go
@@ -0,0 +1,28 @@
+package whatsmeow
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestNewsletterPollMeta(t *testing.T) {
+	poll := &waE2E.PollCreationMessage{Name: proto.String("Q")}
+	for _, msg := range []*waE2E.Message{
+		{PollCreationMessage: poll},
+		{PollCreationMessageV3: poll},
+		{PollCreationMessageV5: poll},
+	} {
+		meta := newsletterPollMeta(msg)
+		if meta == nil || meta.Tag != "meta" || meta.Attrs["polltype"] != "creation" ||
+			meta.Attrs["contenttype"] != "text" {
+			t.Fatalf("poll %v: meta %v", msg, meta)
+		}
+	}
+	for _, msg := range []*waE2E.Message{nil, {Conversation: proto.String("hi")}} {
+		if meta := newsletterPollMeta(msg); meta != nil {
+			t.Fatalf("not a poll %v: meta %v", msg, meta)
+		}
+	}
+}
diff --git a/send.go b/send.go
