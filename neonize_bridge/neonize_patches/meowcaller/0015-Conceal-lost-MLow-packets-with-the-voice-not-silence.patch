@@ -0,0 +1,52 @@
+package meowcaller
+
+import (
+	"math"
+	"testing"
+)
+
+// A lost MLow packet after speech is bridged with sound, at 16 and 48 kHz,
+// for exactly the duration asked.
+func TestMlowLossIsConcealedWithSpeechNotSilence(t *testing.T) {
+	for _, rate := range []int{SampleRate, FullbandSampleRate} {
+		encoder, err := newCallAudioEncoder(AudioCodecMlow, rate)
+		if err != nil {
+			t.Fatal(err)
+		}
+		decoder := newCallAudioDecoder(AudioCodecMlow, rate)
+		frameLen := rate * 60 / 1000
+		for n := 0; n < 10; n++ {
+			frame := make([]float32, frameLen)
+			for i := range frame {
+				frame[i] = float32(.3 * math.Sin(2*math.Pi*200*float64(i+n*frameLen)/float64(rate)))
+			}
+			packet, err := encoder.Encode(frame)
+			if err != nil {
+				t.Fatal(err)
+			}
+			decoder.Decode(packet)
+		}
+		for _, samples := range []int{frameLen, rate / 50, rate/50 + 1} {
+			concealed := decoder.Conceal(samples)
+			if len(concealed) != samples {
+				t.Fatalf("rate %d: concealed %d samples, asked %d", rate, len(concealed), samples)
+			}
+		}
+		decoder = newCallAudioDecoder(AudioCodecMlow, rate)
+		for n := 0; n < 10; n++ {
+			frame := make([]float32, frameLen)
+			for i := range frame {
+				frame[i] = float32(.3 * math.Sin(2*math.Pi*200*float64(i+n*frameLen)/float64(rate)))
+			}
+			packet, _ := encoder.Encode(frame)
+			decoder.Decode(packet)
+		}
+		var energy float64
+		for _, v := range decoder.Conceal(frameLen)[:rate/50] {
+			energy += float64(v) * float64(v)
+		}
+		if energy < 0.01*float64(rate/50) {
+			t.Fatalf("rate %d: the loss sounds as silence (energy %g)", rate, energy)
+		}
+	}
+}
