+func (d *callAudioDecoder) concealMlow(samples int) []float32 {
+	if samples == 0 {
+		return []float32{}
+	}
+	if d.PCMRate() != FullbandSampleRate {
+		output := d.mlow.Conceal(samples)
+		d.last = append(d.last[:0], output...)
+		return output
+	}
+	output := d.up.convert(d.mlow.Conceal((samples+2)/3), true)[:samples]
+	d.last = append(d.last[:0], output...)
+	return output
 }
 
