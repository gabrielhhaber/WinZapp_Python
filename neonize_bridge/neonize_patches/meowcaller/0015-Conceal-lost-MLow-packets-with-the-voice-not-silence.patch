diff --git a/mlow/plc.go b/mlow/plc.go
new file mode 100644
index 0000000..2fc81e8
--- /dev/null
+++ b/mlow/plc.go
@@ -0,0 +1,161 @@
+package mlow
+
+import "math"
+
+// Packet-loss concealment at the decoder's 16 kHz output, after ITU-T G.711
+// Appendix I: the last pitch period repeated (widened to two, then three
+// periods), full level for 20 ms, faded to silence over the next 60 ms, and
+// cross-faded into the first frame decoded after the loss.
+
+const (
+	plcHistory  = 960 // 60 ms of decoded output kept as the source
+	plcMinLag   = 40  // 400 Hz
+	plcMaxLag   = 320 // 50 Hz, the decoder's own maximum pitch lag
+	plcCorrWin  = 320 // 20 ms compared when looking for the period
+	plcWidenAt  = 160 // every 10 ms of loss the repeated span widens by a period
+	plcMaxSpans = 3
+	plcFullGain = 320 // 20 ms at full level
+	plcFadeLen  = 960 // then to silence over 60 ms
+	plcMergeLen = 80  // 5 ms cross-fade into the next decoded frame
+)
+
+type plcState struct {
+	history []float32 // newest last, at most plcHistory samples
+	lost    int       // samples concealed since the last decoded frame
+	lag     int       // pitch period in samples; 0 when there is nothing to repeat
+	spans   int       // periods in the repeated span (1..plcMaxSpans)
+	pos     int       // read position inside the repeated span
+}
+
+// decoded records a frame that was really decoded and returns it, cross-faded
+// with the concealment when it ends a loss.
+func (p *plcState) decoded(pcm []float32) []float32 {
+	if p.lost > 0 && len(pcm) > 0 {
+		n := min(plcMergeLen, len(pcm))
+		tail := p.next(n)
+		merged := append([]float32(nil), pcm...)
+		for i := 0; i < n; i++ {
+			w := float32(n-i) / float32(n+1)
+			merged[i] = w*tail[i] + (1-w)*pcm[i]
+		}
+		pcm = merged
+	}
+	p.lost, p.lag, p.spans, p.pos = 0, 0, 0, 0
+	p.remember(pcm)
+	return pcm
+}
+
+// conceal returns samples standing in for audio that never arrived (or could
+// not be decoded).
+func (p *plcState) conceal(samples int) []float32 {
+	if samples <= 0 {
+		return nil
+	}
+	if p.lost == 0 {
+		p.start()
+	}
+	return p.next(samples)
+}
+
+func (p *plcState) start() {
+	p.spans, p.pos = 1, 0
+	p.lag = pitchLag(p.history)
+}
+
+// next continues the concealment for n samples, advancing the loss.
+func (p *plcState) next(n int) []float32 {
+	out := make([]float32, n)
+	for i := range out {
+		gain := plcGain(p.lost)
+		p.lost++
+		if p.lag == 0 || gain == 0 {
+			continue
+		}
+		if p.spans < plcMaxSpans && p.lost > p.spans*plcWidenAt {
+			p.widen()
+		}
+		out[i] = gain * p.sample(p.spans, p.pos)
+		p.pos++
+	}
+	return out
+}
+
+// widen repeats one more period from now on; a quarter period is cross-faded
+// from the old span into the new one, at the same phase of the period.
+func (p *plcState) widen() {
+	phase := p.pos % (p.spans * p.lag) % p.lag
+	q := p.lag / 4
+	if q > 0 {
+		old := make([]float32, q)
+		for i := range old {
+			old[i] = p.sample(p.spans, p.pos+i)
+		}
+		p.spans++
+		base := len(p.history) - p.spans*p.lag
+		for i := 0; i < q; i++ {
+			idx := base + (phase+i)%(p.spans*p.lag)
+			w := float32(i+1) / float32(q+1)
+			p.history[idx] = (1-w)*old[i] + w*p.history[idx]
+		}
+	} else {
+		p.spans++
+	}
+	p.pos = phase
+}
+
+func (p *plcState) sample(spans, pos int) float32 {
+	span := spans * p.lag
+	return p.history[len(p.history)-span+pos%span]
+}
+
+func (p *plcState) remember(pcm []float32) {
+	p.history = append(p.history, pcm...)
+	if extra := len(p.history) - plcHistory; extra > 0 {
+		p.history = append(p.history[:0], p.history[extra:]...)
+	}
+}
+
+func plcGain(lost int) float32 {
+	if lost < plcFullGain {
+		return 1
+	}
+	faded := lost - plcFullGain
+	if faded >= plcFadeLen {
+		return 0
+	}
+	return 1 - float32(faded)/float32(plcFadeLen)
+}
+
+// pitchLag finds the period of the end of history: the lag whose normalised
+// correlation with the last plcCorrWin samples is highest. 0 when history is
+// too short to repeat plcMaxSpans periods or holds no energy.
+func pitchLag(history []float32) int {
+	if len(history) < plcCorrWin+plcMaxLag || len(history) < plcMaxSpans*plcMaxLag {
+		return 0
+	}
+	end := len(history)
+	window := history[end-plcCorrWin:]
+	var energy float64
+	for _, v := range window {
+		energy += float64(v) * float64(v)
+	}
+	if energy < 1e-9 {
+		return 0
+	}
+	best, bestScore := plcMinLag, math.Inf(-1)
+	for lag := plcMinLag; lag <= plcMaxLag; lag++ {
+		past := history[end-plcCorrWin-lag : end-lag]
+		var cross, pastEnergy float64
+		for i, v := range window {
+			cross += float64(v) * float64(past[i])
+			pastEnergy += float64(past[i]) * float64(past[i])
+		}
+		if pastEnergy < 1e-12 {
+			continue
+		}
+		if score := cross / math.Sqrt(pastEnergy); score > bestScore {
+			best, bestScore = lag, score
+		}
+	}
+	return best
+}
