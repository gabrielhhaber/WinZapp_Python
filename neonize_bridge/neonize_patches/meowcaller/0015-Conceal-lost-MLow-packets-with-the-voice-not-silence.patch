new file mode 100644
index 0000000..9e9228a
--- /dev/null
+++ b/mlow/plc_test.go
@@ -0,0 +1,172 @@
+package mlow
+
+import (
+	"encoding/hex"
+	"math"
+	"testing"
+)
+
+func plcTone(start, n, period int) []float32 {
+	out := make([]float32, n)
+	for i := range out {
+		phase := 2 * math.Pi * float64(start+i) / float64(period)
+		out[i] = float32(0.5*math.Sin(phase) + 0.2*math.Sin(2*phase+0.3))
+	}
+	return out
+}
+
+func TestPLCFindsThePitchPeriod(t *testing.T) {
+	for _, period := range []int{48, 80, 145, 300} {
+		if got := pitchLag(plcTone(0, plcHistory, period)); got != period {
+			t.Fatalf("period %d: lag %d", period, got)
+		}
+	}
+	if got := pitchLag(make([]float32, plcHistory)); got != 0 {
+		t.Fatalf("silence gave lag %d", got)
+	}
+	if got := pitchLag(plcTone(0, 100, 80)); got != 0 {
+		t.Fatalf("short history gave lag %d", got)
+	}
+}
+
+func TestPLCContinuesVoicedSpeechInsteadOfSilence(t *testing.T) {
+	var p plcState
+	p.decoded(plcTone(0, opusFrameSamps, 80))
+	got := p.conceal(plcFullGain)
+	want := plcTone(opusFrameSamps, plcFullGain, 80)
+	var errEnergy, energy float64
+	for i := range got {
+		d := float64(got[i] - want[i])
+		errEnergy += d * d
+		energy += float64(want[i]) * float64(want[i])
+	}
+	if errEnergy > energy*1e-3 {
+		t.Fatalf("concealment strays from the waveform: err/energy=%g", errEnergy/energy)
+	}
+}
+
+func TestPLCFadesToSilenceAndKeepsDuration(t *testing.T) {
+	var p plcState
+	p.decoded(plcTone(0, opusFrameSamps, 120))
+	first := p.conceal(opusFrameSamps)
+	second := p.conceal(opusFrameSamps)
+	if len(first) != opusFrameSamps || len(second) != opusFrameSamps {
+		t.Fatal("concealment changed the duration")
+	}
+	peak := func(x []float32) (m float32) {
+		for _, v := range x {
+			m = max(m, float32(math.Abs(float64(v))))
+		}
+		return m
+	}
+	if peak(first[:plcFullGain]) < 0.5 {
+		t.Fatal("the first 20 ms are not at full level")
+	}
+	if peak(second[plcFullGain+plcFadeLen-opusFrameSamps:]) != 0 {
+		t.Fatal("still sounding after 80 ms of loss")
+	}
+	if peak(first[opusFrameSamps-100:]) >= peak(first[:plcFullGain]) {
+		t.Fatal("no fade during the loss")
+	}
+}
+
+func TestPLCWithNothingToRepeatIsSilent(t *testing.T) {
+	var p plcState
+	for _, v := range p.conceal(opusFrameSamps) {
+		if v != 0 {
+			t.Fatal("concealment invented sound")
+		}
+	}
+}
+
+func TestPLCCrossFadesIntoTheNextFrame(t *testing.T) {
+	var p plcState
+	p.decoded(plcTone(0, opusFrameSamps, 80))
+	concealed := p.conceal(opusFrameSamps)
+	next := make([]float32, opusFrameSamps) // the talker paused: a jump to zero
+	merged := p.decoded(next)
+	if d := math.Abs(float64(merged[0] - concealed[len(concealed)-1])); d > 0.1 {
+		t.Fatalf("click at the join: %g", d)
+	}
+	for _, v := range merged[plcMergeLen:] {
+		if v != 0 {
+			t.Fatal("the decoded frame was altered after the cross-fade")
+		}
+	}
+	if p.lost != 0 || len(p.history) != plcHistory {
+		t.Fatal("the loss did not end")
+	}
+	if got := p.decoded(next); &got[0] != &next[0] {
+		t.Fatal("a frame with no loss before it was copied")
+	}
+}
+
+func TestPLCWideningKeepsTheWaveformContinuous(t *testing.T) {
+	var p plcState
+	p.decoded(plcTone(0, opusFrameSamps, 100))
+	out := p.conceal(plcFullGain)
+	for i := 1; i < len(out); i++ {
+		if d := math.Abs(float64(out[i] - out[i-1])); d > 0.15 {
+			t.Fatalf("jump of %g at sample %d", d, i)
+		}
+	}
+}
+
+func TestDecoderConcealsBetweenRealFrames(t *testing.T) {
+	var frames []string
+	loadJSON(t, "inbound_capture_frames.json", &frames)
+	loud, loudest := 0, 0.0
+	probe := NewMlowDecoder()
+	for i, hf := range frames[:len(frames)-1] {
+		fb, _ := hex.DecodeString(hf)
+		var e float64
+		for _, v := range probe.Decode(fb) {
+			e += float64(v) * float64(v)
+		}
+		if e > loudest {
+			loud, loudest = i+1, e
+		}
+	}
+	dec := NewMlowDecoder()
+	var energy float64
+	for i, hf := range frames {
+		fb, err := hex.DecodeString(hf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i == loud {
+			concealed := dec.Conceal(opusFrameSamps)
+			if len(concealed) != opusFrameSamps {
+				t.Fatal("concealment duration")
+			}
+			for _, v := range concealed {
+				energy += float64(v) * float64(v)
+			}
+			continue
+		}
+		for _, v := range dec.Decode(fb) {
+			if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+				t.Fatal("nonfinite PCM")
+			}
+		}
+	}
+	if dec.FailedFrames() != 0 {
+		t.Fatalf("%d good frames taken for corrupt", dec.FailedFrames())
+	}
+	if energy < loudest*0.05 {
+		t.Fatalf("a loss after speech concealed with near silence: %g of %g", energy, loudest)
+	}
+}
+
+func TestDecoderStateCloneIsIndependent(t *testing.T) {
+	s := newSmplDecoderState()
+	s.PrevNLSF = []float32{1, 2}
+	c := s.clone()
+	c.PrevNLSF[0] = 9
+	c.Celp.acbState[0] = 9
+	c.Harm.stateComb[0] = 9
+	c.Lstate.PrevLag = 9
+	if s.PrevNLSF[0] != 1 || s.Celp.acbState[0] != 0 || s.Harm.stateComb[0] != 0 || s.Lstate.PrevLag != 0 {
+		t.Fatal("the saved state shares memory with the live one")
+	}
+}
