 func buildRelayBindingSuccess(request, integrityKey []byte) ([]byte, bool) {
 	// Source of truth: https://github.com/purpshell/meowcaller/blob/a9e4195fb846a730f30ce98c26a7d1c03993fdb2/datasheets/group-media-relay-refresh.md#L72-L92
 	messageType, ok := stun.StunMessageType(request)
diff --git a/engine_group_relay_test.go b/engine_group_relay_test.go
index a890e9d..56f8d8b 100644
--- a/engine_group_relay_test.go
+++ b/engine_group_relay_test.go
@@ -123,3 +123,41 @@ func TestConnectedRemoteParticipantPIDsExcludesSelfAndInactive(t *testing.T) {
 		t.Fatalf("connected remote PIDs = %v, want [22]", got)
 	}
 }
+
+// A member who left and joined again gets a new PID while the relay stays the
+// same; the allocation must be sent again with the new subscriptions, or the
+// SFU never forwards this device's audio to that member (seen live).
+func TestGroupRelayAllocateIsResentWhenTheParticipantsChangeOnTheSameRelay(t *testing.T) {
+	key := bytes.Repeat([]byte{0x24}, 16)
+	state := newGroupRelayAllocateStateWithHBHFEC([]byte{0}, key, [2]uint32{})
+	endpoint := &relayEndpoint{relayName: "gru1c01",
+		addresses: []relayAddress{{ipv4: "57.144.67.57", port: 3478}}}
+	relay := &groupCallRelay{TransactionID: 5, Key: key, Tokens: [][]byte{bytes.Repeat([]byte{0x42}, 174)},
+		Endpoints: []groupCallRelayEndpoint{{RelayName: "gru1c01", TokenID: 0}}}
+	sends := 0
+	apply := func(r *groupCallRelay, pids []uint32) bool {
+		changed, err := state.ApplyWithSubscriptions(endpoint, r, [9]uint32{}, 0, pids, [12]byte{},
+			func([]byte) error { sends++; return nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		return changed
+	}
+	if !apply(relay, []uint32{1, 0}) {
+		t.Fatal("first allocation not sent")
+	}
+	if apply(relay, []uint32{0, 1}) {
+		t.Fatal("the same members in another order sent a new allocation")
+	}
+	if !apply(relay, []uint32{1, 3}) {
+		t.Fatal("a rejoined member (new PID, same relay) got no new allocation")
+	}
+	older := *relay
+	older.TransactionID = 4
+	if apply(&older, []uint32{7}) {
+		t.Fatal("an older relay transaction was applied")
+	}
+	if sends != 2 {
+		t.Fatalf("sends = %d, want 2", sends)
+	}
+}
