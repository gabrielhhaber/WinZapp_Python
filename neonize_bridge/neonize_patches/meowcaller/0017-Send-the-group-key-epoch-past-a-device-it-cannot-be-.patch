+// buildGroupEpochNodes encrypts the epoch for every recipient independently:
+// one device whose key cannot be encrypted (no Signal session, say) no longer
+// keeps the epoch from every other device. It returns the nodes to send, the
+// recipient of each, and what failed.
+func buildGroupEpochNodes(update groupCallUpdate, recipients []types.JID, nextID func() string,
+	encrypt func(types.JID) ([]byte, string, error)) ([]waBinary.Node, []types.JID, []error) {
+	var nodes []waBinary.Node
+	var sendTo []types.JID
+	var failures []error
+	for _, recipient := range recipients {
+		ciphertext, encType, err := encrypt(recipient)
 		if err != nil {
-			clear(rawKey)
-			return fmt.Errorf("meowcaller: encrypt group epoch for %s: %w", recipient, err)
+			failures = append(failures, fmt.Errorf("meowcaller: encrypt group epoch for %s: %w", recipient, err))
+			continue
 		}
 		node, err := signaling.BuildGroupEncRekey(signaling.GroupEncRekeyParams{
 			CallID: update.CallID, To: recipient, CallCreator: update.CallCreator,
-			TransactionID: update.TransactionID, RequestID: e.nextCallNodeID(),
+			TransactionID: update.TransactionID, RequestID: nextID(),
 			DeviceKey: signaling.OfferDeviceKey{
