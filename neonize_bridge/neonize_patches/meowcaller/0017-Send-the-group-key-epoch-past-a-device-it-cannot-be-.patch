--- /dev/null
+++ b/group_epoch_fanout_test.go
@@ -0,0 +1,59 @@
+package meowcaller
+
+import (
+	"errors"
+	"strconv"
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+func fanoutJID(t *testing.T, s string) types.JID {
+	t.Helper()
+	jid, err := types.ParseJID(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return jid
+}
+
+// One device whose key cannot be encrypted no longer keeps the epoch from the
+// others (seen live: a group call where one member never got the key and
+// nobody could hear anybody).
+func TestGroupEpochFanoutGoesOnPastADeviceThatCannotBeEncrypted(t *testing.T) {
+	broken, julia, web := fanoutJID(t, "111:3@lid"), fanoutJID(t, "222:0@lid"), fanoutJID(t, "333:27@lid")
+	update := groupCallUpdate{CallID: "CALL", CallCreator: julia, TransactionID: 30}
+	n := 0
+	nextID := func() string { n++; return strconv.Itoa(n) }
+	nodes, sendTo, failures := buildGroupEpochNodes(update, []types.JID{broken, julia, web}, nextID,
+		func(recipient types.JID) ([]byte, string, error) {
+			if recipient == broken {
+				return nil, "", errors.New("no signal session")
+			}
+			return []byte{1, 2, 3}, "msg", nil
+		})
+	if len(nodes) != 2 || len(sendTo) != 2 || sendTo[0] != julia || sendTo[1] != web {
+		t.Fatalf("sent to %v, want the two devices that could be encrypted", sendTo)
+	}
+	if len(failures) != 1 {
+		t.Fatalf("failures = %v", failures)
+	}
+	for i, node := range nodes {
+		if node.Attrs["to"] != sendTo[i] {
+			t.Fatalf("node %d addressed to %v, want %v", i, node.Attrs["to"], sendTo[i])
+		}
+	}
+}
+
+func TestConnectedDevicesWithoutPIDAreNamed(t *testing.T) {
+	self, web, phone := fanoutJID(t, "999:52@lid"), fanoutJID(t, "333:27@lid"), fanoutJID(t, "222:0@lid")
+	update := groupCallUpdate{Participants: []groupCallParticipant{
+		{State: "connected", Devices: []groupCallDevice{{JID: web}, {JID: phone, HasPID: true}}},
+		{State: "connected", Devices: []groupCallDevice{{JID: self}}},
+		{State: "invited", Devices: []groupCallDevice{{JID: fanoutJID(t, "444:0@lid")}}},
+	}}
+	got := connectedDevicesWithoutPID(update, self)
+	if len(got) != 1 || got[0] != web {
+		t.Fatalf("skipped = %v, want only the connected remote device without a PID", got)
+	}
+}
