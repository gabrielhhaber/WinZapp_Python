+// MixedTimedAudioSink mixes several timed senders itself, one NetEq per
+// sender on the device clock. A group call then hands it each participant's
+// decoded PCM on that participant's own timeline (SSRC and PCM-unit RTP
+// timestamp) instead of meowcaller's participant mixer.
+type MixedTimedAudioSink interface {
+	TimedAudioSink
+	WantsMixedTimedAudio() bool
+	WriteMixedTimedFrame(frame []float32, timestamp, ssrc, clock uint32) error
+}
+
