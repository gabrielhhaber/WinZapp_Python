--- a/engine_media.go
+++ b/engine_media.go
@@ -1245,6 +1245,14 @@ func (e *engine) runMedia(ctx context.Context, callID string, call *Call, callKe
 			"event": "frame_authenticated", "ssrc": vh.Ssrc, "seq": vh.SequenceNumber,
 		})
 		for _, audio := range frames {
+			// NetEq conceals by its own playout clock. The codec's state was
+			// advanced above, but do not enqueue a second synthetic gap.
+			if audio.Concealed && !groupMixing.Load() {
+				_, sink := callPlayerSink(call)
