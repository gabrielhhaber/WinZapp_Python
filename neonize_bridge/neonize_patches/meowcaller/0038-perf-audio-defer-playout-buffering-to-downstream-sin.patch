diff --git a/audio.go b/audio.go
index ce514be..5e8461b 100644
--- a/audio.go
+++ b/audio.go
@@ -42,6 +42,15 @@ type AudioSink interface {
 	Close() error
 }
 
+// BufferedAudioSink opts into immediate delivery of authenticated, reordered
+// decoder output. The sink owns its playback reservoir and device clock, so
+// meowcaller must not hold another packet or prefill in front of it. Sinks
+// without this capability retain timestamp alignment and the native prefill.
+type BufferedAudioSink interface {
+	AudioSink
+	BuffersAudioPlayout() bool
+}
+
 // SinkFunc adapts a plain function to an AudioSink (Close is a no-op).
 type SinkFunc func(frame []float32)
 
