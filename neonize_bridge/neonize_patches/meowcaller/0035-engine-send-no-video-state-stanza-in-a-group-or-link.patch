 ## [Unreleased]
 
+### engine/group-video — `implemented`
+
+- A group or link call no longer sends a `<video>` state stanza when the
+  camera turns on or off. Captured live from WhatsApp Web, 2026-11-22: its
+  camera on and off put only heartbeats on the wire, and the server answers
+  our stanza with 403.
+
 ### engine/group-relay — `implemented`
 
 - When the relay channel of a group call dies (`abort chunk ... Too many
diff --git a/engine_call_link_test.go b/engine_call_link_test.go
index eb539a9..8e4e821 100644
--- a/engine_call_link_test.go
+++ b/engine_call_link_test.go
@@ -210,3 +210,25 @@ func TestAKeyAlreadyHeldForTheTransactionIsNotDrawnAgain(t *testing.T) {
 	}
 	eng.finishCall("LCID", "test")
 }
+
+func TestAGroupCallSendsNoVideoStateStanza(t *testing.T) {
+	// Live capture of WhatsApp Web (2026-11-22): the camera of a link call changes
+	// nothing on the signaling wire.
+	eng, sent := linkTestEngine(linkJoinAck(false))
+	if _, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{Video: true}); err != nil {
+		t.Fatalf("join: %v", err)
+	}
+	waitForTags(t, sent, 1)
+	before := len(sent.tags())
+	node := waBinary.Node{Tag: "call", Attrs: waBinary.Attrs{"id": "V1"}}
+	if err := eng.transmitVideoState("LCID", node); err != nil {
+		t.Fatalf("transmit: %v", err)
+	}
+	if _, kept := eng.takeVideoStateID("V1"); kept {
+		t.Fatal("a stanza that was not sent leaves no id to answer")
+	}
+	if len(sent.tags()) != before {
+		t.Fatalf("the video state went out: %v", sent.tags())
+	}
+	eng.finishCall("LCID", "test")
+}
