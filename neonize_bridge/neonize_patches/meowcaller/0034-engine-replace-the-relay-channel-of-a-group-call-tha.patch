+
+// unknownPTs is "122=6830 98=4" sorted by payload type: which payload types the
+// demux did not take, so a stream no branch knows (one that is audio to a
+// phone) shows up by number instead of as one anonymous total.
+func (s *audioReceiveStats) unknownPTs() string {
+	types := make([]int, 0, len(s.unknownByPT))
+	for pt := range s.unknownByPT {
+		types = append(types, int(pt))
+	}
+	sort.Ints(types)
+	parts := make([]string, 0, len(types))
+	for _, pt := range types {
+		parts = append(parts, fmt.Sprintf("%d=%d", pt, s.unknownByPT[uint8(pt)]))
+	}
+	return strings.Join(parts, " ")
+}
