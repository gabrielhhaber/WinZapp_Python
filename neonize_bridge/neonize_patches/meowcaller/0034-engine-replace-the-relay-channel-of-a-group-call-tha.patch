diff --git a/relay_reconnect.go b/relay_reconnect.go
new file mode 100644
index 0000000..106f894
--- /dev/null
+++ b/relay_reconnect.go
@@ -0,0 +1,66 @@
+package meowcaller
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	// relayReconnectAttempts is how many times one failure of the relay channel
+	// is retried before the call is left to the silence watchdog.
+	relayReconnectAttempts = 3
+	// relayReconnectMaxRuns bounds consecutive failures that each reconnected but
+	// then failed again without a packet in between.
+	relayReconnectMaxRuns = 5
+)
+
+// relayReconnectDelay is the wait before retry number attempt (0 is the first
+// try, made at once): 2s, then 4s.
+func relayReconnectDelay(attempt int) time.Duration {
+	if attempt <= 0 {
+		return 0
+	}
+	return time.Duration(attempt) * 2 * time.Second
+}
+
+// reconnectGroupRelay opens a new relay channel for a group call whose current
+// one died, on the allocation now in force, through move (the move to a new
+// relay). It reports whether media is flowing on a new channel again.
+func (e *engine) reconnectGroupRelay(
+	ctx context.Context,
+	callID string,
+	moving *atomic.Bool,
+	move func(groupCallUpdate) bool,
+) bool {
+	for attempt := 0; attempt < relayReconnectAttempts; attempt++ {
+		if wait := relayReconnectDelay(attempt); wait > 0 {
+			select {
+			case <-ctx.Done():
+				return false
+			case <-time.After(wait):
+			}
+		}
+		if ctx.Err() != nil {
+			return false
+		}
+		e.mu.Lock()
+		current := e.calls[callID]
+		var update *groupCallUpdate
+		if current != nil && current.group && current.groupUpdate != nil && current.groupUpdate.Relay != nil {
+			cloned := cloneGroupCallUpdate(*current.groupUpdate)
+			update = &cloned
+		}
+		e.mu.Unlock()
+		if update == nil {
+			return false
+		}
+		if !moving.CompareAndSwap(false, true) {
+			continue // a move to a new allocation is already under way
+		}
+		if move(*update) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/relay_reconnect_test.go b/relay_reconnect_test.go
new file mode 100644
index 0000000..170ee01
--- /dev/null
+++ b/relay_reconnect_test.go
@@ -0,0 +1,68 @@
+package meowcaller
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestRelayReconnectDelayGrows(t *testing.T) {
+	if relayReconnectDelay(0) != 0 || relayReconnectDelay(1) != 2*time.Second || relayReconnectDelay(2) != 4*time.Second {
+		t.Fatalf("delays %v %v %v", relayReconnectDelay(0), relayReconnectDelay(1), relayReconnectDelay(2))
+	}
+}
+
+func groupEngineWithRelay(callID string) *engine {
+	e := &engine{calls: map[string]*engineCall{}}
+	e.calls[callID] = &engineCall{group: true, groupUpdate: &groupCallUpdate{CallID: callID, Relay: &groupCallRelay{}}}
+	return e
+}
+
+func TestReconnectGroupRelayStopsAtTheFirstSuccess(t *testing.T) {
+	e := groupEngineWithRelay("c")
+	var moving atomic.Bool
+	tries := 0
+	ok := e.reconnectGroupRelay(context.Background(), "c", &moving, func(groupCallUpdate) bool {
+		tries++
+		moving.Store(false)
+		return true
+	})
+	if !ok || tries != 1 {
+		t.Fatalf("ok=%v tries=%d", ok, tries)
+	}
+}
+
+func TestReconnectGroupRelayGivesUpWithoutAnAllocation(t *testing.T) {
+	e := &engine{calls: map[string]*engineCall{"c": {group: true}}}
+	var moving atomic.Bool
+	if e.reconnectGroupRelay(context.Background(), "c", &moving, func(groupCallUpdate) bool { return true }) {
+		t.Fatal("reconnected with no allocation")
+	}
+}
+
+func TestReconnectGroupRelayStopsWhenTheCallEnds(t *testing.T) {
+	e := groupEngineWithRelay("c")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var moving atomic.Bool
+	if e.reconnectGroupRelay(ctx, "c", &moving, func(groupCallUpdate) bool { return true }) {
+		t.Fatal("reconnected after the call ended")
+	}
+}
+
+func TestSwitchableRelayResumesOnTheNewChannelAfterTheCurrentOneDied(t *testing.T) {
+	old, next := newFakeRelay("old"), newFakeRelay("new")
+	s := newSwitchableRelay(old)
+	defer s.Close()
+	old.fail <- errors.New("Too many retransmissions")
+	if _, err := recvWithin(t, s); err == nil {
+		t.Fatal("the dead current relay did not report")
+	}
+	s.Switch(next, time.Hour)
+	next.in <- []byte("back")
+	if p, err := recvWithin(t, s); err != nil || p != "back" {
+		t.Fatalf("media did not resume on the new channel: %q, %v", p, err)
+	}
+}
