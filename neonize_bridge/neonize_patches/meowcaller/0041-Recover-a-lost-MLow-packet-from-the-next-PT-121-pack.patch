diff --git a/audio_red_recovery.go b/audio_red_recovery.go
new file mode 100644
index 0000000..49a3933
--- /dev/null
+++ b/audio_red_recovery.go
@@ -0,0 +1,118 @@
+package meowcaller
+
+import (
+	"bytes"
+
+	"github.com/purpshell/meowcaller/mlow"
+	"github.com/purpshell/meowcaller/rtp"
+)
+
+// A PT 121 (mlow-red) packet repeats earlier frames in its SplitRed blocks, so
+// the packet after a loss can give the lost frame back instead of concealment
+// inventing it. What a block's time code means is not documented (meowcaller
+// and whatsapp-rust only ever decode the main frame), so no block is trusted
+// by its position alone: a position is used only after this stream proved it,
+// with a block equal, byte for byte, to the main frame of the packet that many
+// sequence numbers back. A sender whose redundancy is a different encoding
+// never proves one, and its losses stay concealed as before.
+const redRecoveryDepth = 3
+
+type redRecoveryMain struct {
+	sequence uint16
+	frame    []byte
+	ok       bool
+}
+
+type redRecovery struct {
+	mains [redRecoveryDepth]redRecoveryMain // the most recent first
+	// back[p-1] = how many packets back the block p-th from the end repeats,
+	// once proven on this stream; 0 while unknown.
+	back [redRecoveryDepth]uint16
+}
+
+// Recover returns, oldest first, the frames of the packets lost just before
+// this one that its SplitRed blocks proved to repeat: the longest run that
+// ends at the packet right before it (anything older is concealed).
+func (r *redRecovery) Recover(payloadType uint8, missing uint16, payload []byte) [][]byte {
+	if payloadType != rtp.RtpPayloadTypeMlowRed || missing == 0 {
+		return nil
+	}
+	frames, err := mlow.DepackSplitRed(payload)
+	if err != nil || len(frames) < 2 {
+		return nil
+	}
+	redundant := frames[:len(frames)-1]
+	var recovered [][]byte
+	for back := uint16(1); back <= missing; back++ {
+		frame := r.blockFor(redundant, back)
+		if frame == nil {
+			break
+		}
+		recovered = append([][]byte{frame}, recovered...)
+	}
+	return recovered
+}
+
+func (r *redRecovery) blockFor(redundant []mlow.MlowFrame, back uint16) []byte {
+	for p := 1; p <= len(redundant) && p <= redRecoveryDepth; p++ {
+		if r.back[p-1] == back {
+			return redundant[len(redundant)-p].Data
+		}
+	}
+	return nil
+}
+
+// Observe records a packet decoded in sequence order and reports whether it
+// proved a block position not proven before.
+func (r *redRecovery) Observe(sequence uint16, payloadType uint8, payload []byte) bool {
+	if payloadType != rtp.RtpPayloadTypeMlowRed {
+		r.mains = [redRecoveryDepth]redRecoveryMain{}
+		return false
+	}
+	frames, err := mlow.DepackSplitRed(payload)
+	if err != nil || len(frames) == 0 {
+		r.mains = [redRecoveryDepth]redRecoveryMain{}
+		return false
+	}
+	proved := false
+	redundant := frames[:len(frames)-1]
+	for p := 1; p <= len(redundant) && p <= redRecoveryDepth; p++ {
+		if r.back[p-1] != 0 {
+			continue
+		}
+		if back := r.provenDistance(sequence, redundant[len(redundant)-p].Data); back != 0 {
+			r.back[p-1] = back
+			proved = true
+		}
+	}
+	copy(r.mains[1:], r.mains[:redRecoveryDepth-1])
+	main := frames[len(frames)-1].Data
+	r.mains[0] = redRecoveryMain{sequence: sequence, frame: append([]byte(nil), main...), ok: true}
+	return proved
+}
+
+// provenDistance returns how many packets back block repeats, or 0 when the
+// remembered main frames cannot tell it unambiguously. The proof needs a full
+// window and exactly one main equal to the block: at the start of a call the
+// mains are often identical (silence, comfort noise), and a block matching
+// several of them, or one whose older neighbour is not yet known, would prove
+// a wrong distance for the rest of the call and replay an older frame on
+// every recovery.
+func (r *redRecovery) provenDistance(sequence uint16, block []byte) uint16 {
+	if len(block) == 0 {
+		return 0
+	}
+	var back uint16
+	for _, main := range r.mains {
+		if !main.ok {
+			return 0
+		}
+		if bytes.Equal(block, main.frame) {
+			if back != 0 {
+				return 0
+			}
+			back = sequence - main.sequence
+		}
+	}
+	return back
+}
diff --git a/audio_red_recovery_test.go b/audio_red_recovery_test.go
new file mode 100644
index 0000000..af6530c
--- /dev/null
+++ b/audio_red_recovery_test.go
@@ -0,0 +1,212 @@
+package meowcaller
+
+import (
+	"bytes"
+	"math"
+	"testing"
+	"time"
+
+	"github.com/purpshell/meowcaller/rtp"
+)
+
+func redTestFrames(t *testing.T, count int) [][]byte {
+	t.Helper()
+	encoder, err := newCallAudioEncoder(AudioCodecMlow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var frames [][]byte
+	for n := 0; n < count; n++ {
+		pcm := make([]float32, FrameSamples)
+		for i := range pcm {
+			pcm[i] = float32(.3 * math.Sin(2*math.Pi*220*float64(i+n*FrameSamples)/SampleRate))
+		}
+		frame, err := encoder.Encode(pcm)
+		if err != nil {
+			t.Fatal(err)
+		}
+		frames = append(frames, frame)
+	}
+	return frames
+}
+
+func TestRedRecoveryTrustsOnlyAProvenBlockPosition(t *testing.T) {
+	x, y, a, b, c, d := []byte{0x50, 7}, []byte{0x50, 8}, []byte{0x50, 1}, []byte{0x50, 2}, []byte{0x50, 3}, []byte{0x50, 4}
+	var r redRecovery
+	if r.Observe(8, rtp.RtpPayloadTypeMlowRed, splitRed(x, x)) {
+		t.Fatal("the first packet has nothing before it to prove a block against")
+	}
+	if r.Observe(9, rtp.RtpPayloadTypeMlowRed, splitRed(x, y)) {
+		t.Fatal("a block proved its position before the window of main frames was full")
+	}
+	r.Observe(10, rtp.RtpPayloadTypeMlowRed, splitRed(y, a))
+	if got := r.Recover(rtp.RtpPayloadTypeMlowRed, 1, splitRed(c, d)); got != nil {
+		t.Fatalf("an unproven block was trusted: %v", got)
+	}
+	if !r.Observe(11, rtp.RtpPayloadTypeMlowRed, splitRed(a, b)) {
+		t.Fatal("a block equal to the previous main frame did not prove its position")
+	}
+	got := r.Recover(rtp.RtpPayloadTypeMlowRed, 1, splitRed(c, d))
+	if len(got) != 1 || !bytes.Equal(got[0], c) {
+		t.Fatalf("recovered %v, want the block repeating the lost frame", got)
+	}
+	// One redundant block covers only the packet right before: an older loss stays concealed.
+	if got := r.Recover(rtp.RtpPayloadTypeMlowRed, 2, splitRed(c, d)); len(got) != 1 {
+		t.Fatalf("recovered %d frames for 2 losses with one block, want 1", len(got))
+	}
+	if r.Recover(rtp.RtpPayloadTypeOpus, 1, splitRed(c, d)) != nil {
+		t.Fatal("a payload that is not PT 121 has no redundancy")
+	}
+}
+
+func TestRedRecoveryNeverProvesAReencodedRedundancy(t *testing.T) {
+	var r redRecovery
+	r.Observe(1, rtp.RtpPayloadTypeMlowRed, splitRed([]byte{0x50, 9}, []byte{0x50, 1}))
+	if r.Observe(2, rtp.RtpPayloadTypeMlowRed, splitRed([]byte{0x50, 7}, []byte{0x50, 2})) {
+		t.Fatal("a block that differs from the earlier main frame proved a position")
+	}
+	if r.Recover(rtp.RtpPayloadTypeMlowRed, 1, splitRed([]byte{0x50, 8}, []byte{0x50, 4})) != nil {
+		t.Fatal("redundancy that never matched was used")
+	}
+}
+
+// At the start of a call the main frames are often identical (silence,
+// comfort noise): a block equal to several of them tells no distance, and
+// trusting the first match would replay an older frame on every recovery.
+func TestRedRecoveryRefusesAProofAmongIdenticalMainFrames(t *testing.T) {
+	silence, voice, next := []byte{0x50, 0}, []byte{0x50, 1}, []byte{0x50, 2}
+	var r redRecovery
+	for seq := uint16(1); seq <= 4; seq++ {
+		if r.Observe(seq, rtp.RtpPayloadTypeMlowRed, splitRed(silence, silence)) {
+			t.Fatalf("packet %d proved a distance among identical main frames", seq)
+		}
+	}
+	if r.Recover(rtp.RtpPayloadTypeMlowRed, 1, splitRed(voice, next)) != nil {
+		t.Fatal("a block position was trusted although no proof was unambiguous")
+	}
+	// Speech starts: once the window holds distinct frames the real distance is proven.
+	r.Observe(5, rtp.RtpPayloadTypeMlowRed, splitRed(silence, voice))
+	r.Observe(6, rtp.RtpPayloadTypeMlowRed, splitRed(voice, next))
+	if r.back[0] != 1 {
+		t.Fatalf("proved distance %d, want 1", r.back[0])
+	}
+}
+
+// A PT 121 stream that loses a packet: once the stream has shown its blocks
+// repeat the previous frame, the lost frame comes back from the next packet,
+// decoded exactly as a receiver that lost nothing decodes it, instead of being
+// invented by concealment.
+func TestReceiveAudioRecoversALostPacketFromTheNextRedPacket(t *testing.T) {
+	frames := redTestFrames(t, 8)
+	self, peer := mediaTestJID("100", 1), mediaTestJID("200", 2)
+	key := bytes.Repeat([]byte{7}, 32)
+	registry, err := newParticipantReceiveRegistry("CID", key, self.String(), peer.String(),
+		func() participantAudioDecoder { return newCallAudioDecoder(AudioCodecMlow) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer registry.clear()
+	ssrc, _ := rtp.DeriveWasmParticipantSsrc("CID", rtp.FormatE2ESrtpParticipantID(peer.String()), 0)
+	tx, err := NewMediaPipeline(key, peer.String(), self.String(), ssrc, 2880)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reference := newCallAudioDecoder(AudioCodecMlow)
+	var want [][]float32
+	for n, frame := range frames {
+		want = append(want, decodeAudioPayload(reference, rtp.RtpPayloadTypeMlowRed, splitRed(frames[max(0, n-1)], frame)))
+	}
+
+	now := time.Unix(0, 0)
+	var got []decodedParticipantAudio
+	for n, frame := range frames {
+		now = now.Add(60 * time.Millisecond)
+		if n == 5 {
+			continue // lost on the network
+		}
+		payload := splitRed(frames[max(0, n-1)], frame)
+		packet, err := tx.ProtectRTP(&rtp.RtpHeader{Ssrc: ssrc, SequenceNumber: uint16(n + 1),
+			Timestamp: uint32(n) * 2880, PayloadType: rtp.RtpPayloadTypeMlowRed}, payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		out, ok := registry.ReceiveAudio(packet, 48000, now)
+		if !ok {
+			t.Fatalf("packet %d not authenticated", n)
+		}
+		got = append(got, out...)
+	}
+	var recovered *decodedParticipantAudio
+	for i := range got {
+		if got[i].Concealed {
+			t.Fatalf("frame at %d was concealed although the next packet repeated it", got[i].Timestamp)
+		}
+		if got[i].Recovered {
+			recovered = &got[i]
+		}
+	}
+	if recovered == nil {
+		t.Fatal("the lost packet was not recovered")
+	}
+	if recovered.Timestamp != 5*FrameSamples {
+		t.Fatalf("recovered frame at %d, want %d", recovered.Timestamp, 5*FrameSamples)
+	}
+	if len(recovered.PCM) != len(want[5]) {
+		t.Fatalf("recovered %d samples, want %d", len(recovered.PCM), len(want[5]))
+	}
+	for i := range want[5] {
+		if recovered.PCM[i] != want[5][i] {
+			t.Fatalf("recovered sample %d: %v, want %v", i, recovered.PCM[i], want[5][i])
+		}
+	}
+	last := got[len(got)-1]
+	for i := range want[7] {
+		if last.PCM[i] != want[7][i] {
+			t.Fatal("the decoder state after the recovery differs from a lossless stream")
+		}
+	}
+}
+
+// Before the stream has proven its redundancy (here, the very first loss), the
+// lost packet is concealed exactly as before.
+func TestReceiveAudioConcealsALossBeforeRedundancyIsProven(t *testing.T) {
+	frames := redTestFrames(t, 4)
+	self, peer := mediaTestJID("100", 1), mediaTestJID("200", 2)
+	key := bytes.Repeat([]byte{7}, 32)
+	registry, err := newParticipantReceiveRegistry("CID", key, self.String(), peer.String(),
+		func() participantAudioDecoder { return newCallAudioDecoder(AudioCodecMlow) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer registry.clear()
+	ssrc, _ := rtp.DeriveWasmParticipantSsrc("CID", rtp.FormatE2ESrtpParticipantID(peer.String()), 0)
+	tx, err := NewMediaPipeline(key, peer.String(), self.String(), ssrc, 2880)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Unix(0, 0)
+	var concealed, recovered int
+	for n, frame := range frames {
+		now = now.Add(60 * time.Millisecond)
+		if n == 1 {
+			continue
+		}
+		packet, err := tx.ProtectRTP(&rtp.RtpHeader{Ssrc: ssrc, SequenceNumber: uint16(n + 1),
+			Timestamp: uint32(n) * 2880, PayloadType: rtp.RtpPayloadTypeMlowRed}, splitRed(frames[max(0, n-1)], frame))
+		if err != nil {
+			t.Fatal(err)
+		}
+		out, _ := registry.ReceiveAudio(packet, 48000, now)
+		for _, frame := range out {
+			if frame.Concealed {
+				concealed++
+			}
+			if frame.Recovered {
+				recovered++
+			}
+		}
+	}
+	if concealed != 1 || recovered != 0 {
+		t.Fatalf("concealed %d, recovered %d; want 1 and 0", concealed, recovered)
+	}
+}
