@@ -132,6 +132,25 @@ func (d *callAudioDecoder) DecodeRed(payload []byte) []float32 {
 	return output
 }
 
+// DecodeRecovered decodes an MLow frame recovered from a PT 121 packet's
+// redundant block, standing in for the packet that was lost before it. Opus
+// never travels as PT 121: nothing is recovered and the loss is concealed.
+func (d *callAudioDecoder) DecodeRecovered(frame []byte) []float32 {
+	if d.codec == AudioCodecOpus {
+		return nil
+	}
+	d.decodedOpus = false
+	output := d.mlow.DecodeRecovered(frame)
+	if len(output) == 0 {
+		return nil
+	}
+	if d.PCMRate() == FullbandSampleRate {
+		output = d.up.convert(output, true)
+	}
+	d.last = append(d.last[:0], output...)
+	return output
+}
+
