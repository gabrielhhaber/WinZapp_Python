From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 03:07:33 +0000
Subject: [PATCH] Keep a group device's PID when a later roster omits it

The server sends a connected device's PID only in the group update where it
joins; every later update is a full roster listing the same connected device
without a PID. Receivers were rebuilt from devices carrying a PID in the
current update, so after the next update every remote but the fallback peer
lost its receiver and its audio was dropped as not matching an authenticated
active participant.

A connected device that was already registered with a PID now keeps it. A
device that leaves the roster or stops being connected is still dropped.
---
 group_media_receive.go      | 25 ++++++++++++++++---
 group_media_receive_test.go | 48 +++++++++++++++++++++++++++++++++++--
 2 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/group_media_receive.go b/group_media_receive.go
index 80cf5fa..59d567d 100644
--- a/group_media_receive.go
+++ b/group_media_receive.go
@@ -291,14 +291,21 @@ func (r *participantReceiveRegistry) prepareGroupUpdateLocked(
 			continue
 		}
 		for _, device := range participant.Devices {
-			if !device.HasPID {
-				continue
-			}
 			// Source of truth: https://github.com/purpshell/meowcaller/blob/e34f414e423e6e45863d19dcfdd7e658f5f1314a/datasheets/group-media-receive.md#L24-L42
 			participantID := rtp.FormatE2ESrtpParticipantID(device.JID.String())
 			if participantID == r.selfID {
 				continue
 			}
+			// The server sends the PID only in the update where a device joins;
+			// later full rosters list the same connected device without it. Keep
+			// the PID learned earlier instead of dropping the receiver.
+			if !device.HasPID {
+				known, ok := r.knownPIDLocked(participantID)
+				if !ok {
+					continue
+				}
+				device.PID, device.HasPID = known, true
+			}
 			hasConnectedRemotePID = true
 			if _, exists := prepared.byDeviceID[participantID]; exists {
 				prepared.clear(true)
@@ -416,6 +423,18 @@ func (r *participantReceiveRegistry) prepareGroupUpdateLocked(
 	return prepared, nil
 }
 
+// knownPIDLocked returns the PID a still-registered device was given by an
+// earlier group update. r.mu must be held.
+func (r *participantReceiveRegistry) knownPIDLocked(participantID string) (uint32, bool) {
+	receiver := r.byDeviceID[participantID]
+	if receiver == nil {
+		return 0, false
+	}
+	receiver.mu.Lock()
+	defer receiver.mu.Unlock()
+	return receiver.pid, receiver.hasPID
+}
+
 func (r *participantReceiveRegistry) commitGroupUpdateLocked(prepared *preparedParticipantReceiveUpdate) {
 	// Source of truth: https://github.com/purpshell/meowcaller/blob/65b1dbf33f365db7392e438c3e3bf3651decb6cf/datasheets/group-media-receive.md#L122-L137
 	for participantID, receiver := range r.byDeviceID {
diff --git a/group_media_receive_test.go b/group_media_receive_test.go
index 46e25ed..d811948 100644
--- a/group_media_receive_test.go
+++ b/group_media_receive_test.go
@@ -1028,8 +1028,10 @@ func TestParticipantReceiveRegistryPrePIDUpdatePrunesNonFallbackReceivers(t *tes
 	if len(registry.byDeviceID) != 1 || registry.byDeviceID[registry.fallbackID] != fallback {
 		t.Fatalf("pre-PID active devices = %v, want only fallback", registry.ActiveParticipantIDs())
 	}
-	if len(registry.byPID) != 0 {
-		t.Fatalf("pre-PID active PID count = %d, want 0", len(registry.byPID))
+	// The peer was given a PID by the earlier update and is still connected,
+	// so it keeps it; the device missing from the roster is pruned.
+	if len(registry.byPID) != 1 || registry.byPID[0] != fallback {
+		t.Fatalf("pre-PID active PID count = %d, want only the peer's kept PID", len(registry.byPID))
 	}
 	if _, ok := registry.bySSRC[addedReceiver.ssrc]; ok {
 		t.Fatal("pre-PID update retained non-fallback participant SSRC")
@@ -1427,3 +1429,45 @@ func TestParticipantReceiveRegistryDepartureWaitsForInFlightDecode(t *testing.T)
 		t.Fatal("departed participant produced audio after pruning completed")
 	}
 }
+
+func TestParticipantReceiveRegistryKeepsPIDWhenLaterRosterOmitsIt(t *testing.T) {
+	callKey := iota32()
+	self := mediaTestJID("111111111111111", 14)
+	peer := mediaTestJID("222222222222222", 0)
+	other := mediaTestJID("333333333333333", 43)
+	registry, err := newParticipantReceiveRegistry("CID", callKey, self.String(), peer.String(), func() participantAudioDecoder {
+		return &recordingParticipantDecoder{}
+	})
+	if err != nil {
+		t.Fatalf("new registry: %v", err)
+	}
+	roster := func(tx uint32, state string, pid uint32, hasPID bool) groupCallUpdate {
+		return groupCallUpdate{CallID: "CID", TransactionID: tx, Participants: []groupCallParticipant{
+			{JID: self.ToNonAD(), State: "connected", Devices: []groupCallDevice{{JID: self}}},
+			{JID: other.ToNonAD(), State: state, Devices: []groupCallDevice{{JID: other, PID: pid, HasPID: hasPID}}},
+		}}
+	}
+	if err = registry.ApplyGroupUpdate(roster(5, "connected", 7, true)); err != nil {
+		t.Fatalf("join update: %v", err)
+	}
+	joined := registry.byDeviceID[rtp.FormatE2ESrtpParticipantID(other.String())]
+	if joined == nil {
+		t.Fatal("device with PID was not registered")
+	}
+	if err = registry.ApplyGroupUpdate(roster(6, "connected", 0, false)); err != nil {
+		t.Fatalf("later update: %v", err)
+	}
+	if registry.byDeviceID[rtp.FormatE2ESrtpParticipantID(other.String())] != joined || registry.byPID[7] != joined {
+		t.Fatal("a later roster without PID dropped the authenticated device")
+	}
+	packet, _ := protectParticipantAudio(t, callKey, self, other, []byte{0x62})
+	if _, ok := registry.DecodeAudio(packet); !ok {
+		t.Fatal("audio from a device whose PID came earlier was rejected")
+	}
+	if err = registry.ApplyGroupUpdate(roster(7, "left", 0, false)); err != nil {
+		t.Fatalf("leave update: %v", err)
+	}
+	if registry.byDeviceID[rtp.FormatE2ESrtpParticipantID(other.String())] != nil {
+		t.Fatal("a device that left kept its receiver")
+	}
+}
