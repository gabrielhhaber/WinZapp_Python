diff --git a/rtcp_report_diag.go b/rtcp_report_diag.go
new file mode 100644
index 0000000..f180a15
--- /dev/null
+++ b/rtcp_report_diag.go
@@ -0,0 +1,45 @@
+package meowcaller
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/purpshell/meowcaller/rtp"
+)
+
+// rtcpReportLogTicks: after a call's media turns to group media, the reception
+// reports of the first ticks are all logged (the sender a converted call lost
+// stopped about 5 s in), then one tick in rtcpReportLogEvery (30 s at 1.5 s).
+const (
+	rtcpReportLogTicks = 8
+	rtcpReportLogEvery = 20
+)
+
+// shouldLogRTCPReports says whether the reports of tick `sinceGroup` (ticks
+// since group media started, -1 while the call is still one to one) and of
+// `tick` (all ticks) are worth a log line.
+func shouldLogRTCPReports(sinceGroup, tick int) bool {
+	if sinceGroup >= 0 && sinceGroup < rtcpReportLogTicks {
+		return true
+	}
+	return tick%rtcpReportLogEvery == 0
+}
+
+// describeRTCPReports is what this client tells the senders it hears, one
+// stream per entry: "ssrc 0x7aa6be3b lost=0/256 cum=3 seq=1234 jitter=5".
+// FractionLost is out of 256, as on the wire.
+func describeRTCPReports(reports []*rtp.RtcpReceptionReport) string {
+	parts := make([]string, 0, len(reports))
+	for _, report := range reports {
+		if report == nil {
+			continue
+		}
+		parts = append(parts, fmt.Sprintf("ssrc 0x%08x lost=%d/256 cum=%d seq=%d jitter=%d",
+			report.Ssrc, report.FractionLost, report.CumulativeLost,
+			report.ExtendedHighestSequence, report.Jitter))
+	}
+	if len(parts) == 0 {
+		return "none"
+	}
+	return strings.Join(parts, "; ")
+}
diff --git a/rtcp_report_diag_test.go b/rtcp_report_diag_test.go
new file mode 100644
index 0000000..f720e18
--- /dev/null
+++ b/rtcp_report_diag_test.go
@@ -0,0 +1,44 @@
+package meowcaller
+
+import (
+	"testing"
+
+	"github.com/purpshell/meowcaller/rtp"
+)
+
+func TestRTCPReportsAreDescribedPerStream(t *testing.T) {
+	got := describeRTCPReports([]*rtp.RtcpReceptionReport{
+		{Ssrc: 0x7aa6be3b, FractionLost: 255, CumulativeLost: 40, ExtendedHighestSequence: 1234, Jitter: 5},
+		nil,
+		{Ssrc: 1, ExtendedHighestSequence: 7},
+	})
+	want := "ssrc 0x7aa6be3b lost=255/256 cum=40 seq=1234 jitter=5; ssrc 0x00000001 lost=0/256 cum=0 seq=7 jitter=0"
+	if got != want {
+		t.Fatalf("describeRTCPReports = %q", got)
+	}
+	if describeRTCPReports(nil) != "none" {
+		t.Fatal("no report is none")
+	}
+}
+
+func TestRTCPReportsAreLoggedRightAfterGroupMediaThenEvery30s(t *testing.T) {
+	var logged []int
+	for tick := 1; tick <= 45; tick++ {
+		sinceGroup := -1
+		if tick >= 10 {
+			sinceGroup = tick - 10
+		}
+		if shouldLogRTCPReports(sinceGroup, tick) {
+			logged = append(logged, tick)
+		}
+	}
+	want := []int{10, 11, 12, 13, 14, 15, 16, 17, 20, 40}
+	if len(logged) != len(want) {
+		t.Fatalf("logged ticks %v, want %v", logged, want)
+	}
+	for i := range want {
+		if logged[i] != want[i] {
+			t.Fatalf("logged ticks %v, want %v", logged, want)
+		}
+	}
+}
