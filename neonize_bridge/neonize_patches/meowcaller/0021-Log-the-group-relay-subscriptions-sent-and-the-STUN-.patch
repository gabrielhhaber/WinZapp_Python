 }
+
+func TestTheGroupSubscriptionIsDescribedWithoutSecrets(t *testing.T) {
+	relay := &groupCallRelay{TransactionID: 6, SelfPID: 2, HasSelfPID: true, Key: []byte("secret"),
+		Tokens:    [][]byte{[]byte("token0"), []byte("token1")},
+		Endpoints: []groupCallRelayEndpoint{{RelayName: "gig4c01", TokenID: 0}, {RelayName: "gru2c02", TokenID: 1}}}
+	got := describeGroupSubscription("gru2c02", relay, []uint32{3, 4})
+	if got != "relay=gru2c02 tx=6 token=1 self_pid=2 subscribed=[3,4]" {
+		t.Fatalf("got %q", got)
+	}
+	if describeGroupSubscription("x", nil, nil) != "none" {
+		t.Fatal("no relay is none")
+	}
+}
+
+func TestTheRelayTrafficNamesTheSTUNTypesItGot(t *testing.T) {
+	var traffic relayTraffic
+	if traffic.stunTypeTotals() != "" {
+		t.Fatal("no STUN yet")
+	}
+	for _, messageType := range []uint16{0x0802, 0x0103, 0x0802, 0x0113} {
+		traffic.noteStunType(messageType)
+	}
+	if got := traffic.stunTypeTotals(); got != "0x0103=1 0x0113=1 0x0802=2" {
+		t.Fatalf("got %q", got)
+	}
+}
diff --git a/relay_traffic.go b/relay_traffic.go
index 1011bed..4aa4de7 100644
--- a/relay_traffic.go
+++ b/relay_traffic.go
@@ -3,6 +3,9 @@ package meowcaller
 import (
 	"context"
 	"fmt"
+	"sort"
+	"strings"
+	"sync"
 	"sync/atomic"
 	"time"
 
@@ -18,6 +21,37 @@ const relayTrafficInterval = 5 * time.Second
 // seconds" and whether SRTCP or STUN kept coming. It only counts.
 type relayTraffic struct {
 	rtp, rtcp, stun, other atomic.Uint64
+
+	// The STUN message types the relay answered with, so "stun=10" says
+	// whether that was allocate-success and pong, or an allocate error.
+	stunMu    sync.Mutex
+	stunTypes map[uint16]uint64
+}
+
+// noteStunType counts one STUN message type the relay sent.
+func (t *relayTraffic) noteStunType(messageType uint16) {
+	t.stunMu.Lock()
+	defer t.stunMu.Unlock()
+	if t.stunTypes == nil {
+		t.stunTypes = make(map[uint16]uint64)
+	}
+	t.stunTypes[messageType]++
+}
+
+// stunTypeTotals is "0x0103=5 0x0802=5", sorted by type; "" when none came.
+func (t *relayTraffic) stunTypeTotals() string {
+	t.stunMu.Lock()
+	defer t.stunMu.Unlock()
+	types := make([]int, 0, len(t.stunTypes))
+	for messageType := range t.stunTypes {
+		types = append(types, int(messageType))
+	}
+	sort.Ints(types)
+	parts := make([]string, 0, len(types))
+	for _, messageType := range types {
+		parts = append(parts, fmt.Sprintf("0x%04x=%d", messageType, t.stunTypes[uint16(messageType)]))
+	}
+	return strings.Join(parts, " ")
 }
 
 type relayTrafficCounts struct{ rtp, rtcp, stun, other uint64 }
@@ -63,6 +97,7 @@ func (t *relayTraffic) watch(ctx context.Context, log zerolog.Logger, interval t
 		log.Info().
 			Str("last_window", now.since(previous).String()).
 			Str("totals", now.String()).
+			Str("stun_types", t.stunTypeTotals()).
 			Msg("relay traffic by kind")
 		previous = now
 	}
