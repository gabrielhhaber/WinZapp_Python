diff --git a/relay_diag.go b/relay_diag.go
index 6a868cd..dbf987e 100644
--- a/relay_diag.go
+++ b/relay_diag.go
@@ -44,3 +44,31 @@ func relayChoiceChanged(old, updated *relayData, inbound bool) bool {
 	}
 	return a.relayName != b.relayName || a.isFNA != b.isFNA
 }
+
+// describeGroupSubscription is what a group allocate told the relay, for the
+// log: the relay and token it went to, this device's PID in the allocation and
+// the PIDs it subscribed to (small numbers, never a token or a key). It exists
+// because a joiner whose relay answered every allocate yet forwarded nothing,
+// either way, left no trace of what it had asked for.
+func describeGroupSubscription(relayName string, relay *groupCallRelay, pids []uint32) string {
+	if relay == nil {
+		return "none"
+	}
+	token := "?"
+	for _, endpoint := range relay.Endpoints {
+		if endpoint.RelayName == relayName {
+			token = fmt.Sprint(endpoint.TokenID)
+			break
+		}
+	}
+	self := "?"
+	if relay.HasSelfPID {
+		self = fmt.Sprint(relay.SelfPID)
+	}
+	subscribed := make([]string, len(pids))
+	for i, pid := range pids {
+		subscribed[i] = fmt.Sprint(pid)
+	}
+	return fmt.Sprintf("relay=%s tx=%d token=%s self_pid=%s subscribed=[%s]",
+		relayName, relay.TransactionID, token, self, strings.Join(subscribed, ","))
+}
