 relay_diag.go        | 28 ++++++++++++++++++++++++++++
 relay_switch_test.go | 26 ++++++++++++++++++++++++++
 relay_traffic.go     | 35 +++++++++++++++++++++++++++++++++++
 4 files changed, 108 insertions(+), 3 deletions(-)

