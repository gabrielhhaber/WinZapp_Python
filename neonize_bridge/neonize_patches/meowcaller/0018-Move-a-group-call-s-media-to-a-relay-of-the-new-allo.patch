diff --git a/relay_switch.go b/relay_switch.go
new file mode 100644
index 0000000..6c04b60
--- /dev/null
+++ b/relay_switch.go
@@ -0,0 +1,163 @@
+package meowcaller
+
+import (
+	"errors"
+	"io"
+	"sync"
+	"time"
+)
+
+// relayConn is what the media loop needs of a relay channel.
+type relayConn interface {
+	Send([]byte) (int, error)
+	Recv([]byte) (int, error)
+	Close() error
+}
+
+// relayRetireDelay is how long a replaced relay keeps delivering after the
+// media moved to another one, so packets already in flight are still played.
+const relayRetireDelay = 5 * time.Second
+
+// relayMoveRetry spaces the attempts to move to a new allocation's relay when
+// one fails, so a relay that cannot be reached is not dialed every second.
+const relayMoveRetry = 10 * time.Second
+
+// errActiveRelayMissing marks a group allocation that no longer lists the
+// relay the media runs on: the media has to move to one it lists.
+var errActiveRelayMissing = errors.New("meowcaller: active relay missing from group allocation")
+
+// switchableRelay is the media loop's relay channel when a group call may move
+// to another relay mid-call, without a gap: it sends on the current relay and
+// receives from every relay still open, and a relay it switched away from is
+// closed only after relayRetireDelay. An error ends Recv only when it comes
+// from the current relay.
+type switchableRelay struct {
+	mu        sync.Mutex
+	current   relayConn
+	open      map[relayConn]struct{}
+	packets   chan []byte
+	errs      chan error
+	closed    chan struct{}
+	closeOnce sync.Once
+}
+
+func newSwitchableRelay(first relayConn) *switchableRelay {
+	s := &switchableRelay{
+		current: first,
+		open:    make(map[relayConn]struct{}),
+		packets: make(chan []byte, 256),
+		errs:    make(chan error, 1),
+		closed:  make(chan struct{}),
+	}
+	s.start(first)
+	return s
+}
+
+// start reads from c until it fails. A call that ended while a move to c was
+// under way (Close has run) has nobody left to close c, so start does: it
+// returns false for a relay it did not take.
+func (s *switchableRelay) start(c relayConn) bool {
+	s.mu.Lock()
+	select {
+	case <-s.closed:
+		s.mu.Unlock()
+		_ = c.Close()
+		return false
+	default:
+	}
+	s.open[c] = struct{}{}
+	s.mu.Unlock()
+	go func() {
+		for {
+			buf := make([]byte, 1500)
+			n, err := c.Recv(buf)
+			if err != nil {
+				s.readerDone(c, err)
+				return
+			}
+			select {
+			case s.packets <- buf[:n]:
+			case <-s.closed:
+				return
+			}
+		}
+	}()
+	return true
+}
+
+func (s *switchableRelay) readerDone(c relayConn, err error) {
+	s.mu.Lock()
+	delete(s.open, c)
+	isCurrent := c == s.current
+	s.mu.Unlock()
+	if !isCurrent {
+		return // a retired relay going away is expected
+	}
+	select {
+	case s.errs <- err:
+	default:
+	}
+}
+
+// Send writes to the current relay.
+func (s *switchableRelay) Send(data []byte) (int, error) {
+	s.mu.Lock()
+	c := s.current
+	s.mu.Unlock()
+	return c.Send(data)
+}
+
+// Recv returns the next packet from any open relay.
+func (s *switchableRelay) Recv(buf []byte) (int, error) {
+	select {
+	case p := <-s.packets:
+		return copy(buf, p), nil
+	case err := <-s.errs:
+		return 0, err
+	case <-s.closed:
+		return 0, io.EOF
+	}
+}
+
+// Switch makes next the relay sends go to; the previous one keeps delivering
+// for retire before it is closed.
+func (s *switchableRelay) Switch(next relayConn, retire time.Duration) {
+	if !s.start(next) {
+		return
+	}
+	s.mu.Lock()
+	previous := s.current
+	s.current = next
+	s.mu.Unlock()
+	if previous == nil || previous == next {
+		return
+	}
+	time.AfterFunc(retire, func() {
+		select {
+		case <-s.closed:
+			return // Close already closed it
+		default:
+		}
+		_ = previous.Close()
+	})
+}
+
+// Close closes every relay still open.
+func (s *switchableRelay) Close() error {
+	s.closeOnce.Do(func() {
+		close(s.closed)
+		s.mu.Lock()
+		conns := make([]relayConn, 0, len(s.open)+1)
+		for c := range s.open {
+			conns = append(conns, c)
+		}
+		if _, ok := s.open[s.current]; !ok && s.current != nil {
+			conns = append(conns, s.current)
+		}
+		s.mu.Unlock()
+		for _, c := range conns {
+			_ = c.Close()
+		}
+	})
+	return nil
+}
diff --git a/relay_switch_test.go b/relay_switch_test.go
new file mode 100644
index 0000000..311ca4f
--- /dev/null
+++ b/relay_switch_test.go
@@ -0,0 +1,165 @@
+package meowcaller
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+type fakeRelay struct {
+	name   string
+	in     chan []byte
+	fail   chan error
+	mu     sync.Mutex
+	sent   [][]byte
+	closed bool
+	done   chan struct{}
+}
+
+func newFakeRelay(name string) *fakeRelay {
+	return &fakeRelay{name: name, in: make(chan []byte, 8), fail: make(chan error, 1), done: make(chan struct{})}
+}
+
+func (f *fakeRelay) Send(p []byte) (int, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.sent = append(f.sent, append([]byte(nil), p...))
+	return len(p), nil
+}
+
+func (f *fakeRelay) Recv(buf []byte) (int, error) {
+	select {
+	case p := <-f.in:
+		return copy(buf, p), nil
+	case err := <-f.fail:
+		return 0, err
+	case <-f.done:
+		return 0, errors.New(f.name + " closed")
+	}
+}
+
+func (f *fakeRelay) Close() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.closed {
+		f.closed = true
+		close(f.done)
+	}
+	return nil
+}
+
+func (f *fakeRelay) isClosed() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.closed
+}
+
+func (f *fakeRelay) sentCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return len(f.sent)
+}
+
+func recvWithin(t *testing.T, s *switchableRelay) (string, error) {
+	t.Helper()
+	type out struct {
+		p   string
+		err error
+	}
+	got := make(chan out, 1)
+	go func() {
+		buf := make([]byte, 64)
+		n, err := s.Recv(buf)
+		got <- out{string(buf[:n]), err}
+	}()
+	select {
+	case o := <-got:
+		return o.p, o.err
+	case <-time.After(2 * time.Second):
+		t.Fatal("Recv blocked")
+		return "", nil
+	}
+}
+
+// Moving a group call to another relay leaves no gap: sends go to the new
+// relay at once, packets still arriving on the old one are played, and the old
+// one is closed only after the retire delay.
+func TestSwitchableRelayMovesWithoutAGap(t *testing.T) {
+	old, next := newFakeRelay("old"), newFakeRelay("new")
+	s := newSwitchableRelay(old)
+	defer s.Close()
+	_, _ = s.Send([]byte("a"))
+	s.Switch(next, 100*time.Millisecond)
+	_, _ = s.Send([]byte("b"))
+	if old.sentCount() != 1 || next.sentCount() != 1 {
+		t.Fatalf("sent old=%d new=%d, want 1 and 1", old.sentCount(), next.sentCount())
+	}
+	old.in <- []byte("late")
+	if p, err := recvWithin(t, s); err != nil || p != "late" {
+		t.Fatalf("packet from the old relay = %q, %v", p, err)
+	}
+	next.in <- []byte("fresh")
+	if p, err := recvWithin(t, s); err != nil || p != "fresh" {
+		t.Fatalf("packet from the new relay = %q, %v", p, err)
+	}
+	if old.isClosed() {
+		t.Fatal("the old relay closed before the retire delay")
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for !old.isClosed() && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if !old.isClosed() {
+		t.Fatal("the old relay was never closed")
+	}
+	next.in <- []byte("after")
+	if p, err := recvWithin(t, s); err != nil || p != "after" {
+		t.Fatalf("the retired relay closing ended the media: %q, %v", p, err)
+	}
+}
+
+func TestSwitchableRelayEndsOnlyWhenTheCurrentRelayFails(t *testing.T) {
+	old, next := newFakeRelay("old"), newFakeRelay("new")
+	s := newSwitchableRelay(old)
+	defer s.Close()
+	s.Switch(next, time.Hour)
+	old.fail <- errors.New("old gone")
+	next.in <- []byte("still")
+	if p, err := recvWithin(t, s); err != nil || p != "still" {
+		t.Fatalf("a retired relay failing ended the media: %q, %v", p, err)
+	}
+	next.fail <- errors.New("current gone")
+	if _, err := recvWithin(t, s); err == nil {
+		t.Fatal("the current relay failing did not end the media")
+	}
+}
+
+func TestSwitchableRelayCloseClosesEveryRelay(t *testing.T) {
+	old, next := newFakeRelay("old"), newFakeRelay("new")
+	s := newSwitchableRelay(old)
+	s.Switch(next, time.Hour)
+	_ = s.Close()
+	if !old.isClosed() || !next.isClosed() {
+		t.Fatalf("closed old=%v new=%v", old.isClosed(), next.isClosed())
+	}
+	if _, err := recvWithin(t, s); err == nil {
+		t.Fatal("Recv after Close returned a packet")
+	}
+}
+
+func TestSwitchableRelaySwitchAfterCloseClosesTheNewRelay(t *testing.T) {
+	first, next := newFakeRelay("first"), newFakeRelay("next")
+	s := newSwitchableRelay(first)
+	_ = s.Close()
+	s.Switch(next, time.Millisecond)
+	if !next.isClosed() {
+		t.Fatal("a relay opened after the call ended is closed, not leaked")
+	}
+	if s.current != first {
+		t.Fatal("the call's current relay does not move after Close")
+	}
+	if _, err := s.Recv(make([]byte, 8)); err == nil {
+		t.Fatal("Recv on a closed relay fails")
+	}
+}
diff --git a/roster_diag.go b/roster_diag.go
index d6aca3a..b010edb 100644
--- a/roster_diag.go
+++ b/roster_diag.go
@@ -37,3 +37,16 @@ func describeGroupRoster(update groupCallUpdate) string {
 	return fmt.Sprintf("participants=%d %s connected_devices=%d with_pid=%d",
 		len(update.Participants), strings.Join(parts, ","), devices, withPID)
 }
+
+// describeGroupRelay summarizes a group update's relay block for the log:
+// whether there is one, its transaction and the relay names it lists.
+func describeGroupRelay(update groupCallUpdate) string {
+	if update.Relay == nil {
+		return "none"
+	}
+	names := make([]string, 0, len(update.Relay.Endpoints))
+	for _, endpoint := range update.Relay.Endpoints {
+		names = append(names, endpoint.RelayName)
+	}
+	return fmt.Sprintf("tx=%d relays=%s", update.Relay.TransactionID, strings.Join(names, ","))
+}
