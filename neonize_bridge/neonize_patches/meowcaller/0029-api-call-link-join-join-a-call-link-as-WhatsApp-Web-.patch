@@ -0,0 +1,63 @@
+package meowcaller
+
+import (
+	"context"
+	"time"
+
+	"github.com/purpshell/meowcaller/signaling"
+)
+
+var callLinkHeartbeatInterval = 10 * time.Second
+
+func (e *engine) startCallLinkHeartbeat(callID string) {
+	// Source of truth: datasheets/voip-call-link-join.md (heartbeat every 10 s, the whole call)
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil || m.call == nil || m.linkHeartbeatCancel != nil {
+		e.mu.Unlock()
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	m.linkHeartbeatCancel = cancel
+	e.mu.Unlock()
+	go func() {
+		ticker := time.NewTicker(callLinkHeartbeatInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				e.sendCallLinkHeartbeat(ctx, callID)
+			}
+		}
+	}()
+}
+
+func (e *engine) sendCallLinkHeartbeat(ctx context.Context, callID string) {
+	// Source of truth: datasheets/voip-call-link-join.md (heartbeat every 10 s, the whole call)
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil || m.call == nil {
+		e.mu.Unlock()
+		return
+	}
+	creator, call := m.creator, m.call
+	e.mu.Unlock()
+	if call.State() == CallPhaseEnded {
+		return
+	}
+	requestID := e.nextCallNodeID()
+	var node = signaling.BuildWaitingRoomHeartbeat(callID, creator, requestID)
+	if call.State() != CallPhaseWaitingRoom {
+		built, err := signaling.BuildCallLinkHeartbeat(callID, creator, requestID)
+		if err != nil {
+			e.c.log.Debug().Err(err).Str("call_id", callID).Msg("call-link heartbeat skipped")
+			return
+		}
+		node = built
+	}
+	if err := e.transmitCallNode(ctx, node); err != nil && ctx.Err() == nil {
+		e.c.log.Debug().Err(err).Str("call_id", callID).Msg("call-link heartbeat failed")
+	}
+}
diff --git a/engine_call_link_test.go b/engine_call_link_test.go
new file mode 100644
index 0000000..792ac74
--- /dev/null
