@@ -0,0 +1,154 @@
+package meowcaller
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+func linkJoinAck(waiting bool) *waBinary.Node {
+	creator := creatorJID()
+	room := waBinary.Node{Tag: "waiting_room", Attrs: waBinary.Attrs{
+		"is_admin": "1", "link-token": "TOKEN", "media": "audio", "call-id": "LCID",
+		"call-creator": creator, "enabled": "0",
+	}}
+	if waiting {
+		room.Attrs["enabled"] = "1"
+		room.Attrs["is_admin"] = "0"
+		return &waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"class": "call", "type": "link_join"},
+			Content: []waBinary.Node{room}}
+	}
+	guest := types.NewJID("300003", types.HiddenUserServer)
+	return &waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"class": "call", "type": "link_join"}, Content: []waBinary.Node{
+		{Tag: "group_info", Attrs: waBinary.Attrs{
+			"call-creator": creator, "call-id": "LCID", "transaction-id": "2", "media": "audio",
+			"connected-limit": "32", "link-token": "TOKEN",
+		}, Content: []waBinary.Node{
+			{Tag: "user", Attrs: waBinary.Attrs{"jid": creator.ToNonAD(), "state": "connected", "type": "admin"},
+				Content: []waBinary.Node{{Tag: "device", Attrs: waBinary.Attrs{"jid": creator, "platform": "web"}}}},
+			{Tag: "user", Attrs: waBinary.Attrs{"jid": guest, "state": "connected", "account_kind": "guest", "push_name": "Guest"},
+				Content: []waBinary.Node{{Tag: "device", Attrs: waBinary.Attrs{"jid": guest, "platform": "web"}}}},
+		}},
+		room,
+	}}
+}
+
+type linkTestSent struct {
+	mu    sync.Mutex
+	nodes []waBinary.Node
+}
+
+func (s *linkTestSent) add(node waBinary.Node) {
+	s.mu.Lock()
+	s.nodes = append(s.nodes, node)
+	s.mu.Unlock()
+}
+
+func (s *linkTestSent) tags() []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var tags []string
+	for _, node := range s.nodes {
+		if kids := node.GetChildren(); len(kids) > 0 {
+			tags = append(tags, kids[0].Tag+":"+kids[0].AttrGetter().OptionalString("type"))
+		}
+	}
+	return tags
+}
+
+func linkTestEngine(ack *waBinary.Node) (*engine, *linkTestSent) {
+	c := &Client{log: zerolog.Nop()}
+	c.eng = newEngine(c)
+	sent := &linkTestSent{}
+	c.eng.requestCallNode = func(_ context.Context, node waBinary.Node, _ string) (*waBinary.Node, error) {
+		sent.add(node)
+		return ack, nil
+	}
+	c.eng.sendCallNode = func(_ context.Context, node waBinary.Node) error {
+		sent.add(node)
+		return nil
+	}
+	return c.eng, sent
+}
+
+func TestJoiningACallLinkSendsOneJoinAndNoAccept(t *testing.T) {
+	// datasheets/voip-call-link-join.md: link_join, then nothing but heartbeats.
+	previous := callLinkHeartbeatInterval
+	callLinkHeartbeatInterval = 20 * time.Millisecond
+	defer func() { callLinkHeartbeatInterval = previous }()
+	eng, sent := linkTestEngine(linkJoinAck(false))
+	call, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{Video: true})
+	if err != nil || call == nil {
+		t.Fatalf("join: %v", err)
+	}
+	m := eng.lookup("LCID")
+	if m == nil || !m.group || m.direction != CallDirectionIncoming || m.localVideo || m.remoteVideo {
+		t.Fatalf("call entry %+v", m)
+	}
+	if m.groupUpdate == nil || len(m.groupUpdate.Participants) != 2 ||
+		m.groupUpdate.Participants[1].PushName != "Guest" || !m.groupUpdate.Participants[1].Guest {
+		t.Fatalf("roster %+v", m.groupUpdate)
+	}
+	state, ok := call.GroupState()
+	if !ok || len(state.Participants) != 2 || state.Participants[1].PushName != "Guest" {
+		t.Fatalf("public roster %+v", state)
+	}
+	tags := waitForTags(t, sent, 2)
+	if tags[0] != "link_join:" {
+		t.Fatalf("sent %v", tags)
+	}
+	for _, tag := range tags[1:] {
+		if tag != "heartbeat:" {
+			t.Fatalf("after the join only heartbeats go out: %v", tags)
+		}
+	}
+	if _, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{}); err == nil {
+		t.Fatal("a call already held is not joined again")
+	}
+	eng.finishCall("LCID", "test")
+	// a heartbeat already on its way when the call ended may still land
+	time.Sleep(callLinkHeartbeatInterval)
+	count := len(sent.tags())
+	time.Sleep(4 * callLinkHeartbeatInterval)
+	if len(sent.tags()) != count {
+		t.Fatal("the heartbeat stops when the call ends")
+	}
+}
+
+// waitForTags waits (up to a generous deadline, so a loaded machine does not
+// fail the test) until at least n stanzas went out, and returns their tags.
+func waitForTags(t *testing.T, sent *linkTestSent, n int) []string {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		tags := sent.tags()
+		if len(tags) >= n {
+			return tags
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("only %v went out", tags)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+func TestAJoinThatWaitsSendsTheWaitingRoomHeartbeat(t *testing.T) {
+	previous := callLinkHeartbeatInterval
+	callLinkHeartbeatInterval = 20 * time.Millisecond
+	defer func() { callLinkHeartbeatInterval = previous }()
+	eng, sent := linkTestEngine(linkJoinAck(true))
+	call, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{})
+	if err != nil || call == nil || call.State() != CallPhaseWaitingRoom {
+		t.Fatalf("join: %v %v", err, call)
+	}
+	tags := waitForTags(t, sent, 2)
+	if tags[1] != "heartbeat:waiting_room" {
+		t.Fatalf("sent %v", tags)
+	}
+	eng.finishCall("LCID", "test")
+}
