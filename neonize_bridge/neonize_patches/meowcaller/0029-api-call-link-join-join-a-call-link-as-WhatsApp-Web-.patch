+func TestCallLinkHeartbeatMatchesTheCapture(t *testing.T) {
+	// datasheets/voip-call-link-join.md: <call to="c4@call" id><heartbeat call-id call-creator/></call>
+	creator := types.JID{User: "100001", Server: types.HiddenUserServer, Device: 27}
+	node, err := BuildCallLinkHeartbeat("CID", creator, "REQ")
+	if err != nil {
+		t.Fatalf("BuildCallLinkHeartbeat: %v", err)
+	}
+	if to, _ := node.Attrs["to"].(types.JID); to != types.NewJID("CID", "call") || node.Attrs["id"] != "REQ" {
+		t.Fatalf("envelope = %+v", node.Attrs)
+	}
+	action := contentNodes(t, node)[0]
+	if action.Tag != "heartbeat" || len(action.Attrs) != 2 || action.Attrs["call-id"] != "CID" ||
+		action.Attrs["call-creator"] != creator || action.Content != nil {
+		t.Fatalf("action = %+v", action)
+	}
+	if _, err := BuildCallLinkHeartbeat("CID", types.EmptyJID, "REQ"); err == nil {
+		t.Fatal("a heartbeat without the call's creator is refused")
+	}
+}
