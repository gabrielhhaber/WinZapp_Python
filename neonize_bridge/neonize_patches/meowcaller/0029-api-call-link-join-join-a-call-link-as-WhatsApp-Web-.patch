+func TestTheCapturedLinkJoinAckIsAdmittedWithItsRoster(t *testing.T) {
+	// The link_join ACK of the capture: the roster, a waiting room that is off,
+	// and the guest, uploadfieldstat and voip_settings children.
+	creator := types.JID{User: "100001", Server: types.HiddenUserServer, Device: 27}
+	user := types.NewJID("100001", types.HiddenUserServer)
+	ack := waBinary.Node{
+		Tag: "ack", Attrs: waBinary.Attrs{"from": types.NewJID("", "call"), "class": "call", "type": "link_join", "id": "REQ"},
+		Content: []waBinary.Node{
+			{Tag: "group_info", Attrs: waBinary.Attrs{
+				"call-creator": creator, "call-id": "CID", "transaction-id": "2", "media": "audio",
+				"connected-limit": "32", "link-token": "TOKEN",
+			}, Content: []waBinary.Node{{Tag: "user", Attrs: waBinary.Attrs{
+				"jid": user, "state": "connected", "type": "admin",
+				"user_pn": types.NewJID("5500000000000", types.DefaultUserServer),
+			}, Content: []waBinary.Node{{Tag: "device", Attrs: waBinary.Attrs{"jid": creator, "platform": "web"},
+				Content: []waBinary.Node{{Tag: "capability", Attrs: waBinary.Attrs{"ver": "1"}, Content: []byte{1, 2, 3, 4, 5, 6, 7}}}}}}}},
+			{Tag: "waiting_room", Attrs: waBinary.Attrs{
+				"is_admin": "1", "link-token": "TOKEN", "media": "audio", "call-id": "CID",
+				"call-creator": creator, "enabled": "0",
+			}},
+			{Tag: "guest", Attrs: waBinary.Attrs{"is_guest_eligible": "1"}},
+			{Tag: "uploadfieldstat"},
+			{Tag: "voip_settings", Attrs: waBinary.Attrs{"uncompressed": "1"}, Content: []byte("{}")},
+		},
+	}
+	result, err := ParseCallLinkJoinAck(&ack)
+	if err != nil {
+		t.Fatalf("ParseCallLinkJoinAck: %v", err)
+	}
+	if result.InWaitingRoom || !result.IsAdmin || result.WaitingRoomEnabled || result.CallID != "CID" ||
+		result.CallCreator != creator || result.Group == nil || len(result.Group.Participants) != 1 {
+		t.Fatalf("result = %+v", result)
+	}
+}
