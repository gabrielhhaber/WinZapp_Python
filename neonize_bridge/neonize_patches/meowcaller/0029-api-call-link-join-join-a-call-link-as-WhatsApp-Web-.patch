+// BuildCallLinkHeartbeat keeps a joined call-link call alive.
+func BuildCallLinkHeartbeat(callID string, callCreator types.JID, requestID string) (waBinary.Node, error) {
+	// Source of truth: datasheets/voip-call-link-join.md (WhatsApp Web capture, heartbeat every 10 s)
+	if callID == "" || callCreator.IsEmpty() || requestID == "" {
+		return waBinary.Node{}, fmt.Errorf("signaling: build call-link heartbeat: incomplete identity")
+	}
+	return callWrap(types.NewJID(callID, "call"), &requestID, waBinary.Node{
+		Tag:   "heartbeat",
+		Attrs: waBinary.Attrs{"call-id": callID, "call-creator": callCreator},
+	}), nil
+}
