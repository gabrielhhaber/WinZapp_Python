+func TestAGuestInTheWaitingRoomHasNoPhoneNumber(t *testing.T) {
+	// A guest arrives as account_kind="guest" with a push name and no user_pn.
+	creator := types.JID{User: "100001", Server: types.HiddenUserServer, Device: 27}
+	guest := types.NewJID("300003", types.HiddenUserServer)
+	action := waBinary.Node{
+		Tag: "waiting_room_update", Attrs: waBinary.Attrs{"call-id": "CID", "call-creator": creator},
+		Content: []waBinary.Node{{Tag: "waiting_room", Attrs: waBinary.Attrs{
+			"filter": "guests_only", "is_admin": "1", "link-token": "TOKEN", "media": "audio",
+			"call-id": "CID", "call-creator": creator, "enabled": "1", "transaction-id": "1",
+		}, Content: []waBinary.Node{{Tag: "user", Attrs: waBinary.Attrs{
+			"account_kind": "guest", "push_name": "Guest", "jid": guest, "state": "waiting_room_joined",
+		}}}}},
+	}
+	room, err := ParseWaitingRoomUpdate(&action)
+	if err != nil {
+		t.Fatalf("ParseWaitingRoomUpdate: %v", err)
+	}
+	if len(room.Users) != 1 || room.Users[0].JID != guest || !room.Users[0].PN.IsEmpty() ||
+		room.Users[0].State != "waiting_room_joined" || room.Users[0].PushName != "Guest" || !room.Users[0].Guest {
+		t.Fatalf("room = %+v", room)
+	}
+}
