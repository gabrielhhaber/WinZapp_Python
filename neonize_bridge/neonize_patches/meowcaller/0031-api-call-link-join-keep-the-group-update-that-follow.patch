+func TestAGroupUpdateOfTheHeldTransactionIsKeptOnlyWhenItAddsTheRelayOrPIDs(t *testing.T) {
+	device := func(pid bool) groupCallDevice {
+		return groupCallDevice{JID: types.NewJID("1", types.HiddenUserServer), HasPID: pid}
+	}
+	update := func(tx uint32, relay bool, pid bool) groupCallUpdate {
+		u := groupCallUpdate{CallID: "C", TransactionID: tx, Participants: []groupCallParticipant{
+			{State: "connected", Devices: []groupCallDevice{device(pid)}}}}
+		if relay {
+			u.Relay = &groupCallRelay{}
+		}
+		return u
+	}
+	ack := update(11, false, false)
+	for _, tc := range []struct {
+		name  string
+		held  *groupCallUpdate
+		next  groupCallUpdate
+		stale bool
+	}{
+		{"nothing held", nil, update(1, false, false), false},
+		{"a newer transaction", &ack, update(12, false, false), false},
+		{"an older transaction", &ack, update(10, true, true), true},
+		{"the same transaction with the relay the ACK lacked", &ack, update(11, true, true), false},
+		{"the same transaction with only PIDs added", &ack, update(11, false, true), false},
+		{"the same transaction again", &ack, update(11, false, false), true},
+		{"the same full update delivered twice", ptr(update(11, true, true)), update(11, true, true), true},
+	} {
+		if got := groupUpdateIsStale(tc.held, tc.next); got != tc.stale {
+			t.Errorf("%s: stale=%v, want %v", tc.name, got, tc.stale)
+		}
+	}
+}
+
+func ptr[T any](v T) *T { return &v }
