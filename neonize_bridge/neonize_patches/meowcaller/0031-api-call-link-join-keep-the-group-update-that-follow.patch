+// groupEpochHeldFor reports whether the call already holds a key epoch for this
+// update's transaction or a later one: an update of the same transaction that
+// only adds PIDs must not make this device draw a second, different key.
+func (e *engine) groupEpochHeldFor(update groupCallUpdate) bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	m := e.calls[update.CallID]
+	return m != nil && m.hasGroupEpoch && m.groupEpochTxID >= update.TransactionID
+}
+
 func (e *engine) distributeRequestedGroupEpoch(ctx context.Context, update groupCallUpdate) error {
 	// Source of truth: https://github.com/purpshell/meowcaller/blob/d9df3eb9d96ea5260ffcd4036b6669499a1c1bc2/datasheets/voip-group-key-epoch-fanout.md#L99-L162
 	self := e.c.wa.Store.GetLID()
diff --git a/group_update_carry.go b/group_update_carry.go
index b8afa33..ad4d036 100644
--- a/group_update_carry.go
+++ b/group_update_carry.go
@@ -46,3 +46,35 @@ func carryGroupSnapshot(previous, next *groupCallUpdate) (relayCarried bool, pid
 	}
 	return relayCarried, pidsCarried
 }
+
+// groupUpdateIsStale reports whether update must be dropped for an update the
+// call already holds. An older transaction always is. The same transaction is
+// too, unless it brings what the held one lacks: a call link's join ACK and
+// the group_update that follows carry the same transaction-id, the ACK without
+// the relay or any device PID and the update with them (and with the rekey
+// request), so dropping the second left the call with no relay, no PIDs and no
+// key fan-out.
+func groupUpdateIsStale(held *groupCallUpdate, update groupCallUpdate) bool {
+	if held == nil || update.TransactionID > held.TransactionID {
+		return false
+	}
+	if update.TransactionID < held.TransactionID {
+		return true
+	}
+	if update.Relay != nil && held.Relay == nil {
+		return false
+	}
+	return groupPIDCount(update) <= groupPIDCount(*held)
+}
+
+func groupPIDCount(update groupCallUpdate) int {
+	count := 0
+	for _, participant := range update.Participants {
+		for _, device := range participant.Devices {
+			if device.HasPID {
+				count++
+			}
+		}
+	}
+	return count
+}
