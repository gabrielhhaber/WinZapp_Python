+func TestTheGroupUpdateAfterTheJoinAckWithTheSameTransactionIsApplied(t *testing.T) {
+	// The join ACK and the group_update right after it share a transaction-id;
+	// the ACK has no relay or PIDs, the update has them and asks for the key.
+	previous := callLinkHeartbeatInterval
+	callLinkHeartbeatInterval = time.Hour
+	defer func() { callLinkHeartbeatInterval = previous }()
+	eng, _ := linkTestEngine(linkJoinAck(false))
+	if _, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{}); err != nil {
+		t.Fatalf("join: %v", err)
+	}
+	held := eng.lookup("LCID").groupUpdate
+	if held == nil || held.Relay != nil || groupPIDCount(*held) != 0 {
+		t.Fatalf("the ACK's roster %+v", held)
+	}
+	full := cloneGroupCallUpdate(*held)
+	full.Relay = &groupCallRelay{}
+	full.RekeyRequested = true
+	for i := range full.Participants {
+		for j := range full.Participants[i].Devices {
+			full.Participants[i].Devices[j].PID, full.Participants[i].Devices[j].HasPID = uint32(i), true
+		}
+	}
+	if !eng.applyGroupUpdate(full) {
+		t.Fatal("the update with the relay and the PIDs was dropped as stale")
+	}
+	if got := eng.lookup("LCID").groupUpdate; got.Relay == nil || groupPIDCount(*got) != 2 {
+		t.Fatalf("installed %+v", got)
+	}
+	if eng.applyGroupUpdate(full) {
+		t.Fatal("the same update twice is stale")
+	}
+	eng.finishCall("LCID", "test")
+}
+
+func TestAKeyAlreadyHeldForTheTransactionIsNotDrawnAgain(t *testing.T) {
+	previous := callLinkHeartbeatInterval
+	callLinkHeartbeatInterval = time.Hour
+	defer func() { callLinkHeartbeatInterval = previous }()
+	eng, _ := linkTestEngine(linkJoinAck(false))
+	if _, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{}); err != nil {
+		t.Fatalf("join: %v", err)
+	}
+	update := groupCallUpdate{CallID: "LCID", TransactionID: 6}
+	if eng.groupEpochHeldFor(update) {
+		t.Fatal("no key is held yet")
+	}
+	if err := eng.installGroupEpoch("LCID", 6, make([]byte, 32)); err != nil {
+		t.Fatalf("install: %v", err)
+	}
+	if !eng.groupEpochHeldFor(update) || !eng.groupEpochHeldFor(groupCallUpdate{CallID: "LCID", TransactionID: 5}) {
+		t.Fatal("a key held for transaction 6 covers 6 and earlier")
+	}
+	if eng.groupEpochHeldFor(groupCallUpdate{CallID: "LCID", TransactionID: 7}) {
+		t.Fatal("a later transaction may ask for a new key")
+	}
+	eng.finishCall("LCID", "test")
+}
