+package meowcaller
+
+import (
+	"context"
+	"errors"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+
+	"github.com/purpshell/meowcaller/signaling"
+)
+
+// inviteRoster is what this client knows of a call when it invites someone.
+// onServer says the server already holds the call as a group call (a group
+// update arrived): the two cases take different invite stanzas.
+type inviteRoster struct {
+	creator      types.JID
+	participants []signaling.GroupCallParticipant
+	video        bool
+	onServer     bool
+}
+
+// participantInviteNode builds the offer that brings one person into the call.
+// A one-to-one call is turned into a group call by an offer to the person, with
+// the roster of who is in it. Once the server holds a group call it only takes
+// an offer to the call naming the invited user; it drops the other one without
+// an answer.
+func participantInviteNode(
+	roster inviteRoster,
+	callID string,
+	target, targetPN types.JID,
+	targetDevices []types.JID,
+) (waBinary.Node, error) {
+	// Source of truth: WhatsApp Web 2.3000.1052669929, the stanza it sent on 2026-11-17 to add a person to a group call of two connected participants (docs/reference/neonize-build.md, meowcaller 0027)
+	if roster.onServer {
+		return signaling.BuildGroupCallInvite(signaling.GroupCallInviteParams{
+			CallID: callID, CallCreator: roster.creator,
+			Target: target, TargetPN: targetPN,
+			TargetDevices: targetDevices, Video: roster.video,
+		})
+	}
+	return signaling.BuildGroupInviteOffer(signaling.GroupInviteOfferParams{
+		CallID: callID, To: target, CallCreator: roster.creator,
+		TargetDevices: targetDevices, Participants: roster.participants, Video: roster.video,
+	})
+}
+
+// ringRoster checks that target is on the call's list and not connected, and
+// returns the roster a ring is sent with (the connected participants) and the
+// phone number the list has for the target.
+func ringRoster(roster inviteRoster, target types.JID) (inviteRoster, types.JID, error) {
+	// Source of truth: https://github.com/purpshell/meowcaller/blob/25eda415afb0f926112ca375c5892b95b4bd6f60/datasheets/voip-group-invite-offer.md#L81-L106
+	var targetPN types.JID
+	found := false
+	connected := make([]signaling.GroupCallParticipant, 0, len(roster.participants))
+	for _, participant := range roster.participants {
+		if participant.JID.ToNonAD() != target {
+			if participant.State == "connected" {
+				connected = append(connected, participant)
+			}
+			continue
+		}
+		if participant.State == "connected" {
+			return inviteRoster{}, types.EmptyJID, errors.New("meowcaller: participant is already connected")
+		}
+		found = true
+		targetPN = participant.PN
+	}
+	if !found {
+		return inviteRoster{}, types.EmptyJID, errors.New("meowcaller: participant is not in the call roster")
+	}
+	if len(connected) == 0 {
+		return inviteRoster{}, types.EmptyJID, errors.New("meowcaller: group call has no connected participant roster")
+	}
+	roster.participants = connected
+	return roster, targetPN, nil
+}
+
+// phoneNumberOf is the phone number JID stored for a LID, empty when unknown:
+// the invite then goes without user_pn.
+func (e *engine) phoneNumberOf(ctx context.Context, lid types.JID) types.JID {
+	// Source of truth: WhatsApp Web 2.3000.1052669929, the user_pn attribute of the invited <user> (docs/reference/neonize-build.md, meowcaller 0027)
+	pn, err := e.c.wa.Store.LIDs.GetPNForLID(ctx, lid)
+	if err != nil {
+		e.c.log.Debug().Err(err).Msg("phone number of the invited participant unavailable")
+		return types.EmptyJID
+	}
+	return pn
+}
