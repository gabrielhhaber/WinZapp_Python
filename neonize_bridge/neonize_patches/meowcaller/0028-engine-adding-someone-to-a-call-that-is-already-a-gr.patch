+package meowcaller
+
+import (
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+
+	"github.com/purpshell/meowcaller/signaling"
+)
+
+func inviteChildren(t *testing.T, node waBinary.Node) (waBinary.Node, map[string]waBinary.Node) {
+	t.Helper()
+	actions, ok := node.Content.([]waBinary.Node)
+	if !ok || len(actions) != 1 || actions[0].Tag != "offer" {
+		t.Fatalf("stanza content = %#v, want one <offer>", node.Content)
+	}
+	children := make(map[string]waBinary.Node)
+	for _, child := range actions[0].Content.([]waBinary.Node) {
+		children[child.Tag] = child
+	}
+	return actions[0], children
+}
+
+func groupRoster(creator types.JID) inviteRoster {
+	connected := func(user string, device uint16) signaling.GroupCallParticipant {
+		jid := types.NewJID(user, types.HiddenUserServer)
+		return signaling.GroupCallParticipant{JID: jid, State: "connected", Devices: []signaling.GroupCallDevice{{
+			JID: types.JID{User: user, Server: types.HiddenUserServer, Device: device},
+			PID: 1, HasPID: true, CapabilityVersion: 1, Capability: []byte{1, 5, 0xf7},
+		}}}
+	}
+	return inviteRoster{
+		creator: creator, onServer: true,
+		participants: []signaling.GroupCallParticipant{
+			connected("100", 14), connected("200", 3), connected("300", 0),
+		},
+	}
+}
+
+// What WhatsApp Web sends to add a person to a call that is already a group
+// call: to the call, with the invited user alone. The server answered nothing
+// to the one-to-one form here (user logs, 2026-11-16: six invites, none rang).
+func TestAGroupCallInvitesThroughTheCallNamingOnlyTheInvitedUser(t *testing.T) {
+	creator := types.JID{User: "100", Server: types.HiddenUserServer, Device: 14}
+	target := types.NewJID("400", types.HiddenUserServer)
+	pn := types.NewJID("5500000000", types.DefaultUserServer)
+	devices := []types.JID{target, {User: "400", Server: types.HiddenUserServer, Device: 51}}
+
+	node, err := participantInviteNode(groupRoster(creator), "CID", target, pn, devices)
+	if err != nil {
+		t.Fatalf("participantInviteNode: %v", err)
+	}
+
+	if to, _ := node.Attrs["to"].(types.JID); to != types.NewJID("CID", "call") {
+		t.Fatalf("to = %v, want the call", node.Attrs["to"])
+	}
+	offer, children := inviteChildren(t, node)
+	if offer.Attrs["call-id"] != "CID" || offer.Attrs["call-creator"] != creator {
+		t.Fatalf("offer attrs = %v", offer.Attrs)
+	}
+	if _, has := children["group_info"]; has {
+		t.Fatal("the invite carries the roster of the call")
+	}
+	if _, has := children["destination"]; has {
+		t.Fatal("the invite carries a <destination>")
+	}
+	if children["net"].Attrs["medium"] != "2" || children["audio"].Attrs["rate"] != "16000" {
+		t.Fatalf("media children = %v %v", children["net"].Attrs, children["audio"].Attrs)
+	}
+	users, _ := children["invite"].Content.([]waBinary.Node)
+	if len(users) != 1 || users[0].Tag != "user" {
+		t.Fatalf("invite = %#v, want one <user>", children["invite"])
+	}
+	if users[0].Attrs["jid"] != target || users[0].Attrs["user_pn"] != pn {
+		t.Fatalf("invited user attrs = %v", users[0].Attrs)
+	}
+	got, _ := users[0].Content.([]waBinary.Node)
+	if len(got) != 2 || got[0].Attrs["jid"] != devices[0] || got[1].Attrs["jid"] != devices[1] {
+		t.Fatalf("invited devices = %#v", got)
+	}
+	for _, device := range got {
+		if device.Content != nil {
+			t.Fatalf("an invited device carries content: %#v", device)
+		}
+	}
+}
+
+func TestAnInviteWithoutAKnownPhoneNumberLeavesUserPNOut(t *testing.T) {
+	creator := types.JID{User: "100", Server: types.HiddenUserServer, Device: 14}
+	target := types.NewJID("400", types.HiddenUserServer)
+
+	node, err := participantInviteNode(groupRoster(creator), "CID", target, types.EmptyJID, []types.JID{target})
+	if err != nil {
+		t.Fatalf("participantInviteNode: %v", err)
+	}
+
+	_, children := inviteChildren(t, node)
+	user := children["invite"].Content.([]waBinary.Node)[0]
+	if _, has := user.Attrs["user_pn"]; has {
+		t.Fatalf("user attrs = %v, want no user_pn", user.Attrs)
+	}
+}
+
+// The first person added to a one-to-one call: the server has no group call
+// yet, and the offer to the person with the roster is what creates it.
+func TestAOneToOneCallStillInvitesThePersonWithTheRoster(t *testing.T) {
+	creator := types.JID{User: "100", Server: types.HiddenUserServer, Device: 14}
+	target := types.NewJID("400", types.HiddenUserServer)
+	roster := groupRoster(creator)
+	roster.onServer = false
+	roster.participants = roster.participants[:2]
+
+	node, err := participantInviteNode(roster, "CID", target, types.EmptyJID, []types.JID{target})
+	if err != nil {
+		t.Fatalf("participantInviteNode: %v", err)
+	}
+
+	if to, _ := node.Attrs["to"].(types.JID); to != target {
+		t.Fatalf("to = %v, want the invited person", node.Attrs["to"])
+	}
+	_, children := inviteChildren(t, node)
+	if users, _ := children["group_info"].Content.([]waBinary.Node); len(users) != 2 {
+		t.Fatalf("group_info = %#v, want the two people in the call", children["group_info"])
+	}
+	if _, has := children["invite"]; has {
+		t.Fatal("a one-to-one call was invited with the group call form")
+	}
+}
+
+func TestACallWithAGroupUpdateIsHeldByTheServer(t *testing.T) {
+	eng, call, creator := testGroupEngine("GROUP")
+	call.setPhase(CallPhaseActive)
+	m := eng.calls["GROUP"]
+	m.creator = creator
+	if m.groupUpdate == nil {
+		m.groupUpdate = &groupCallUpdate{CallID: "GROUP"}
+	}
+
+	roster, err := eng.groupInviteRoster("GROUP")
+	if err != nil {
+		t.Fatalf("groupInviteRoster: %v", err)
+	}
+	if !roster.onServer {
+		t.Fatal("a call with a group update is not taken for a group call the server holds")
+	}
+}
+
+func TestRingingSomeoneOnTheListKeepsTheirPhoneNumber(t *testing.T) {
+	creator := types.JID{User: "100", Server: types.HiddenUserServer, Device: 14}
+	target := types.NewJID("400", types.HiddenUserServer)
+	pn := types.NewJID("5500000000", types.DefaultUserServer)
+	roster := groupRoster(creator)
+	roster.participants = append(roster.participants, signaling.GroupCallParticipant{
+		JID: target, PN: pn, State: "invited", Devices: []signaling.GroupCallDevice{{JID: target}},
+	})
+
+	ringable, gotPN, err := ringRoster(roster, target)
+	if err != nil {
+		t.Fatalf("ringRoster: %v", err)
+	}
+	if gotPN != pn || !ringable.onServer || len(ringable.participants) != 3 {
+		t.Fatalf("ring roster = (pn %v, onServer %v, %d connected)", gotPN, ringable.onServer, len(ringable.participants))
+	}
+
+	if _, _, err = ringRoster(roster, types.NewJID("200", types.HiddenUserServer)); err == nil {
+		t.Fatal("someone connected was rung")
+	}
+	if _, _, err = ringRoster(roster, types.NewJID("999", types.HiddenUserServer)); err == nil {
+		t.Fatal("someone off the list was rung")
+	}
+}
