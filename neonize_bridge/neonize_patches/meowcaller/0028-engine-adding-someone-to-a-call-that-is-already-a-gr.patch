+// GroupCallInviteParams contains the wire inputs for inviting or ringing one
+// person in a call the server already holds as a group call.
+type GroupCallInviteParams struct {
+	CallID        string
+	CallCreator   types.JID
+	Target        types.JID
+	TargetPN      types.JID
+	TargetDevices []types.JID
+	Video         bool
+}
+
+// BuildGroupCallInvite builds the offer that adds one person to a group call:
+// addressed to the call, naming only the invited user and their devices.
+func BuildGroupCallInvite(params GroupCallInviteParams) (waBinary.Node, error) {
+	// Source of truth: WhatsApp Web 2.3000.1052669929, the stanza it sent on 2026-11-17 to add a person to a group call of two connected participants (docs/reference/neonize-build.md, meowcaller 0027)
+	if params.CallID == "" || params.CallCreator.IsEmpty() || params.Target.IsEmpty() {
+		return waBinary.Node{}, fmt.Errorf("signaling: build group call invite: call identity and target are required")
+	}
+	if len(params.TargetDevices) == 0 {
+		return waBinary.Node{}, fmt.Errorf("signaling: build group call invite: target devices are required")
+	}
+	devices := make([]waBinary.Node, len(params.TargetDevices))
+	for i, device := range params.TargetDevices {
+		if device.IsEmpty() {
+			return waBinary.Node{}, fmt.Errorf("signaling: build group call invite: device %d JID is required", i)
+		}
+		devices[i] = waBinary.Node{Tag: "device", Attrs: waBinary.Attrs{"jid": device}}
+	}
+	userAttrs := waBinary.Attrs{"jid": params.Target.ToNonAD()}
+	if !params.TargetPN.IsEmpty() {
