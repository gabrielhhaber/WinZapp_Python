diff --git a/engine_video_refused.go b/engine_video_refused.go
new file mode 100644
index 0000000..a8fa5d2
--- /dev/null
+++ b/engine_video_refused.go
@@ -0,0 +1,65 @@
+package meowcaller
+
+import (
+	"context"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+// maxVideoStateIDs bounds the ids remembered; a call sends a handful.
+const maxVideoStateIDs = 64
+
+// transmitVideoState sends a <video> state stanza and remembers its id: a server that
+// refuses it answers an <ack class="call" error="..."> carrying that id, which is not
+// the end of the call.
+func (e *engine) transmitVideoState(callID string, node waBinary.Node) error {
+	if id, _ := node.Attrs["id"].(string); id != "" {
+		e.mu.Lock()
+		if e.videoStateIDs == nil || len(e.videoStateIDs) >= maxVideoStateIDs {
+			e.videoStateIDs = make(map[string]string)
+		}
+		e.videoStateIDs[id] = callID
+		e.mu.Unlock()
+	}
+	return e.transmitCallNode(context.Background(), node)
+}
+
+// takeVideoStateID returns the call a <video> state stanza of the given id was sent
+// for, and forgets the id.
+func (e *engine) takeVideoStateID(id string) (string, bool) {
+	if id == "" {
+		return "", false
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	callID, ok := e.videoStateIDs[id]
+	if ok {
+		delete(e.videoStateIDs, id)
+	}
+	return callID, ok
+}
+
+// videoStateRefused handles a server error ack to one of our <video> state stanzas.
+// The server answers 403 to a link call's video state (live, 2026-11-21: four voice
+// calls of a call link turned to video ended 0.2 s after the camera's first frame
+// with "call rejected by server"), and ending the whole call for it dropped a call
+// whose audio worked. Only our video stops; the call goes on.
+func (e *engine) videoStateRefused(callID, errCode string) {
+	e.mu.Lock()
+	m := e.calls[callID]
+	var sender *videoSender
+	if m != nil {
+		m.localVideo = false
+		m.videoGate = false
+		sender = m.videoTx
+	}
+	e.mu.Unlock()
+	if m == nil {
+		return
+	}
+	if sender != nil {
+		sender.disable()
+	}
+	e.c.log.Warn().Str("call_id", callID).Str("error_code", errCode).
+		Msg("video state refused by server; the call goes on without our video")
+}
diff --git a/engine_video_refused_test.go b/engine_video_refused_test.go
new file mode 100644
index 0000000..f8b9352
--- /dev/null
+++ b/engine_video_refused_test.go
@@ -0,0 +1,71 @@
+package meowcaller
+
+import (
+	"context"
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+func videoErrorAck(id string) *waBinary.Node {
+	return &waBinary.Node{
+		Tag:   "ack",
+		Attrs: waBinary.Attrs{"class": "call", "id": id, "error": "403"},
+		Content: []waBinary.Node{{
+			Tag: "error", Attrs: waBinary.Attrs{"call-id": "CID", "code": "403"},
+		}},
+	}
+}
+
+func TestAServerErrorToAVideoStateLeavesTheCallUp(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	m := eng.calls[call.ID()]
+	m.localVideo, m.videoGate = true, true
+	m.videoTx = &videoSender{active: true}
+	var sentID string
+	eng.sendCallNode = func(_ context.Context, node waBinary.Node) error {
+		sentID, _ = node.Attrs["id"].(string)
+		return nil
+	}
+	if err := eng.setVideoEnabled("CID", true); err != nil {
+		t.Fatalf("setVideoEnabled: %v", err)
+	}
+	if sentID == "" {
+		t.Fatal("the video state stanza carries no id")
+	}
+
+	eng.onCallAck(videoErrorAck(sentID))
+
+	if eng.lookup("CID") == nil || call.State() == CallPhaseEnded {
+		t.Fatal("an error ack to a video state ended the call")
+	}
+	if eng.callIsSendingVideo("CID") {
+		t.Fatal("the call still sends video after the server refused it")
+	}
+	if active, _ := senderVideoState(m.videoTx); active {
+		t.Fatal("the video sender is still active")
+	}
+	if len(eng.videoStateIDs) != 0 {
+		t.Fatalf("the id of the answered stanza is still remembered: %v", eng.videoStateIDs)
+	}
+}
+
+func TestAServerErrorToAnythingElseStillEndsTheCall(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	eng.onCallAck(videoErrorAck("NOT-A-VIDEO-STATE"))
+	if eng.lookup(call.ID()) != nil {
+		t.Fatal("an error ack that names no video state must end the call")
+	}
+}
+
+func TestTheVideoStateIDsStayBounded(t *testing.T) {
+	eng, _ := testEngineWithOutgoingCall()
+	eng.sendCallNode = func(context.Context, waBinary.Node) error { return nil }
+	for i := 0; i < 3*maxVideoStateIDs; i++ {
+		node := waBinary.Node{Tag: "call", Attrs: waBinary.Attrs{"id": string(rune('A'+i%26)) + string(rune('a'+i/26))}}
+		_ = eng.transmitVideoState("CID", node)
+	}
+	if len(eng.videoStateIDs) > maxVideoStateIDs {
+		t.Fatalf("%d ids remembered, bound is %d", len(eng.videoStateIDs), maxVideoStateIDs)
+	}
+}
