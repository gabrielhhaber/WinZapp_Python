diff --git a/engine_group_invite_ack_test.go b/engine_group_invite_ack_test.go
new file mode 100644
index 0000000..2a0d9f1
--- /dev/null
+++ b/engine_group_invite_ack_test.go
@@ -0,0 +1,122 @@
+package meowcaller
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+func rosterUser(user, state string, device uint16) waBinary.Node {
+	return waBinary.Node{
+		Tag:   "user",
+		Attrs: waBinary.Attrs{"jid": types.NewJID(user, types.HiddenUserServer), "state": state},
+		Content: []waBinary.Node{{Tag: "device", Attrs: waBinary.Attrs{
+			"jid": types.JID{User: user, Server: types.HiddenUserServer, Device: device},
+		}}},
+	}
+}
+
+// The ack WhatsApp's server gave WhatsApp Web's invite: the roster, with the
+// invited person in state "outgoing".
+func inviteAck(creator types.JID, users ...waBinary.Node) *waBinary.Node {
+	return &waBinary.Node{
+		Tag:   "ack",
+		Attrs: waBinary.Attrs{"from": types.NewJID("GROUP", "call"), "class": "call", "type": "offer"},
+		Content: []waBinary.Node{{
+			Tag: "group_info",
+			Attrs: waBinary.Attrs{
+				"call-id": "GROUP", "call-creator": creator, "transaction-id": "94",
+				"media": "audio", "connected-limit": "32",
+			},
+			Content: users,
+		}},
+	}
+}
+
+func invitingEngine(t *testing.T, answer func(waBinary.Node) (*waBinary.Node, error)) (*engine, types.JID) {
+	t.Helper()
+	eng, call, creator := testGroupEngine("GROUP")
+	call.setPhase(CallPhaseActive)
+	eng.requestCallNode = func(_ context.Context, node waBinary.Node, requestID string) (*waBinary.Node, error) {
+		if node.Attrs["id"] != requestID || requestID == "" {
+			t.Fatalf("invite id = %v, waited for %q", node.Attrs["id"], requestID)
+		}
+		return answer(node)
+	}
+	return eng, creator
+}
+
+func inviteStanza() waBinary.Node {
+	return waBinary.Node{Tag: "call", Attrs: waBinary.Attrs{"to": types.NewJID("GROUP", "call")}}
+}
+
+func TestAnInviteTheServerAcksWithThePersonOnTheRosterSucceeds(t *testing.T) {
+	target := types.NewJID("400", types.HiddenUserServer)
+	var eng *engine
+	eng, creator := invitingEngine(t, func(waBinary.Node) (*waBinary.Node, error) {
+		return inviteAck(types.NewJID("100", types.HiddenUserServer),
+			rosterUser("100", "connected", 14), rosterUser("400", "outgoing", 0)), nil
+	})
+
+	if err := eng.sendParticipantInvite(context.Background(), inviteStanza(), target); err != nil {
+		t.Fatalf("sendParticipantInvite: %v", err)
+	}
+
+	// the ack never reaches onCallAck: its roster has to be applied here
+	update := eng.calls["GROUP"].groupUpdate
+	if update == nil || update.TransactionID != 94 || len(update.Participants) != 2 {
+		t.Fatalf("roster after the ack = %+v", update)
+	}
+	if update.CallCreator != creator {
+		t.Fatalf("creator after the ack = %v", update.CallCreator)
+	}
+}
+
+// What happened to every invite after the first one (user logs, 2026-11-16):
+// the server answered nothing, and the caller was told the person was invited.
+func TestAnInviteTheServerDoesNotAnswerFails(t *testing.T) {
+	eng, _ := invitingEngine(t, func(waBinary.Node) (*waBinary.Node, error) {
+		return nil, context.DeadlineExceeded
+	})
+
+	err := eng.sendParticipantInvite(context.Background(), inviteStanza(), types.NewJID("400", types.HiddenUserServer))
+
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("err = %v, want the missing answer", err)
+	}
+}
+
+func TestAnInviteTheServerRefusesFailsAndLeavesTheCallUp(t *testing.T) {
+	eng, _ := invitingEngine(t, func(waBinary.Node) (*waBinary.Node, error) {
+		return &waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"class": "call", "type": "offer", "error": "403"}}, nil
+	})
+
+	err := eng.sendParticipantInvite(context.Background(), inviteStanza(), types.NewJID("400", types.HiddenUserServer))
+
+	if err == nil {
+		t.Fatal("a refused invite was reported as sent")
+	}
+	if m := eng.calls["GROUP"]; m == nil || m.call.State() != CallPhaseActive {
+		t.Fatal("a refused invite ended the call")
+	}
+}
+
+func TestAnAckWithoutTheInvitedPersonFails(t *testing.T) {
+	answers := map[string]*waBinary.Node{
+		"no roster": {Tag: "ack", Attrs: waBinary.Attrs{"class": "call", "type": "offer"}},
+		"person left out": inviteAck(types.NewJID("100", types.HiddenUserServer),
+			rosterUser("100", "connected", 14)),
+	}
+	for name, ack := range answers {
+		eng, _ := invitingEngine(t, func(waBinary.Node) (*waBinary.Node, error) { return ack, nil })
+
+		err := eng.sendParticipantInvite(context.Background(), inviteStanza(), types.NewJID("400", types.HiddenUserServer))
+
+		if err == nil {
+			t.Fatalf("%s: the invite was reported as sent", name)
+		}
+	}
+}
