+// inviteAckTimeout is how long an invite waits for the server's ack. WhatsApp
+// Web got it in 0.3 s; a call whose invite the server drops gets none at all.
+const inviteAckTimeout = 15 * time.Second
+
+// sendParticipantInvite sends the invite and returns only when the server
+// confirmed it: its ack carries the call's roster with the invited person on
+// it. The ack is waited for by id, so it never reaches onCallAck; its roster is
+// applied here. A refusal leaves the call as it is.
+func (e *engine) sendParticipantInvite(ctx context.Context, node waBinary.Node, target types.JID) error {
+	// Source of truth: WhatsApp Web 2.3000.1052669929, the ack to its invite on 2026-11-17: <ack class="call" type="offer"> with <group_info>, the invited user in state "outgoing" (docs/reference/neonize-build.md, meowcaller 0028)
+	requestID := e.nextCallNodeID()
+	node.Attrs["id"] = requestID
+	ctx, cancel := context.WithTimeout(ctx, inviteAckTimeout)
+	defer cancel()
+	ack, err := e.requestCall(ctx, node, requestID)
+	if err != nil {
+		return fmt.Errorf("no answer from the server: %w", err)
+	}
+	if code := ack.AttrGetter().OptionalString("error"); code != "" {
+		e.c.log.Warn().Str("error_code", code).Msg("participant invite refused by server")
+		return fmt.Errorf("the server refused the invite (%s)", code)
+	}
+	update, isGroup, err := signaling.ParseInitialGroupCallAck(ack)
+	if err != nil {
+		return fmt.Errorf("unreadable invite ack: %w", err)
+	}
+	if !isGroup {
+		return errors.New("the server's ack carries no roster")
+	}
+	fromAck := groupCallUpdateFromSignaling(*update)
+	e.c.log.Info().
+		Str("call_id", fromAck.CallID).
+		Uint32("transaction_id", fromAck.TransactionID).
+		Str("ack_type", ack.AttrGetter().OptionalString("type")).
+		Str("roster", describeGroupRoster(fromAck)).
+		Str("relay", describeGroupRelay(fromAck)).
+		Msg("group update from a participant invite ack")
+	e.applyGroupUpdate(fromAck)
+	for _, participant := range update.Participants {
+		if participant.JID.ToNonAD() == target.ToNonAD() {
+			return nil
+		}
+	}
+	return errors.New("the server's roster leaves the invited participant out")
+}
