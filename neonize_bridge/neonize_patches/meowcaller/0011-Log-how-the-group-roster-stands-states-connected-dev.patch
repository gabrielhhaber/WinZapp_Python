--- /dev/null
+++ b/roster_diag.go
@@ -0,0 +1,39 @@
+package meowcaller
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// describeGroupRoster summarizes a group update's roster for the log without
+// naming anyone: how many participants are in each state, how many devices
+// they carry and how many of those devices have a PID. WinZapp: a callee heard
+// nobody because every roster it received left no connected device with a PID.
+func describeGroupRoster(update groupCallUpdate) string {
+	states := make(map[string]int)
+	devices, withPID := 0, 0
+	for _, participant := range update.Participants {
+		states[participant.State]++
+		if participant.State != "connected" {
+			continue
+		}
+		for _, device := range participant.Devices {
+			devices++
+			if device.HasPID {
+				withPID++
+			}
+		}
+	}
+	names := make([]string, 0, len(states))
+	for state := range states {
+		names = append(names, state)
+	}
+	sort.Strings(names)
+	parts := make([]string, 0, len(names))
+	for _, state := range names {
+		parts = append(parts, fmt.Sprintf("%s=%d", state, states[state]))
+	}
+	return fmt.Sprintf("participants=%d %s connected_devices=%d with_pid=%d",
+		len(update.Participants), strings.Join(parts, ","), devices, withPID)
+}
diff --git a/roster_diag_test.go b/roster_diag_test.go
new file mode 100644
index 0000000..52bf1de
--- /dev/null
+++ b/roster_diag_test.go
@@ -0,0 +1,19 @@
+package meowcaller
+
+import "testing"
+
+func TestDescribeGroupRosterCountsStatesAndPIDsWithoutNamingAnyone(t *testing.T) {
+	update := groupCallUpdate{Participants: []groupCallParticipant{
+		{State: "connected", Devices: []groupCallDevice{{HasPID: true}, {HasPID: false}}},
+		{State: "connected"},
+		{State: "invited"},
+	}}
+	got := describeGroupRoster(update)
+	want := "participants=3 connected=2,invited=1 connected_devices=2 with_pid=1"
+	if got != want {
+		t.Fatalf("describeGroupRoster() = %q, want %q", got, want)
+	}
+	if got := describeGroupRoster(groupCallUpdate{}); got != "participants=0  connected_devices=0 with_pid=0" {
+		t.Fatalf("empty roster = %q", got)
+	}
+}
