+
+func TestAJoinAckThatAsksForTheGroupKeyDistributesIt(t *testing.T) {
+	// A link joined second gets rekey="1" in the join ACK and in no later
+	// group_update: without the fan-out here nobody sends the key.
+	previous := callLinkHeartbeatInterval
+	callLinkHeartbeatInterval = time.Hour
+	defer func() { callLinkHeartbeatInterval = previous }()
+	ack := linkJoinAck(false)
+	ack.GetChildren()[0].Attrs["rekey"] = "1"
+	eng, _ := linkTestEngine(ack)
+	var asked []groupCallUpdate
+	eng.distributeEpoch = func(_ context.Context, update groupCallUpdate) error {
+		asked = append(asked, update)
+		return nil
+	}
+	if _, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{}); err != nil {
+		t.Fatalf("join: %v", err)
+	}
+	if len(asked) != 1 || asked[0].CallID != "LCID" || !asked[0].RekeyRequested {
+		t.Fatalf("fan-out %+v", asked)
+	}
+	eng.finishCall("LCID", "test")
+}
+
+func TestAJoinAckWithoutARekeyRequestDistributesNothing(t *testing.T) {
+	previous := callLinkHeartbeatInterval
+	callLinkHeartbeatInterval = time.Hour
+	defer func() { callLinkHeartbeatInterval = previous }()
+	eng, _ := linkTestEngine(linkJoinAck(false))
+	eng.distributeEpoch = func(context.Context, groupCallUpdate) error {
+		t.Fatal("no rekey was asked for")
+		return nil
+	}
+	if _, err := eng.joinPublicCallLink(context.Background(), "TOKEN", CallLinkOptions{}); err != nil {
+		t.Fatalf("join: %v", err)
+	}
+	eng.finishCall("LCID", "test")
+}
diff --git a/engine_group_api.go b/engine_group_api.go
index cfb6e78..7f25381 100644
--- a/engine_group_api.go
+++ b/engine_group_api.go
@@ -442,13 +442,31 @@ func (e *engine) joinPublicCallLink(
 	e.c.log.Info().Str("call_id", result.CallID).Bool("video", video).
 		Bool("waiting_room", result.InWaitingRoom).Bool("has_roster", result.Group != nil).
 		Msg("joined a call link")
+	rekeyRequested := false
 	if result.Group != nil {
-		e.applyGroupUpdate(*result.Group)
+		rekeyRequested = e.applyGroupUpdate(*result.Group) && result.Group.RekeyRequested
 	}
 	e.startCallLinkHeartbeat(result.CallID)
+	if rekeyRequested {
+		e.distributeJoinRekey(*result.Group)
+	}
 	return call, nil
 }
 
+// distributeJoinRekey answers a rekey the server asked for in the join ACK
+// itself: a link joined second is told to create the group key there, and no
+// later group_update repeats it, so the stanza handler's fan-out never runs
+// and nobody sends the key (media never starts).
+func (e *engine) distributeJoinRekey(update groupCallUpdate) {
+	distribute := e.distributeEpoch
+	if distribute == nil {
+		distribute = e.distributeRequestedGroupEpoch
+	}
+	if err := distribute(context.Background(), update); err != nil {
+		e.c.log.Warn().Err(err).Str("call_id", update.CallID).Msg("group rekey fanout after a call link join failed")
+	}
+}
+
