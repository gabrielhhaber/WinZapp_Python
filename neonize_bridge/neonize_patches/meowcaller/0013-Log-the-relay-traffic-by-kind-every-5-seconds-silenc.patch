diff --git a/relay_traffic.go b/relay_traffic.go
new file mode 100644
index 0000000..79a5076
--- /dev/null
+++ b/relay_traffic.go
@@ -0,0 +1,69 @@
+package meowcaller
+
+import (
+	"context"
+	"fmt"
+	"sync/atomic"
+	"time"
+
+	"github.com/purpshell/meowcaller/relay"
+	"github.com/rs/zerolog"
+)
+
+const relayTrafficInterval = 5 * time.Second
+
+// relayTraffic counts what the relay delivers by kind, from the media loop, and
+// is read by a ticker. The receive summary only prints when a packet arrives,
+// so a call whose relay went quiet said nothing; this says "0 RTP in the last 5
+// seconds" and whether SRTCP or STUN kept coming. It only counts.
+type relayTraffic struct {
+	rtp, rtcp, stun, other atomic.Uint64
+}
+
+type relayTrafficCounts struct{ rtp, rtcp, stun, other uint64 }
+
+func (t *relayTraffic) note(kind relay.RelayPacketKind) {
+	switch kind {
+	case relay.RelayPacketRtp:
+		t.rtp.Add(1)
+	case relay.RelayPacketRtcp:
+		t.rtcp.Add(1)
+	case relay.RelayPacketStun:
+		t.stun.Add(1)
+	default:
+		t.other.Add(1)
+	}
+}
+
+func (t *relayTraffic) counts() relayTrafficCounts {
+	return relayTrafficCounts{t.rtp.Load(), t.rtcp.Load(), t.stun.Load(), t.other.Load()}
+}
+
+// since is what arrived after earlier was taken.
+func (c relayTrafficCounts) since(earlier relayTrafficCounts) relayTrafficCounts {
+	return relayTrafficCounts{c.rtp - earlier.rtp, c.rtcp - earlier.rtcp, c.stun - earlier.stun, c.other - earlier.other}
+}
+
+func (c relayTrafficCounts) String() string {
+	return fmt.Sprintf("rtp=%d rtcp=%d stun=%d other=%d", c.rtp, c.rtcp, c.stun, c.other)
+}
+
+// watch logs the window's counts every interval until ctx ends.
+func (t *relayTraffic) watch(ctx context.Context, log zerolog.Logger, interval time.Duration) {
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	previous := t.counts()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		now := t.counts()
+		log.Info().
+			Str("last_window", now.since(previous).String()).
+			Str("totals", now.String()).
+			Msg("relay traffic by kind")
+		previous = now
+	}
+}
diff --git a/relay_traffic_test.go b/relay_traffic_test.go
new file mode 100644
index 0000000..0bd5758
--- /dev/null
+++ b/relay_traffic_test.go
@@ -0,0 +1,23 @@
+package meowcaller
+
+import (
+	"testing"
+
+	"github.com/purpshell/meowcaller/relay"
+)
+
+func TestRelayTrafficCountsEachKindAndTheWindow(t *testing.T) {
+	var traffic relayTraffic
+	traffic.note(relay.RelayPacketRtp)
+	traffic.note(relay.RelayPacketRtp)
+	traffic.note(relay.RelayPacketRtcp)
+	first := traffic.counts()
+	if got := first.String(); got != "rtp=2 rtcp=1 stun=0 other=0" {
+		t.Fatalf("counts = %q", got)
+	}
+	traffic.note(relay.RelayPacketStun)
+	traffic.note(relay.RelayPacketOther)
+	if got := traffic.counts().since(first).String(); got != "rtp=0 rtcp=0 stun=1 other=1" {
+		t.Fatalf("window = %q, want the silence of RTP to show as rtp=0", got)
+	}
+}
