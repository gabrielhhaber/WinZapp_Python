@@ -0,0 +1,76 @@
+package meowcaller
+
+import (
+	"fmt"
+	"github.com/pion/opus"
+	"github.com/purpshell/meowcaller/mlow"
+	"math"
+)
+
+type mlowPCM48Encoder struct {
+	codec *mlow.MlowEncoder
+	down  pcmRateFilter
+}
+
+func (e *mlowPCM48Encoder) Encode(frame []float32) ([]byte, error) {
+	if len(frame) != 2880 {
+		return nil, fmt.Errorf("MLow PCM48: expected 2880 samples, got %d", len(frame))
+	}
+	return e.codec.Encode(e.down.convert(frame, false))
+}
+
+type opusPCM48Encoder struct{ codec *opus.Encoder }
+
+func (e *opusPCM48Encoder) Encode(frame []float32) ([]byte, error) {
+	if len(frame) != 2880 {
+		return nil, fmt.Errorf("Opus PCM48: expected 2880 samples, got %d", len(frame))
+	}
+	parts := make([][]byte, 0, 3)
+	for offset := 0; offset < len(frame); offset += 960 {
+		pcm := append([]float32(nil), frame[offset:offset+960]...)
+		for i, v := range pcm {
+			if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+				v = 0
+			}
+			pcm[i] = max(-1, min(1, v))
+		}
+		packet := make([]byte, 4096)
+		n, err := e.codec.EncodeFloat32(pcm, packet)
+		if err != nil {
+			return nil, err
+		}
+		packet = packet[:n]
+		if n < 1 || packet[0]>>3 != 31 || packet[0]&7 != 0 || n > 1276 {
+			return nil, fmt.Errorf("unexpected CELT20 packet shape")
+		}
+		parts = append(parts, packet[1:])
+	}
+	// Code-3 VBR: three independent 20ms coding frames, no second lossy encoding.
+	output := []byte{0xfb, 0x83}
+	for _, p := range parts[:2] {
+		n := len(p)
+		if n < 252 {
+			output = append(output, byte(n))
+		} else {
+			first := 252 + (n & 3)
+			output = append(output, byte(first), byte((n-first)/4))
+		}
+	}
+	for _, p := range parts {
+		output = append(output, p...)
+	}
+	return output, nil
+}
+
+func newPCM48Encoder(codec AudioCodec) (callAudioEncoder, error) {
+	if codec != AudioCodecOpus {
+		return &mlowPCM48Encoder{codec: mlow.NewMlowEncoder()}, nil
+	}
+	enc, err := opus.NewEncoder(opus.WithSampleRate(48000), opus.WithChannels(1),
+		opus.WithApplication(opus.ApplicationVoIP), opus.WithBitrate(24000), opus.WithVBR(true),
+		opus.WithComplexity(10), opus.WithBandwidth(opus.BandwidthFullband), opus.WithMaxBandwidth(opus.BandwidthFullband))
+	if err != nil {
+		return nil, err
+	}
+	return &opusPCM48Encoder{codec: enc}, nil
+}
