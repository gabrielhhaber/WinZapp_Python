new file mode 100644
index 0000000..214d755
--- /dev/null
+++ b/audio_pcm_rate.go
@@ -0,0 +1,80 @@
+package meowcaller
+
+import "math"
+
+// PCM48 is an opt-in source/sink contract; codec and RTP clocks remain negotiated.
+const FullbandSampleRate = 48000
+
+func audioPCMRate(rates ...int) int {
+	if len(rates) > 0 && rates[0] == FullbandSampleRate {
+		return FullbandSampleRate
+	}
+	return SampleRate
+}
+
+// PCMRate is fixed for the client lifetime, including late codec changes.
+func (c *Call) PCMRate() int {
+	if c != nil && c.eng != nil && c.eng.c != nil {
+		return audioPCMRate(c.eng.c.pcmRate)
+	}
+	return SampleRate
+}
+
+// WithPCM48 opts this client's AudioSource/AudioSink into mono 48k / 2880 samples
+// per 60ms frame. Default clients and built-in 16k sources remain unchanged.
+func WithPCM48() Option { return func(c *config) { c.pcmRate = FullbandSampleRate } }
+
+var pcmRateWeights = func() [97]float64 {
+	var taps [97]float64
+	sum := 0.0
+	for n := range taps {
+		x := float64(n - 48)
+		sinc := 0.30
+		if x != 0 {
+			sinc = math.Sin(math.Pi*0.30*x) / (math.Pi * x)
+		}
+		window := 0.42 - 0.5*math.Cos(2*math.Pi*float64(n)/96) + 0.08*math.Cos(4*math.Pi*float64(n)/96)
+		taps[n] = sinc * window
+		sum += taps[n]
+	}
+	for n := range taps {
+		taps[n] /= sum
+	}
+	return taps
+}()
+
+// Per-codec causal FIR state. No tail is flushed into a replacement codec/call.
+type pcmRateFilter struct{ history [96]float64 }
+
+func (f *pcmRateFilter) convert(input []float32, up bool) []float32 {
+	factor := 1
+	if up {
+		factor = 3
+	}
+	data := make([]float64, 96+len(input)*factor)
+	copy(data, f.history[:])
+	for i, v := range input {
+		if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+			v = 0
+		}
+		data[96+i*factor] = float64(v)
+	}
+	step, start, gain := 3, 98, 1.0
+	if up {
+		step, start, gain = 1, 96, 3
+	}
+	output := make([]float32, 0, len(input)*factor/step)
+	for end := start; end < len(data); end += step {
+		value := 0.0
+		for i, w := range pcmRateWeights {
+			value += w * data[end-96+i]
+		}
+		value *= gain
+		if !up { // Same s16 rounding boundary as the legacy bridge FIR.
+			value = math.Max(-32768, math.Min(32767, math.RoundToEven(value*32768))) / 32768
+		}
+		output = append(output, float32(value))
+	}
+	copy(f.history[:], data[len(data)-96:])
+	return output
+}
