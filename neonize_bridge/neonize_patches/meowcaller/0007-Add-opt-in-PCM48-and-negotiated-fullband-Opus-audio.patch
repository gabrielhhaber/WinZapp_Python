+
+func TestPCM48ReferenceCELTPacket(t *testing.T) {
+	enc, err := newCallAudioEncoder(AudioCodecOpus, 48000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	packet, err := enc.Encode(pcm48Tone(12000, 2880))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Synthetic packet only, for an independent file decoder outside this package.
+	t.Logf("PCM48_REFERENCE=%s", hex.EncodeToString(packet))
+}
+
+func pcm48Tone(hz float64, n int) []float32 {
+	pcm := make([]float32, n)
+	for i := range pcm {
+		pcm[i] = float32(.25 * math.Sin(2*math.Pi*hz*float64(i)/48000))
+	}
+	return pcm
+}
+
+func TestPCM48CodecContracts(t *testing.T) {
+	for _, codec := range []AudioCodec{AudioCodecMlow, AudioCodecOpus} {
+		t.Run(codec.String(), func(t *testing.T) {
+			enc, err := newCallAudioEncoder(codec, 48000)
+			if err != nil {
+				t.Fatal(err)
+			}
+			dec := newCallAudioDecoder(codec, 48000)
+			packet, err := enc.Encode(pcm48Tone(1000, 2880))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if codec == AudioCodecOpus && (packet[0] != 0xfb || packet[1]&63 != 3) {
+				t.Fatal("not three fullband CELT frames")
+			}
+			output := dec.Decode(packet)
+			if len(output) != 2880 || dec.PCMRate() != 48000 {
+				t.Fatal("PCM48 duration lost")
+			}
+			for _, v := range output {
+				if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+					t.Fatal("nonfinite PCM")
+				}
+			}
+			if _, err = enc.Encode(make([]float32, 960)); err == nil {
+				t.Fatal("16k frame accepted as PCM48")
+			}
+			if len(dec.Conceal(960)) != 960 {
+				t.Fatal("PLC lost 20ms48k duration")
+			}
+		})
+	}
+}
+
+func TestPCM48LegacyDefaultsAndEscapedReceive(t *testing.T) {
+	if resolveConfig(nil).pcmRate != 0 || audioPCMRate() != 16000 {
+		t.Fatal("default changed")
+	}
+	cfg := resolveConfig([]Option{WithPCM48()})
+	if cfg.pcmRate != 48000 {
+		t.Fatal("opt-in ignored")
+	}
+	enc, _ := newCallAudioEncoder(AudioCodecOpus, 48000)
+	packet, err := enc.Encode(pcm48Tone(12000, 2880))
+	if err != nil {
+		t.Fatal(err)
+	}
+	escaped := append([]byte(nil), packet...)
+	escaped[0] = 0xfd
+	native := newCallAudioDecoder(AudioCodecOpus, 48000).Decode(packet)
+	decoded := newCallAudioDecoder(AudioCodecMlow, 48000).Decode(escaped)
+	if !reflect.DeepEqual(native, decoded) {
+		t.Fatal("MLow escape changed CELT PCM")
+	}
+	if len(newCallAudioDecoder(AudioCodecMlow, 48000).Decode([]byte{0x90})) != 2880 {
+		t.Fatal("SID changed contract")
+	}
+}
+
+func TestPCM48FilterCountsContinuityAndAliasRejection(t *testing.T) {
+	signal := pcm48Tone(1000, 5760)
+	var whole, split pcmRateFilter
+	a := whole.convert(signal, false)
+	b := append(split.convert(signal[:2880], false), split.convert(signal[2880:], false)...)
+	if len(a) != 1920 || !reflect.DeepEqual(a, b) {
+		t.Fatal("downsample split/count drift")
+	}
+	var up pcmRateFilter
+	if len(up.convert(a, true)) != 5760 {
+		t.Fatal("upsample count drift")
+	}
+	var aliased pcmRateFilter
+	rejected := aliased.convert(pcm48Tone(12000, 5760), false)
+	energy := 0.0
+	for _, v := range rejected[100:] {
+		energy += float64(v * v)
+	}
+	if math.Sqrt(energy/float64(len(rejected)-100)) > .001 {
+		t.Fatal("out-of-band folded into MLow")
+	}
+}
+
+func TestPCM48ClockPlayoutAndGroupBudgets(t *testing.T) {
+	var order audioReceiveOrder
+	order.Timestamp(0xfffffff0, 48000, 48000)
+	if order.Timestamp(0xfffffff0+uint32(0), 48000, 48000) != 0 {
+		t.Fatal("initial timestamp changed")
+	}
+	if order.Timestamp(2864, 48000, 48000) != 2880 {
+		t.Fatal("wrapped48k RTP time lost")
+	}
+	mixer := newParticipantAudioMixer(48000)
+	mixer.Add("p", make([]float32, 11520+100))
+	if len(mixer.streams["p"].pending) != 11520 {
+		t.Fatal("group budget is not240ms")
+	}
+	chunk, ok := mixer.MixChunk()
+	if !ok || len(chunk) != 480 {
+		t.Fatal("group chunk is not10ms")
+	}
+	framer := participantAudioSinkFramer{pcmRate: 48000}
+	for i := 0; i < 6; i++ {
+		frame, ready := framer.Push(chunk)
+		if ready != (i == 5) || ready && len(frame) != 2880 {
+			t.Fatal("group frame changed duration")
+		}
+	}
+	sink := SinkFunc(func(frame []float32) {
+		if len(frame) != 2880 {
+			t.Fatal("playout changed frame size")
+		}
+	})
+	playout := newAudioPlayoutBuffer(48000)
+	for i := 0; i < 3; i++ {
+		started, err := playout.Push(uint32(i*2880), make([]float32, 2880), sink)
+		if err != nil || started != (i == 2) {
+			t.Fatal("48k prefill is not120ms")
+		}
+	}
+}
+
+func TestPCM48LateCodecSwitchPreservesFormatAndSRTP(t *testing.T) {
+	self, peer := mediaTestJID("100", 1), mediaTestJID("200", 2)
+	key := bytes.Repeat([]byte{7}, 32)
+	registry, err := newParticipantReceiveRegistry("PCM48", key, self.String(), peer.String(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer registry.clear()
+	selfSSRC, _ := rtp.DeriveWasmParticipantSsrc("PCM48", rtp.FormatE2ESrtpParticipantID(self.String()), 0)
+	peerSSRC, _ := rtp.DeriveWasmParticipantSsrc("PCM48", rtp.FormatE2ESrtpParticipantID(peer.String()), 0)
+	sender, _ := NewMediaPipeline(key, self.String(), peer.String(), selfSSRC, 960)
+	remote, _ := NewMediaPipeline(key, peer.String(), self.String(), peerSSRC, 960)
+	codec := AudioCodecMlow
+	enc, _ := newCallAudioEncoder(codec, 48000)
+	registry.configureAudioCodec(codec, 48000)
+	audio := &callAudioRuntime{pcmRate: 48000, codec: codec, encoder: enc, receivers: registry, sender: sender, current: func() AudioCodec { return codec }}
+	var previous uint16
+	for i, want := range []AudioCodec{AudioCodecMlow, AudioCodecOpus, AudioCodecMlow} {
+		codec = want
+		packet, err := audio.Protect(make([]float32, 2880))
+		if err != nil {
+			t.Fatal(err)
+		}
+		header, payload, ok := remote.UnprotectAudio(packet)
+		if !ok {
+			t.Fatal("SRTP rejected")
+		}
+		if i > 0 && header.SequenceNumber != previous+1 {
+			t.Fatal("sequence reset")
+		}
+		previous = header.SequenceNumber
+		if len(newCallAudioDecoder(want, 48000).Decode(payload)) != 2880 {
+			t.Fatal("send48k format changed")
+		}
+		peerEnc, _ := newCallAudioEncoder(want, 48000)
+		payload, err = peerEnc.Encode(make([]float32, 2880))
+		if err != nil {
+			t.Fatal(err)
+		}
+		remote.setAudioTimestampStride(audioRTPClock(want) * 60 / 1000)
+		packet, err = remote.ProtectAudio(payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		frames, ok, _, err := audio.Receive(packet, time.Unix(int64(i), 0))
+		if err != nil || !ok || len(frames) != 1 || len(frames[0].PCM) != 2880 {
+			t.Fatal("receive48k format changed")
+		}
+	}
+}
