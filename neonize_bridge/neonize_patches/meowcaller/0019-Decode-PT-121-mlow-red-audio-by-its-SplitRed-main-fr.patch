+// decodeAudioPayload decodes one authenticated audio payload by its RTP
+// payload type: PT 121 (mlow-red) carries SplitRed blocks around the main
+// frame, and decoding it as a bare frame gave silence (seen live: after a
+// member joined a group call again, the others sent PT 121 to it and it heard
+// nobody).
+func decodeAudioPayload(decoder participantAudioDecoder, payloadType uint8, payload []byte) []float32 {
+	if red, ok := decoder.(interface{ DecodeRed([]byte) []float32 }); ok && payloadType == rtp.RtpPayloadTypeMlowRed {
+		return red.DecodeRed(payload)
+	}
+	return decoder.Decode(payload)
+}
