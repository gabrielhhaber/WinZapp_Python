 		UserJID:       receiver.userJID, DeviceJID: receiver.deviceJID,
diff --git a/mlow/decoder.go b/mlow/decoder.go
index cdac3c2..2896836 100644
--- a/mlow/decoder.go
+++ b/mlow/decoder.go
@@ -103,6 +103,21 @@ func (d *MlowDecoder) Decode(payload []byte) []float32 {
 	return d.decodeFrame(payload)
 }
 
+// DecodeRed decodes one PT 121 (mlow-red) payload: SplitRed blocks with the
+// main frame last, whatever redundancy level was negotiated. A payload that
+// cannot be unpacked is concealed.
+func (d *MlowDecoder) DecodeRed(payload []byte) []float32 {
+	if len(payload) == 0 {
+		return d.plc.decoded(make([]float32, opusFrameSamps))
+	}
+	frames, err := DepackSplitRed(payload, d.log)
+	if err != nil || len(frames) == 0 {
+		d.log.Debug().Err(err).Int("payload_bytes", len(payload)).Msg("decode red: depack failed, concealing")
+		return d.plc.conceal(opusFrameSamps)
+	}
+	return d.decodeFrame(frames[len(frames)-1].Data)
+}
+
