diff --git a/audio_red_test.go b/audio_red_test.go
new file mode 100644
index 0000000..2d7e6af
--- /dev/null
+++ b/audio_red_test.go
@@ -0,0 +1,62 @@
+package meowcaller
+
+import (
+	"math"
+	"testing"
+
+	"github.com/purpshell/meowcaller/rtp"
+)
+
+func splitRed(previous, current []byte) []byte {
+	out := []byte{0x80 | 1, byte(len(previous)), 2}
+	out = append(out, previous...)
+	return append(out, current...)
+}
+
+// PT 121 (mlow-red) carries the main frame after SplitRed blocks; decoded as
+// a bare frame it gave silence (seen live after a member rejoined a group
+// call). Decoding the RED payloads must give exactly what the bare frames give.
+func TestMlowRedPayloadDecodesLikeItsMainFrame(t *testing.T) {
+	encoder, err := newCallAudioEncoder(AudioCodecMlow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var frames [][]byte
+	for n := 0; n < 8; n++ {
+		pcm := make([]float32, FrameSamples)
+		for i := range pcm {
+			pcm[i] = float32(.3 * math.Sin(2*math.Pi*220*float64(i+n*FrameSamples)/SampleRate))
+		}
+		frame, err := encoder.Encode(pcm)
+		if err != nil {
+			t.Fatal(err)
+		}
+		frames = append(frames, frame)
+	}
+	bare, red := newCallAudioDecoder(AudioCodecMlow), newCallAudioDecoder(AudioCodecMlow)
+	var energy float64
+	for n, frame := range frames {
+		previous := frames[max(0, n-1)]
+		want := decodeAudioPayload(bare, rtp.RtpPayloadTypeOpus, frame)
+		got := decodeAudioPayload(red, rtp.RtpPayloadTypeMlowRed, splitRed(previous, frame))
+		if len(got) != len(want) {
+			t.Fatalf("frame %d: %d samples, want %d", n, len(got), len(want))
+		}
+		for i := range got {
+			if got[i] != want[i] {
+				t.Fatalf("frame %d sample %d: %v, want %v", n, i, got[i], want[i])
+			}
+			energy += float64(got[i]) * float64(got[i])
+		}
+	}
+	if energy < 1 {
+		t.Fatalf("the RED stream decoded to silence: energy %g", energy)
+	}
+}
+
+func TestBrokenMlowRedPayloadIsConcealedNotDropped(t *testing.T) {
+	decoder := newCallAudioDecoder(AudioCodecMlow)
+	if got := decodeAudioPayload(decoder, rtp.RtpPayloadTypeMlowRed, []byte{0x81, 200}); len(got) != FrameSamples {
+		t.Fatalf("broken RED payload gave %d samples, want %d", len(got), FrameSamples)
+	}
+}
