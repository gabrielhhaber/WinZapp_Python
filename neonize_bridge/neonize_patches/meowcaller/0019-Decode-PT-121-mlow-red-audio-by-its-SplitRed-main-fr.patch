+// DecodeRed decodes a PT 121 payload (MLow with SplitRed redundancy). Opus
+// never travels as PT 121, so an Opus call decodes it as a plain packet.
+func (d *callAudioDecoder) DecodeRed(payload []byte) []float32 {
+	if d.codec == AudioCodecOpus {
+		return d.Decode(payload)
+	}
+	d.decodedOpus = false
+	output := d.mlow.DecodeRed(payload)
+	if d.PCMRate() == FullbandSampleRate {
+		output = d.up.convert(output, true)
+	}
+	d.last = append(d.last[:0], output...)
+	return output
+}
+
