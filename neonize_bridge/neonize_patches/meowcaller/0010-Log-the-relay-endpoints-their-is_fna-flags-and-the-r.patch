diff --git a/relay_diag.go b/relay_diag.go
new file mode 100644
index 0000000..6a868cd
--- /dev/null
+++ b/relay_diag.go
@@ -0,0 +1,46 @@
+package meowcaller
+
+import (
+	"fmt"
+	"strings"
+)
+
+// describeRelayEndpoints lists a call's relay endpoints for the log, one entry
+// per te2, by relay name and flags only (never an address or a token): the
+// entry the media loop picked is marked with "*". It exists so a call whose
+// peer media never arrives shows whether the endpoint chosen was the one the
+// caller marked is_fna.
+func describeRelayEndpoints(rd *relayData, inbound bool) string {
+	if rd == nil || len(rd.endpoints) == 0 {
+		return "none"
+	}
+	chosen := getMediaRelayEndpoint(rd, inbound)
+	parts := make([]string, 0, len(rd.endpoints))
+	for i := range rd.endpoints {
+		ep := &rd.endpoints[i]
+		mark := ""
+		if ep == chosen {
+			mark = "*"
+		}
+		fna := 0
+		if ep.isFNA {
+			fna = 1
+		}
+		parts = append(parts, fmt.Sprintf("%s%s:fna=%d:token=%d:auth=%d:addrs=%d",
+			mark, ep.relayName, fna, ep.tokenID, ep.authTokenID, len(ep.addresses)))
+	}
+	return strings.Join(parts, " ")
+}
+
+// relayChoiceChanged reports whether new relay data would make the media loop
+// pick a different endpoint than old did (by relay name and is_fna).
+func relayChoiceChanged(old, updated *relayData, inbound bool) bool {
+	if old == nil || updated == nil {
+		return old != updated
+	}
+	a, b := getMediaRelayEndpoint(old, inbound), getMediaRelayEndpoint(updated, inbound)
+	if a == nil || b == nil {
+		return a != b
+	}
+	return a.relayName != b.relayName || a.isFNA != b.isFNA
+}
diff --git a/relay_diag_test.go b/relay_diag_test.go
new file mode 100644
index 0000000..42e2d73
--- /dev/null
+++ b/relay_diag_test.go
@@ -0,0 +1,52 @@
+package meowcaller
+
+import "testing"
+
+func TestDescribeRelayEndpointsMarksTheChosenOne(t *testing.T) {
+	rd := &relayData{endpoints: []relayEndpoint{
+		{relayName: "a1", tokenID: 0, authTokenID: 1, addresses: []relayAddress{{"192.0.2.1", 3478}}},
+		{relayName: "b2", tokenID: 1, isFNA: true, addresses: []relayAddress{{"192.0.2.2", 3478}}},
+	}}
+	if got, want := describeRelayEndpoints(rd, true), "a1:fna=0:token=0:auth=1:addrs=1 *b2:fna=1:token=1:auth=0:addrs=1"; got != want {
+		t.Fatalf("inbound = %q, want %q", got, want)
+	}
+	if got, want := describeRelayEndpoints(rd, false), "*a1:fna=0:token=0:auth=1:addrs=1 b2:fna=1:token=1:auth=0:addrs=1"; got != want {
+		t.Fatalf("outbound = %q, want %q", got, want)
+	}
+	if got := describeRelayEndpoints(nil, true); got != "none" {
+		t.Fatalf("nil = %q", got)
+	}
+}
+
+func TestDescribeRelayEndpointsNeverPrintsAddresses(t *testing.T) {
+	rd := &relayData{endpoints: []relayEndpoint{{relayName: "a1", addresses: []relayAddress{{"192.0.2.1", 3478}}}}}
+	if got := describeRelayEndpoints(rd, false); containsAny(got, "192.0.2.1", "3478") {
+		t.Fatalf("address leaked into %q", got)
+	}
+}
+
+func containsAny(s string, needles ...string) bool {
+	for _, n := range needles {
+		for i := 0; i+len(n) <= len(s); i++ {
+			if s[i:i+len(n)] == n {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func TestRelayChoiceChanged(t *testing.T) {
+	a := &relayData{endpoints: []relayEndpoint{{relayName: "a1", authTokenID: 1}}}
+	b := &relayData{endpoints: []relayEndpoint{{relayName: "a1", authTokenID: 1}}}
+	c := &relayData{endpoints: []relayEndpoint{{relayName: "b2", authTokenID: 1}}}
+	if relayChoiceChanged(a, b, true) {
+		t.Fatal("same endpoint reported as changed")
+	}
+	if !relayChoiceChanged(a, c, true) {
+		t.Fatal("different relay not reported")
+	}
+	if !relayChoiceChanged(a, nil, true) {
+		t.Fatal("lost relay not reported")
+	}
+}
