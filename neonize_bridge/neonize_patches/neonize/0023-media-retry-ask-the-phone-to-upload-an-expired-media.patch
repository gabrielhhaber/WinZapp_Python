+    def send_media_retry(self, request: dict) -> dict:
+        """Asks the account's own phone to upload a message's media again (its
+        CDN link expired). request is {"chat", "sender" (groups), "id",
+        "from_me", "is_group", "media_key": base64}. The phone's answer comes
+        later as ``MediaRetryEv`` (see :meth:`decrypt_media_retry`).
+
+        :return: {"ok": true} or {"error"}.
+        :raises AttributeError: on a build without media retry.
+        """
+        raw = self.__client.SendMediaRetry(self.uuid, json.dumps(request).encode())
+        return json.loads(raw.decode() or "{}")
+
+    def decrypt_media_retry(self, request: dict) -> dict:
+        """Opens the phone's answer to :meth:`send_media_retry`. request is
+        {"media_key": base64, "message_id", "ciphertext": base64, "iv":
+        base64, "has_error", "error_code"}.
+
+        :return: {"result": SUCCESS | NOT_FOUND | DECRYPTION_ERROR |
+            GENERAL_ERROR, "direct_path"} or {"error"}.
+        :raises AttributeError: on a build without media retry.
+        """
+        raw = self.__client.DecryptMediaRetry(json.dumps(request).encode())
+        return json.loads(raw.decode() or "{}")
+
     def request_app_state_recovery(self, name: str):
