diff --git a/goneonize/mediaretry.go b/goneonize/mediaretry.go
new file mode 100644
index 0000000..ba4e48e
--- /dev/null
+++ b/goneonize/mediaretry.go
@@ -0,0 +1,131 @@
+package main
+
+/*
+   #include <stdlib.h>
+*/
+import "C"
+
+// Media retry: when a media's CDN link has expired (403/404/410) the phone
+// that holds the file can upload it again. Two calls, JSON in and out like
+// rawiq.go (the Python wrapper is Client.send_media_retry /
+// Client.decrypt_media_retry), and the events.MediaRetry event (59):
+//
+//   - SendMediaRetry(id, request) asks the account's own phone to upload the
+//     media of one message again;
+//   - DecryptMediaRetry(request) opens the phone's answer (the MediaRetry event)
+//     with the media key and says whether it succeeded and the new direct path.
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waMmsRetry"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+type mediaRetryRequest struct {
+	Chat     string `json:"chat"`
+	Sender   string `json:"sender"`
+	ID       string `json:"id"`
+	FromMe   bool   `json:"from_me"`
+	IsGroup  bool   `json:"is_group"`
+	MediaKey string `json:"media_key"`
+}
+
+type mediaRetryDecrypt struct {
+	MediaKey   string `json:"media_key"`
+	MessageID  string `json:"message_id"`
+	Ciphertext string `json:"ciphertext"`
+	IV         string `json:"iv"`
+	ErrorCode  int    `json:"error_code"`
+	HasError   bool   `json:"has_error"`
+}
+
+// SendMediaRetry sends the retry receipt; answers {"ok": true} or {"error"}.
+//
+//export SendMediaRetry
+func SendMediaRetry(id *C.char, request *C.char) *C.char {
+	cli := clients[C.GoString(id)]
+	if cli == nil {
+		return rawError(fmt.Errorf("client not found"))
+	}
+	var req mediaRetryRequest
+	if err := json.Unmarshal([]byte(C.GoString(request)), &req); err != nil {
+		return rawError(fmt.Errorf("request: %w", err))
+	}
+	key, err := base64.StdEncoding.DecodeString(req.MediaKey)
+	if err != nil || len(key) == 0 {
+		return rawError(fmt.Errorf("request: media_key must be base64 and not empty"))
+	}
+	chat, err := types.ParseJID(req.Chat)
+	if err != nil {
+		return rawError(fmt.Errorf("chat: %w", err))
+	}
+	info := &types.MessageInfo{
+		MessageSource: types.MessageSource{Chat: chat, IsFromMe: req.FromMe, IsGroup: req.IsGroup},
+		ID:            types.MessageID(req.ID),
+	}
+	if req.Sender != "" {
+		sender, err := types.ParseJID(req.Sender)
+		if err != nil {
+			return rawError(fmt.Errorf("sender: %w", err))
+		}
+		info.Sender = sender
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	if err := cli.SendMediaRetryReceipt(ctx, info, key); err != nil {
+		return rawError(err)
+	}
+	return rawAnswer(map[string]any{"ok": true})
+}
+
+// DecryptMediaRetry answers {"result": "SUCCESS" | "NOT_FOUND" |
+// "DECRYPTION_ERROR" | "GENERAL_ERROR", "direct_path": ...}. A phone that no
+// longer has the media (the unencrypted error code 2, or NOT_FOUND inside the
+// notification) answers NOT_FOUND; {"error"} is a notification that cannot be
+// opened with this key.
+//
+//export DecryptMediaRetry
+func DecryptMediaRetry(request *C.char) *C.char {
+	var req mediaRetryDecrypt
+	if err := json.Unmarshal([]byte(C.GoString(request)), &req); err != nil {
+		return rawError(fmt.Errorf("request: %w", err))
+	}
+	key, err := base64.StdEncoding.DecodeString(req.MediaKey)
+	if err != nil || len(key) == 0 {
+		return rawError(fmt.Errorf("request: media_key must be base64 and not empty"))
+	}
+	evt := &events.MediaRetry{MessageID: types.MessageID(req.MessageID)}
+	if req.HasError {
+		evt.Error = &events.MediaRetryError{Code: req.ErrorCode}
+	}
+	if req.Ciphertext != "" {
+		if evt.Ciphertext, err = base64.StdEncoding.DecodeString(req.Ciphertext); err != nil {
+			return rawError(fmt.Errorf("ciphertext: %w", err))
+		}
+	}
+	if req.IV != "" {
+		if evt.IV, err = base64.StdEncoding.DecodeString(req.IV); err != nil {
+			return rawError(fmt.Errorf("iv: %w", err))
+		}
+	}
+	notification, err := whatsmeow.DecryptMediaRetryNotification(evt, key)
+	if err != nil {
+		if errors.Is(err, whatsmeow.ErrMediaNotAvailableOnPhone) {
+			return rawAnswer(map[string]any{"result": "NOT_FOUND"})
+		}
+		return rawError(err)
+	}
+	result := waMmsRetry.MediaRetryNotification_ResultType_name[int32(notification.GetResult())]
+	return rawAnswer(map[string]any{
+		"result":      result,
+		"direct_path": notification.GetDirectPath(),
+	})
+}
