 """
 import ctypes
 import json
@@ -19,6 +21,10 @@ FRAME_BYTES = FRAME_SAMPLES * 2
 _NO_CALL = -2
 _EVENT_BUFFER = 64 * 1024       # an event that does not fit is lost on the Go side
 _RESULT_BUFFER = 4 * 1024
+_VIDEO_BUFFER = 1024 * 1024     # a larger access unit is dropped on the Go side
+
+# CallVideo actions
+VIDEO_REQUEST, VIDEO_ACCEPT, VIDEO_STOP, VIDEO_ENABLE, VIDEO_DISABLE = 1, 2, 3, 4, 5
 
 
 class CallError(Exception):
@@ -30,6 +36,11 @@ def available() -> bool:
     return hasattr(gocode, "CallsConfigure")
 
 
+def video_available() -> bool:
+    """Whether this build carries video and group calls."""
