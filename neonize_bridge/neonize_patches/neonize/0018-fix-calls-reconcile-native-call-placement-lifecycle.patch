diff --git a/neonize/calls.py b/neonize/calls.py
index 59986a4..1a7085d 100644
--- a/neonize/calls.py
+++ b/neonize/calls.py
@@ -147,6 +147,33 @@ class Calls:
             return None
         return json.loads(buf.raw[:size].decode("utf-8"))
 
+    def placement_state(self, call_id: str):
+        """An exact-generation lifecycle snapshot; None only for native no-call.
+
+        Called only when a placement result carries generation. An old DLL's
+        legacy CallInfo response must not masquerade as a terminal snapshot.
+        """
+        if not hasattr(gocode, "CallInfo"):
+            raise CallError("native placement snapshot unavailable")
+        buf = ctypes.create_string_buffer(_RESULT_BUFFER)
+        size = gocode.CallInfo(self.uuid, call_id.encode(), buf, _RESULT_BUFFER)
+        if size == _NO_CALL:
+            return None
+        if size <= 0 or size > _RESULT_BUFFER:
+            raise CallError("invalid native placement snapshot")
+        try:
+            value = json.loads(buf.raw[:size].decode("utf-8"))
+        except (UnicodeError, ValueError) as error:
+            raise CallError("invalid native placement snapshot") from error
+        if (not isinstance(value, dict) or type(value.get("generation")) is not int
+                or not 0 < value["generation"] < 2**64
+                or type(value.get("peerAccepted")) is not bool
+                or type(value.get("ended")) is not bool
+                or type(value.get("phase")) is not int
+                or not 0 <= value["phase"] <= 8):
+            raise CallError("invalid native placement snapshot")
+        return value
+
     def lobby(self, call_id: str, creator: str):
         """Where the group call `call_id` started by `creator` stands, as the
         server says while this account is not in it: {"call", "groupJid",
