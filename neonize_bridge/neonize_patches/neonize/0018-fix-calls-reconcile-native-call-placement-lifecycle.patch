diff --git a/goneonize/calls_lifecycle.go b/goneonize/calls_lifecycle.go
new file mode 100644
index 0000000..de04410
--- /dev/null
+++ b/goneonize/calls_lifecycle.go
@@ -0,0 +1,87 @@
+package main
+
+import (
+	"encoding/json"
+	"github.com/purpshell/meowcaller"
+)
+
+// Called under chamadasMu. The queue operations never block or call back.
+func queueCallEvent(queue chan string, encoded string) bool {
+	if queue == nil {
+		return false
+	}
+	select {
+	case queue <- encoded:
+		return true
+	default:
+		select {
+		case <-queue:
+		default:
+		}
+		select {
+		case queue <- encoded:
+			return true
+		default:
+			return false
+		}
+	}
+}
+
+// Incoming and end must be queued in one record order. Checking current and
+// enqueueing under the same map lock also fences a same-ID replacement.
+func emitIncomingCallRecord(cliente, id string, a *chamadaAtiva, event map[string]any) bool {
+	encoded, _ := json.Marshal(event)
+	a.notifications.Lock()
+	defer a.notifications.Unlock()
+	if a.call.State() == meowcaller.CallPhaseEnded {
+		return false
+	}
+	select {
+	case <-a.fim:
+		return false
+	default:
+	}
+	chamadasMu.Lock()
+	defer chamadasMu.Unlock()
+	if chamadasAtivas[chaveChamada(cliente, id)] != a {
+		return false
+	}
+	return queueCallEvent(chamadasEventos[cliente], string(encoded))
+}
+
+// The final map check is the snapshot's linearization point. No callback or
+// JSON serialization runs under chamadasMu; generation belongs to this a.
+func callLifecycleInfo(cliente, id string, a *chamadaAtiva) (map[string]any, bool) {
+	phase := a.call.State()
+	ended := phase == meowcaller.CallPhaseEnded
+	select {
+	case <-a.fim:
+		ended = true
+	default:
+	}
+	info := map[string]any{
+		"generation": a.generation, "peerAccepted": a.peerAccepted.Load(),
+		"ended": ended, "phase": int(phase),
+	}
+	chamadasMu.Lock()
+	current := chamadasAtivas[chaveChamada(cliente, id)] == a
+	chamadasMu.Unlock()
+	return info, current
+}
+
+func finishCallRecord(cliente, id string, a *chamadaAtiva, reason string) {
+	a.notifications.Lock()
+	defer a.notifications.Unlock()
+	a.finished.Do(func() {
+		a.encerrar()
+		encoded, _ := json.Marshal(map[string]any{"ev": "end", "call": id,
+			"reason": reason, "generation": a.generation})
+		chamadasMu.Lock()
+		current := chamadasAtivas[chaveChamada(cliente, id)] == a
+		if current {
+			delete(chamadasAtivas, chaveChamada(cliente, id))
+			queueCallEvent(chamadasEventos[cliente], string(encoded))
+		}
+		chamadasMu.Unlock()
+	})
+}
diff --git a/goneonize/calls_lifecycle_test.go b/goneonize/calls_lifecycle_test.go
new file mode 100644
index 0000000..922c6b6
--- /dev/null
+++ b/goneonize/calls_lifecycle_test.go
@@ -0,0 +1,172 @@
+package main
+
+import (
+	"encoding/json"
+	"sync"
+	"testing"
+
+	"github.com/purpshell/meowcaller"
+)
+
+func lifecycleRecord(t *testing.T, client, id string, generation uint64) *chamadaAtiva {
+	t.Helper()
+	a := &chamadaAtiva{call: &meowcaller.Call{}, generation: generation,
+		entrada: newCallPCMQueue(), fim: make(chan struct{})}
+	key := chaveChamada(client, id)
+	chamadasMu.Lock()
+	previous, events := chamadasAtivas[key], chamadasEventos[client]
+	chamadasAtivas[key] = a
+	chamadasEventos[client] = make(chan string, 4)
+	chamadasMu.Unlock()
+	t.Cleanup(func() {
+		a.encerrar()
+		chamadasMu.Lock()
+		delete(chamadasAtivas, key)
+		delete(chamadasEventos, client)
+		if previous != nil {
+			chamadasAtivas[key] = previous
+		}
+		if events != nil {
+			chamadasEventos[client] = events
+		}
+		chamadasMu.Unlock()
+	})
+	return a
+}
+
+func TestCallLifecycleSnapshotKeepsOneRecordIdentity(t *testing.T) {
+	a := lifecycleRecord(t, "lifecycle-snapshot", "C", 17)
+	a.peerAccepted.Store(true)
+	info, current := callLifecycleInfo("lifecycle-snapshot", "C", a)
+	if !current || info["generation"] != uint64(17) || info["peerAccepted"] != true || info["ended"] != false {
+		t.Fatalf("invalid snapshot: %#v, current=%v", info, current)
+	}
+	a.encerrar()
+	info, current = callLifecycleInfo("lifecycle-snapshot", "C", a)
+	if !current || info["ended"] != true {
+		t.Fatal("closed queue was not terminal")
+	}
+}
+
+func TestCallLifecycleReplacementCannotReturnOldSnapshotOrBeRemoved(t *testing.T) {
+	a := lifecycleRecord(t, "lifecycle-replaced", "C", 17)
+	b := &chamadaAtiva{generation: 18}
+	chamadasMu.Lock()
+	chamadasAtivas[chaveChamada("lifecycle-replaced", "C")] = b
+	chamadasMu.Unlock()
+	if _, current := callLifecycleInfo("lifecycle-replaced", "C", a); current {
+		t.Fatal("old owner is current")
+	}
+	finishCallRecord("lifecycle-replaced", "C", a, "old end")
+	chamadasMu.Lock()
+	current := chamadasAtivas[chaveChamada("lifecycle-replaced", "C")]
+	chamadasMu.Unlock()
+	if current != b {
+		t.Fatal("old end removed replacement")
+	}
+}
+
+func TestCallLifecycleFinishEmitsOneTerminalEvent(t *testing.T) {
+	a := lifecycleRecord(t, "lifecycle-finish", "C", 17)
+	finishCallRecord("lifecycle-finish", "C", a, "ended_before_binding")
+	finishCallRecord("lifecycle-finish", "C", a, "hangup")
+	chamadasMu.Lock()
+	queue := chamadasEventos["lifecycle-finish"]
+	current := chamadasAtivas[chaveChamada("lifecycle-finish", "C")]
+	chamadasMu.Unlock()
+	if current != nil || len(queue) != 1 {
+		t.Fatal("terminal cleanup was not once")
+	}
+	var event map[string]any
+	if err := json.Unmarshal([]byte(<-queue), &event); err != nil {
+		t.Fatal(err)
+	}
+	if event["ev"] != "end" || event["generation"] != float64(17) {
+		t.Fatalf("wrong terminal identity: %#v", event)
+	}
+}
+
+func TestIncomingAfterTerminalCannotResurrectTheCall(t *testing.T) {
+	a := lifecycleRecord(t, "incoming-ended", "C", 17)
+	finishCallRecord("incoming-ended", "C", a, "ended_before_binding")
+	if emitIncomingCallRecord("incoming-ended", "C", a, map[string]any{"ev": "incoming"}) {
+		t.Fatal("an ended incoming call was published")
+	}
+	if len(chamadasEventos["incoming-ended"]) != 1 {
+		t.Fatal("extra event after end")
+	}
+}
+
+func TestIncomingBeforeTerminalKeepsItsEventOrder(t *testing.T) {
+	a := lifecycleRecord(t, "incoming-order", "C", 17)
+	if !emitIncomingCallRecord("incoming-order", "C", a, map[string]any{"ev": "incoming"}) {
+		t.Fatal("live incoming call was suppressed")
+	}
+	finishCallRecord("incoming-order", "C", a, "hangup")
+	queue := chamadasEventos["incoming-order"]
+	for _, expected := range []string{"incoming", "end"} {
+		var event map[string]any
+		if err := json.Unmarshal([]byte(<-queue), &event); err != nil {
+			t.Fatal(err)
+		}
+		if event["ev"] != expected {
+			t.Fatalf("got %v, want %s", event, expected)
+		}
+	}
+}
+
+func TestOldIncomingOwnerCannotPublishAfterReplacement(t *testing.T) {
+	a := lifecycleRecord(t, "incoming-replaced", "C", 17)
+	chamadasAtivas[chaveChamada("incoming-replaced", "C")] = &chamadaAtiva{generation: 18}
+	if emitIncomingCallRecord("incoming-replaced", "C", a, map[string]any{"ev": "incoming"}) {
+		t.Fatal("stale incoming owner was published")
+	}
+	if len(chamadasEventos["incoming-replaced"]) != 0 {
+		t.Fatal("stale event was queued")
+	}
+}
+
+func TestConcurrentIncomingAndEndNeverQueueTerminalThenIncoming(t *testing.T) {
+	for iteration := 0; iteration < 30; iteration++ {
+		a := lifecycleRecord(t, "incoming-concurrent", "C", uint64(iteration+1))
+		start := make(chan struct{})
+		var done sync.WaitGroup
+		done.Add(2)
+		go func() {
+			defer done.Done()
+			<-start
+			emitIncomingCallRecord("incoming-concurrent", "C", a, map[string]any{"ev": "incoming"})
+		}()
+		go func() { defer done.Done(); <-start; finishCallRecord("incoming-concurrent", "C", a, "hangup") }()
+		close(start)
+		done.Wait()
+		queue := chamadasEventos["incoming-concurrent"]
+		seenEnd := false
+		for len(queue) > 0 {
+			var event map[string]any
+			if err := json.Unmarshal([]byte(<-queue), &event); err != nil {
+				t.Fatal(err)
+			}
+			if event["ev"] == "incoming" && seenEnd {
+				t.Fatal("incoming followed terminal event")
+			}
+			seenEnd = seenEnd || event["ev"] == "end"
+		}
+		if !seenEnd {
+			t.Fatal("terminal event missing")
+		}
+	}
+}
+
+func TestCallEventQueueRemainsBoundedAndDropsOldest(t *testing.T) {
+	queue := make(chan string, 2)
+	queueCallEvent(queue, "old")
+	queueCallEvent(queue, "middle")
+	queueCallEvent(queue, "latest")
+	if len(queue) != 2 || <-queue != "middle" || <-queue != "latest" {
+		t.Fatal("queue bound/order changed")
+	}
+	if queueCallEvent(nil, "none") {
+		t.Fatal("missing queue reported success")
+	}
+}
