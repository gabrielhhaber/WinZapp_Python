diff --git a/goneonize/calls_audio_format.go b/goneonize/calls_audio_format.go
new file mode 100644
index 0000000..8ffa490
--- /dev/null
+++ b/goneonize/calls_audio_format.go
@@ -0,0 +1,46 @@
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"time"
+)
+
+const callPCMHeaderBytes = 12 // little-endian rate u32 + native record generation u64
+
+var errCallPCMCapacity = errors.New("call PCM buffer too small")
+
+func readCallPCMEnvelope(queue *callPCMQueue, rate int, generation uint64, capacity int, timeout time.Duration) ([]byte, bool, error) {
+	frameBytes := callAudioFrameBytes(rate)
+	if capacity < callPCMHeaderBytes+frameBytes {
+		return nil, false, errCallPCMCapacity
+	}
+	// A universal 48k-capable caller must not dequeue three 16k frames at once.
+	pcm, ended := queue.Read(frameBytes, timeout)
+	if ended || len(pcm) == 0 {
+		return nil, ended, nil
+	}
+	return callPCMEnvelope(rate, generation, pcm), false, nil
+}
+
+func callAudioRate(rate int) int {
+	if rate == 48000 {
+		return 48000
+	}
+	return 16000
+}
+func callAudioFrameBytes(rate int) int { return callAudioRate(rate) * 60 / 1000 * 2 }
+func callAudioMaxBytes(rate int) int   { return callAudioRate(rate) * 480 / 1000 * 2 }
+
+func callPCMEnvelope(rate int, generation uint64, pcm []byte) []byte {
+	packet := make([]byte, callPCMHeaderBytes+len(pcm))
+	binary.LittleEndian.PutUint32(packet, uint32(callAudioRate(rate)))
+	binary.LittleEndian.PutUint64(packet[4:], generation)
+	copy(packet[callPCMHeaderBytes:], pcm)
+	return packet
+}
+
+func validCallPCMWrite(rate int, generation uint64, wantRate int, wantGeneration uint64, n int) bool {
+	return (rate == 16000 || rate == 48000) && generation != 0 && generation == wantGeneration &&
+		rate == callAudioRate(wantRate) && n == callAudioFrameBytes(rate)
+}
diff --git a/goneonize/calls_audio_format_test.go b/goneonize/calls_audio_format_test.go
new file mode 100644
index 0000000..f838403
--- /dev/null
+++ b/goneonize/calls_audio_format_test.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+)
+
+func TestPCM48QueueEnvelopeAndStaleWrites(t *testing.T) {
+	q := newCallPCMQueueForRate(48000)
+	input := make([]byte, 46080)
+	for i := range input {
+		input[i] = byte(i * 7)
+	}
+	q.Push(input)
+	var output []byte
+	for range 8 {
+		pcm, ended := q.Read(5760, 0)
+		if ended || len(pcm) != 5760 {
+			t.Fatal("partial read lost PCM48")
+		}
+		output = append(output, pcm...)
+	}
+	if !bytes.Equal(input, output) {
+		t.Fatal("PCM48 burst corrupted")
+	}
+	packet := callPCMEnvelope(48000, 27, input[:5760])
+	if binary.LittleEndian.Uint32(packet) != 48000 || binary.LittleEndian.Uint64(packet[4:]) != 27 || !bytes.Equal(packet[12:], input[:5760]) {
+		t.Fatal("header detached from PCM")
+	}
+	if !validCallPCMWrite(48000, 27, 48000, 27, 5760) {
+		t.Fatal("valid write rejected")
+	}
+	for _, bad := range []struct {
+		rate, n    int
+		generation uint64
+	}{{16000, 1920, 27}, {48000, 1920, 27}, {48000, 5760, 26}, {48000, 5760, 0}} {
+		if validCallPCMWrite(bad.rate, bad.generation, 48000, 27, bad.n) {
+			t.Fatal("wrong format/generation accepted")
+		}
+	}
+	q.Close()
+	if _, ended := q.Read(5760, 0); !ended {
+		t.Fatal("closed queue leaked old audio")
+	}
+}
+
+func TestPCM48MicrophoneAndDurationBound(t *testing.T) {
+	queue := make(chan []byte, 1)
+	done := make(chan struct{})
+	frame, err := readCallMicrophone(queue, done, 5760)
+	if err != nil || len(frame) != 2880 {
+		t.Fatal("underrun duration changed")
+	}
+	queue <- make([]byte, 1920)
+	frame, err = readCallMicrophone(queue, done, 5760)
+	if err != nil || len(frame) != 2880 {
+		t.Fatal("16k bytes confused with48k capture")
+	}
+	q := newCallPCMQueueForRate(48000)
+	q.Push(make([]byte, 46080+5760))
+	if len(q.pending) != 46080 || q.dropped != 2880 {
+		t.Fatal("480ms cap changed")
+	}
+	close(done)
+	if _, err = readCallMicrophone(queue, done, 5760); err == nil {
+		t.Fatal("ended capture still alive")
+	}
+}
+
+func TestPCM48UniversalReadBufferPreservesBothRates(t *testing.T) {
+	for _, rate := range []int{16000, 48000} {
+		q := newCallPCMQueueForRate(rate)
+		n := callAudioFrameBytes(rate)
+		data := make([]byte, 8*n)
+		for i := range data {
+			data[i] = byte(i * 7)
+		}
+		q.Push(data)
+		var output []byte
+		for range 8 {
+			packet, ended, err := readCallPCMEnvelope(q, rate, 17, 5772, 0)
+			if err != nil || ended || len(packet) != 12+n {
+				t.Fatal("large caller buffer changed frame duration")
+			}
+			if binary.LittleEndian.Uint32(packet) != uint32(rate) || binary.LittleEndian.Uint64(packet[4:]) != 17 {
+				t.Fatal("wrong metadata")
+			}
+			output = append(output, packet[12:]...)
+		}
+		if !bytes.Equal(output, data) {
+			t.Fatal("burst lost or duplicated")
+		}
+		if _, _, err := readCallPCMEnvelope(q, rate, 17, 12+n-1, 0); err == nil {
+			t.Fatal("small buffer accepted")
+		}
+	}
+}
diff --git a/goneonize/calls_audio_v2.go b/goneonize/calls_audio_v2.go
new file mode 100644
index 0000000..59e2ce2
--- /dev/null
+++ b/goneonize/calls_audio_v2.go
@@ -0,0 +1,94 @@
+package main
+
+/*
+#include <stdint.h>
+*/
+import "C"
+
+import (
+	"encoding/json"
+	"time"
+	"unsafe"
+)
+
+// CallsConfigurePCM48 changes only future clients. No codec is forced.
+//
+//export CallsConfigurePCM48
+func CallsConfigurePCM48(enabled C.int) {
+	chamadasMu.Lock()
+	chamadasPCM48 = enabled != 0
+	chamadasMu.Unlock()
+}
+
+//export CallAudioFormat
+func CallAudioFormat(id *C.char, call *C.char, buf *C.uchar, capacity C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	data, _ := json.Marshal(map[string]any{"sampleRate": callAudioRate(a.pcmRate), "generation": a.generation})
+	if int(capacity) < len(data) {
+		return erroTamanho
+	}
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(buf)), int(capacity)), data)
+	return C.int(len(data))
+}
+
+// Read one bounded PCM chunk and its format atomically from the same record.
+//
+//export CallReadAudioFrame
+func CallReadAudioFrame(id *C.char, call *C.char, buf *C.uchar, capacity C.int, timeoutMs C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	if int(capacity) < callPCMHeaderBytes+callAudioFrameBytes(a.pcmRate) {
+		return erroTamanho
+	}
+	packet, ended, err := readCallPCMEnvelope(a.entrada, a.pcmRate, a.generation, int(capacity), time.Duration(timeoutMs)*time.Millisecond)
+	if err != nil {
+		return erroTamanho
+	}
+	if ended {
+		return erroSemChamada
+	}
+	if len(packet) == 0 {
+		return 0
+	}
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(buf)), int(capacity)), packet)
+	return C.int(len(packet))
+}
+
+// Reject stale capture after same-id replacement, even when byte sizes agree.
+//
+//export CallWriteAudioFrame
+func CallWriteAudioFrame(id *C.char, call *C.char, rate C.int, generation C.uint64_t, buf *C.uchar, n C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	if !validCallPCMWrite(int(rate), uint64(generation), a.pcmRate, a.generation, int(n)) {
+		return erroTamanho
+	}
+	select {
+	case <-a.fim:
+		return erroSemChamada
+	default:
+	}
+	pcm := append([]byte(nil), unsafe.Slice((*byte)(unsafe.Pointer(buf)), int(n))...)
+	select {
+	case a.saida <- pcm:
+	default:
+		select {
+		case <-a.saida:
+		default:
+		}
+		select {
+		case <-a.fim:
+			return erroSemChamada
+		case a.saida <- pcm:
+		default:
+		}
+	}
+	return 0
+}
