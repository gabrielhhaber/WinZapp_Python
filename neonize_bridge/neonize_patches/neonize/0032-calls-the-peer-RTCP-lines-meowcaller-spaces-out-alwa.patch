+package main
+
+import (
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+func TestChaveLogChamadasSeparaAsChamadas(t *testing.T) {
+	a := chaveLogChamadas([]byte(`{"level":"info","call_id":"AAA","message":"group roster received"}`))
+	b := chaveLogChamadas([]byte(`{"level":"info","call_id":"BBB","message":"group roster received"}`))
+	if a == b {
+		t.Fatalf("duas chamadas dividem a chave %q", a)
+	}
+	again := chaveLogChamadas([]byte(`{"level":"info","call_id":"AAA","message":"group roster received","transaction_id":9}`))
+	if a != again {
+		t.Fatalf("a mesma mensagem da mesma chamada mudou de chave: %q != %q", a, again)
+	}
+	if chaveLogChamadas([]byte("texto solto\n")) != "texto solto" {
+		t.Fatal("linha que nao e JSON deve ser a propria chave")
+	}
+}
+
+type logContado struct{ linhas []string }
+
+func (l *logContado) Warnf(msg string, args ...interface{})  { l.linhas = append(l.linhas, msg) }
+func (l *logContado) Errorf(msg string, args ...interface{}) {}
+func (l *logContado) Infof(msg string, args ...interface{})  {}
+func (l *logContado) Debugf(msg string, args ...interface{}) {}
+func (l *logContado) Sub(module string) waLog.Logger         { return l }
+
+// Cada mídia que começa tem a sua cota de linhas repetidas: na volta a uma
+// chamada as falhas de mídia ainda aparecem (sem call_id, a cota era do
+// processo e se esgotava antes).
+func TestCadaMidiaQueComecaTemASuaCota(t *testing.T) {
+	saida := &logContado{}
+	w := &logChamadas{log: saida, vistos: map[string]int{}}
+	falha := []byte(`{"level":"warn","message":"unprotect: authentication failed"}`)
+	for i := 0; i < 20; i++ {
+		_, _ = w.Write(falha)
+	}
+	if len(saida.linhas) != 8 {
+		t.Fatalf("linhas antes da volta = %d, want 8", len(saida.linhas))
+	}
+	_, _ = w.Write([]byte(`{"level":"info","call_id":"AAA","message":"starting media"}`))
+	for i := 0; i < 3; i++ {
+		_, _ = w.Write(falha)
+	}
+	if len(saida.linhas) != 8+1+3 {
+		t.Fatalf("linhas depois da volta = %d, want 12", len(saida.linhas))
+	}
+}
+
+func TestResumosPeriodicosAparecemACada30sAChamadaInteira(t *testing.T) {
+	resumo := `info|relay traffic by kind|`
+	comum := `info|group roster received|AAA`
+	var mostrados, comuns []int
+	for n := 1; n <= 30; n++ {
+		if mostrarLinhaChamadas(resumo, n) {
+			mostrados = append(mostrados, n)
+		}
+		if mostrarLinhaChamadas(comum, n) {
+			comuns = append(comuns, n)
+		}
+	}
+	if len(mostrados) != 12 || mostrados[8] != 12 || mostrados[11] != 30 {
+		t.Fatalf("resumo mostrado em %v", mostrados)
+	}
+	if len(comuns) != 8 {
+		t.Fatalf("linha comum mostrada em %v", comuns)
+	}
+	if !mostrarLinhaChamadas(comum, 200) || !mostrarLinhaChamadas(`info|audio receive summary (totals since the media started)|`, 30) {
+		t.Fatal("a cota antiga e os dois resumos continuam")
+	}
+}
+
+func TestTagsDaStanzaDizemOQueVeioDentro(t *testing.T) {
+	node := &waBinary.Node{Tag: "call", Content: []waBinary.Node{{Tag: "group_update"}, {Tag: "relaylatency"}}}
+	if got := tagsDaStanza(node); got != "call/group_update/relaylatency" {
+		t.Fatalf("tagsDaStanza = %q", got)
+	}
+	if tagsDaStanza(nil) != "?" {
+		t.Fatal("sem stanza")
+	}
+}
+
+func TestRelatoriosRTCPJaEspacadosPassamSempre(t *testing.T) {
+	for _, n := range []int{1, 9, 57, 201} {
+		if !mostrarLinhaChamadas(`info|sent RTCP reception reports|AAA`, n) {
+			t.Fatalf("relatorio RTCP %d cortado", n)
+		}
+		if !mostrarLinhaChamadas(`info|peer RTCP received|`, n) {
+			t.Fatalf("RTCP recebido %d cortado", n)
+		}
+	}
+}
