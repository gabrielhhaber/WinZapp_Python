From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Mon, 26 Oct 2026 02:04:36 -0300
Subject: [PATCH] calls: Python bindings for the call layer

The functions calls.go exports (CallsConfigure, CallsEnabled,
CallsNextEvent, CallDial, CallAnswer, CallHangup, CallReadAudio,
CallWriteAudio) get their ctypes signatures in _binder.py, behind
hasattr like the other optional exports, and a small wrapper in
neonize/calls.py: configure() before a client connects, then Calls(uuid)
for events (JSON), dialing, answering, hanging up and 16 kHz PCM frames.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 neonize/_binder.py | 21 ++++++++++
 neonize/calls.py   | 96 ++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 117 insertions(+)
 create mode 100644 neonize/calls.py

diff --git a/neonize/_binder.py b/neonize/_binder.py
index b9944f6..b8e0756 100644
--- a/neonize/_binder.py
+++ b/neonize/_binder.py
@@ -865,6 +865,27 @@ if not os.environ.get("SPHINX"):
         ]
         gocode.UploadFile.restype = ctypes.POINTER(Bytes)
         gocode.UploadFile.errcheck = consume_bytes_struct
+    if hasattr(gocode, "CallsConfigure"):
+        # The call layer (goneonize/calls.go): plain C types, no protobuf; the
+        # wrapper is neonize/calls.py.
+        gocode.CallsConfigure.argtypes = [ctypes.c_int]
+        gocode.CallsConfigure.restype = None
+        gocode.CallsEnabled.argtypes = [ctypes.c_char_p]
+        gocode.CallsEnabled.restype = ctypes.c_int
+        gocode.CallsNextEvent.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+        gocode.CallsNextEvent.restype = ctypes.c_int
+        gocode.CallDial.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_int]
+        gocode.CallDial.restype = ctypes.c_int
+        gocode.CallAnswer.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
+        gocode.CallAnswer.restype = ctypes.c_int
+        gocode.CallHangup.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
+        gocode.CallHangup.restype = ctypes.c_int
+        gocode.CallReadAudio.argtypes = [
+            ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+        gocode.CallReadAudio.restype = ctypes.c_int
+        gocode.CallWriteAudio.argtypes = [
+            ctypes.c_char_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
+        gocode.CallWriteAudio.restype = ctypes.c_int
 
 else:
     gocode: Any = object()
diff --git a/neonize/calls.py b/neonize/calls.py
new file mode 100644
index 0000000..09b44d9
--- /dev/null
+++ b/neonize/calls.py
@@ -0,0 +1,96 @@
+"""WhatsApp voice calls through the DLL's call layer (goneonize/calls.go, on
+meowcaller).
+
+`configure(True)` before a client connects installs the call layer on every
+client created afterwards; then `Calls(client.uuid)` drives that client's
+calls. Events and results are small JSON objects; audio is PCM s16le, mono,
+SAMPLE_RATE Hz, one FRAME_BYTES frame (60 ms) at a time. Every call releases
+the GIL (ctypes), so the blocking ones belong on their own threads.
+"""
+import ctypes
+import json
+
+from ._binder import gocode
+
+SAMPLE_RATE = 16000
+FRAME_SAMPLES = 960
+FRAME_BYTES = FRAME_SAMPLES * 2
+
+_NO_CALL = -2
+_EVENT_BUFFER = 64 * 1024       # an event that does not fit is lost on the Go side
+_RESULT_BUFFER = 4 * 1024
+
+
+class CallError(Exception):
+    """A call could not be placed, or the layer is not there."""
+
+
+def available() -> bool:
+    """Whether this neonize build carries the call layer."""
+    return hasattr(gocode, "CallsConfigure")
+
+
+def configure(enabled: bool) -> None:
+    """Turns the call layer on (or off) for the clients that connect from now on."""
+    if not available():
+        raise CallError("this neonize build has no call layer")
+    gocode.CallsConfigure(1 if enabled else 0)
+
+
+class Calls:
+    """The calls of one client (`uuid`: NewClient.uuid)."""
+
+    def __init__(self, uuid: bytes):
+        self.uuid = uuid
+
+    def enabled(self) -> bool:
+        """Whether the call layer is installed on this (connected) client."""
+        return available() and gocode.CallsEnabled(self.uuid) == 1
+
+    def next_event(self, timeout_ms: int = 500):
+        """The next event ({"ev": "incoming" | "state" | "accepted" | "ready" |
+        "end", "call": id, ...}), or None when none came in time. CallError when
+        the client has no call layer (not connected, or already stopped)."""
+        buf = ctypes.create_string_buffer(_EVENT_BUFFER)
+        size = gocode.CallsNextEvent(self.uuid, buf, _EVENT_BUFFER, int(timeout_ms))
+        if size == _NO_CALL:
+            raise CallError("no call layer on this client")
+        if size <= 0:
+            return None
+        return json.loads(buf.raw[:size].decode("utf-8"))
+
+    def dial(self, target: str) -> dict:
+        """Calls `target` (digits with the country code, or an address such as
+        123@lid). {"call": id, "peer": jid}; CallError on failure."""
+        buf = ctypes.create_string_buffer(_RESULT_BUFFER)
+        size = gocode.CallDial(self.uuid, target.encode(), buf, _RESULT_BUFFER)
+        if size <= 0:
+            raise CallError("the call could not be placed")
+        result = json.loads(buf.raw[:size].decode("utf-8"))
+        if "error" in result:
+            raise CallError(result["error"])
+        return result
+
+    def answer(self, call_id: str) -> bool:
+        return gocode.CallAnswer(self.uuid, call_id.encode()) == 0
+
+    def hangup(self, call_id: str) -> bool:
+        """Ends the call, or rejects it while it still rings."""
+        return gocode.CallHangup(self.uuid, call_id.encode()) == 0
+
+    def read_audio(self, call_id: str, timeout_ms: int = 200):
+        """A frame from the other side; b"" when none came in time; None once
+        the call is over."""
+        buf = ctypes.create_string_buffer(FRAME_BYTES)
+        size = gocode.CallReadAudio(self.uuid, call_id.encode(), buf, FRAME_BYTES, int(timeout_ms))
+        if size == _NO_CALL:
+            return None
+        if size <= 0:
+            return b""
+        return buf.raw[:size]
+
+    def write_audio(self, call_id: str, frame: bytes) -> bool:
+        """Queues one microphone frame (FRAME_BYTES); False once the call is over."""
+        if len(frame) != FRAME_BYTES:
+            raise ValueError(f"a frame is {FRAME_BYTES} bytes, not {len(frame)}")
+        return gocode.CallWriteAudio(self.uuid, call_id.encode(), frame, FRAME_BYTES) == 0
