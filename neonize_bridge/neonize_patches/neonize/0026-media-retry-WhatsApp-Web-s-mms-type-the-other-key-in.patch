From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <noreply@example.com>
Date: Thu, 12 Nov 2026 09:05:28 -0300
Subject: [PATCH] media retry: WhatsApp Web's mms-type, the other key infos,
 and what each host served

Issue #766: a voice note's re-uploaded file was refused with
"invalid media hmac". The URL now asks for WhatsApp Web's own
mms-type (ptt, ptv, gif, sticker) before the plain kind's, opens the file
with the other key infos when the message's own does not authenticate
it (the plaintext hash still has to match), and a failure answers what
each host served (size, old hash, text or not, first bytes). The
decrypted notification also says whether it carried a message secret.
---
 goneonize/mediaretry.go              |   3 +
 goneonize/mediaretry_decrypt.go      |  41 +++++
 goneonize/mediaretry_decrypt_test.go |  24 +++
 goneonize/mediaretry_download.go     | 262 +++++++++++++++------------
 4 files changed, 213 insertions(+), 117 deletions(-)

diff --git a/goneonize/mediaretry.go b/goneonize/mediaretry.go
index ba4e48e..391f462 100644
--- a/goneonize/mediaretry.go
+++ b/goneonize/mediaretry.go
@@ -127,5 +127,8 @@ func DecryptMediaRetry(request *C.char) *C.char {
 	return rawAnswer(map[string]any{
 		"result":      result,
 		"direct_path": notification.GetDirectPath(),
+		// diagnostics (issue #766): what else the phone's answer carried
+		"has_message_secret": len(notification.GetMessageSecret()) > 0,
+		"stanza_matches":     notification.GetStanzaID() == req.MessageID,
 	})
 }
diff --git a/goneonize/mediaretry_decrypt.go b/goneonize/mediaretry_decrypt.go
index 3a76289..2239eed 100644
--- a/goneonize/mediaretry_decrypt.go
+++ b/goneonize/mediaretry_decrypt.go
@@ -7,8 +7,10 @@ import (
 	"bytes"
 	"crypto/hmac"
 	"crypto/sha256"
+	"encoding/hex"
 	"errors"
 	"fmt"
+	"unicode/utf8"
 
 	"go.mau.fi/whatsmeow"
 	"go.mau.fi/whatsmeow/util/cbcutil"
@@ -45,3 +47,42 @@ func decryptRetried(data, mediaKey []byte, appInfo string, fileSHA256 []byte) ([
 	}
 	return plain, nil
 }
+
+// retriedKeyInfos: every media key info, the message's own first.
+var retriedKeyInfos = []string{string(whatsmeow.MediaImage), string(whatsmeow.MediaVideo),
+	string(whatsmeow.MediaAudio), string(whatsmeow.MediaDocument)}
+
+// openRetried decrypts with the message's key info, else with any other one
+// (a media whose kind changed on the phone); the plaintext hash keeps it safe.
+func openRetried(data, mediaKey []byte, appInfo string, fileSHA256 []byte) ([]byte, string, error) {
+	plain, err := decryptRetried(data, mediaKey, appInfo, fileSHA256)
+	if err == nil || !errors.Is(err, errRetriedHMAC) {
+		return plain, appInfo, err
+	}
+	for _, other := range retriedKeyInfos {
+		if other == appInfo {
+			continue
+		}
+		if alt, altErr := decryptRetried(data, mediaKey, other, fileSHA256); altErr == nil {
+			return alt, other, nil
+		}
+	}
+	return nil, appInfo, err
+}
+
+// servedDiagnostics: what a host served that could not be opened (no key, no
+// plaintext: sizes, hashes compared and the first bytes of the ciphertext).
+func servedDiagnostics(host, mmsType string, data, encSHA256 []byte, fileLength int64,
+	err error) map[string]any {
+	sum := sha256.Sum256(data)
+	head := data
+	if len(head) > 16 {
+		head = head[:16]
+	}
+	return map[string]any{
+		"host": host, "mms_type": mmsType, "error": err.Error(), "size": len(data),
+		"file_length": fileLength, "old_enc_sha256": bytes.Equal(sum[:], encSHA256),
+		"looks_like_text": utf8.Valid(head) && !bytes.ContainsRune(head, 0),
+		"head":            hex.EncodeToString(head),
+	}
+}
diff --git a/goneonize/mediaretry_decrypt_test.go b/goneonize/mediaretry_decrypt_test.go
index 02d986b..786b970 100644
--- a/goneonize/mediaretry_decrypt_test.go
+++ b/goneonize/mediaretry_decrypt_test.go
@@ -63,3 +63,27 @@ func TestDecryptRetriedChecksThePlaintextHash(t *testing.T) {
 		t.Fatalf("wrong plaintext hash: %v", err)
 	}
 }
+
+func TestOpenRetriedTriesTheOtherKeyInfos(t *testing.T) {
+	key := bytes.Repeat([]byte{7}, 32)
+	plain := []byte("a voice note")
+	sum := sha256.Sum256(plain)
+	data := encryptLikeThePhone(t, plain, key, string(whatsmeow.MediaDocument))
+	got, used, err := openRetried(data, key, string(whatsmeow.MediaAudio), sum[:])
+	if err != nil || !bytes.Equal(got, plain) || used != string(whatsmeow.MediaDocument) {
+		t.Fatalf("got %q with %q, %v", got, used, err)
+	}
+	if _, _, err := openRetried(data, bytes.Repeat([]byte{8}, 32), string(whatsmeow.MediaAudio), nil); !errors.Is(err, errRetriedHMAC) {
+		t.Fatalf("a wrong key: %v", err)
+	}
+}
+
+func TestServedDiagnosticsSayWhatCameBack(t *testing.T) {
+	page := []byte("<html><body>nope</body></html>")
+	sum := sha256.Sum256(page)
+	d := servedDiagnostics("mmg.whatsapp.net", "ptt", page, sum[:], 4096, errRetriedHMAC)
+	if d["size"] != len(page) || d["old_enc_sha256"] != true || d["looks_like_text"] != true ||
+		d["file_length"] != int64(4096) || d["head"] != "3c68746d6c3e3c626f64793e6e6f7065" {
+		t.Fatalf("diagnostics: %v", d)
+	}
+}
