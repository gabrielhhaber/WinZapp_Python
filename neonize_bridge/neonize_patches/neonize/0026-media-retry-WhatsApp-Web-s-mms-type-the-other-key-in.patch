+package main
+
+/*
+   #include <stdlib.h>
+*/
+import "C"
+
+// Download of a media the phone uploaded again after a media retry.
+//
+// The MediaRetryNotification only carries the new direct path. The phone's new
+// upload can be encrypted into different bytes than the first one, so the
+// message's old fileEncSHA256 no longer matches them, and whatsmeow checks that
+// hash before the HMAC: every host answered 200 and every one was refused
+// ("hash of media ciphertext doesn't match", issue #756). Here the ciphertext
+// is authenticated the way the media key allows, by the 10-byte HMAC, then
+// decrypted and checked against the plaintext's fileSHA256, which does not
+// change with the upload. JSON in and out like rawiq.go; the plaintext goes to
+// a file the caller names.
+//
+// The URL's mms-type is WhatsApp Web's own for the message (ptt for a voice
+// note, ptv, gif, sticker), falling back to the plain kind's (issue #766: a
+// voice note fetched as "audio" was refused with "invalid media hmac"). When
+// nothing authenticates, the answer carries what was served from each host
+// (size, whether it is the old ciphertext, whether it looks like text, which
+// key info would have opened it) so a report can tell why.
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+)
+
+type retriedDownload struct {
+	DirectPath string `json:"direct_path"`
+	MediaKey   string `json:"media_key"`
+	EncSHA256  string `json:"enc_sha256"`
+	FileSHA256 string `json:"file_sha256"`
+	Kind       string `json:"kind"`
+	MmsType    string `json:"mms_type"`
+	FileLength int64  `json:"file_length"`
+	Dest       string `json:"dest"`
+	TimeoutMs  int    `json:"timeout_ms"`
+}
+
+// retriedMediaTypes: the message kind to whatsmeow's key info and the
+// mms-type of the URL.
+var retriedMediaTypes = map[string][2]string{
+	"image":    {string(whatsmeow.MediaImage), "image"},
+	"video":    {string(whatsmeow.MediaVideo), "video"},
+	"audio":    {string(whatsmeow.MediaAudio), "audio"},
+	"document": {string(whatsmeow.MediaDocument), "document"},
+	"sticker":  {string(whatsmeow.MediaImage), "image"},
+}
+
+// DownloadRetriedMedia downloads and decrypts the media at the new direct path
+// into `dest`. Answers {"ok": true, "size": n} or {"error"}.
+//
+//export DownloadRetriedMedia
+func DownloadRetriedMedia(id *C.char, request *C.char) *C.char {
+	cli := clients[C.GoString(id)]
+	if cli == nil {
+		return rawError(fmt.Errorf("client not found"))
+	}
+	var req retriedDownload
+	if err := json.Unmarshal([]byte(C.GoString(request)), &req); err != nil {
+		return rawError(fmt.Errorf("request: %w", err))
+	}
+	kind, known := retriedMediaTypes[req.Kind]
+	mediaKey, keyErr := base64.StdEncoding.DecodeString(req.MediaKey)
+	encSHA256, _ := base64.StdEncoding.DecodeString(req.EncSHA256)
+	fileSHA256, _ := base64.StdEncoding.DecodeString(req.FileSHA256)
+	if !known || keyErr != nil || len(mediaKey) == 0 || req.Dest == "" ||
+		!strings.HasPrefix(req.DirectPath, "/") {
+		return rawError(fmt.Errorf("request: kind, media_key, dest and a direct_path starting with / are required"))
+	}
+	ctx, cancel := rawContext(req.TimeoutMs)
+	defer cancel()
+	conn, err := cli.DangerousInternals().RefreshMediaConn(ctx, false)
+	if err != nil {
+		return rawError(fmt.Errorf("failed to refresh media connections: %w", err))
+	}
+	mmsTypes := []string{kind[1]}
+	if req.MmsType != "" && req.MmsType != kind[1] {
+		mmsTypes = []string{req.MmsType, kind[1]}
+	}
+	var lastErr error
+	var tried []map[string]any
+	for _, host := range conn.Hosts {
+		for _, mmsType := range mmsTypes {
+			// the same URL form whatsmeow and WhatsApp Web use
+			url := fmt.Sprintf("https://%s%s&hash=%s&mms-type=%s&__wa-mms=", host.Hostname,
+				req.DirectPath, base64.URLEncoding.EncodeToString(encSHA256), mmsType)
+			var data []byte
+			for attempt := 0; attempt < 3; attempt++ {
+				if data, lastErr = cli.DangerousInternals().DownloadMedia(ctx, url); lastErr == nil ||
+					errors.Is(lastErr, context.Canceled) {
+					break
+				}
+				var httpErr whatsmeow.DownloadHTTPError
+				if errors.As(lastErr, &httpErr) {
+					break // 403, 404, 410...: retrying the same URL will not help
+				}
+				time.Sleep(time.Duration(attempt+1) * time.Second)
+			}
+			if lastErr != nil {
+				tried = append(tried, map[string]any{"host": host.Hostname, "mms_type": mmsType,
+					"error": lastErr.Error()})
+				if errors.Is(lastErr, context.Canceled) {
+					return retriedFailure(lastErr, tried)
+				}
+				continue
+			}
+			plain, appInfo, err := openRetried(data, mediaKey, kind[0], fileSHA256)
+			if err != nil {
+				tried = append(tried, servedDiagnostics(host.Hostname, mmsType, data, encSHA256,
+					req.FileLength, err))
+				lastErr = err
+				continue
+			}
+			if err := os.WriteFile(req.Dest, plain, 0o600); err != nil {
+				return rawError(err)
+			}
+			return rawAnswer(map[string]any{"ok": true, "size": len(plain), "host": host.Hostname,
+				"mms_type": mmsType, "app_info": appInfo, "tried": tried})
+		}
+	}
+	if lastErr == nil {
+		lastErr = fmt.Errorf("no media host")
+	}
+	return retriedFailure(lastErr, tried)
+}
+
+func retriedFailure(err error, tried []map[string]any) *C.char {
+	if len(tried) == 0 && !errors.Is(err, errRetriedHMAC) {
+		err = fmt.Errorf("failed to download media from last host: %w", err)
+	}
+	return rawAnswer(map[string]any{"error": err.Error(), "tried": tried})
+}
