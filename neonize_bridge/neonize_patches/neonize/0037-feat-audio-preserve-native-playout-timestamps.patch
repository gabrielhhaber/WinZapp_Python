diff --git a/neonize/calls.py b/neonize/calls.py
index e403471..b098e03 100644
--- a/neonize/calls.py
+++ b/neonize/calls.py
@@ -306,14 +306,15 @@ class Calls:
             return b""
         return buf.raw[:size]
 
-    def open_audio_transport(self, call_id: str, generation: int, stream: int):
+    def open_audio_transport(self, call_id: str, generation: int, stream: int, *, protocol: int = 1):
         """Reserve a single-use loopback PCM connection, or None on older DLLs."""
         if not hasattr(gocode, "CallAudioTransportOpen"):
             return None
         if type(generation) is not int or not 0 < generation < 2**64 or type(stream) is not int or not 0 < stream < 2**53:
             raise ValueError("invalid native audio owner")
         buf = ctypes.create_string_buffer(_RESULT_BUFFER)
-        size = gocode.CallAudioTransportOpen(self.uuid, call_id.encode(), generation, stream, buf, _RESULT_BUFFER)
+        opener = gocode.CallAudioTransportOpenV2 if protocol == 2 and hasattr(gocode, "CallAudioTransportOpenV2") else gocode.CallAudioTransportOpen
+        size = opener(self.uuid, call_id.encode(), generation, stream, buf, _RESULT_BUFFER)
         if not 0 < size <= _RESULT_BUFFER:
             raise CallError("native audio transport unavailable")
         return json.loads(buf.raw[:size].decode("utf-8"))
