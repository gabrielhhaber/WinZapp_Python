+
+//export CallAudioTransportOpenV2
+func CallAudioTransportOpenV2(id *C.char, call *C.char, generation C.uint64_t, stream C.uint64_t, buf *C.uchar, capacity C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	if capacity < 512 {
+		return erroTamanho
+	}
+	value, err := openCallAudioIPCProtocol(a, uint64(generation), uint64(stream), 2)
+	if err != nil {
+		return erroTamanho
+	}
+	data, _ := json.Marshal(value)
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(buf)), int(capacity)), data)
+	return C.int(len(data))
+}
diff --git a/goneonize/calls_audio_timed.go b/goneonize/calls_audio_timed.go
new file mode 100644
index 0000000..3b81918
--- /dev/null
+++ b/goneonize/calls_audio_timed.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"encoding/binary"
+	"net"
+	"time"
+)
+
+type timedCallAudio struct {
+	pcm                    []byte
+	timestamp, ssrc, clock uint32
+	timed                  bool
+}
+
+func (a *chamadaAtiva) WantsTimedAudio() bool {
+	a.audioMu.Lock()
+	defer a.audioMu.Unlock()
+	return a.audioIPC != nil && a.audioIPC.active && a.audioIPC.protocol == 2
+}
+
+func (a *chamadaAtiva) WriteTimedFrame(frame []float32, timestamp, ssrc, clock uint32) error {
+	a.recebidos.Add(1)
+	a.pushCallAudio(encodeCallPCM(frame), timestamp, ssrc, clock, true)
+	return nil
+}
+
+func (a *chamadaAtiva) pushCallAudio(pcm []byte, timestamp, ssrc, clock uint32, timed bool) {
+	a.audioMu.Lock()
+	defer a.audioMu.Unlock()
+	p := a.audioIPC
+	if p == nil || !p.active || p.protocol != 2 {
+		a.entrada.Push(pcm)
+		return
+	}
+	select {
+	case <-a.fim:
+		return
+	default:
+	}
+	// Eight <=60 ms packets, including multi-frame decoder bursts: 480 ms cap.
+	for len(pcm) > 0 {
+		n := min(len(pcm), callAudioFrameBytes(a.pcmRate))
+		frame := timedCallAudio{append([]byte(nil), pcm[:n]...), timestamp, ssrc, clock, timed}
+		select {
+		case p.timed <- frame:
+		default:
+			select {
+			case <-p.timed:
+			default:
+			}
+			select {
+			case p.timed <- frame:
+			default:
+			}
+		}
+		pcm = pcm[n:]
+		timestamp += uint32(n / 2)
+	}
+}
+
+func (p *callAudioIPC) sendTimed(a *chamadaAtiva, conn net.Conn) {
+	// Discard the legacy queue once at handoff, never replay its backlog if
+	// this lease falls back. Producer and lease selection share audioMu.
+	for {
+		if data, _ := a.entrada.Read(callAudioFrameBytes(a.pcmRate), 0); len(data) == 0 {
+			break
+		}
+	}
+	timer := time.NewTicker(200 * time.Millisecond)
+	defer timer.Stop()
+	for {
+		var frame timedCallAudio
+		select {
+		case <-p.done:
+			return
+		case <-a.fim:
+			return
+		case frame = <-p.timed:
+		case <-timer.C:
+		}
+		packet := make([]byte, 32+len(frame.pcm))
+		binary.LittleEndian.PutUint32(packet, uint32(28+len(frame.pcm)))
+		binary.LittleEndian.PutUint32(packet[4:], uint32(callAudioRate(a.pcmRate)))
+		binary.LittleEndian.PutUint64(packet[8:], a.generation)
+		binary.LittleEndian.PutUint32(packet[16:], frame.timestamp)
+		binary.LittleEndian.PutUint32(packet[20:], frame.ssrc)
+		binary.LittleEndian.PutUint32(packet[24:], frame.clock)
+		if frame.timed {
+			binary.LittleEndian.PutUint32(packet[28:], 1)
+		}
+		copy(packet[32:], frame.pcm)
+		conn.SetWriteDeadline(time.Now().Add(250 * time.Millisecond))
+		if _, err := conn.Write(packet); err != nil {
+			return
+		}
+	}
+}
diff --git a/goneonize/calls_audio_timed_test.go b/goneonize/calls_audio_timed_test.go
new file mode 100644
index 0000000..9009887
--- /dev/null
+++ b/goneonize/calls_audio_timed_test.go
@@ -0,0 +1,75 @@
+package main
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestCallAudioTimedProtocol(t *testing.T) {
+	a := ipcCall(16000)
+	defer a.encerrar()
+	d, err := openCallAudioIPCProtocol(a, 7, 1, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := net.DialTimeout("tcp4", net.JoinHostPort("127.0.0.1", fmtPort(d["port"].(int))), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(time.Second))
+	secret, _ := hex.DecodeString(d["secret"].(string))
+	conn.Write(secret)
+	var header [4]byte
+	if _, err := io.ReadFull(conn, header[:]); err != nil || string(header[:]) != "NZA2" {
+		t.Fatal("protocol 2 handshake failed")
+	}
+	if !a.WantsTimedAudio() {
+		t.Fatal("timed owner missing")
+	}
+	a.WriteTimedFrame(make([]float32, 1920), 0xfffffff0, 42, 48000)
+	for i := 0; i < 2; {
+		if _, err := io.ReadFull(conn, header[:]); err != nil {
+			t.Fatal(err)
+		}
+		packet := make([]byte, binary.LittleEndian.Uint32(header[:]))
+		if _, err := io.ReadFull(conn, packet); err != nil {
+			t.Fatal(err)
+		}
+		if len(packet) == 28 {
+			continue
+		}
+		if len(packet) != 28+1920 || binary.LittleEndian.Uint32(packet[12:]) != uint32(0xfffffff0+uint64(i*960)) || binary.LittleEndian.Uint32(packet[16:]) != 42 || binary.LittleEndian.Uint32(packet[20:]) != 48000 || binary.LittleEndian.Uint32(packet[24:]) != 1 {
+			t.Fatal("timeline changed at native boundary")
+		}
+		i++
+	}
+}
+
+func TestCallAudioTimedBoundedQueueAndLegacyFallback(t *testing.T) {
+	a := ipcCall(48000)
+	defer a.encerrar()
+	p := &callAudioIPC{protocol: 2, active: true, timed: make(chan timedCallAudio, 8)}
+	// No listener for this pure queue test: remove the lease before cleanup.
+	a.audioIPC = p
+	for i := 0; i < 12; i++ {
+		a.WriteTimedFrame(make([]float32, 2880), uint32(i*2880), 42, 48000)
+	}
+	if len(p.timed) != 8 {
+		t.Fatal("unbounded timed queue")
+	}
+	first := <-p.timed
+	if first.timestamp != 4*2880 {
+		t.Fatal("stale native backlog retained")
+	}
+	a.audioIPC = nil
+	a.WriteFrame(make([]float32, 2880))
+	pcm, ended := a.entrada.Read(5760, 0)
+	if ended || len(pcm) != 5760 || a.WantsTimedAudio() {
+		t.Fatal("legacy fallback blocked")
+	}
+}
