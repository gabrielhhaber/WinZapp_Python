From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 20:52:52 -0300
Subject: [PATCH] calls: the group roster and key lines always reach the log

Seen live: in a 15-minute group call where members left and joined again,
"installed shared group media key epoch" stopped at its 8th line and the
log could no longer say whether the key of a member who came back reached
our send path (they heard nobody from us). Those lines, and the group
update, roster, subscription and rekey ones, come once per change of the
call, so they are few: they now always pass, like the RTCP reports.

Tested: the roster and key lines pass at any count, a common line still
stops after 8; the periodic summary test now uses a truly common line.
---
 goneonize/calls.go          | 19 +++++++++++++++++++
 goneonize/calls_log_test.go | 20 +++++++++++++++++++-
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/goneonize/calls.go b/goneonize/calls.go
index 5016e87..b43b49d 100644
--- a/goneonize/calls.go
+++ b/goneonize/calls.go
@@ -132,6 +132,20 @@ var resumosPeriodicos = []string{"|relay traffic by kind|", "|audio receive summ
 // passam sempre.
 var linhasJaEspacadas = []string{"|sent RTCP reception reports|", "|peer RTCP received|"}
 
+// linhasDeRoster sao as de entrada e saida de participantes e das chaves do
+// grupo: uma por mudanca da chamada, entao poucas, e passam sempre. Com a
+// cota comum, numa chamada em grupo de 15 min em que pessoas sairam e
+// voltaram, "installed shared group media key epoch" parou na 8a vez e o log
+// ja nao dizia se a chave de quem voltou chegou ao envio.
+var linhasDeRoster = []string{
+	"|group update received|", "|group roster received|",
+	"|applied group media receive roster|", "|group snapshot PIDs or relay changed|",
+	"|sent group relay subscriptions|", "|group rekey received|", "|group rekey installed|",
+	"|installed shared group media key epoch|", "|distributed group key epoch|",
+	"|group key epoch held|", "|group key epoch older than the one held, ignored|",
+	"|group key epoch parked until its group update|",
+}
+
 // mostrarLinhaChamadas: as 8 primeiras vezes de uma mensagem e depois a cada
 // 200; um resumo periodico, depois das 8 primeiras, a cada 6 (30 s).
 func mostrarLinhaChamadas(chave string, n int) bool {
@@ -143,6 +157,11 @@ func mostrarLinhaChamadas(chave string, n int) bool {
 			return true
 		}
 	}
+	for _, roster := range linhasDeRoster {
+		if strings.Contains(chave, roster) {
+			return true
+		}
+	}
 	for _, resumo := range resumosPeriodicos {
 		if strings.Contains(chave, resumo) {
 			return n%6 == 0
diff --git a/goneonize/calls_log_test.go b/goneonize/calls_log_test.go
index e22718e..8796ec7 100644
--- a/goneonize/calls_log_test.go
+++ b/goneonize/calls_log_test.go
@@ -54,7 +54,7 @@ func TestCadaMidiaQueComecaTemASuaCota(t *testing.T) {
 
 func TestResumosPeriodicosAparecemACada30sAChamadaInteira(t *testing.T) {
 	resumo := `info|relay traffic by kind|`
-	comum := `info|group roster received|AAA`
+	comum := `info|unprotect: authentication failed|`
 	var mostrados, comuns []int
 	for n := 1; n <= 30; n++ {
 		if mostrarLinhaChamadas(resumo, n) {
@@ -95,3 +95,21 @@ func TestRelatoriosRTCPJaEspacadosPassamSempre(t *testing.T) {
 		}
 	}
 }
+
+func TestLinhasDeRosterEChavesPassamSempre(t *testing.T) {
+	for _, n := range []int{1, 9, 57, 201} {
+		for _, chave := range []string{
+			`info|installed shared group media key epoch|AAA`,
+			`info|group rekey received|AAA`,
+			`info|group key epoch held|AAA`,
+			`info|group update received|AAA`,
+		} {
+			if !mostrarLinhaChamadas(chave, n) {
+				t.Fatalf("%s na vez %d cortada", chave, n)
+			}
+		}
+	}
+	if mostrarLinhaChamadas(`info|first RTP decoded from relay, inbound audio flowing|`, 9) {
+		t.Fatal("uma linha comum passou da cota")
+	}
+}
