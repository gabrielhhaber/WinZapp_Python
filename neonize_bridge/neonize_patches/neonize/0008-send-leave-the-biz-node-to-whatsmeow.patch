diff --git a/goneonize/wabinary_test.go b/goneonize/wabinary_test.go
new file mode 100644
index 0000000..5e82f83
--- /dev/null
+++ b/goneonize/wabinary_test.go
@@ -0,0 +1,39 @@
+package main
+
+import (
+	"context"
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestGenerateWABinaryLeavesTheBizNodeToWhatsmeow(t *testing.T) {
+	t.Setenv("NEONIZE_BOT_TAG", "")
+	to := types.NewJID("5511", types.DefaultUserServer)
+	for _, msg := range []*waE2E.Message{
+		{ListMessage: &waE2E.ListMessage{Title: proto.String("l")}},
+		{InteractiveMessage: &waE2E.InteractiveMessage{InteractiveMessage: &waE2E.InteractiveMessage_NativeFlowMessage_{
+			NativeFlowMessage: &waE2E.InteractiveMessage_NativeFlowMessage{Buttons: []*waE2E.InteractiveMessage_NativeFlowMessage_NativeFlowButton{
+				{Name: proto.String("payment_info")}}}}}},
+		{ButtonsMessage: &waE2E.ButtonsMessage{}},
+	} {
+		if nodes := *GenerateWABinary(context.Background(), to, msg); len(nodes) != 0 {
+			t.Errorf("extra nodes %v", nodes)
+		}
+	}
+}
+
+func TestTheBotNodeIsOptIn(t *testing.T) {
+	to := types.NewJID("5511", types.DefaultUserServer)
+	msg := &waE2E.Message{Conversation: proto.String("hi")}
+	t.Setenv("NEONIZE_BOT_TAG", "on")
+	if nodes := *GenerateWABinary(context.Background(), to, msg); len(nodes) != 1 || nodes[0].Tag != "bot" {
+		t.Errorf("want the bot node, got %v", nodes)
+	}
+	group := types.NewJID("1203", types.GroupServer)
+	if nodes := *GenerateWABinary(context.Background(), group, msg); len(nodes) != 0 {
+		t.Errorf("no bot node in a group, got %v", nodes)
+	}
+}
