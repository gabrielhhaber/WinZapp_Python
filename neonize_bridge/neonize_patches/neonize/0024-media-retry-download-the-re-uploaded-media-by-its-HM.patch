diff --git a/neonize/client.py b/neonize/client.py
index 2fca0e3..1346ab1 100644
--- a/neonize/client.py
+++ b/neonize/client.py
@@ -2935,6 +2935,21 @@ class NewClient:
         raw = self.__client.DecryptMediaRetry(json.dumps(request).encode())
         return json.loads(raw.decode() or "{}")
 
+    def download_retried_media(self, request: dict) -> dict:
+        """Downloads and decrypts a media the phone uploaded again after
+        :meth:`send_media_retry`, into the file ``dest``. The old
+        ``fileEncSHA256`` no longer matches the new upload, so the ciphertext is
+        authenticated by its HMAC and the plaintext by ``fileSHA256``. request is
+        {"direct_path", "media_key": base64, "enc_sha256": base64, "file_sha256":
+        base64, "kind" (image|video|audio|document|sticker), "dest",
+        "timeout_ms"}.
+
+        :return: {"ok": true, "size"} or {"error"}.
+        :raises AttributeError: on a build without it.
+        """
+        raw = self.__client.DownloadRetriedMedia(self.uuid, json.dumps(request).encode())
+        return json.loads(raw.decode() or "{}")
+
