diff --git a/goneonize/device_props.go b/goneonize/device_props.go
new file mode 100644
index 0000000..3897562
--- /dev/null
+++ b/goneonize/device_props.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"sync"
+
+	"go.mau.fi/whatsmeow/proto/waCompanionReg"
+	"go.mau.fi/whatsmeow/store"
+	"google.golang.org/protobuf/proto"
+)
+
+var (
+	baseDeviceProps = proto.Clone(store.DeviceProps).(*waCompanionReg.DeviceProps)
+	devicePropsMu   sync.Mutex
+)
+
+func applyDeviceProps(custom *waCompanionReg.DeviceProps) {
+	devicePropsMu.Lock()
+	defer devicePropsMu.Unlock()
+	applyDevicePropsTo(store.DeviceProps, baseDeviceProps, custom)
+}
+
+func applyDevicePropsTo(target, base, custom *waCompanionReg.DeviceProps) {
+	proto.Reset(target)
+	if base != nil {
+		proto.Merge(target, base)
+	}
+	if custom != nil {
+		proto.Merge(target, custom)
+	}
+}
diff --git a/goneonize/device_props_test.go b/goneonize/device_props_test.go
new file mode 100644
index 0000000..d1b2f19
--- /dev/null
+++ b/goneonize/device_props_test.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"bytes"
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waCompanionReg"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+func appendSupportOmittedField28(cfg *waCompanionReg.DeviceProps_HistorySyncConfig) {
+	var extra []byte
+	extra = protowire.AppendTag(extra, 28, protowire.VarintType)
+	extra = protowire.AppendVarint(extra, 1)
+	cfg.ProtoReflect().SetUnknown(extra)
+}
+
+func TestApplyDevicePropsResetsPreviousFullSyncAndDedupesUnknowns(t *testing.T) {
+	base := &waCompanionReg.DeviceProps{
+		Os:           proto.String("whatsmeow"),
+		PlatformType: waCompanionReg.DeviceProps_UNKNOWN.Enum(),
+		HistorySyncConfig: &waCompanionReg.DeviceProps_HistorySyncConfig{
+			StorageQuotaMb: proto.Uint32(10240),
+		},
+	}
+	target := proto.Clone(base).(*waCompanionReg.DeviceProps)
+
+	full := &waCompanionReg.DeviceProps{
+		Os:              proto.String("WinZapp"),
+		PlatformType:    waCompanionReg.DeviceProps_DESKTOP.Enum(),
+		RequireFullSync: proto.Bool(true),
+		HistorySyncConfig: &waCompanionReg.DeviceProps_HistorySyncConfig{
+			FullSyncDaysLimit:   proto.Uint32(3650),
+			FullSyncSizeMbLimit: proto.Uint32(102400),
+			StorageQuotaMb:      proto.Uint32(102400),
+		},
+	}
+	appendSupportOmittedField28(full.HistorySyncConfig)
+	applyDevicePropsTo(target, base, full)
+	if target.GetHistorySyncConfig().GetFullSyncDaysLimit() != 3650 || !target.GetRequireFullSync() {
+		t.Fatalf("full props were not applied: %+v", target)
+	}
+	firstUnknown := append([]byte(nil), target.GetHistorySyncConfig().ProtoReflect().GetUnknown()...)
+
+	// Second call ("recent only") must not inherit 3650 or duplicate field 28 bytes.
+	recent := &waCompanionReg.DeviceProps{
+		Os:                proto.String("WinZapp"),
+		PlatformType:      waCompanionReg.DeviceProps_DESKTOP.Enum(),
+		RequireFullSync:   proto.Bool(false),
+		HistorySyncConfig: &waCompanionReg.DeviceProps_HistorySyncConfig{},
+	}
+	appendSupportOmittedField28(recent.HistorySyncConfig)
+	applyDevicePropsTo(target, base, recent)
+
+	if target.GetRequireFullSync() {
+		t.Fatalf("RequireFullSync leaked from prior session")
+	}
+	if target.GetHistorySyncConfig().FullSyncDaysLimit != nil {
+		t.Fatalf("FullSyncDaysLimit leaked: %v", target.GetHistorySyncConfig().GetFullSyncDaysLimit())
+	}
+	if target.GetHistorySyncConfig().GetStorageQuotaMb() != 10240 {
+		t.Fatalf("base StorageQuotaMb lost: %v", target.GetHistorySyncConfig().GetStorageQuotaMb())
+	}
+	if !bytes.Equal(target.GetHistorySyncConfig().ProtoReflect().GetUnknown(), firstUnknown) {
+		t.Fatalf("unknown fields accumulated across calls: %x vs %x",
+			target.GetHistorySyncConfig().ProtoReflect().GetUnknown(), firstUnknown)
+	}
+}
