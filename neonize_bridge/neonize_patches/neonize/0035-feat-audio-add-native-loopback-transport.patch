diff --git a/neonize/calls.py b/neonize/calls.py
index 820ed0b..e403471 100644
--- a/neonize/calls.py
+++ b/neonize/calls.py
@@ -306,6 +306,22 @@ class Calls:
             return b""
         return buf.raw[:size]
 
