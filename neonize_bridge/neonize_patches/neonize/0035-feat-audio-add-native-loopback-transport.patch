new file mode 100644
index 0000000..8a40428
--- /dev/null
+++ b/goneonize/calls_audio_ipc_export.go
@@ -0,0 +1,35 @@
+package main
+
+/*
+#include <stdint.h>
+*/
+import "C"
+import (
+	"encoding/json"
+	"unsafe"
+)
+
+//export CallAudioTransportOpen
+func CallAudioTransportOpen(id *C.char, call *C.char, generation C.uint64_t, stream C.uint64_t, buf *C.uchar, capacity C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	if capacity < 512 {
+		return erroTamanho
+	}
+	value, err := openCallAudioIPC(a, uint64(generation), uint64(stream))
+	if err != nil {
+		return erroTamanho
+	}
+	data, _ := json.Marshal(value)
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(buf)), int(capacity)), data)
+	return C.int(len(data))
+}
+
+//export CallAudioTransportClose
+func CallAudioTransportClose(id *C.char, call *C.char, generation C.uint64_t, stream C.uint64_t) {
+	if a := buscarChamada(C.GoString(id), C.GoString(call)); a != nil {
+		closeCallAudioIPC(a, uint64(generation), uint64(stream))
+	}
+}
diff --git a/goneonize/calls_audio_ipc_test.go b/goneonize/calls_audio_ipc_test.go
new file mode 100644
index 0000000..df5f3ad
--- /dev/null
+++ b/goneonize/calls_audio_ipc_test.go
@@ -0,0 +1,217 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"net"
+	"runtime"
+	"testing"
+	"time"
+)
+
+func ipcCall(rate int) *chamadaAtiva {
+	return &chamadaAtiva{pcmRate: rate, generation: 7, entrada: newCallPCMQueueForRate(rate), saida: make(chan []byte, 3), fim: make(chan struct{})}
+}
+
+func ipcConnect(t *testing.T, a *chamadaAtiva, stream uint64) net.Conn {
+	t.Helper()
+	d, err := openCallAudioIPC(a, 7, stream)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := net.DialTimeout("tcp4", net.JoinHostPort("127.0.0.1", fmtPort(d["port"].(int))), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.SetDeadline(time.Now().Add(2 * time.Second))
+	secret, _ := hex.DecodeString(d["secret"].(string))
+	conn.Write(secret)
+	ready := make([]byte, 4)
+	if _, err = io.ReadFull(conn, ready); err != nil || string(ready) != "NZA1" {
+		t.Fatalf("handshake: %q %v", ready, err)
+	}
+	t.Cleanup(func() { conn.Close(); a.encerrar() })
+	return conn
+}
+
+func fmtPort(port int) string { // keep the protocol tests independent of C
+	return fmt.Sprint(port)
+}
+
+func TestCallAudioIPCPCM(t *testing.T) {
+	for _, rate := range []int{16000, 48000} {
+		a := ipcCall(rate)
+		conn := ipcConnect(t, a, 10)
+		pcm := bytes.Repeat([]byte{3, 4}, callAudioFrameBytes(rate)/2)
+		a.entrada.Push(pcm)
+		var header [4]byte
+		for {
+			if _, err := io.ReadFull(conn, header[:]); err != nil {
+				t.Fatal(err)
+			}
+			packet := make([]byte, binary.LittleEndian.Uint32(header[:]))
+			if _, err := io.ReadFull(conn, packet); err != nil {
+				t.Fatal(err)
+			}
+			if binary.LittleEndian.Uint32(packet) != uint32(rate) || binary.LittleEndian.Uint64(packet[4:]) != 7 {
+				t.Fatal("wrong owner")
+			}
+			if len(packet) > 12 {
+				if !bytes.Equal(packet[12:], pcm) {
+					t.Fatal("changed PCM")
+				}
+				break
+			}
+		}
+		capture := bytes.Repeat([]byte{20, 0}, 960)
+		for i := 0; i < 3; i++ {
+			binary.LittleEndian.PutUint32(header[:], uint32(len(capture)))
+			conn.Write(header[:])
+			conn.Write(capture)
+		}
+		select {
+		case frame := <-a.saida:
+			if len(frame) != callAudioFrameBytes(rate) {
+				t.Fatal("wrong native frame length")
+			}
+			if rate == 48000 && !bytes.Equal(frame, bytes.Repeat(capture, 3)) {
+				t.Fatal("capture changed")
+			}
+			if rate == 16000 {
+				expected, _ := resampleCallPCM48(append(make([]byte, 192), bytes.Repeat(capture, 3)...))
+				if !bytes.Equal(frame, expected) {
+					t.Fatal("FIR history changed")
+				}
+			}
+		case <-time.After(time.Second):
+			t.Fatal("capture stalled behind remote read")
+		}
+	}
+}
+
+func TestCallAudioIPCOwnership(t *testing.T) {
+	a := ipcCall(48000)
+	conn := ipcConnect(t, a, 10)
+	if _, err := openCallAudioIPC(a, 6, 11); err == nil {
+		t.Fatal("stale generation accepted")
+	}
+	if _, err := openCallAudioIPC(a, 7, 10); err == nil {
+		t.Fatal("replayed stream accepted")
+	}
+	newConn := ipcConnect(t, a, 11)
+	closeCallAudioIPC(a, 7, 10) // stale stop cannot close the replacement
+	a.audioMu.Lock()
+	current := a.audioIPC
+	active := current != nil && current.active
+	a.audioMu.Unlock()
+	if !active {
+		t.Fatal("stale stop closed replacement")
+	}
+	var one [1]byte
+	for {
+		if _, err := conn.Read(one[:]); err != nil {
+			break
+		}
+	} // previous socket is closed
+	a.encerrar()
+	if _, err := newConn.Read(one[:]); err == nil {
+		t.Fatal("terminal call kept socket open")
+	}
+}
+
+func TestCallAudioIPCExclusiveAndFallback(t *testing.T) {
+	a := ipcCall(48000)
+	// A reserved but not authenticated socket cannot interrupt Socket.IO.
+	_, err := openCallAudioIPC(a, 7, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.entrada.Push([]byte{1, 2})
+	packet, ended, err := readCallAudioEnvelope(a, 5772, 0)
+	if err != nil || ended || !bytes.Equal(packet[12:], []byte{1, 2}) {
+		t.Fatal("reservation blocked fallback")
+	}
+	conn := ipcConnect(t, a, 2)
+	packet, _, _ = readCallAudioEnvelope(a, 5772, 0)
+	if len(packet) != 0 {
+		t.Fatal("legacy reader competed with native reader")
+	}
+	a.audioMu.Lock()
+	p := a.audioIPC
+	a.audioMu.Unlock()
+	conn.Close()
+	select {
+	case <-p.done:
+	case <-time.After(time.Second):
+		t.Fatal("disconnect not observed")
+	}
+	// Wait only for this lease's cleanup, not for unrelated application threads.
+	deadline := time.After(time.Second)
+	for {
+		a.audioMu.Lock()
+		released := a.audioIPC == nil
+		a.audioMu.Unlock()
+		if released {
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("fallback owner not restored")
+		default:
+			runtime.Gosched()
+		}
+	}
+	a.entrada.Push([]byte{3, 4})
+	packet, ended, err = readCallAudioEnvelope(a, 5772, 0)
+	if err != nil || ended || !bytes.Equal(packet[12:], []byte{3, 4}) {
+		t.Fatal("Socket.IO reader did not resume")
+	}
+}
+
+func TestCallAudioIPCBadAuthenticationAndBounds(t *testing.T) {
+	a := ipcCall(16000)
+	defer a.encerrar()
+	d, err := openCallAudioIPC(a, 7, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := net.JoinHostPort("127.0.0.1", fmtPort(d["port"].(int)))
+	bad, _ := net.DialTimeout("tcp4", addr, time.Second)
+	bad.SetDeadline(time.Now().Add(time.Second))
+	bad.Write(make([]byte, 32))
+	var ready [4]byte
+	if _, err := io.ReadFull(bad, ready[:]); err == nil {
+		t.Fatal("unauthenticated connection accepted")
+	}
+	bad.Close()
+	a.audioMu.Lock()
+	active := a.audioIPC.active
+	a.audioMu.Unlock()
+	if active {
+		t.Fatal("bad authentication took ownership")
+	}
+	conn, _ := net.DialTimeout("tcp4", addr, time.Second)
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(time.Second))
+	secret, _ := hex.DecodeString(d["secret"].(string))
+	conn.Write(secret)
+	if _, err := io.ReadFull(conn, ready[:]); err != nil {
+		t.Fatal(err)
+	}
+	binary.LittleEndian.PutUint32(ready[:], 0xffffffff)
+	conn.Write(ready[:])
+	// Malformed sizes are rejected before allocating the requested body.
+	for {
+		if _, err := conn.Read(ready[:]); err != nil {
+			break
+		}
+	}
+	select {
+	case pcm := <-a.saida:
+		t.Fatalf("invalid capture reached native sink: %d", len(pcm))
+	default:
+	}
+}
