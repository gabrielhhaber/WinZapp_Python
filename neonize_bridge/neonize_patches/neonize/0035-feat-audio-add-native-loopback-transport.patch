diff --git a/goneonize/calls_audio_ipc.go b/goneonize/calls_audio_ipc.go
new file mode 100644
index 0000000..9722c96
--- /dev/null
+++ b/goneonize/calls_audio_ipc.go
@@ -0,0 +1,274 @@
+package main
+
+// Local PCM transport. Control/authentication stays on the bridge's HTTP API;
+// the hot path connects the device worker directly to this native call record.
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"time"
+)
+
+type callAudioIPC struct {
+	listener *net.TCPListener
+	secret   [32]byte
+	stream   uint64
+	active   bool // protected by chamadaAtiva.audioMu
+	done     chan struct{}
+	once     sync.Once
+	mu       sync.Mutex
+	conn     net.Conn
+}
+
+func (p *callAudioIPC) close() {
+	p.once.Do(func() {
+		close(p.done)
+		p.listener.Close()
+		p.mu.Lock()
+		if p.conn != nil {
+			p.conn.Close()
+		}
+		p.mu.Unlock()
+	})
+}
+
+func drainCallMicrophone(a *chamadaAtiva) {
+	for {
+		select {
+		case <-a.saida:
+		default:
+			return
+		}
+	}
+}
+
+func openCallAudioIPC(a *chamadaAtiva, generation, stream uint64) (map[string]any, error) {
+	a.audioMu.Lock()
+	defer a.audioMu.Unlock()
+	select {
+	case <-a.fim:
+		return nil, errCallPCMClosed
+	default:
+	}
+	if generation == 0 || generation != a.generation || stream == 0 || stream >= 1<<53 || stream <= a.audioStream {
+		return nil, errors.New("stale native audio owner")
+	}
+	listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return nil, err
+	}
+	p := &callAudioIPC{listener: listener, stream: stream, done: make(chan struct{})}
+	if _, err = rand.Read(p.secret[:]); err != nil {
+		listener.Close()
+		return nil, err
+	}
+	if a.audioIPC != nil {
+		a.audioIPC.close()
+	}
+	a.audioIPC, a.audioStream = p, stream
+	go p.serve(a)
+	return map[string]any{"protocol": 1, "port": listener.Addr().(*net.TCPAddr).Port,
+		"secret": hex.EncodeToString(p.secret[:]), "sampleRate": callAudioRate(a.pcmRate), "generation": a.generation}, nil
+}
+
+func (p *callAudioIPC) serve(a *chamadaAtiva) {
+	defer func() {
+		p.close()
+		a.audioMu.Lock()
+		if a.audioIPC == p {
+			a.audioIPC = nil
+			drainCallMicrophone(a)
+		}
+		a.audioMu.Unlock()
+	}()
+	// An abandoned HTTP negotiation cannot leave a listening port behind.
+	p.listener.SetDeadline(time.Now().Add(10 * time.Second))
+	for {
+		conn, err := p.listener.AcceptTCP()
+		if err != nil {
+			return
+		}
+		conn.SetNoDelay(true)
+		conn.SetDeadline(time.Now().Add(time.Second))
+		var secret [32]byte
+		_, err = io.ReadFull(conn, secret[:])
+		if err != nil || subtle.ConstantTimeCompare(secret[:], p.secret[:]) != 1 {
+			conn.Close()
+			continue
+		}
+		p.mu.Lock()
+		select {
+		case <-p.done:
+			conn.Close()
+			p.mu.Unlock()
+			return
+		default:
+		}
+		p.conn = conn
+		p.mu.Unlock()
+		p.listener.Close() // One authenticated consumer per lease.
+		a.audioReadMu.Lock()
+		a.audioMu.Lock()
+		if a.audioIPC != p {
+			a.audioMu.Unlock()
+			a.audioReadMu.Unlock()
+			return
+		}
+		select {
+		case <-a.fim:
+			a.audioMu.Unlock()
+			a.audioReadMu.Unlock()
+			return
+		default:
+		}
+		drainCallMicrophone(a)
+		p.active = true
+		_, err = conn.Write([]byte("NZA1"))
+		a.audioMu.Unlock()
+		a.audioReadMu.Unlock()
+		if err != nil {
+			return
+		}
+		conn.SetDeadline(time.Time{})
+		remoteDone := make(chan struct{})
+		go func() { defer close(remoteDone); p.sendRemote(a, conn); p.close() }()
+		p.readMicrophone(a, conn)
+		p.close()
+		<-remoteDone
+		return
+	}
+}
+
+func (p *callAudioIPC) sendRemote(a *chamadaAtiva, conn net.Conn) {
+	for {
+		a.audioReadMu.Lock()
+		a.audioMu.Lock()
+		current := a.audioIPC == p
+		a.audioMu.Unlock()
+		if !current {
+			a.audioReadMu.Unlock()
+			return
+		}
+		pcm, ended := a.entrada.Read(callAudioFrameBytes(a.pcmRate), 200*time.Millisecond)
+		a.audioReadMu.Unlock()
+		if ended {
+			return
+		}
+		select {
+		case <-p.done:
+			return
+		default:
+		}
+		// Empty PCM is a heartbeat, with the same immutable format envelope.
+		packet := make([]byte, 16+len(pcm))
+		binary.LittleEndian.PutUint32(packet, uint32(12+len(pcm)))
+		binary.LittleEndian.PutUint32(packet[4:], uint32(callAudioRate(a.pcmRate)))
+		binary.LittleEndian.PutUint64(packet[8:], a.generation)
+		copy(packet[16:], pcm)
+		conn.SetWriteDeadline(time.Now().Add(250 * time.Millisecond))
+		if _, err := conn.Write(packet); err != nil {
+			return
+		}
+	}
+}
+
+func (p *callAudioIPC) readMicrophone(a *chamadaAtiva, conn net.Conn) {
+	var header [4]byte
+	history := make([]byte, 192)
+	var pending []byte
+	for {
+		conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+		if _, err := io.ReadFull(conn, header[:]); err != nil {
+			return
+		}
+		n := binary.LittleEndian.Uint32(header[:])
+		if n == 0 {
+			continue
+		} // receive-only clients also send heartbeats
+		if n != 1920 {
+			return
+		} // exactly 20 ms, s16le mono at 48 kHz
+		pcm := make([]byte, n)
+		if _, err := io.ReadFull(conn, pcm); err != nil {
+			return
+		}
+		if callAudioRate(a.pcmRate) == 16000 {
+			window := append(history, pcm...)
+			converted, err := resampleCallPCM48(window)
+			if err != nil {
+				return
+			}
+			history = append([]byte(nil), window[len(window)-192:]...)
+			pcm = converted
+		}
+		pending = append(pending, pcm...)
+		frameBytes := callAudioFrameBytes(a.pcmRate)
+		if len(pending) < frameBytes {
+			continue
+		}
+		a.audioMu.Lock()
+		if a.audioIPC != p {
+			a.audioMu.Unlock()
+			return
+		}
+		select {
+		case <-a.fim:
+			a.audioMu.Unlock()
+			return
+		default:
+		}
+		frame := append([]byte(nil), pending[:frameBytes]...)
+		pending = pending[frameBytes:]
+		select {
+		case a.saida <- frame:
+		default:
+			select {
+			case <-a.saida:
+			default:
+			}
+			select {
+			case a.saida <- frame:
+			default:
+			}
+		}
+		a.audioMu.Unlock()
+	}
+}
+
+func closeCallAudioIPC(a *chamadaAtiva, generation, stream uint64) {
+	a.audioMu.Lock()
+	defer a.audioMu.Unlock()
+	if generation == a.generation && a.audioIPC != nil && a.audioIPC.stream <= stream {
+		a.audioIPC.close()
+	}
+}
+
+// The legacy bridge reader stays alive during native ownership but cannot
+// dequeue PCM. Never hold its reader lock during the idle wait: that would
+// add 200 ms to native delivery, and never hold audioMu across a blocking read
+// because microphone delivery must remain independent of receive cadence.
+func readCallAudioEnvelope(a *chamadaAtiva, capacity int, timeout time.Duration) ([]byte, bool, error) {
+	a.audioReadMu.Lock()
+	a.audioMu.Lock()
+	active := a.audioIPC != nil && a.audioIPC.active
+	a.audioMu.Unlock()
+	if active {
+		a.audioReadMu.Unlock()
+		if timeout <= 0 {
+			return nil, false, nil
+		}
+		select {
+		case <-a.fim:
+			return nil, true, nil
+		case <-time.After(timeout):
+			return nil, false, nil
+		}
+	}
+	defer a.audioReadMu.Unlock()
+	return readCallPCMEnvelope(a.entrada, a.pcmRate, a.generation, capacity, timeout)
+}
