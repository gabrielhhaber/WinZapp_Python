From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Mon, 26 Oct 2026 10:10:09 -0300
Subject: [PATCH] MediaConn: the media upload hosts and token

For uploads whatsmeow has no function for, such as a catalog product's
picture, which goes unencrypted to /product/image.
---
 goneonize/rawiq.go | 23 +++++++++++++++++++++++
 neonize/_binder.py |  3 +++
 neonize/client.py  |  9 +++++++++
 3 files changed, 35 insertions(+)

diff --git a/goneonize/rawiq.go b/goneonize/rawiq.go
index 282275a..a76896a 100644
--- a/goneonize/rawiq.go
+++ b/goneonize/rawiq.go
@@ -246,3 +246,26 @@ func SendMexIQ(id *C.char, queryID *C.char, variables *C.char, timeoutMs C.int)
 	}
 	return rawAnswer(answer)
 }
+
+// MediaConn answers the media upload hosts and the token to upload with
+// ({"auth", "ttl", "hosts": [...]}), for uploads whatsmeow has no function for
+// (a catalog product's picture goes unencrypted to /product/image).
+//
+//export MediaConn
+func MediaConn(id *C.char, force C.int) *C.char {
+	cli := clients[C.GoString(id)]
+	if cli == nil {
+		return rawError(fmt.Errorf("client not found"))
+	}
+	ctx, cancel := rawContext(30000)
+	defer cancel()
+	conn, err := cli.DangerousInternals().RefreshMediaConn(ctx, force != 0)
+	if err != nil {
+		return rawError(err)
+	}
+	hosts := make([]string, 0, len(conn.Hosts))
+	for _, host := range conn.Hosts {
+		hosts = append(hosts, host.Hostname)
+	}
+	return rawAnswer(map[string]any{"auth": conn.Auth, "ttl": conn.TTL, "hosts": hosts})
+}
diff --git a/neonize/_binder.py b/neonize/_binder.py
index aae2f15..ab6639a 100644
--- a/neonize/_binder.py
+++ b/neonize/_binder.py
@@ -873,6 +873,9 @@ if not os.environ.get("SPHINX"):
         gocode.SendMexIQ.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
         gocode.SendMexIQ.restype = ctypes.c_void_p
         gocode.SendMexIQ.errcheck = consume_cstring
+        gocode.MediaConn.argtypes = [ctypes.c_char_p, ctypes.c_int]
+        gocode.MediaConn.restype = ctypes.c_void_p
+        gocode.MediaConn.errcheck = consume_cstring
     if hasattr(gocode, "CallsConfigure"):
         # The call layer (goneonize/calls.go): plain C types, no protobuf; the
         # wrapper is neonize/calls.py.
diff --git a/neonize/client.py b/neonize/client.py
index 52958bb..a35a722 100644
--- a/neonize/client.py
+++ b/neonize/client.py
@@ -2879,6 +2879,15 @@ class NewClient:
                                       json.dumps(variables).encode(), int(timeout_ms))
         return json.loads(raw.decode() or "{}")
 
+    def media_conn(self, force: bool = False) -> dict:
+        """The media upload hosts and token: ``{"auth", "ttl", "hosts"}``, or
+        ``{"error"}``. For an upload whatsmeow has no function for.
+
+        :raises AttributeError: on a build without raw queries.
+        """
+        raw = self.__client.MediaConn(self.uuid, 1 if force else 0)
+        return json.loads(raw.decode() or "{}")
+
     def request_app_state_recovery(self, name: str):
         """Asks the primary device for a recovery snapshot of an app state
         collection that keeps failing with ``mismatching LTHash`` even after a
