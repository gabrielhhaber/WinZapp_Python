+// Each group sender keeps its own 480 ms: a talker whose packets arrive in a
+// burst drops only its own oldest audio, never another sender's.
+func TestCallAudioTimedQueueBoundsEachSenderSeparately(t *testing.T) {
+	a := ipcCall(48000)
+	defer a.encerrar()
+	p := &callAudioIPC{protocol: 3, active: true, timed: newTimedCallQueue()}
+	a.audioIPC = p
+	defer func() { a.audioIPC = nil }()
+	a.WriteMixedTimedFrame(make([]float32, 2880), 0, 7, 48000)
+	for i := 0; i < 20; i++ {
+		a.WriteMixedTimedFrame(make([]float32, 2880), uint32(i*2880), 42, 48000)
+	}
+	if p.timed.len() != 9 {
+		t.Fatalf("queue holds %d frames, want 8 of the talker and 1 of the other", p.timed.len())
+	}
+	first, _ := p.timed.pop()
+	if first.ssrc != 7 || first.flags != callAudioFlagTimed|callAudioFlagMixed {
+		t.Fatalf("the quiet sender's frame was dropped or lost its flags: %+v", first)
+	}
+	next, _ := p.timed.pop()
+	if next.ssrc != 42 || next.timestamp != 12*2880 {
+		t.Fatalf("the talker kept a stale frame: %+v", next)
+	}
+	q := newTimedCallQueue()
+	for i := 0; i < timedCallFramesTotal+5; i++ {
+		q.push(timedCallAudio{ssrc: uint32(i)})
+	}
+	if q.len() != timedCallFramesTotal {
+		t.Fatal("unbounded total")
+	}
+	if oldest, _ := q.pop(); oldest.ssrc != 5 {
+		t.Fatalf("total bound kept %d, want the oldest dropped first", oldest.ssrc)
+	}
+}
+
+func TestMixedTimedAudioNeedsProtocol3(t *testing.T) {
+	a := ipcCall(48000)
+	defer a.encerrar()
+	p := &callAudioIPC{protocol: 2, active: true, timed: newTimedCallQueue()}
+	a.audioIPC = p
+	defer func() { a.audioIPC = nil }()
+	if !a.WantsTimedAudio() || a.WantsMixedTimedAudio() {
+		t.Fatal("protocol 2 must take direct timed audio only")
+	}
+	a.WriteMixedTimedFrame(make([]float32, 2880), 0, 42, 48000)
+	if p.timed.len() != 0 {
+		t.Fatal("a group sender reached a client that would let it replace the others")
+	}
+	p.protocol = 3
+	if !a.WantsTimedAudio() || !a.WantsMixedTimedAudio() {
+		t.Fatal("protocol 3 takes both direct and group timed audio")
+	}
+}
+
+func TestCallAudioProtocol3HandshakeAndGroupFlag(t *testing.T) {
+	a := ipcCall(16000)
+	defer a.encerrar()
+	d, err := openCallAudioIPCProtocol(a, 7, 1, 3)
+	if err != nil || d["protocol"] != 3 {
+		t.Fatalf("protocol 3 refused: %v %v", d, err)
+	}
+	conn, err := net.DialTimeout("tcp4", net.JoinHostPort("127.0.0.1", fmtPort(d["port"].(int))), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(time.Second))
+	secret, _ := hex.DecodeString(d["secret"].(string))
+	conn.Write(secret)
+	var header [4]byte
+	if _, err := io.ReadFull(conn, header[:]); err != nil || string(header[:]) != "NZA3" {
+		t.Fatal("protocol 3 handshake failed")
+	}
+	a.WriteMixedTimedFrame(make([]float32, 960), 960, 5, 48000)
+	a.WriteTimedFrame(make([]float32, 960), 1920, 6, 48000)
+	want := []struct{ ssrc, flags uint32 }{{5, 3}, {6, 1}}
+	for i := 0; i < len(want); {
+		if _, err := io.ReadFull(conn, header[:]); err != nil {
+			t.Fatal(err)
+		}
+		packet := make([]byte, binary.LittleEndian.Uint32(header[:]))
+		if _, err := io.ReadFull(conn, packet); err != nil {
+			t.Fatal(err)
+		}
+		if len(packet) == 28 {
+			continue
+		}
+		if binary.LittleEndian.Uint32(packet[16:]) != want[i].ssrc || binary.LittleEndian.Uint32(packet[24:]) != want[i].flags {
+			t.Fatalf("packet %d: ssrc %d flags %d", i, binary.LittleEndian.Uint32(packet[16:]), binary.LittleEndian.Uint32(packet[24:]))
+		}
+		i++
+	}
+	if _, err := openCallAudioIPCProtocol(a, 7, 2, 4); err == nil {
+		t.Fatal("an unknown protocol was accepted")
+	}
+}
