+
+//export CallAudioTransportOpenV3
+func CallAudioTransportOpenV3(id *C.char, call *C.char, generation C.uint64_t, stream C.uint64_t, buf *C.uchar, capacity C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	if capacity < 512 {
+		return erroTamanho
+	}
+	value, err := openCallAudioIPCProtocol(a, uint64(generation), uint64(stream), 3)
+	if err != nil {
+		return erroTamanho
+	}
+	data, _ := json.Marshal(value)
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(buf)), int(capacity)), data)
+	return C.int(len(data))
+}
