+// Protocol 2 flags: bit 0 = PCM on the sender's RTP timeline; bit 1 (protocol
+// 3 only) = one sender of a group call, to be mixed with the others.
+const (
+	callAudioFlagTimed uint32 = 1
+	callAudioFlagMixed uint32 = 2
+)
+
+// Eight <=60 ms packets (480 ms) per sender, including multi-frame decoder
+// bursts, so one talker in a group call never pushes the others out.
+const (
+	timedCallFramesPerSource = 8
+	timedCallFramesTotal     = 64
+)
+
 type timedCallAudio struct {
 	pcm                    []byte
 	timestamp, ssrc, clock uint32
-	timed                  bool
+	flags                  uint32
+}
+
+type timedCallQueue struct {
+	mu     sync.Mutex
+	frames []timedCallAudio
+	ready  chan struct{}
+}
+
+func newTimedCallQueue() *timedCallQueue {
+	return &timedCallQueue{ready: make(chan struct{}, 1)}
+}
+
+// push drops the oldest frame of the same sender past its share, or the
+// oldest frame of all past the total: a stale backlog is never replayed.
+func (q *timedCallQueue) push(frame timedCallAudio) {
+	q.mu.Lock()
+	same, oldest := 0, -1
+	for i, queued := range q.frames {
+		if queued.ssrc == frame.ssrc {
+			if oldest < 0 {
+				oldest = i
+			}
+			same++
+		}
+	}
+	if same >= timedCallFramesPerSource {
+		q.frames = append(q.frames[:oldest], q.frames[oldest+1:]...)
+	} else if len(q.frames) >= timedCallFramesTotal {
+		q.frames = append(q.frames[:0], q.frames[1:]...)
+	}
+	q.frames = append(q.frames, frame)
+	q.mu.Unlock()
+	select {
+	case q.ready <- struct{}{}:
+	default:
+	}
+}
+
+func (q *timedCallQueue) pop() (timedCallAudio, bool) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if len(q.frames) == 0 {
+		return timedCallAudio{}, false
+	}
+	frame := q.frames[0]
+	q.frames = append(q.frames[:0], q.frames[1:]...)
+	return frame, true
+}
+
+func (q *timedCallQueue) len() int {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	return len(q.frames)
 }
 
