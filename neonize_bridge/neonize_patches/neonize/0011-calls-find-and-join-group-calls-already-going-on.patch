 else:
     gocode: Any = object()
diff --git a/neonize/calls.py b/neonize/calls.py
index d3afc2e..380a0c8 100644
--- a/neonize/calls.py
+++ b/neonize/calls.py
@@ -21,6 +21,8 @@ FRAME_BYTES = FRAME_SAMPLES * 2
 _NO_CALL = -2
 _EVENT_BUFFER = 64 * 1024       # an event that does not fit is lost on the Go side
 _RESULT_BUFFER = 4 * 1024
+# a group call's roster: every member invited, with their address and number
+_ROSTER_BUFFER = 128 * 1024
 _VIDEO_BUFFER = 1024 * 1024     # a larger access unit is dropped on the Go side
 
 # CallVideo actions
@@ -36,6 +38,11 @@ def available() -> bool:
     return hasattr(gocode, "CallsConfigure")
 
 
+def ongoing_available() -> bool:
+    """Whether this build finds and joins group calls already going on."""
+    return hasattr(gocode, "CallLobby")
+
+
 def video_available() -> bool:
     """Whether this build carries video and group calls."""
     return hasattr(gocode, "CallVideo")
@@ -123,6 +130,40 @@ class Calls:
             return None
         return json.loads(buf.raw[:size].decode("utf-8"))
 
+    def lobby(self, call_id: str, creator: str):
+        """Where the group call `call_id` started by `creator` stands, as the
+        server says while this account is not in it: {"call", "groupJid",
+        "video", "participants": [{"jid", "pn", "state"}]}, or None once it
+        is over. CallError when the server could not be asked."""
+        if not ongoing_available():
+            raise CallError("this neonize build does not find ongoing group calls")
+        buf = ctypes.create_string_buffer(_ROSTER_BUFFER)
+        size = gocode.CallLobby(self.uuid, call_id.encode(), creator.encode(), buf,
+                                _ROSTER_BUFFER)
+        result = _result(buf, size)
+        return None if result.get("over") else result
+
+    def join_ongoing(self, call_id: str, creator: str, video: bool = False) -> dict:
+        """Joins the group call `call_id` that is already going on. {"call":
+        id}; CallError on failure."""
+        if not ongoing_available():
+            raise CallError("this neonize build does not join ongoing group calls")
+        buf = ctypes.create_string_buffer(_RESULT_BUFFER)
+        size = gocode.CallJoinOngoing(self.uuid, call_id.encode(), creator.encode(),
+                                      1 if video else 0, buf, _RESULT_BUFFER)
+        return _result(buf, size)
+
+    def roster(self, call_id: str):
+        """{"group", "participants": [{"jid", "pn", "state"}]} of a call this
+        client is in, or None once it is over."""
+        if not ongoing_available():
+            return None
+        buf = ctypes.create_string_buffer(_ROSTER_BUFFER)
+        size = gocode.CallRoster(self.uuid, call_id.encode(), buf, _ROSTER_BUFFER)
+        if size <= 0:
+            return None
+        return json.loads(buf.raw[:size].decode("utf-8"))
+
     def answer(self, call_id: str) -> bool:
         return gocode.CallAnswer(self.uuid, call_id.encode()) == 0
 
