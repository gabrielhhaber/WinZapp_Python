diff --git a/neonize/calls.py b/neonize/calls.py
index 984e3c3..820ed0b 100644
--- a/neonize/calls.py
+++ b/neonize/calls.py
@@ -84,6 +84,28 @@ class Calls:
     def __init__(self, uuid: bytes):
         self.uuid = uuid
 
+    @staticmethod
+    def resample_pcm48_to16(window: bytes):
+        """Convert 96 history samples + up to 100 ms of PCM48, without stream state.
+
+        None means an older DLL: the caller retains its Python fallback.
+        The caller owns the history and must clear it on a microphone change.
+        """
+        convert = getattr(gocode, "CallResamplePCM48To16", None)
+        if convert is None:
+            return None
+        size = len(window)
+        if size < 192 or size > 9792 or (size - 192) % 6:
+            raise ValueError("invalid PCM48 resampler window")
+        expected = (size - 192) // 3
+        if not expected:
+            return b""
+        buffer = ctypes.create_string_buffer(expected)
+        count = convert(window, size, buffer, expected)
+        if count != expected:
+            raise CallError("native PCM48 resampler failed")
+        return buffer.raw[:count]
+
     def enabled(self) -> bool:
         """Whether the call layer is installed on this (connected) client."""
         return available() and gocode.CallsEnabled(self.uuid) == 1
