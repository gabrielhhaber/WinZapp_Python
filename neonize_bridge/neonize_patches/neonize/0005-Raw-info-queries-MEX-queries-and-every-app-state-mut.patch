diff --git a/goneonize/rawiq.go b/goneonize/rawiq.go
new file mode 100644
index 0000000..282275a
--- /dev/null
+++ b/goneonize/rawiq.go
@@ -0,0 +1,248 @@
+package main
+
+/*
+   #include <stdlib.h>
+*/
+import "C"
+
+// Raw info queries for what whatsmeow has no function for (catalogs, business
+// profile, status privacy...). JSON in and out, no protobuf:
+//
+//   - SendIQ(id, query) sends one <iq> and answers the response node;
+//   - SendMexIQ(id, queryID, variables) runs one w:mex (GraphQL) query and
+//     answers its "data".
+//
+// A node is {"tag": "...", "attrs": {...}, "content": [node...] | {"bytes":
+// base64} | "text"}. An attribute value written as {"jid": "..."} is sent as a
+// JID (the server tells a JID from a string by its encoding); in a response,
+// JIDs come back as plain strings. Every answer is {"node"|"data": ...} or
+// {"error": text, "code": n, "node": error node}.
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+type rawNode struct {
+	Tag     string                     `json:"tag"`
+	Attrs   map[string]json.RawMessage `json:"attrs,omitempty"`
+	Content json.RawMessage            `json:"content,omitempty"`
+}
+
+type rawIQ struct {
+	Namespace string          `json:"namespace"`
+	Type      string          `json:"type"`
+	To        string          `json:"to"`
+	Target    string          `json:"target"`
+	SMaxID    string          `json:"smax_id"`
+	Content   json.RawMessage `json:"content"`
+	TimeoutMs int             `json:"timeout_ms"`
+}
+
+func decodeRawAttr(value json.RawMessage) (any, error) {
+	var text string
+	if err := json.Unmarshal(value, &text); err == nil {
+		return text, nil
+	}
+	var jid struct {
+		JID string `json:"jid"`
+	}
+	if err := json.Unmarshal(value, &jid); err == nil && jid.JID != "" {
+		parsed, err := types.ParseJID(jid.JID)
+		if err != nil {
+			return nil, fmt.Errorf("attribute jid %q: %w", jid.JID, err)
+		}
+		return parsed, nil
+	}
+	return nil, fmt.Errorf("attribute value must be a string or {\"jid\": ...}")
+}
+
+func decodeRawContent(content json.RawMessage) (any, error) {
+	if len(content) == 0 || string(content) == "null" {
+		return nil, nil
+	}
+	var children []rawNode
+	if err := json.Unmarshal(content, &children); err == nil {
+		nodes := make([]waBinary.Node, 0, len(children))
+		for _, child := range children {
+			node, err := decodeRawNode(child)
+			if err != nil {
+				return nil, err
+			}
+			nodes = append(nodes, node)
+		}
+		return nodes, nil
+	}
+	var text string
+	if err := json.Unmarshal(content, &text); err == nil {
+		return []byte(text), nil
+	}
+	var blob struct {
+		Bytes string `json:"bytes"`
+	}
+	if err := json.Unmarshal(content, &blob); err == nil {
+		return base64.StdEncoding.DecodeString(blob.Bytes)
+	}
+	return nil, fmt.Errorf("content must be a list of nodes, a string or {\"bytes\": base64}")
+}
+
+func decodeRawNode(raw rawNode) (waBinary.Node, error) {
+	if raw.Tag == "" {
+		return waBinary.Node{}, fmt.Errorf("node without tag")
+	}
+	attrs := waBinary.Attrs{}
+	for key, value := range raw.Attrs {
+		decoded, err := decodeRawAttr(value)
+		if err != nil {
+			return waBinary.Node{}, fmt.Errorf("<%s %s>: %w", raw.Tag, key, err)
+		}
+		attrs[key] = decoded
+	}
+	content, err := decodeRawContent(raw.Content)
+	if err != nil {
+		return waBinary.Node{}, fmt.Errorf("<%s>: %w", raw.Tag, err)
+	}
+	return waBinary.Node{Tag: raw.Tag, Attrs: attrs, Content: content}, nil
+}
+
+func encodeRawNode(node *waBinary.Node) map[string]any {
+	if node == nil {
+		return nil
+	}
+	out := map[string]any{"tag": node.Tag}
+	if len(node.Attrs) > 0 {
+		attrs := make(map[string]string, len(node.Attrs))
+		for key, value := range node.Attrs {
+			attrs[key] = fmt.Sprint(value)
+		}
+		out["attrs"] = attrs
+	}
+	switch content := node.Content.(type) {
+	case []waBinary.Node:
+		children := make([]map[string]any, 0, len(content))
+		for i := range content {
+			children = append(children, encodeRawNode(&content[i]))
+		}
+		out["content"] = children
+	case []byte:
+		out["content"] = map[string]string{"bytes": base64.StdEncoding.EncodeToString(content)}
+	case nil:
+	default:
+		out["content"] = fmt.Sprint(content)
+	}
+	return out
+}
+
+func rawAnswer(value map[string]any) *C.char {
+	b, err := json.Marshal(value)
+	if err != nil {
+		b, _ = json.Marshal(map[string]any{"error": err.Error()})
+	}
+	return C.CString(string(b))
+}
+
+func rawError(err error) *C.char {
+	answer := map[string]any{"error": err.Error()}
+	var iqErr *whatsmeow.IQError
+	if errors.As(err, &iqErr) {
+		answer["code"] = iqErr.Code
+		answer["text"] = iqErr.Text
+		answer["node"] = encodeRawNode(iqErr.ErrorNode)
+	}
+	return rawAnswer(answer)
+}
+
+func rawContext(timeoutMs int) (context.Context, context.CancelFunc) {
+	if timeoutMs <= 0 {
+		timeoutMs = 30000
+	}
+	return context.WithTimeout(context.Background(), time.Duration(timeoutMs)*time.Millisecond)
+}
+
+// SendIQ sends the info query described by the JSON `query` and answers the
+// response node (see the top of this file).
+//
+//export SendIQ
+func SendIQ(id *C.char, query *C.char) *C.char {
+	cli := clients[C.GoString(id)]
+	if cli == nil {
+		return rawError(fmt.Errorf("client not found"))
+	}
+	var iq rawIQ
+	if err := json.Unmarshal([]byte(C.GoString(query)), &iq); err != nil {
+		return rawError(fmt.Errorf("query: %w", err))
+	}
+	if iq.Namespace == "" || (iq.Type != "get" && iq.Type != "set") {
+		return rawError(fmt.Errorf("query needs a namespace and type get or set"))
+	}
+	to := types.ServerJID
+	if iq.To != "" {
+		parsed, err := types.ParseJID(iq.To)
+		if err != nil {
+			return rawError(fmt.Errorf("to: %w", err))
+		}
+		to = parsed
+	}
+	var target types.JID
+	if iq.Target != "" {
+		parsed, err := types.ParseJID(iq.Target)
+		if err != nil {
+			return rawError(fmt.Errorf("target: %w", err))
+		}
+		target = parsed
+	}
+	content, err := decodeRawContent(iq.Content)
+	if err != nil {
+		return rawError(err)
+	}
+	ctx, cancel := rawContext(iq.TimeoutMs)
+	defer cancel()
+	resp, err := cli.DangerousInternals().SendIQ(ctx, whatsmeow.DangerousInfoQuery{
+		Namespace: iq.Namespace,
+		Type:      whatsmeow.DangerousInfoQueryType(iq.Type),
+		To:        to,
+		Target:    target,
+		SMaxID:    iq.SMaxID,
+		Content:   content,
+		Timeout:   time.Duration(max(iq.TimeoutMs, 0)) * time.Millisecond,
+	})
+	if err != nil {
+		return rawError(err)
+	}
+	return rawAnswer(map[string]any{"node": encodeRawNode(resp)})
+}
+
+// SendMexIQ runs one w:mex (GraphQL) query: `variables` is its JSON object.
+// Answers {"data": ...}, or {"error": ..., "data": ...} when the server
+// answered with GraphQL errors.
+//
+//export SendMexIQ
+func SendMexIQ(id *C.char, queryID *C.char, variables *C.char, timeoutMs C.int) *C.char {
+	cli := clients[C.GoString(id)]
+	if cli == nil {
+		return rawError(fmt.Errorf("client not found"))
+	}
+	vars := json.RawMessage(C.GoString(variables))
+	if !json.Valid(vars) {
+		return rawError(fmt.Errorf("variables are not JSON"))
+	}
+	ctx, cancel := rawContext(int(timeoutMs))
+	defer cancel()
+	data, err := cli.DangerousInternals().SendMexIQ(ctx, C.GoString(queryID), vars)
+	answer := map[string]any{}
+	if len(data) > 0 {
+		answer["data"] = json.RawMessage(data)
+	}
+	if err != nil {
+		answer["error"] = err.Error()
+	}
+	return rawAnswer(answer)
+}
