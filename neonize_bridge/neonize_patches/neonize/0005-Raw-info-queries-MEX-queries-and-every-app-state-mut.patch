+    def send_iq(self, query: dict) -> dict:
+        """Sends one raw info query and answers the response node, for what
+        whatsmeow has no function for. query is {"namespace", "type"
+        (get|set), "to" (default s.whatsapp.net), "target", "smax_id",
+        "content": [node...], "timeout_ms"}; a node is {"tag", "attrs",
+        "content"}, content a list of nodes, a string or {"bytes":
+        base64}, and an attribute {"jid": ...} is sent as a JID.
+
+        :return: {"node": response} or {"error", "code", "text",
+            "node"} (an error answered by the server has its code).
+        :raises AttributeError: on a build without raw queries.
+        """
+        raw = self.__client.SendIQ(self.uuid, json.dumps(query).encode())
+        return json.loads(raw.decode() or "{}")
+
+    def send_mex(self, query_id: str, variables: dict, timeout_ms: int = 30000) -> dict:
+        """Runs one w:mex (GraphQL) query: {"data": ...}, with "error"
+        when it failed or the server answered GraphQL errors.
+
+        :raises AttributeError: on a build without raw queries.
+        """
+        raw = self.__client.SendMexIQ(self.uuid, str(query_id).encode(),
+                                      json.dumps(variables).encode(), int(timeout_ms))
+        return json.loads(raw.decode() or "{}")
