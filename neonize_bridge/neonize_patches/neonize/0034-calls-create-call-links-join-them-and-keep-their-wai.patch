From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Wed, 18 Nov 2026 09:17:32 -0300
Subject: [PATCH] calls: create call links, join them and keep their waiting
 room

CallLinkCreate, CallLinkJoin, CallWaitingRoom and CallWaitingRoomDecide
expose meowcaller's call links (api/call-link-join): a new voice or video
link, the call behind a link (audio wired like an ongoing group join), and
for the call's admin the people waiting to enter, admitted or denied one by
one. A guest who opens the link in a browser always waits there.

The roster and the waiting room carry each person's push name and whether
they are a guest: a guest has no phone number. Python: CallClient
create_link, join_link, waiting_room, decide_waiting and
call_links_available().
---
 goneonize/calls_links.go   | 132 +++++++++++++++++++++++++++++++++++++
 goneonize/calls_ongoing.go |  10 +--
 neonize/_binder.py         |  13 ++++
 neonize/calls.py           |  46 +++++++++++++
 4 files changed, 197 insertions(+), 4 deletions(-)
 create mode 100644 goneonize/calls_links.go

diff --git a/goneonize/calls_links.go b/goneonize/calls_links.go
new file mode 100644
index 0000000..1fbd92f
--- /dev/null
+++ b/goneonize/calls_links.go
@@ -0,0 +1,132 @@
+package main
+
+/*
+   #include <stdlib.h>
+   #include <stdint.h>
+*/
+import "C"
+
+// Links de chamada, como o "Novo link de chamada" do WhatsApp Web: criar o
+// link, entrar na chamada dele e, para quem organiza, a sala de espera
+// (quem pediu para entrar, admitir ou recusar). O meowcaller faz a
+// sinalizacao (api/call-link-join); aqui so o JSON.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/purpshell/meowcaller"
+)
+
+// CallLinkCreate cria um link de chamada de voz ou de video: {"link",
+// "video"} ou {"error"}. O token so sai dentro do link.
+//
+//export CallLinkCreate
+func CallLinkCreate(id *C.char, video C.int, buf *C.char, cap C.int) C.int {
+	cliente := C.GoString(id)
+	mc := clienteDeChamadas(cliente)
+	if mc == nil {
+		return erroJSON(fmt.Errorf("chamadas desligadas neste cliente"), buf, cap)
+	}
+	ctx, cancelar := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancelar()
+	link, err := mc.CreateCallLink(ctx, meowcaller.CallLinkOptions{Video: video != 0})
+	if err != nil {
+		registrar(cliente, "criar link de chamada falhou: %v", err)
+		return erroJSON(err, buf, cap)
+	}
+	registrar(cliente, "link de chamada criado (video=%v)", link.Video)
+	b, _ := json.Marshal(map[string]any{"link": link.URL, "video": link.Video})
+	return escreverTexto(string(b), buf, cap)
+}
+
+// CallLinkJoin entra na chamada do link (a URL ou so o token): {"call",
+// "video", "waiting", "admin"} ou {"error"}. "waiting": a chamada pede
+// aprovacao e esta conta espera na sala de espera. O audio e ligado como numa
+// chamada em grupo em andamento.
+//
+//export CallLinkJoin
+func CallLinkJoin(id *C.char, link *C.char, video C.int, buf *C.char, cap C.int) C.int {
+	cliente := C.GoString(id)
+	mc := clienteDeChamadas(cliente)
+	if mc == nil {
+		return erroJSON(fmt.Errorf("chamadas desligadas neste cliente"), buf, cap)
+	}
+	ctx, cancelar := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancelar()
+	registrar(cliente, "entrando numa chamada por link (video=%v)", video != 0)
+	c, err := mc.JoinCallLink(ctx, C.GoString(link), meowcaller.CallLinkOptions{Video: video != 0})
+	if err != nil {
+		registrar(cliente, "a entrada pelo link falhou: %v", err)
+		return erroJSON(err, buf, cap)
+	}
+	ligarChamada(cliente, c, false)
+	sala, _ := c.WaitingRoomState()
+	b, _ := json.Marshal(map[string]any{
+		"call": c.ID(), "video": video != 0,
+		"waiting": c.State() == meowcaller.CallPhaseWaitingRoom || sala.InWaitingRoom,
+		"admin":   sala.IsAdmin})
+	return escreverTexto(string(b), buf, cap)
+}
+
+type esperandoJSON struct {
+	JID      string `json:"jid"`
+	PN       string `json:"pn,omitempty"`
+	PushName string `json:"pushName,omitempty"`
+	Guest    bool   `json:"guest,omitempty"`
+	State    string `json:"state"`
+}
+
+// CallWaitingRoom: a sala de espera da chamada por link `call`: {"enabled",
+// "admin", "waiting", "users": [{"jid", "pn", "pushName", "guest",
+// "state"}]}. Devolve o tamanho, ou -2 sem chamada.
+//
+//export CallWaitingRoom
+func CallWaitingRoom(id *C.char, call *C.char, buf *C.char, cap C.int) C.int {
+	a := buscarChamada(C.GoString(id), C.GoString(call))
+	if a == nil {
+		return erroSemChamada
+	}
+	sala, _ := a.call.WaitingRoomState()
+	usuarios := make([]esperandoJSON, 0, len(sala.Users))
+	for _, u := range sala.Users {
+		item := esperandoJSON{JID: u.JID.ToNonAD().String(), PushName: u.PushName, Guest: u.Guest, State: u.State}
+		if !u.PN.IsEmpty() {
+			item.PN = u.PN.ToNonAD().String()
+		}
+		usuarios = append(usuarios, item)
+	}
+	b, _ := json.Marshal(map[string]any{
+		"enabled": sala.Enabled, "admin": sala.IsAdmin,
+		"waiting": a.call.State() == meowcaller.CallPhaseWaitingRoom || sala.InWaitingRoom,
+		"users":   usuarios})
+	return escreverTexto(string(b), buf, cap)
+}
+
+// CallWaitingRoomDecide admite (admit != 0) ou recusa `user` na sala de
+// espera da chamada `call`: {"ok": true} ou {"error"}.
+//
+//export CallWaitingRoomDecide
+func CallWaitingRoomDecide(id *C.char, call *C.char, user *C.char, admit C.int, buf *C.char, cap C.int) C.int {
+	cliente := C.GoString(id)
+	a := buscarChamada(cliente, C.GoString(call))
+	if a == nil {
+		return erroJSON(fmt.Errorf("call not found"), buf, cap)
+	}
+	ctx, cancelar := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancelar()
+	var err error
+	if admit != 0 {
+		err = a.call.AdmitParticipant(ctx, C.GoString(user))
+	} else {
+		err = a.call.DenyParticipant(ctx, C.GoString(user))
+	}
+	if err != nil {
+		registrar(cliente, "sala de espera (admitir=%v) falhou: %v", admit != 0, err)
+		return erroJSON(err, buf, cap)
+	}
+	registrar(cliente, "sala de espera: pessoa %s", map[bool]string{true: "admitida", false: "recusada"}[admit != 0])
+	return escreverTexto(`{"ok":true}`, buf, cap)
+}
