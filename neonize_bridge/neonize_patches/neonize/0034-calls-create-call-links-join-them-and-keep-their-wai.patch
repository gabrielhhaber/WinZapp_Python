--- a/neonize/calls.py
+++ b/neonize/calls.py
@@ -49,6 +49,12 @@ def add_participant_available() -> bool:
     return hasattr(gocode, "CallAddParticipant")
 
 
+def call_links_available() -> bool:
+    """Whether this build creates call links, joins them and keeps their
+    waiting room."""
+    return hasattr(gocode, "CallLinkCreate")
+
+
 def video_available() -> bool:
     """Whether this build carries video and group calls."""
     return hasattr(gocode, "CallVideo")
@@ -209,6 +215,46 @@ class Calls:
                                          buf, _RESULT_BUFFER)
         return _result(buf, size)
 
+    def create_link(self, video: bool = False) -> dict:
+        """A new call link: {"link", "video"}; CallError on failure."""
+        if not call_links_available():
+            raise CallError("this neonize build does not create call links")
+        buf = ctypes.create_string_buffer(_RESULT_BUFFER)
+        size = gocode.CallLinkCreate(self.uuid, 1 if video else 0, buf, _RESULT_BUFFER)
+        return _result(buf, size)
+
+    def join_link(self, link: str, video: bool = False) -> dict:
+        """Joins the call of a call link (its URL or token): {"call", "video",
+        "waiting", "admin"}; CallError on failure."""
+        if not call_links_available():
+            raise CallError("this neonize build does not join call links")
+        buf = ctypes.create_string_buffer(_RESULT_BUFFER)
+        size = gocode.CallLinkJoin(self.uuid, link.encode(), 1 if video else 0, buf,
+                                   _RESULT_BUFFER)
+        return _result(buf, size)
+
+    def waiting_room(self, call_id: str):
+        """{"enabled", "admin", "waiting", "users": [{"jid", "pn", "pushName",
+        "guest", "state"}]} of a call-link call this client is in, or None once
+        it is over."""
+        if not call_links_available():
+            return None
+        buf = ctypes.create_string_buffer(_ROSTER_BUFFER)
+        size = gocode.CallWaitingRoom(self.uuid, call_id.encode(), buf, _ROSTER_BUFFER)
+        if size <= 0:
+            return None
+        return json.loads(buf.raw[:size].decode("utf-8"))
+
+    def decide_waiting(self, call_id: str, user: str, admit: bool) -> dict:
+        """Admits or denies `user` waiting to enter the call-link call
+        `call_id`: {"ok": True}; CallError on failure."""
+        if not call_links_available():
+            raise CallError("this neonize build has no call-link waiting room")
+        buf = ctypes.create_string_buffer(_RESULT_BUFFER)
+        size = gocode.CallWaitingRoomDecide(self.uuid, call_id.encode(), user.encode(),
+                                            1 if admit else 0, buf, _RESULT_BUFFER)
+        return _result(buf, size)
+
     def roster(self, call_id: str):
         """{"group", "participants": [{"jid", "pn", "state"}]} of a call this
         client is in, or None once it is over."""
