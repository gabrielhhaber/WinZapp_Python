From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WinZapp <gabarrios2006@gmail.com>
Date: Fri, 13 Nov 2026 21:54:37 -0300
Subject: [PATCH] Turn on whatsmeow's decrypted event buffer

---
 goneonize/main.go | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/goneonize/main.go b/goneonize/main.go
index 8e2f2af..649c89d 100644
--- a/goneonize/main.go
+++ b/goneonize/main.go
@@ -696,6 +696,11 @@ func Neonize(db *C.char, id *C.char, JIDByte *C.uchar, JIDSize C.int, newDevice
 	// not resend it within RequestFromPhoneDelay. Off by default in whatsmeow:
 	// the message was lost for good whenever the sender's device stayed silent.
 	client.AutomaticMessageRerequestFromPhone = true
+	// A message already handled here is then recognized as such (its ciphertext
+	// hash is kept 14 days), so an "old counter" left over means the sender's
+	// session went back in time, and whatsmeow asks it for a new one instead of
+	// dropping that device's messages (whatsmeow old_counter.go).
+	client.EnableDecryptedEventBuffer = true
 	setClient(uuid, client)
 	instalarChamadas(uuid)
 	sprStore := newSPRRetryStore(C.GoString(db))
